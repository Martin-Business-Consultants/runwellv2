#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Databases and files stay where they are whichever release runs.
export RUNWELL_DATA_DIR="$(realpath -m "${RUNWELL_DATA_DIR:-/rails/storage}")"

# An install that updated itself (Settings > Updates, Upgrade::InPlace) keeps the release in its
# data volume and runs it, until an image at least as new is deployed.
current="$RUNWELL_DATA_DIR/releases/current"
if [ -f "$current/VERSION" ] && ruby -e 'exit Gem::Version.new(File.read(ARGV[0]).strip) > Gem::Version.new(File.read(ARGV[1]).strip)' "$current/VERSION" /rails/VERSION; then
  cd "$(readlink -f "$current")"
  export BUNDLE_PATH="$PWD/bundle"
  echo "Running Runwell $(cat VERSION) from $PWD (the image holds $(cat /rails/VERSION))"
fi

# If running the rails server then create or migrate the databases (primary, cache, queue,
# cable), and installed plugins' tables after them. A database with migrations to run is backed
# up first (lib/tasks/backup.rake).
#
# A release the install updated itself to that can't migrate (a failing migration) would stop the
# install starting at all. It falls back to the image's own version instead: the release is set
# aside as releases/failed, the database was backed up first and its failed migration rolled
# back, and Settings > Updates shows the update as failed (Upgrade#reconcile!).
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  if ! ./bin/rails db:prepare; then
    if [ "$PWD" != "/rails" ] && [ -L "$current" ]; then
      echo "Runwell $(cat VERSION) couldn't migrate; starting the image's $(cat /rails/VERSION) instead" >&2
      rm -rf "$RUNWELL_DATA_DIR/releases/failed"
      mv "$(readlink -f "$current")" "$RUNWELL_DATA_DIR/releases/failed"
      rm -f "$current"
      cd /rails
      export BUNDLE_PATH=/usr/local/bundle
      ./bin/rails db:prepare
    else
      exit 1
    fi
  fi
fi

exec "${@}"
