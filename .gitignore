# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Installed plugins belong to the install, not the core (plugins/README.md).
/plugins/*
!/plugins/.keep
!/plugins/README.md

# Ignore key files for decrypting credentials and more.
/config/*.key



# Each deployment's own Kamal config and secrets name its servers and hosts: keep them out of
# the repository. Start from the examples (docs/install.md).
/config/deploy*.yml
!/config/deploy.example.yml
!/config/deploy.yml
/.kamal/secrets*
!/.kamal/secrets.example

# A client's real QA source of truth stays local; examples/acme_storage.yml shows the shape.
/engines/qa/examples/*
!/engines/qa/examples/acme_storage.yml
