<!DOCTYPE html>
<% appearance = appearance_data %>
<html lang="en" data-scheme="<%= appearance[:scheme] %>" data-radius="<%= appearance[:radius] %>" data-font="<%= appearance[:font] %>" data-text-size="<%= appearance[:text_size] %>" data-default-theme="<%= appearance[:default_theme] %>">
  <%= render "layouts/shared/head" %>

  <%# Staff pages: rune_ui's shell (the nav down the left, the page in an inset panel under a bar
      with the nav's toggle and the breadcrumb). Runwell's keys (keyboard), the details sidebar
      (panes, ]), the "/" filter (filter) and bulk actions (bulk) ride on it. %>
  <body class="<%= class_names(@body_class) %>" data-controller="keyboard panes side-panel" data-action="keyboard:select->side-panel#follow">
    <a href="#main" class="skip-link" data-turbo="false">Skip to main content</a>
    <% if authenticated? %>
      <%= crumbs(*breadcrumb_items) %>
      <% page = capture do %>
        <% if content_for?(:settings_nav) %>
          <div class="settings-layout">
            <%= yield :settings_nav %>
            <div class="settings-layout__page"><%= yield %></div>
          </div>
        <% else %>
          <%= yield %>
        <% end %>
      <% end %>
      <%= app_shell sidebar: render("layouts/shared/sidenav"), main: page, storage_key: "sidenav", shortcuts: false,
            toggle: render("layouts/shared/sidenav_toggle"), flash: render("layouts/shared/flash"),
            attributes: { id: "global-container", data: { controller: "filter" } },
            main_attributes: { id: "main", data: { controller: "bulk", action: "submit->bulk#include turbo:submit-end->bulk#done" } } %>
    <% else %>
      <div id="global-container" data-controller="filter">
        <main id="main" class="main main--narrow">
          <%= render "layouts/shared/flash" %>
          <%= yield %>
        </main>
      </div>
    <% end %>

    <footer id="footer">
      <%= yield :footer %>

      <% if authenticated? && !@hide_footer_frames %>
        <div id="footer_frames" data-turbo-permanent>
          <%= render "bar/bar" %>
          <%= render "notifications/tray" %>
        </div>
        <%= render "quick_actions/tray" %>
        <%= render "layouts/shared/side_panel", task: side_panel_task %>
        <%= turbo_stream_from Current.user, :notifications %>
        <turbo-frame id="modal"></turbo-frame>
        <%# The menus' templates rows copy from, once, out of every row and panel (TasksHelper#page_template). %>
        <%= yield :page_templates %>
      <% end %>
      <% if authenticated? %>
        <%= render "layouts/shared/hint_legend" %>
      <% end %>
    </footer>
  </body>
</html>
