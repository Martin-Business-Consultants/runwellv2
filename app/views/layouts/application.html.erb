<!DOCTYPE html>
<% appearance = appearance_data %>
<html lang="en" data-scheme="<%= appearance[:scheme] %>" data-radius="<%= appearance[:radius] %>" data-font="<%= appearance[:font] %>" data-text-size="<%= appearance[:text_size] %>" data-default-theme="<%= appearance[:default_theme] %>">
  <%= render "layouts/shared/head" %>

  <%# Staff pages: runeui's shell, inset (ui :app_shell: the nav down the left, collapsing to icons
      with [, a sheet on a phone; the page in a rounded panel under a bar with the nav's toggle and
      the breadcrumb). Runwell's keys (keyboard), the details sidebar (panes, ]), the "/" filter
      (filter, on the shell) and bulk actions (bulk, on the page's box, #main) ride on it. %>
  <body class="<%= class_names(@body_class) %>" data-controller="keyboard panes side-panel connection" data-action="keyboard:select->side-panel#follow">
    <a href="#main" class="skip-link" data-turbo="false">Skip to main content</a>
    <% if authenticated? %>
      <% page = capture do %>
        <% if content_for?(:settings_nav) %>
          <div class="settings-layout">
            <%= yield :settings_nav %>
            <div class="settings-layout__page"><%= yield %></div>
          </div>
        <% else %>
          <%= yield %>
        <% end %>
      <% end %>
      <%= ui :app_shell, variant: :inset, id: "global-container", data: { controller: "filter" },
            sidebar_header: render("layouts/shared/sidenav_brand"), sidebar: render("layouts/shared/sidenav"),
            sidebar_footer: render("layouts/shared/sidenav_foot"), header: render("layouts/shared/panel_bar", trail: breadcrumb_items, trays: !@hide_footer_frames),
            content_attrs: { id: "main", class: "main", data: { controller: "bulk", action: "submit->bulk#include turbo:submit-start->bulk#pending turbo:submit-end->bulk#done", filter_remote: (true if @filters_remotely) } },
            content: page %>
    <% else %>
      <div id="global-container" data-controller="filter">
        <main id="main" class="main main--narrow">
          <%= yield %>
        </main>
      </div>
    <% end %>

    <footer id="footer">
      <%= yield :footer %>

      <% if authenticated? && !@hide_footer_frames %>
        <div id="footer_frames" data-turbo-permanent>
          <%= render "bar/bar" %>
        </div>
        <%= render "layouts/shared/side_panel", task: side_panel_task, peek: side_panel_peek %>
        <%= turbo_stream_from Current.user, :notifications %>
        <%= render "layouts/shared/connection_status" %>
        <%= render "layouts/shared/modal_placeholder" %>
        <turbo-frame id="modal" data-loading-placeholder="modal_placeholder" data-breaks-out></turbo-frame>
        <%# The menus' templates rows copy from, once, out of every row and panel (TasksHelper#page_template). %>
        <%= yield :page_templates %>
      <% end %>
      <% if authenticated? %>
        <%= render "layouts/shared/hint_legend" %>
      <% end %>
    </footer>
    <%= render "layouts/shared/feedback" %>
  </body>
</html>
