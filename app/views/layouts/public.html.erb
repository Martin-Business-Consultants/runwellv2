<!DOCTYPE html>
<% appearance = appearance_data %>
<html lang="en" data-scheme="<%= appearance[:scheme] %>" data-radius="<%= appearance[:radius] %>" data-font="<%= appearance[:font] %>" data-text-size="<%= appearance[:text_size] %>" data-default-theme="<%= appearance[:default_theme] %>">
  <%= render "layouts/shared/head" %>

  <%# Signed-out and client-facing pages: the install's brand centered above one column, the
      theme toggle in the corner (runwell.css, .auth-layout). %>
  <body class="auth-layout">
    <a href="#main" class="skip-link" data-turbo="false">Skip to main content</a>
    <div id="global-container">
      <header class="auth-layout__header" id="header">
        <button type="button" class="icon-button theme-toggle auth-layout__theme" data-controller="theme" data-action="theme#toggle" title="Switch between light and dark">
          <%= icon_tag "moon", class: "theme-toggle__moon" %>
          <%= icon_tag "sun", class: "theme-toggle__sun" %>
          <span class="visually-hidden">Switch between light and dark</span>
        </button>
        <% logo = Setting.current.logo %>
        <div class="auth-layout__brand">
          <% if logo.attached? %>
            <%= render "layouts/shared/logo" %>
          <% else %>
            <span class="sidebar__logo"><%= render "layouts/shared/logo_mark" %></span>
            <span><%= Setting.current.brand_name %></span>
          <% end %>
        </div>

        <%= yield :header %>
      </header>

      <main id="main" class="main main--narrow auth-layout__main">
        <%= render "layouts/shared/flash" %>
        <%= yield %>
      </main>
    </div>

    <footer id="footer" class="auth-layout__footer">
      <%= yield :footer %>
    </footer>
  </body>
</html>
