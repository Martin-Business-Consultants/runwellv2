<!DOCTYPE html>
<% appearance = appearance_data %>
<html lang="en" data-scheme="<%= appearance[:scheme] %>" data-radius="<%= appearance[:radius] %>" data-font="<%= appearance[:font] %>" data-text-size="<%= appearance[:text_size] %>" data-default-theme="<%= appearance[:default_theme] %>">
  <%= render "layouts/shared/head" %>

  <%# The client portal: a top bar (the client, the sections, New request, the contact's menu)
      over one centered column (runwell.css, .portal-layout). %>
  <body class="portal-layout" data-controller="side-panel">
    <a href="#main" class="skip-link" data-turbo="false">Skip to main content</a>
    <div id="global-container">
      <% if Current.previewing? %>
        <div class="portal-preview" role="status">
          <span>
            Viewing as <strong><%= current_contact.name %></strong> at <%= current_contact.client.name %>: what they see. Nothing you do here is sent.
            <% unless current_contact.portal? %>
              <span class="portal-preview__note">They can’t sign in yet: <%= current_contact.portal_access? ? "they have no email address" : "portal access is off" %>.</span>
            <% end %>
          </span>
          <%= button_to "Stop viewing", contact_preview_path(current_contact), method: :delete, class: button_classes(variant: :secondary, size: :sm), form: { data: { turbo: false } } %>
        </div>
      <% end %>
      <header class="portal-topbar" id="header">
        <div class="portal-topbar__inner">
          <%= link_to portal_root_path, class: "sidebar__brand portal-topbar__brand" do %>
            <span class="sidebar__logo"><%= render "layouts/shared/logo_mark" %></span>
            <span class="portal-topbar__name"><%= current_contact.client.name %></span>
          <% end %>

          <nav class="portal-nav" aria-label="Portal">
            <%= link_to term(:work, count: 2), portal_root_path, class: "portal-nav__link", aria: { current: (request.path == portal_root_path || request.path.start_with?("/portal/works")) ? "page" : "false" } %>
            <%= link_to term(:task, count: 2), portal_tasks_path, class: "portal-nav__link", aria: { current: (request.path.start_with?(portal_tasks_path)) ? "page" : "false" } %>
            <%= plugin_portal_nav_links(class: "portal-nav__link") %>
            <%= link_to "Requests", portal_requests_path, class: "portal-nav__link", aria: { current: (request.path == portal_requests_path) ? "page" : "false" } %>
          </nav>

          <div class="portal-topbar__actions">
            <%= plugin_slots(:portal_actions, contact: current_contact) %>
            <%= link_to new_portal_request_path, class: button_classes(variant: :primary, size: :sm, extra: "portal-topbar__new"), data: { turbo_frame: "modal" } do %>
              <%= icon_tag "add" %>
              <span>New request</span>
            <% end %>

            <% you = capture do %>
              <%= avatar current_contact.name, size: :md %>
              <span class="visually-hidden">Your menu</span>
            <% end %>
            <%= menu you, trigger_class: "portal-user__button" do %>
              <div class="menu__label portal-user__label">
                <strong class="portal-user__name"><%= current_contact.name %></strong>
                <span class="portal-user__email"><%= current_contact.email %></span>
              </div>
              <%= menu_divider %>
              <%= menu_link safe_join([ icon_tag("email"), tag.span("Your requests") ]), portal_requests_path %>
              <%= menu_link safe_join([ icon_tag("settings-outline"), tag.span("Connected apps") ]), portal_connected_apps_path,
                    aria: { current: ("page" if request.path == portal_connected_apps_path) } %>
              <button type="button" class="menu__item theme-toggle" data-controller="theme" data-action="theme#toggle">
                <%= icon_tag "moon", class: "theme-toggle__moon" %>
                <%= icon_tag "sun", class: "theme-toggle__sun" %>
                <span>Light or dark</span>
              </button>
              <%= menu_divider %>
              <%= menu_button safe_join([ icon_tag("logout"), tag.span("Sign out") ]), portal_session_path, method: :delete %>
            <% end %>
          </div>
        </div>
      </header>

      <main id="main" class="main portal-main">
        <%= render "layouts/shared/flash" %>
        <div class="portal-page-header">
          <%= yield :header %>
        </div>
        <%= yield %>
      </main>
    </div>

    <footer id="footer" class="portal-footer">
      <%= yield :footer %>
    </footer>
    <%# New request opens here, over the page (portal/requests/new, layouts/shared/modal). %>
    <turbo-frame id="modal"></turbo-frame>
    <%# A shared task opens here, read-only (?task=, the side-panel controller, as on staff pages). %>
    <% if current_contact %>
      <%= render "portal/tasks/side_panel", task: portal_side_panel_task %>
    <% end %>
  </body>
</html>
