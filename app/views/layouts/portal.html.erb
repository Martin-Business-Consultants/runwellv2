<!DOCTYPE html>
<% appearance = appearance_data %>
<html lang="en" data-scheme="<%= appearance[:scheme] %>" data-radius="<%= appearance[:radius] %>" data-font="<%= appearance[:font] %>" data-text-size="<%= appearance[:text_size] %>" data-default-theme="<%= appearance[:default_theme] %>">
  <%= render "layouts/shared/head" %>

  <%# The client portal: a top bar (whose portal it is and for whom, the sections, New request, the
      contact's menu) over one centered column (runwell.css, .portal-layout). Its pages refresh in
      place when something of the client's changes (LiveRefreshes): a message from the team shows
      without a reload. %>
  <body class="portal-layout" data-controller="side-panel connection">
    <a href="#main" class="skip-link" data-turbo="false">Skip to main content</a>
    <%= turbo_stream_from current_contact.client %>
    <div id="global-container">
      <% if Current.previewing? %>
        <div class="portal-preview" role="status">
          <span>
            Viewing as <strong><%= current_contact.name %></strong> at <%= current_contact.client.name %>: what they see. Nothing you do here is sent.
            <% unless current_contact.portal? %>
              <span class="portal-preview__note">They can’t sign in yet: <%= current_contact.portal_access? ? "they have no email address" : "portal access is off" %>.</span>
            <% end %>
          </span>
          <%= button_to "Stop viewing", contact_preview_path(current_contact), method: :delete, class: "ui-button", data: { variant: "outline", size: "sm" }, form: { data: { turbo: false } } %>
        </div>
      <% end %>
      <header class="portal-topbar" id="header">
        <div class="portal-topbar__inner">
          <%= link_to portal_root_path, class: "portal-topbar__brand" do %>
            <span class="portal-topbar__logo"><%= render "layouts/shared/logo_mark" %></span>
            <span class="portal-topbar__names">
              <span class="portal-topbar__name"><%= Setting.current.brand_name %></span>
              <span class="portal-topbar__client"><%= current_contact.client.name %></span>
            </span>
          <% end %>

          <nav class="portal-nav" aria-label="Portal">
            <%= link_to term(:work, count: 2), portal_root_path, class: "portal-nav__link", aria: { current: (request.path == portal_root_path || request.path.start_with?("/portal/works")) ? "page" : "false" } %>
            <%= link_to portal_tasks_path, class: "portal-nav__link", aria: { current: (request.path.start_with?(portal_tasks_path)) ? "page" : "false" } do %>
              <span><%= term(:task, count: 2) %></span>
              <% if portal_unread_task_ids.any? %>
                <%= ui :badge, content: portal_unread_task_ids.size.to_s, class: "portal-nav__count", title: pluralize(portal_unread_task_ids.size, "new message") %>
              <% end %>
            <% end %>
            <%= portal_page_link :documents, "Documents", portal_documents_path, class: "portal-nav__link" %>
            <%= plugin_portal_nav_links(class: "portal-nav__link") %>
            <%= link_to "Requests", portal_requests_path, class: "portal-nav__link", aria: { current: (request.path == portal_requests_path) ? "page" : "false" } %>
          </nav>

          <div class="portal-topbar__actions">
            <%= plugin_slots(:portal_actions, contact: current_contact) %>
            <%= ui :button, href: new_portal_request_path, size: :sm, class: "portal-topbar__new", data: { turbo_frame: "modal" },
                  content: safe_join([ icon_tag("add"), tag.span("New request", class: "portal-topbar__new-label") ]) %>

            <%# The contact's menu (ui :menu): who they are, their account, requests and connected apps,
                light or dark, and signing out. %>
            <% you = capture do %>
              <button type="button" class="portal-user__button" title="Your menu">
                <%= ui :avatar, name: current_contact.name, initials: initials(current_contact.name), size: :sm %>
                <span class="visually-hidden">Your menu</span>
              </button>
            <% end %>
            <% who = capture do %>
              <span class="portal-user__label">
                <strong class="portal-user__name"><%= current_contact.name %></strong>
                <span class="portal-user__email"><%= current_contact.email %></span>
              </span>
            <% end %>
            <% theme = capture do %><span class="theme-toggle"><%= icon_tag "moon", class: "theme-toggle__moon" %><%= icon_tag "sun", class: "theme-toggle__sun" %></span> <span>Light or dark</span><% end %>
            <%= ui :menu, trigger: you, align: :end, label: "Your menu", class: "portal-user", items: [
                  { heading: who }, :separator,
                  { label: safe_join([ icon_tag("person"), tag.span("Your account") ]), href: portal_account_path },
                  { label: safe_join([ icon_tag("email"), tag.span("Your requests") ]), href: portal_requests_path },
                  { label: safe_join([ icon_tag("settings-outline"), tag.span("Connected apps") ]), href: portal_connected_apps_path },
                  { label: theme, value: "theme", data: { controller: "theme", action: "select->theme#toggle" } },
                  :separator,
                  { label: safe_join([ icon_tag("logout"), tag.span("Sign out") ]), href: portal_session_path, method: :delete } ] %>
          </div>
        </div>
      </header>

      <main id="main" class="main portal-main">
        <div class="portal-page-header">
          <%= yield :header %>
        </div>
        <%= yield %>
      </main>
    </div>

    <%# Whose portal this is and how else to reach them: a request here, or by email when the
        install takes requests that way (Settings > Email). %>
    <footer id="footer" class="portal-footer">
      <%= yield :footer %>
      <p>
        <%= Setting.current.brand_name %> · Need something?
        <%= link_to "Send a request", new_portal_request_path, data: { turbo_frame: "modal" } %><% if Setting.current.requests_email.present? %>,
          or email <%= mail_to Setting.current.requests_email %><% end %>.
      </p>
    </footer>
    <%# New request opens here, over the page (portal/requests/new, layouts/shared/modal), with
        placeholder lines while it loads and a full visit for an answer that isn't the modal. %>
    <%= render "layouts/shared/connection_status" %>
    <%= render "layouts/shared/modal_placeholder" %>
    <turbo-frame id="modal" data-loading-placeholder="modal_placeholder" data-breaks-out data-empties-on-close></turbo-frame>
    <%# A shared task opens here, read-only (?task=: runeui's side panel and the side-panel
        controller, as on staff pages). %>
    <% if current_contact %>
      <% task = portal_side_panel_task %>
      <%= ui :side_panel, params: %w[task], src: (request.fullpath if task), closable: false, label: (task ? task.title : "Details") do %>
        <% if task %>
          <%= render "portal/tasks/panel", task: task %>
        <% end %>
      <% end %>
    <% end %>
    <%= render "layouts/shared/feedback" %>
  </body>
</html>
