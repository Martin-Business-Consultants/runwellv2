<%# locals: () %>
<%# The top of the page sheet, as shadcn/ui's sidebar-inset header: the sidebar's toggle ([), a
    rule, and where this page is (breadcrumb_items). %>
<div class="ui-inset-header">
  <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm sidenav__collapse" title="Collapse or expand the menu ([)" data-keys="[" data-pane="sidenav" data-action="panes#toggleNav" aria-expanded="true">
    <%= icon_tag "column-left" %>
    <span class="for-screen-reader">Collapse or expand the menu</span>
  </button>
  <span class="ui-separator ui-separator--vertical ui-inset-header__rule" aria-hidden="true"></span>
  <nav aria-label="Breadcrumb">
    <ol class="ui-breadcrumb">
      <% breadcrumb_items.each do |label, url| %>
        <%# herb:key label %>
        <li>
          <% if url %>
            <%= link_to label, url %>
          <% else %>
            <span aria-current="page"><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
  </nav>
</div>
