<%# locals: () %>
<%# Every key the keyboard controller answers to, grouped. Shown in the ? sheet and on
    Settings > Help. Letters act outside inputs; a pair like g c is pressed in sequence. %>
<div class="shortcuts__groups txt-small txt-align-start">
  <section>
    <h3 class="txt-medium font-weight-bold margin-block-end-half">Move around</h3>
    <dl class="shortcut-list">
      <dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Next or previous item on the page</dd>
      <dt><kbd>g</kbd><kbd>g</kbd> <kbd>G</kbd></dt><dd>First or last item</dd>
      <dt><kbd>Enter</kbd> <kbd>o</kbd></dt><dd>Open the item</dd>
      <dt><kbd>e</kbd></dt><dd>Edit the item, or the record on screen</dd>
      <dt><kbd>d</kbd></dt><dd>Delete, archive or close it (asks first)</dd>
      <dt><kbd>c</kbd></dt><dd>Copy a work item’s brief for your AI</dd>
      <dt><kbd>x</kbd></dt><dd>Pick the row, to act on several at once (in a table)</dd>
      <dt><kbd>Esc</kbd></dt><dd>Drop the selection, then go up a level</dd>
    </dl>
  </section>

  <section>
    <h3 class="txt-medium font-weight-bold margin-block-end-half">Go to</h3>
    <dl class="shortcut-list">
      <dt><kbd>g</kbd><kbd>h</kbd></dt><dd>Home</dd>
      <dt><kbd>g</kbd><kbd>c</kbd></dt><dd><%= term(:client, count: 2) %></dd>
      <dt><kbd>g</kbd><kbd>e</kbd></dt><dd><%= term(:engagement, count: 2) %></dd>
      <dt><kbd>g</kbd><kbd>w</kbd></dt><dd><%= term(:work) %></dd>
      <dt><kbd>g</kbd><kbd>b</kbd></dt><dd><%= term(:work) %> board</dd>
      <dt><kbd>g</kbd><kbd>m</kbd></dt><dd>Commitments</dd>
      <dt><kbd>g</kbd><kbd>r</kbd></dt><dd>Requests</dd>
      <% Runwell::Plugins.enabled_nav_items.values.each_with_index do |(label, _path), index| %>
        <%# herb:key label %>
        <dt><kbd>g</kbd><kbd><%= index + 1 %></kbd></dt><dd><%= label %></dd>
      <% end %>
      <dt><kbd>g</kbd><kbd>n</kbd></dt><dd>Notifications</dd>
      <dt><kbd>g</kbd><kbd>s</kbd></dt><dd>Settings</dd>
    </dl>
  </section>

  <section>
    <h3 class="txt-medium font-weight-bold margin-block-end-half">On a page</h3>
    <dl class="shortcut-list">
      <dt><kbd>n</kbd></dt><dd>New one, on a list page</dd>
      <dt><kbd>v</kbd></dt><dd>Switch cards, table and board</dd>
      <dt><kbd>/</kbd></dt><dd>Filter what’s on the page</dd>
      <dt><kbd>s</kbd> <kbd>⌘K</kbd></dt><dd>Search everything</dd>
      <dt><kbd>a</kbd></dt><dd>Add a note, document, <%= term(:commitment).downcase %> or time</dd>
      <dt><kbd>p</kbd></dt><dd>Add a <%= term(:commitment).downcase %> (a promise with a date)</dd>
      <% if Ai.ready? %>
        <dt><kbd>i</kbd></dt><dd>Ask AI about what’s on screen</dd>
      <% end %>
      <dt><kbd>[</kbd></dt><dd>Collapse or expand the menu</dd>
      <dt><kbd>]</kbd></dt><dd>Hide or show a record’s details sidebar</dd>
      <dt><kbd>?</kbd></dt><dd>This list</dd>
      <dt><kbd>.</kbd></dt><dd>Hint mode: show each key on the button it presses</dd>
    </dl>
  </section>

  <section>
    <h3 class="txt-medium font-weight-bold margin-block-end-half">Board</h3>
    <dl class="shortcut-list">
      <dt><kbd>h</kbd> <kbd>l</kbd></dt><dd>Previous or next column</dd>
      <dt><kbd>j</kbd> <kbd>k</kbd></dt><dd>Up or down the column</dd>
      <dt><kbd>H</kbd> <kbd>L</kbd></dt><dd>Move the card a column left or right</dd>
      <dt><kbd>J</kbd> <kbd>K</kbd></dt><dd>Move the card down or up its column</dd>
      <dt><kbd>Enter</kbd></dt><dd>Open the card</dd>
    </dl>
  </section>

  <section>
    <h3 class="txt-medium font-weight-bold margin-block-end-half">Forms and editors</h3>
    <dl class="shortcut-list">
      <dt><kbd>⌘</kbd><kbd>Enter</kbd></dt><dd>Save (Ctrl+Enter on Windows and Linux)</dd>
      <dt><kbd>Esc</kbd></dt><dd>Cancel: close a form opened on the page, or go back</dd>
      <dt><kbd>@</kbd></dt><dd>Mention a teammate</dd>
      <dt><kbd>↑</kbd> <kbd>↓</kbd> <kbd>Enter</kbd></dt><dd>Pick from search results and notifications</dd>
    </dl>
  </section>
</div>
