<%# locals: (path:, title:, id_label: nil, context: nil, meta: nil, status: nil, highlight: nil, people: nil) %>
<%# A record as a card for the Cards view on indexes, drawn as shadcn's Card: a muted line naming
    where it sits, the title, and a footer of outline badges (the status with a dot in its tone,
    never a tint) with the people on it at the end. The whole card is its link. %>
<article class="card app-card" data-filter-target="item">
  <%= link_to path, class: "card__link app-card__link", title: title, data: { turbo_frame: "_top" } do %>
    <span class="for-screen-reader"><%= title %></span>
  <% end %>

  <header class="app-card__header">
    <% if id_label.present? || context.present? %>
      <p class="app-card__eyebrow">
        <% if id_label.present? %>
          <span class="app-card__ref"><%= id_label %></span>
        <% end %>
        <% if context.present? %>
          <span class="app-card__context"><%= context %></span>
        <% end %>
      </p>
    <% end %>
    <h3 class="app-card__title"><%= title %></h3>
  </header>

  <footer class="app-card__footer">
    <div class="app-card__badges">
      <% if status.present? %>
        <%= ui_status_badge status.to_s.humanize, highlight: highlight %>
      <% end %>
      <% Array(meta).compact_blank.each do |text| %>
        <%# herb:key text %>
        <span class="ui-badge ui-badge--outline app-card__meta"><%= text %></span>
      <% end %>
    </div>
    <% if people.present? %>
      <span class="app-card__people"><%= people %></span>
    <% end %>
  </footer>
</article>
