<%# locals: () %>
<head>
  <%= page_title_tag %>

  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <%# The browser's own bar takes the page's ground, light or dark (runeui's --background); the
      installed app's is the scheme's colour (pwa/manifest, Setting#brand_color). %>
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <% turbo_refreshes_with method: :morph, scroll: :preserve %>
  <%# Turbo's visits render through the browser's own view transitions (runwell.css styles them). %>
  <meta name="view-transition" content="same-origin">

  <%= render "layouts/theme_preference" %>
  <%= app_stylesheet_tags %>
  <% if custom_theme? %>
    <%= stylesheet_link_tag theme_stylesheet_path(Setting.current.custom_css_digest), data: { turbo_track: "reload" } %>
  <% end %>
  <%= javascript_importmap_tags %>

  <%= yield :parent_page %>
  <%= yield :head %>

  <%# Staff pages can be installed as an app (the manifest; the service worker is registered by
      application.js when this is here). The portal isn't. %>
  <% if Current.user && !controller_path.start_with?("portal") %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
  <% end %>

  <% favicon = Setting.current.favicon %>
  <% if favicon.attached? %>
    <link rel="icon" href="<%= rails_blob_path(favicon, disposition: :inline) %>" type="<%= favicon.content_type %>">
    <link rel="apple-touch-icon" href="<%= rails_blob_path(favicon, disposition: :inline) %>">
  <% else %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  <% end %>
</head>
