<%# locals: () %>
<head>
  <%= page_title_tag %>

  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0d181d" media="(prefers-color-scheme: dark)">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <% turbo_refreshes_with method: :morph, scroll: :preserve %>

  <%= render "layouts/theme_preference" %>
  <%= app_stylesheet_tags %>
  <% if custom_theme? %>
    <%= stylesheet_link_tag theme_stylesheet_path(Setting.current.custom_css_digest), data: { turbo_track: "reload" } %>
  <% end %>
  <%= javascript_importmap_tags %>

  <%= yield :parent_page %>
  <%= yield :head %>

  <% favicon = Setting.current.favicon %>
  <% if favicon.attached? %>
    <link rel="icon" href="<%= rails_blob_path(favicon, disposition: :inline) %>" type="<%= favicon.content_type %>">
    <link rel="apple-touch-icon" href="<%= rails_blob_path(favicon, disposition: :inline) %>">
  <% else %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
  <% end %>
</head>
