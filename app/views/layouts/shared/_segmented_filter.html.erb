<%# locals: (label:, param:, options:, current:, counts: nil) %>
<%# A section's filter as segmented tabs (ui-tabs): every choice in view, with its count when
    given, the current one raised. Each choice is a link that swaps one query param, as
    quick_filter's do, so it's bookmarkable and Back works. With counts, empty choices drop out,
    except the current one and the last ("All"). %>
<% shown = options.select.with_index { |(_text, value), index| counts.nil? || value == current || index == options.size - 1 || counts.fetch(value, 0).positive? } %>
<nav class="ui-tabs" aria-label="<%= label %>">
  <% shown.each do |text, value| %>
    <%# herb:key value %>
    <%= link_to url_for(request.query_parameters.merge(param.to_s => value)), class: "ui-tabs__trigger", aria: { current: ("page" if value == current) }, data: { turbo_action: "replace" } do %>
      <span><%= text %></span>
      <% if counts %>
        <span class="ui-badge ui-badge--count"><%= counts.fetch(value, 0) %></span>
      <% end %>
    <% end %>
  <% end %>
</nav>
