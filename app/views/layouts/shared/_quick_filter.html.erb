<%# locals: (title:, param:, options:, current:) %>
<%# A quick filter, drawn as shadcn's dropdown menu: an outline button showing the current choice,
    opening a menu of the others (Fizzy's popup underneath, so it keeps its keys). Each choice is a
    link that swaps one query param, so filters are bookmarkable. %>
<div class="quick-filter quick-filter--with-default" data-filter-show="true" data-controller="dialog" data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside">
  <button type="button" class="ui-button ui-button--outline ui-button--sm ui-dropdown__trigger" aria-haspopup="menu" data-action="click->dialog#toggle:stop">
    <span class="overflow-ellipsis"><%= options.to_h.invert.fetch(current, options.first.first) %></span>
    <span class="ui-dropdown__chevron" aria-hidden="true"></span>
  </button>

  <%= popup_menu label: title, title: title do %>
    <ul class="popup__list" role="listbox">
      <% options.each do |text, value| %>
        <%# herb:key value %>
        <li class="popup__item" role="checkbox" aria-checked="<%= value == current %>">
          <%= link_to url_for(request.query_parameters.merge(param.to_s => value)), class: "popup__btn", data: { turbo_action: "replace" } do %>
            <span class="overflow-ellipsis flex-item-grow"><%= text %></span>
            <%= icon_tag "check", class: "checked" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
