<%# locals: (text:, action_text: nil, action_path: nil, action_frame: nil) %>
<%# What an empty list says, and where its records come from (runeui's ui :empty), with a button
    to the next step when there is one (action_frame: the frame it opens in, "modal" for a form
    over the page). The name plugins render; the core's lists call ui :empty themselves. %>
<% action = action_path ? ui(:button, href: action_path, variant: :outline, size: :sm, content: action_text, data: { turbo_frame: action_frame }) : nil %>
<%= ui :empty, description: text, action: action %>
