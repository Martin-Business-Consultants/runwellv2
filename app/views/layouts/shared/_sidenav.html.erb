<%# locals: () %>
<%# The staff nav, down the left (rune_ui's sidebar): the install at the top, Needs You and the
    core sections, then what plugins add, and at the foot the page filter (/), plugins' actions,
    the shortcut sheet (?) and the signed-in person, whose menu holds their account, settings,
    the theme, help and signing out. The current section is marked (aria-current). %>
<nav class="sidebar" id="sidenav" aria-label="Main">
  <div class="sidebar__top">
    <%= link_to root_path, class: "sidebar__brand", title: "Needs You (g h)", data: { keys: "g h" } do %>
      <span class="sidebar__brand-text">
        <span class="sidebar__brand-name"><%= render "layouts/shared/logo" %></span>
        <span class="sidebar__brand-sub"><%= term(:client, count: 2) %> and work</span>
      </span>
    <% end %>
  </div>

  <%= sidebar_section "Workspace" %>
  <%= sidenav_link_to "Needs You", root_path, icon: "home", current: request.path == root_path %>
  <%= sidenav_link_to term(:client, count: 2), clients_path, icon: "everyone", keys: "g c" %>
  <%= sidenav_link_to term(:engagement, count: 2), engagements_path, icon: "clipboard", keys: "g e" %>
  <%= sidenav_link_to term(:work, count: 2), todos_path, icon: "board", keys: "g w" %>
  <%= sidenav_link_to "Users", users_path, icon: "person", keys: "g u" %>

  <% if nav_plugin_items.any? %>
    <%= sidebar_section "Plugins" %>
    <%= plugin_sidenav_links %>
  <% end %>

  <div class="sidebar__tools">
    <%= render "layouts/shared/nav_filter" %>
    <%= plugin_slots(:nav_actions) %>
    <%= render "layouts/shared/shortcuts" %>
  </div>

  <div class="sidebar__footer">
    <% account = capture do %>
      <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "sidebar__avatar" %>
      <span class="sidebar__account-text">
        <span class="sidebar__label"><%= Current.user.display_name %></span>
        <span class="sidebar__account-email"><%= Current.user.email_address %></span>
      </span>
    <% end %>
    <%= menu account, up: true, trigger_class: "sidebar__account" do %>
      <%= menu_link safe_join([ icon_tag("person"), tag.span("Your account") ]), settings_account_path %>
      <%= menu_link safe_join([ icon_tag("settings-outline"), tag.span("Settings and help"), tag.kbd("G S") ]), settings_path,
            data: { keys: "g s" }, aria: { current: (request.path.start_with?(settings_path) ? "page" : "false") } %>
      <button type="button" class="menu__item theme-toggle" data-controller="theme" data-action="theme#toggle">
        <%= icon_tag "moon", class: "theme-toggle__moon" %>
        <%= icon_tag "sun", class: "theme-toggle__sun" %>
        <span>Light or dark</span>
      </button>
      <button type="button" class="menu__item" data-controller="rune-proxy" data-action="rune-proxy#click" data-rune-proxy-selector-param="[data-keys='?']">
        <%= icon_tag "lifebuoy" %> <span>Keyboard shortcuts</span> <kbd>?</kbd>
      </button>
      <%= menu_divider %>
      <%= menu_button safe_join([ icon_tag("logout"), tag.span("Sign out") ]), session_path, method: :delete %>
    <% end %>
  </div>
</nav>
