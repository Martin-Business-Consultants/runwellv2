<%# locals: () %>
<%# The staff nav's sections (the middle of ui :app_shell's sidebar, which scrolls and keeps its
    place from page to page): as Settings > Sidebar arranges them (NavLayout: the core's and
    plugins' pages together, under headings the install names), each a ui :sidebar_group of
    ui :sidebar_item (sidenav_link_to), the current one marked. The brand above them is
    layouts/shared/_sidenav_brand; the filter, the shortcut sheet and the person's menu below,
    layouts/shared/_sidenav_foot. %>
<% nav_sections.each_with_index do |(label, links), index| %>
  <%# herb:key index %>
  <%= ui :sidebar_group, label: label.presence do %>
    <% links.each do |link_label, url, icon, keys| %>
      <%# herb:key url %>
      <%= sidenav_link_to link_label, url, icon: icon, keys: keys %>
    <% end %>
  <% end %>
<% end %>
