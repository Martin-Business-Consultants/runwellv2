<%# locals: (record:, open_path:, context: nil, meta: nil) %>
<%# The top of a peek in the side panel (clients/_peek, works/_peek, contacts/_peek): where the
    record sits (context, a peek link of its own when it's a record), beside it what it's worth
    knowing at a glance (meta: a client's status, changed in place), then Open its page and Close. %>
<header class="<%= class_names("task-panel__header", "task-panel__header--meta": meta.present?) %>">
  <p class="task-panel__context">
    <% if context.is_a?(ActiveRecord::Base) %>
      <%= peek_link_to context, peek_title(context) %>
    <% elsif context %>
      <span><%= context %></span>
    <% end %>
  </p>
  <% if meta.present? %>
    <div class="task-panel__meta"><%= meta %></div>
  <% end %>
  <div class="task-panel__actions">
    <%= ui :button, href: open_path, variant: :ghost, size: :icon_sm, title: "Open its page", aria: { label: "Open #{peek_title(record)} on its own page" }, data: { turbo_frame: "_top" }, content: icon_tag("maximize") %>
    <%= ui :button, variant: :ghost, size: :icon_sm, title: "Close (Esc)", aria: { label: "Close" }, data: { keys: "esc", action: "side-panel#close" }, content: icon_tag("close") %>
  </div>
</header>
