<%# locals: () %>
<%# The ? sheet: every key (layouts/shared/_shortcut_list) in runeui's ui :dialog, opened by ? (its
    button sits out of sight in the nav's foot, where the keyboard controller can press it; the
    account menu's Keyboard shortcuts presses it too), with hint mode's switch at its foot. %>
<% trigger = capture do %>
  <%# runeui:allow native-control — out of sight: what the ? key presses %>
  <button type="button" class="nav-shortcuts-button" title="Help and keyboard shortcuts" data-keys="?">
    <span class="visually-hidden">Keyboard shortcuts</span>
  </button>
<% end %>
<% footer = capture do %>
  <%= ui :switch, id: "hints-switch", label: "Show each key on the control it presses", data: { action: "change->keyboard#setHints" } %>
  <%= ui :button, content: "Close", variant: :outline, data: { runeui_close: "shortcuts" } %>
<% end %>
<%= ui :dialog, id: "shortcuts", trigger: trigger, size: :xl, class: "shortcuts", title: "Keyboard shortcuts",
      description: "Letters work anywhere outside a text field. A pair like g c is pressed one key after the other.", footer: footer do %>
  <%= render "layouts/shared/shortcut_list" %>
<% end %>
