<%# locals: () %>
<%# The ? sheet: a button in the nav opening shadcn's Dialog, listing every key as Kbd. %>
<div class="display-contents" data-controller="dialog" data-dialog-modal-value="true" data-action="keydown.esc->dialog#close:stop">
  <button type="button" class="ui-button ui-button--ghost ui-button--icon-sm" title="Help and keyboard shortcuts" data-keys="?" data-action="dialog#open">
    <kbd class="txt-x-small">?</kbd>
    <span class="for-screen-reader">Keyboard shortcuts</span>
  </button>
  <dialog class="ui-dialog shortcuts" data-dialog-target="dialog" aria-labelledby="shortcuts_title">
    <header class="ui-dialog__header">
      <h2 class="ui-dialog__title" id="shortcuts_title">Keyboard shortcuts</h2>
      <p class="ui-dialog__description">Letters work anywhere outside a text field. A pair like <kbd>g</kbd> <kbd>c</kbd> is pressed one key after the other.</p>
    </header>
    <button type="button" class="ui-dialog__close ui-button ui-button--ghost ui-button--icon-sm" title="Close" data-action="dialog#close">
      <%= icon_tag "close" %>
      <span class="for-screen-reader">Close</span>
    </button>
    <%= render "layouts/shared/shortcut_list" %>
    <footer class="ui-dialog__footer shortcuts__footer">
      <button type="button" class="ui-button ui-button--outline hints-switch" data-action="keyboard#toggleHints">
        <span class="hints-switch__show">Show key hints</span>
        <span class="hints-switch__hide">Hide key hints</span>
        <kbd class="hide-on-touch">.</kbd>
      </button>
      <button type="button" class="ui-button" data-action="dialog#close">Close <kbd class="hide-on-touch">Esc</kbd></button>
    </footer>
  </dialog>
</div>
