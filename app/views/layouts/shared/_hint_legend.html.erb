<%# locals: () %>
<%# Hint mode's strip at the foot of the page: the keys that have no control to label, each a
    ui :kbd. Shown only while hint mode is on; the keyboard controller turns it on and off. %>
<aside class="hint-legend hide-on-touch" aria-label="Keyboard hints">
  <span class="hint-legend__item"><%= ui :kbd, content: "j" %><%= ui :kbd, content: "k" %> Move</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "Enter" %> Open</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "/" %> Filter</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "s" %> Search</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "a" %> Quick actions</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "Esc" %> Back</span>
  <span class="hint-legend__item"><%= ui :kbd, content: "?" %> All keys</span>
  <%= ui :button, variant: :ghost, size: :sm, class: "hint-legend__close", data: { action: "keyboard#toggleHints" } do %>
    Hide hints <%= ui :kbd, content: "." %>
  <% end %>
</aside>
