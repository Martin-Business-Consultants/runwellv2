<%# locals: () %>
<%# In a record page's header actions: hides its sidebar for a wider working column (]), and
    brings it back (the panes controller, data-sidebar on <html>). runeui's ghost icon button. %>
<%= ui :button, variant: :ghost, size: :icon, class: "sidebar-toggle", content: icon_tag("column-right"), title: "Hide or show the details (])",
      aria: { label: "Hide or show the details", expanded: "true" }, data: { keys: "]", pane: "sidebar", action: "panes#toggleSidebar" } %>
