<%# locals: () %>
<%# The first thing in a record page's sidebar: hides it for a wider working column (]), and
    stays as a thin strip to bring it back. %>
<button type="button" class="sidebar-toggle btn btn--circle borderless txt-small" title="Hide or show the details (])" data-keys="]" data-pane="sidebar" data-action="panes#toggleSidebar" aria-expanded="true">
  <%= icon_tag "column-right" %>
  <span class="for-screen-reader">Hide or show the details</span>
</button>
