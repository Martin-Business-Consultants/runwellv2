<%# locals: (tabs:, current:, variant: nil) %>
<%# A record page's tabs (and a settings page's): runeui's tabs as links (ui :tabs with href:),
    each swapping ?tab= inside the record_tab frame, so a tab is bookmarkable, Back works and only
    the frame reloads; the one clicked is current at once (the picks-current behavior). The panel
    under them is the caller's (record-tabs__panel). variant: "pill" is the default muted row;
    anything else draws them underlined. %>
<%= ui :tabs, label: "Sections", value: current, variant: (variant == "pill" || variant.nil? ? nil : :line), tabs: record_tab_links(tabs), class: "record-tabs__list", data: { picks_current: true } %>
