<%# locals: () %>
<%# What a modal frame shows while a slow form is on its way (the loading-placeholder behavior,
    after 150ms): the dialog itself, with quiet lines where the form goes. The form's answer
    replaces it. %>
<template id="modal_placeholder">
  <div data-loading-placeholder-content>
    <%= ui :dialog, open: true, size: :lg, class: "record-modal", aria: { busy: "true" } do %>
      <div class="record-modal__placeholder" aria-label="Loading">
        <%= ui :skeleton, class: "record-modal__skeleton record-modal__skeleton--title" %>
        <%= ui :skeleton, class: "record-modal__skeleton" %>
        <%= ui :skeleton, class: "record-modal__skeleton" %>
        <%= ui :skeleton, class: "record-modal__skeleton record-modal__skeleton--short" %>
      </div>
    <% end %>
  </div>
</template>
