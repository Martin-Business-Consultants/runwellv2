<%# locals: (name:, edit_path: nil, delete_path: nil, delete_message: nil, task: nil, peek: nil, undoable: nil) %>
<%# A table row's last cell: edit and delete, each only when the record allows it (and
    delete only for people who may delete records). Delete asks in the page's one confirm dialog
    (row_delete_button) and the row goes in place. peek: a record that's changed in
    place, whose Edit opens it in the side panel rather than going to its edit page. undoable: a
    record removed at once with Undo in the toast (a task), with no dialog. %>
<td class="row-actions" data-align="end">
  <div class="row-actions__row">
    <% if task %>
      <%= render "tasks/ai_brief", task: task %>
    <% end %>
    <% if edit_path %>
      <% edit_label = "Edit " + name %>
      <% if peek %>
        <%= peek_link_to peek, class: "ui-button row-action", title: edit_label, aria: { label: edit_label }, data: { variant: "ghost", size: "icon-sm", keys: "e" } do %>
          <%= icon_tag "pencil" %>
        <% end %>
      <% else %>
        <%= link_to edit_path, class: "ui-button row-action", title: edit_label, aria: { label: edit_label }, data: { variant: "ghost", size: "icon-sm", keys: "e" } do %>
          <%= icon_tag "pencil" %>
        <% end %>
      <% end %>
    <% end %>
    <% if delete_path && can?(:delete_records) %>
      <% if undoable %>
        <%= row_remove_button name: name, path: delete_path %>
      <% else %>
        <%= row_delete_button name: name, path: delete_path, message: delete_message %>
      <% end %>
    <% end %>
  </div>
</td>
