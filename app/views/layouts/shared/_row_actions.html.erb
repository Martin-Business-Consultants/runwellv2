<%# locals: (name:, edit_path: nil, delete_path: nil, delete_message: nil, task: nil, peek: nil) %>
<%# A table row's last cell: edit and delete, each only when the record allows it (and
    delete only for people who may delete records). Delete opens the table's one dialog
    (layouts/shared/_row_delete_dialog), which its button fills in. peek: a record that's changed in
    place, whose Edit opens it in the side panel rather than going to its edit page. %>
<td class="data-table__actions">
  <div class="data-table__actions-row">
    <% if task %>
      <%= render "tasks/ai_brief", task: task %>
    <% end %>
    <% if edit_path %>
      <% edit_label = "Edit " + name %>
      <% if peek %>
        <%= peek_link_to peek, class: "icon-button row-action", title: edit_label, aria: { label: edit_label }, data: { keys: "e" } do %>
          <%= icon_tag "pencil" %>
        <% end %>
      <% else %>
        <%= link_to edit_path, class: "icon-button row-action", title: edit_label, aria: { label: edit_label }, data: { keys: "e" } do %>
          <%= icon_tag "pencil" %>
        <% end %>
      <% end %>
    <% end %>
    <% if delete_path && can?(:delete_records) %>
      <%= row_delete_button name: name, path: delete_path, message: delete_message %>
    <% end %>
  </div>
</td>
