<%# locals: (record:) %>
<% if record.errors.any? %>
  <div class="ui-alert ui-alert--destructive margin-block-half" role="alert">
    <%= icon_tag "close-circle", class: "ui-alert__icon" %>
    <p class="ui-alert__title">That didn’t work</p>
    <ul class="ui-alert__description margin-block-none">
      <% record.errors.full_messages.each do |message| %>
        <%# herb:key message %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
