<%# locals: (record:) %>
<%# Why a save was refused, above the form: ui :alert with each of the record's errors. %>
<% if record.errors.any? %>
  <%= ui :alert, variant: :destructive, title: "That didn’t work", class: "form-errors" do %>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <%# herb:key message %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>
<% end %>
