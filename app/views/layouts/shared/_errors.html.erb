<%# locals: (record:) %>
<% if record.errors.any? %>
  <div class="alert alert--danger" role="alert">
    <%= icon_tag "close-circle", class: "alert__icon" %>
    <p class="alert__title">That didn’t work</p>
    <ul class="alert__body">
      <% record.errors.full_messages.each do |message| %>
        <%# herb:key message %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
