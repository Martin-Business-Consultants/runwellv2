<%# locals: () %>
<%# A table's one delete dialog (ui/_data_table): each row's trash button fills it in and opens
    it (row_delete controller), so a long table doesn't carry a dialog and a form per row. %>
<dialog class="dialog" aria-label="Delete" data-row-delete-target="dialog" data-action="click->row-delete#backdrop keydown.esc->row-delete#close:stop">
  <div class="dialog__box">
    <header class="dialog__header">
      <h2 class="dialog__title" data-row-delete-target="title">Delete?</h2>
    </header>
    <div class="dialog__body">
      <p class="dialog__hint" data-row-delete-target="hint">This can’t be undone.</p>
      <div class="dialog__actions">
        <button type="button" class="btn btn--ghost" data-action="row-delete#close">Cancel</button>
        <%= button_to "#", method: :delete, params: { inline: "row" }, class: "btn btn--danger", form: { data: { row_delete_target: "form", turbo_frame: "_top" } }, data: { turbo_frame: "_top" } do %>
          <%= icon_tag "trash" %>
          <span>Delete</span>
        <% end %>
      </div>
    </div>
  </div>
</dialog>
