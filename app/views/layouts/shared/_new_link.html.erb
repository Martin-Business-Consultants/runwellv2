<%# locals: (text:, path:, icon: nil, key: nil) %>
<% icon ||= "add"
   key ||= "n" %>
<a href="<%= path %>" class="btn btn--primary new-link" data-keys="<%= key %>">
  <%= icon_tag icon %>
  <span class="new-link__text"><%= text %></span>
  <kbd class="new-link__key hide-on-touch"><%= key.upcase %></kbd>
</a>
