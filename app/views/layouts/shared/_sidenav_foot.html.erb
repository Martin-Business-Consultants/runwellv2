<%# locals: () %>
<%# The foot of the staff nav (ui :app_shell's sidebar_footer): the page filter (/), plugins'
    actions and the shortcut sheet (?) in a row, then the signed-in person, whose menu holds their
    account, settings, the theme, help and signing out. %>
<div class="nav-tools">
  <%= render "layouts/shared/nav_filter" %>
  <%= plugin_slots(:nav_actions) %>
  <%= render "layouts/shared/shortcuts" %>
</div>

<div class="nav-account">
  <% account = capture do %>
    <%= avatar_preview_tag Current.user, hidden_for_screen_reader: true, class: "nav-account__avatar" %>
    <span class="nav-account__text">
      <span class="nav-account__name"><%= Current.user.display_name %></span>
      <span class="nav-account__email"><%= Current.user.email_address %></span>
    </span>
  <% end %>
  <%# Their menu (ui :menu), opening upwards: their account, settings (g s), light or dark, the
      shortcut sheet (it opens the sheet's ui :dialog, #shortcuts) and signing out. %>
  <% theme = capture do %><span class="theme-toggle"><%= icon_tag "moon", class: "theme-toggle__moon" %><%= icon_tag "sun", class: "theme-toggle__sun" %></span> <span>Light or dark</span><% end %>
  <% shortcuts = capture do %><%= icon_tag "lifebuoy" %> <span>Keyboard shortcuts</span> <%= ui :kbd, content: "?" %><% end %>
  <% settings = capture do %><%= icon_tag "settings-outline" %> <span>Settings and help</span> <%= ui :kbd, keys: %w[G S] %><% end %>
  <%# runeui:allow native-control — the nav's account row (avatar, name, address) opening its menu %>
  <%= ui :menu, trigger: tag.button(account, type: "button", class: "nav-account__button"), side: :top, align: :start, label: "Your menu", class: "nav-account__menu", items: [
        { label: safe_join([ icon_tag("person"), tag.span("Your account") ]), href: settings_account_path },
        { label: settings, href: settings_path, data: { keys: "g s", keys_anywhere: true } },
        { label: theme, value: "theme", data: { runeui_theme: "toggle" } },
        { label: shortcuts, value: "shortcuts", data: { runeui_open: "shortcuts" } },
        :separator,
        { label: safe_join([ icon_tag("logout"), tag.span("Sign out") ]), href: session_path, method: :delete } ] %>
</div>
