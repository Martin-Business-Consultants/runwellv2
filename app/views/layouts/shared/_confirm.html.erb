<%# locals: (trigger:, title:, body:, button:, path:, method: nil, icon: nil) %>
<%# herb:slots client %>
<%# herb:state (confirming: false) %>
<%# Both halves are always on the page and state only hides one, so asking and cancelling never
    wait on the server. %>
<div class="confirm" data-controller="state-focus" data-state-focus-state-value="confirming">
  <div class="card card--sm card--danger confirm__card" role="alertdialog" aria-label="<%= title %>" hidden="<%= !confirming %>">
    <header class="card__head">
      <h3 class="card__title"><%= title %></h3>
      <p class="card__hint"><%= body %></p>
    </header>
    <footer class="card__footer">
      <button type="button" class="btn btn--ghost" data-keys="esc" data-herb-reset="confirming" autofocus>Cancel</button>
      <%= button_to path, method: method || :delete, class: "btn btn--danger" do %>
        <span><%= button %></span>
      <% end %>
    </footer>
  </div>
  <button type="button" class="btn btn--ghost btn--sm confirm__trigger" data-keys="d" data-herb-toggle="confirming" hidden="<%= confirming %>">
    <%= icon_tag icon || "trash" %>
    <span><%= trigger %></span>
  </button>
</div>
