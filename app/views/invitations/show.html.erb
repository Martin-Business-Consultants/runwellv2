<% @page_title = "Join Runwell" %>

<div class="auth">
  <section class="ui-card auth__card <%= "shake" if @user.errors.any? %>">
    <header class="ui-card__header auth__header">
      <h1 class="ui-card__title auth__title">Join Runwell</h1>
      <p class="ui-card__description"><%= @invitation.invited_by.display_name %> invited <strong class="auth__strong"><%= @invitation.email_address %></strong> as <%= @invitation.role == "owner" ? "an owner" : "a " + @invitation.role %>.</p>
    </header>

    <div class="ui-card__content auth__content">
      <%= render "layouts/shared/errors", record: @user %>

      <%= form_with model: @user, url: invitation_path(params[:token]), method: :patch, scope: :user, class: "auth__form", data: { controller: "form" } do |form| %>
        <div class="ui-field">
          <%= form.label :name, "Full name", class: "ui-label" %>
          <%= form.text_field :name, required: true, class: "ui-input", autofocus: true, autocomplete: "name", maxlength: 240 %>
        </div>

        <div class="ui-field">
          <%= form.label :password, "Choose a password", class: "ui-label" %>
          <%= form.password_field :password, required: true, class: "ui-input", autocomplete: "new-password", maxlength: 72 %>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Join</button>
      <% end %>
    </div>
  </section>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
