<% @page_title = "Join Runwell" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <% hint = capture do %><%= @invitation.invited_by.display_name %> invited <strong class="auth__strong"><%= @invitation.email_address %></strong> as <%= @invitation.role == "owner" ? "an owner" : "a " + @invitation.role %>.<% end %>
  <%= auth_card title: "Join Runwell", hint: hint, shake: @user.errors.any? do %>
      <%= render "layouts/shared/errors", record: @user %>

      <%= form_with model: @user, url: invitation_path(params[:token]), method: :patch, scope: :user, class: "auth__form", data: { controller: "form" } do |form| %>
        <%= form.ui :field, :name, label: "Full name" do %>
          <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 240 %>
        <% end %>

        <%= form.ui :field, :password, label: "Choose a password" do %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>

        <%= ui :button, type: :submit, content: "Join", "data-form-target": "submit", class: "auth__button" %>
      <% end %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
