<%# locals: () %>
<%# The bell at the right of the panel bar (g n) and its menu (ui :menu): the newest few unread as
    items (notifications/trays/show, loaded into the notifications frame and reloaded on every
    refresh the person's notifications broadcast), each opening its record and reading it on the
    way, then the way to every notification and Mark all as read. Arrows, Home / End and Esc are
    the menu's. Permanent, so its loaded list rides along from page to page; the badge controller
    keeps the tab's title and the app's badge to the unread total, and the bell carries a dot while
    anything is unread. %>
<% trigger = capture do %>
  <button type="button" class="tray__toggle" aria-label="Notifications" title="Notifications (G N)" data-keys="g n">
    <span class="tray__toggle-btn"><%= icon_tag "bell" %></span>
  </button>
<% end %>
<div class="tray tray--notifications" id="notifications_tray" data-turbo-permanent data-controller="badge" data-action="turbo:frame-render->badge#update">
  <%= ui :menu, id: "notifications-menu", trigger: trigger, side: :bottom, align: :end, label: "Notifications", class: "notifications-menu" do %>
    <ui-menu-group-label data-slot="menu-group-label" class="notifications-menu__title">Notifications</ui-menu-group-label>
    <turbo-frame id="notifications" src="<%= notifications_tray_path %>" refresh="morph" data-controller="frame-reloader" data-action="focus@window->frame-reloader#reload"></turbo-frame>
    <p class="notifications-menu__empty">You’re all caught up.</p>
    <%= ui :menu, part: "items", items: [ :separator,
          { label: tag.span(safe_join([ tag.span("See all new", class: "notifications-menu__new"), tag.span("View all", class: "notifications-menu__all") ])), href: notifications_path, icon: :inbox },
          { label: "Mark all as read", href: bulk_reading_path(from_tray: true), method: :post, icon: :check, data: { action: "click->badge#clear" } } ] %>
  <% end %>
</div>
