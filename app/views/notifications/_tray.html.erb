<%# locals: () %>
<%# The bell in the bottom right corner (g n) and its Popover: a header with the way to every
    notification and Clear all, over the newest few as Items (notifications/trays/show). %>
<section class="tray tray--notifications" data-controller="dialog badge" data-badge-unread-class="unread" data-action="turbo:render#update" data-dialog-sizing-value="false">
  <dialog class="tray__dialog"
      aria-label="Notifications"
      data-controller="navigable-list"
      data-dialog-target="dialog"
      data-navigable-list-actionable-items-value="true"
      data-navigable-list-reverse-navigation-value="true"
      data-action="keydown->navigable-list#navigate dialog:show@document->navigable-list#reset turbo-visit->navigable-list#reset keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
    <turbo-frame id="notifications" src="<%= notifications_tray_path %>" refresh="morph" data-controller="frame-reloader" data-action="focus@window->frame-reloader#reload"></turbo-frame>

    <p class="tray__empty">You’re all caught up.</p>

    <div class="tray__item tray__item--hat">
      <h2 class="tray__title">Notifications</h2>
      <div data-navigable-list-target="item" class="tray__hat-action">
        <%= link_to notifications_path, class: "ui-button ui-button--ghost ui-button--sm tray__see-all", data: { action: "click->dialog#close" } do %>
          <span class="tray__new-notifications">See all new</span>
          <span class="tray__old-notifications">View all</span>
        <% end %>
      </div>

      <%= button_to bulk_reading_path(from_tray: true),
            class: "ui-button ui-button--ghost ui-button--sm tray__clear-notifications",
            title: "Mark all notifications as read",
            data: { action: "dialog#close badge#clear", turbo_frame: "notifications" },
            form: { class: "tray__hat-action", data: { navigable_list_target: "item" } } do %>
        <%= icon_tag "check" %>
        <span>Clear all</span>
      <% end %>
    </div>
  </dialog>

  <button class="tray__toggle" data-action="dialog#toggle" data-keys="g n" aria-label="Toggle notifications stack" aria-haspopup="true">
    <span class="tray__toggle-btn">
      <%= icon_tag "bell" %>
      <span class="tray__toggle-text">Notifications</span>
    </span>
  </button>
</section>
