<% @page_title = "Notifications" %>
<% @hide_footer_frames = true %>
<%# The breadcrumb (Home › Notifications) is the page's title. j / k move through the rows (the
    keyboard controller), Enter opens one. %>
<%= parent_page term(:task, count: 2), tasks_path %>

<div class="notifications-page" data-controller="badge" data-badge-unread-class="unread">
  <%= render "notifications/index/lists", unread: @unread, read: @read %>
</div>
