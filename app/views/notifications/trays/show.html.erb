<turbo-frame id="notifications">
  <%# All unread, not just the newest shown, for the tab's title and the app's badge (badge controller). %>
  <data hidden value="<%= @unread_total %>" data-badge-target="total"></data>
  <%= render partial: "notifications/tray_item", collection: @notifications.first(NotificationsHelper::TRAY_SIZE), as: :notification %>
  <% if @notifications.size > NotificationsHelper::TRAY_SIZE %><span hidden data-notifications-more></span><% end %>
</turbo-frame>
