<%# locals: (read:) %>
<% if read.any? %>
  <section class="card card--flush notifications-list notifications-list--read" aria-labelledby="notifications-read-title">
    <header class="card__head">
      <h2 class="card__title" id="notifications-read-title">Previously seen</h2>
    </header>

    <div id="notifications_list_read" class="notifications-list__items">
      <%= render partial: "notifications/notification", collection: read, as: :notification %>
    </div>
  </section>
<% end %>
