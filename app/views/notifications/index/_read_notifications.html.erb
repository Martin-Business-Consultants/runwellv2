<%# locals: (read:) %>
<% if read.any? %>
  <%= record_card title: tag.h2("Previously seen", id: "notifications-read-title", class: "record-card__title"), css: "notifications-list notifications-list--read", aria: { labelledby: "notifications-read-title" } do %>
    <div id="notifications_list_read" class="notifications-list__items">
      <%= render partial: "notifications/notification", collection: read, as: :notification %>
    </div>
  <% end %>
<% end %>
