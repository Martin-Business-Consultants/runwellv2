<%# locals: (unread:) %>
<%# New for you. The empty line shows once the list under it has nothing in it, so reading the
    last one (a turbo stream moves it to Previously seen) brings it back without a reload. %>
<% action = capture do %>
  <% if unread.any? %>
    <%= button_to "Mark all as read", bulk_reading_path, class: "ui-button", data: { variant: "outline", size: "sm", action: "badge#clear" } %>
  <% end %>
<% end %>
<%= record_card title: tag.h2("New for you", id: "notifications-new-title", class: "record-card__title"), hint: "Mentions you haven’t opened yet.", action: action,
      css: "notifications-list", aria: { labelledby: "notifications-new-title" } do %>
  <p class="notifications-list__empty">Nothing new for you.</p>
  <div id="notifications_list" class="notifications-list__items">
    <%= render partial: "notifications/notification", collection: unread, as: :notification %>
  </div>
<% end %>
