<% content_for :preheader, "We have it. Reply to this email to add anything." %>
<% content_for :reason, "You’re getting this because you sent this request." %>
<%= mail_heading "We have your request" %>
<p>Thanks<% if @request.contact %>, <%= @request.contact.name.split.first %><% end %>. This came through:</p>
<%= mail_quote @request.subject %>
<p>We’ll be in touch. To add anything, reply to this email: it goes with the same request.</p>
