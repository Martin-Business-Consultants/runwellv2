<%# locals: () %>
<%# Search, opened with S or ⌘K: a command box a third of the way down the page. The input sits
    at the top, the results (searches/_results, loaded into bar_content) below it, and the keys at
    the foot. Closed, nothing shows: the button S clicks is on the page but out of sight. The
    backdrop closes it, as Esc and the ✕ do. %>
<div class="bar" data-controller="bar" data-bar-dialog-outlet="#bar-modal"
    data-bar-search-url-value="<%= search_path %>">
  <div class="bar__backdrop" aria-hidden="true" data-action="click->bar#reset"></div>

  <div class="bar__placeholder" data-bar-target="buttonsContainer">
    <%= tag.button class: "btn btn--ghost btn--sm", type: "button", title: "Search (S or ⌘K)", data: { keys: "s, mod+k", action: "bar#search" } do %>
      Search <kbd class="hide-on-touch">S</kbd>
    <% end %>
  </div>

  <div class="bar__input" data-bar-target="search" hidden>
    <%= render "searches/form", query_terms: "", target_turbo_frame: "bar_content" %>
  </div>

  <%= tag.dialog id: "bar-modal", class: "bar__modal", data: {
        controller: "dialog", dialog_target: "dialog", action: "keydown.esc@document->bar#reset:stop" } do %>
    <%= turbo_frame_tag "bar_content", data: { bar_target: "turboFrame" } %>
  <% end %>

  <footer class="bar__footer hide-on-touch" aria-hidden="true">
    <span class="bar__footer-key"><kbd>↵</kbd> Search</span>
    <span class="bar__footer-key"><kbd>Esc</kbd> Close</span>
  </footer>
</div>
