// Runwell's service worker (served at /service-worker.js, registered on staff pages; versioned by the
// release, so an update replaces it and its cache). It keeps nothing anyone signed in to see: the
// only thing cached is the offline page, shown when a page can't load for want of a connection.
// It shows the notifications the install pushes (PushNotificationJob) and opens one when clicked
// (notifications#show reads it and goes to its record), and keeps the app's badge to the unread
// count. The portal is left alone.
const VERSION = "<%= Runwell::VERSION %>"
const CACHE = `runwell-offline-${VERSION}`
const OFFLINE = "/offline.html"

self.addEventListener("install", event => {
  event.waitUntil(caches.open(CACHE).then(cache => cache.add(new Request(OFFLINE, { cache: "reload" }))).then(() => self.skipWaiting()))
})

self.addEventListener("activate", event => {
  event.waitUntil(caches.keys()
    .then(keys => Promise.all(keys.filter(key => key.startsWith("runwell-") && key !== CACHE).map(key => caches.delete(key))))
    .then(() => self.clients.claim()))
})

self.addEventListener("fetch", event => {
  const request = event.request
  if (request.mode !== "navigate" || new URL(request.url).pathname.startsWith("/portal")) return

  event.respondWith(fetch(request).catch(() => caches.match(OFFLINE)))
})

self.addEventListener("push", event => {
  const data = event.data ? event.data.json() : {}
  const badge = typeof data.unread === "number" && self.navigator.setAppBadge ? self.navigator.setAppBadge(data.unread) : Promise.resolve()
  event.waitUntil(Promise.all([
    self.registration.showNotification(data.title || "Runwell", { body: data.body, tag: data.tag, icon: "/icon.png", data: { url: data.url || "/" } }),
    badge
  ]))
})

self.addEventListener("notificationclick", event => {
  event.notification.close()
  const url = new URL(event.notification.data?.url || "/", self.location.origin).href

  event.waitUntil(self.clients.matchAll({ type: "window", includeUncontrolled: true }).then(windows => {
    const open = windows.find(client => new URL(client.url).origin === self.location.origin && "navigate" in client)
    return open ? open.navigate(url).then(client => (client || open).focus()) : self.clients.openWindow(url)
  }))
})
