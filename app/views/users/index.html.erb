<% @page_title = "Users" %>
<% manage = can?(:manage_people) %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :status, current: @status,
        options: [ [ "Active (#{@counts["active"]})", "active" ], [ "Deactivated (#{@counts["deactivated"]})", "deactivated" ], [ "All (#{@counts.values.sum})", "all" ] ] %>
<% end %>
<% if @view == "table" && manage %>
  <% content_for :index_bulk do %>
    <%= bulk_bar do %>
      <%= bulk_menu bulk_users_path, method: :patch, name: "user[role]", label: "Role", choices: User::ROLES.map { [ it.capitalize, it ] } %>
      <%= bulk_menu bulk_users_path, method: :patch, name: "user[status]", label: "Status", choices: [ [ "Active", "active" ], [ "Deactivated", "deactivated" ] ] %>
    <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: ("Invite someone" if manage), new_path: (new_user_invitation_path if manage), new_modal: true %>

<% if @people.any? %>
  <% columns = [ ui_column(:name, "Name", sort: :name, width: [ @column_widths[:name], "Name" ], hideable: false),
                 ui_column(:email, "Email address", sort: :email, width: [ @column_widths[:email], "Email address" ]),
                 ui_column(:role, "Role", sort: :role, width: :pill),
                 ui_column(:status, "Status", width: :status) ] %>
  <%= render "ui/data_table", id: "users", columns: columns, rows: @people, row: "users/row", as: :person,
        row_locals: { manage: manage }, page: @page, selectable: manage, actions: true %>
<% else %>
  <%= render "layouts/shared/empty", text: "No #{@status} users.", action_text: "Show all", action_path: users_path(status: "all", view: params[:view]) %>
<% end %>

<% if manage && @invitations.any? %>
  <section class="card card--flush users-invitations">
    <header class="card__head">
      <h2 class="card__title">Invitations out</h2>
    </header>
    <ul class="list">
      <% @invitations.each do |invitation| %>
        <%# herb:key invitation.id %>
        <li class="list-row">
          <div class="list-row__content">
            <p class="list-row__title"><%= invitation.email_address %></p>
            <p class="list-row__desc"><%= invitation.role.capitalize %> · invited by <%= invitation.invited_by.display_name %> <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></p>
          </div>
          <div class="list-row__actions">
            <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "btn btn--secondary btn--sm" %>
            <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation),
                  message: "The link they were sent stops working." %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
