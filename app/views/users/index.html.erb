<% @page_title = "Users" %>
<% manage = can?(:manage_people) %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :status, current: @status,
        options: [ [ "Active (#{@counts["active"]})", "active" ], [ "Deactivated (#{@counts["deactivated"]})", "deactivated" ], [ "All (#{@counts.values.sum})", "all" ] ] %>
<% end %>
<% if @view == "table" && manage %>
  <% content_for :index_bulk do %>
  <%= bulk_bar do %>
    <%= bulk_menu bulk_users_path, method: :patch, name: "user[role]", label: "Role", choices: User::ROLES.map { [ it.capitalize, it ] } %>
    <%= bulk_menu bulk_users_path, method: :patch, name: "user[status]", label: "Status", choices: [ [ "Active", "active" ], [ "Deactivated", "deactivated" ] ] %>
  <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: ("Invite someone" if manage), new_path: (new_user_invitation_path if manage) %>

<% if @people.any? && @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :users_cards, @page do %>
        <% @people.each do |person| %>
          <%# herb:key person.id %>
          <%= render "layouts/shared/card", path: user_path(person), title: person.display_name + (person == Current.user ? " (you)" : ""), id_label: person.role.capitalize,
                context: person.email_address, meta: [ ("Two-factor" if person.two_factor?) ],
                status: (person.active? ? "active" : "deactivated"), highlight: person.active? %>
        <% end %>
      <% end %>
    </div>
  </section>
<% elsif @people.any? %>
  <section class="panel center index-table">
    <table class="data-table data-table--fixed">
      <%= table_colgroup(*([ :select ] if manage), [ @column_widths[:name], "Name" ], [ @column_widths[:email], "Email address" ], :pill, :status, :actions) %>
      <thead>
        <tr><% if manage %><%= bulk_select_all_header %><% end %><%= sortable_th "Name", :name %><%= sortable_th "Email address", :email %><%= sortable_th "Role", :role %><th>Status</th><th></th></tr>
      </thead>
      <tbody id="<%= pagination_frame_id_for(:users_rows, @page.number) %>">
        <% @people.each do |person| %>
          <%# herb:key person.id %>
          <tr data-filter-target="item">
            <% if manage %>
              <%= bulk_select_cell person, person.display_name %>
            <% end %>
            <td>
              <span class="flex align-center gap-half">
                <%= avatar_preview_tag person, hidden_for_screen_reader: true, class: "people__avatar" %>
                <%= link_to person.display_name, user_path(person), class: "txt-ink font-weight-bold" %><%= " (you)" if person == Current.user %>
              </span>
            </td>
            <td class="txt-subtle"><%= person.email_address %></td>
            <td><%= person.role.capitalize %></td>
            <td>
              <% if person.deactivated? %>
                <%= status_tag "Deactivated" %>
              <% elsif person.two_factor? %>
                <span class="status-tag status-tag--positive" title="Signs in with a code from an authenticator app">Two-factor</span>
              <% elsif Setting.current.require_two_factor? %>
                <span class="status-tag status-tag--waiting" title="Sets it up on their next page">Two-factor pending</span>
              <% else %>
                <%= status_tag "Active" %>
              <% end %>
            </td>
            <%= render "layouts/shared/row_actions", name: person.display_name, edit_path: (user_path(person) if manage) %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <%= table_pagination @page %>
<% else %>
  <%= render "layouts/shared/empty", text: "No #{@status} users.", action_text: "Show all", action_path: users_path(status: "all", view: params[:view]) %>
<% end %>

<% if manage && @invitations.any? %>
  <section class="settings">
    <div class="settings__panel panel shadow txt-align-start">
      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">Invitations out</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% @invitations.each do |invitation| %>
            <%# herb:key invitation.id %>
            <li class="flex align-center gap-half txt-small">
              <div class="txt-align-start overflow-ellipsis min-width">
                <strong><%= invitation.email_address %></strong>
                <div class="txt-x-small txt-subtle"><%= invitation.role.capitalize %> · invited by <%= invitation.invited_by.display_name %> <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></div>
              </div>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "btn txt-small" %>
              <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation), trigger_class: "txt-small",
                    message: "The link they were sent stops working." %>
            </li>
          <% end %>
        </ul>
      </section>
    </div>
  </section>
<% end %>
