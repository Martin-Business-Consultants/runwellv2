<% @page_title = "Users" %>
<% manage = can?(:manage_people) %>

<% content_for :index_filters do %>
  <%= ui :filter, param: :who, label: "Who", value: @who, any: false,
        options: [ [ "Everyone", "everyone" ], [ "The team", "team" ], [ "#{term(:client, count: 2)}’ people", "clients" ] ] %>
  <%= ui :filter, param: :status, label: "Show", value: @status, any: false,
        options: [ [ "Active (#{@counts["active"]})", "active" ], [ "Deactivated (#{@counts["deactivated"]})", "deactivated" ], [ "All (#{@counts.values.sum})", "all" ] ] %>
<% end %>
<% if manage %>
  <% bar = bulk_bar do %>
    <%= bulk_menu bulk_users_path, method: :patch, name: "user[role]", label: "Role", choices: User::ROLES.map { [ it.capitalize, it ] }, params: { list_status: @status } %>
    <%= bulk_menu bulk_users_path, method: :patch, name: "user[status]", label: "Status", choices: [ [ "Active", "active" ], [ "Deactivated", "deactivated" ] ], params: { list_status: @status } %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: ("Invite someone" if manage), new_path: (new_user_invitation_path if manage), new_modal: true %>

<% if @people.any? %>
  <% columns = [ ui_column(:name, "Name", sort: :name, hideable: false),
                 ui_column(:email, "Email address", sort: :email),
                 ui_column(:role, "Role", sort: :role),
                 ui_column(:client, term(:client), sort: :client),
                 ui_column(:status, "Status") ] %>
  <%= render "layouts/shared/list_table", id: "users", columns: columns, rows: @people, row: "users/row", as: :person,
        row_locals: { manage: manage }, page: @page, selectable: manage, noun: "person", bulk: bar, actions: true %>
<% else %>
  <%= ui :empty, description: "No #{@status} users.", action: ui(:button, href: users_path(status: "all", who: "everyone", view: params[:view]), variant: :outline, size: :sm, content: "Show all") %>
<% end %>

<% if manage && @invitations.any? %>
  <section class="card card--flush users-invitations">
    <header class="card__head">
      <h2 class="card__title">Invitations out</h2>
    </header>
    <ul class="list">
      <% @invitations.each do |invitation| %>
        <%# herb:key invitation.id %>
        <li class="list-row">
          <div class="list-row__content">
            <p class="list-row__title"><%= invitation.email_address %></p>
            <p class="list-row__desc"><%= invitation.role.capitalize %> · invited by <%= invitation.invited_by.display_name %> <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></p>
          </div>
          <div class="list-row__actions">
            <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "btn btn--secondary btn--sm" %>
            <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation),
                  message: "The link they were sent stops working." %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
