<%# locals: (person:) %>
<%# herb:slots client %>
<%# herb:state (setting: false) %>
<%# Setting someone's password for them, opened in place. The form is always on the page and state
    only shows it, so opening it never waits on the server. %>
<div data-controller="state-focus" data-state-focus-state-value="setting">
  <button type="button" class="btn txt-small" data-herb-set="setting=true" hidden="<%= setting %>">Set a new password for them</button>
  <div hidden="<%= !setting %>">
    <%= form_with model: person, url: user_password_path(person), method: :patch, scope: :user, namespace: dom_id(person, :password), class: "flex flex-column gap-half txt-small" do |form| %>
      <%= form.password_field :password, required: true, class: "input full-width", autocomplete: "new-password", placeholder: "New password", maxlength: 72, autofocus: true, aria: { label: "New password" } %>
      <%= form.password_field :password_confirmation, required: true, class: "input full-width", autocomplete: "new-password", placeholder: "The same again", maxlength: 72, aria: { label: "Confirm the new password" } %>
      <span class="record-form__hint">For someone who can’t get the email. They’re signed out everywhere; tell them the new one yourself.</span>
      <div class="flex gap-half">
        <button type="submit" class="btn btn--link txt-small">Set password</button>
        <button type="button" class="btn btn--plain txt-small" data-keys="esc" data-herb-reset="setting">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
