<%# locals: (person:) %>
<%# herb:slots client %>
<%# herb:state (setting: false) %>
<%# Setting someone's password for them, opened in place. The form is always on the page and state
    only shows it, so opening it never waits on the server. %>
<div data-controller="state-focus" data-state-focus-state-value="setting">
  <button type="button" class="btn btn--ghost btn--sm" data-herb-set="setting=true" hidden="<%= setting %>">Set a new password for them</button>
  <div hidden="<%= !setting %>">
    <%= form_with model: person, url: user_password_path(person), method: :patch, scope: :user, namespace: dom_id(person, :password), class: "settings-subform" do |form| %>
      <div class="field">
        <%= form.label :password, "New password", class: "field__label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, autofocus: true %>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "The same again", class: "field__label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
        <p class="field__hint">For someone who can’t get the email. They’re signed out everywhere; tell them the new one yourself.</p>
      </div>
      <div class="button-row">
        <button type="submit" class="btn btn--primary btn--sm">Set password</button>
        <button type="button" class="btn btn--ghost btn--sm" data-keys="esc" data-herb-reset="setting">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
