<%# locals: (person:) %>
<%# herb:slots client %>
<%# herb:state (setting: false) %>
<%# Setting someone's password for them, opened in place. The form is always on the page and state
    only shows it, so opening it never waits on the server. %>
<div data-controller="state-focus" data-state-focus-state-value="setting">
  <button type="button" class="ui-button" data-variant="ghost" data-size="sm" data-herb-set="setting=true" hidden="<%= setting %>">Set a new password for them</button>
  <div hidden="<%= !setting %>">
    <%= form_with model: person, url: user_password_path(person), method: :patch, scope: :user, namespace: dom_id(person, :password), class: "settings-subform" do |form| %>
      <%= form.ui :field, :password, label: "New password" do %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, autofocus: true %>
      <% end %>
      <%= form.ui :field, :password_confirmation, label: "The same again", description: "For someone who can’t get the email. They’re signed out everywhere; tell them the new one yourself." do %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
      <% end %>
      <div class="settings-buttons">
        <%= ui :button, type: :submit, size: :sm, content: "Set password" %>
        <button type="button" class="ui-button" data-variant="ghost" data-size="sm" data-keys="esc" data-herb-reset="setting">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
