<% @page_title = @person.display_name %>
<%= parent_page "Users", users_path %>
<% me = @person == Current.user %>
<% manage = can?(:manage_people) %>

<div class="<%= class_names("person-page", "person-page--split": manage) %>">
  <%= ui :card, class: "person-page__main" do %>
    <%= render "users/heading", person: @person, manage: manage %>

    <% if manage %>
    <% layout = record_layout(:user) %>
    <%# Their name, address and role in the order the install arranged them (template mode,
        RecordLayout; one column, so order only), each saving as it changes (in place). %>
    <section class="settings-section" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:user) %>"
      data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
      <%= render "record_fields/arrange", layout: layout, noun: "people’s" %>
      <header class="settings-section__head">
        <h2>Details</h2>
        <p class="settings-section__description">Their name, the address they sign in with, and what they may do.</p>
        <div class="settings-section__actions"><%= render "record_fields/arrange_button" %></div>
      </header>
      <%= render "record_fields/zone", layout: layout, zone: "main", record: @person, in_place: true, scope: :user, url: user_path(@person) %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Password</h2>
        <% if me %>
          <p class="settings-section__description">Change your own in <%= link_to "Your account", settings_account_path %>.</p>
        <% else %>
          <p class="settings-section__description">Send them a link to choose a new one, or set one for them.</p>
        <% end %>
      </header>
      <% unless me %>
        <div class="button-row">
          <%= button_to user_password_path(@person), class: "ui-button", data: { variant: "outline", size: "default" } do %>
            <%= icon_tag "email" %> <span>Email them a link to choose one</span>
          <% end %>
        </div>
        <%= render "users/set_password", person: @person %>
      <% end %>
    </section>

    <% unless me %>
      <section class="settings-section">
        <div class="settings-danger">
          <div class="settings-danger__text">
            <h2 class="settings-danger__title">Danger zone</h2>
            <% if @person.deactivated? %>
              <p>Deactivated: they can’t sign in, and their name stays on their work.</p>
            <% else %>
              <p>Deactivating signs them out everywhere and stops their connected apps. Their name stays on their work, and you can reactivate them.</p>
            <% end %>
          </div>
          <div class="button-row">
            <% if @person.deactivated? %>
              <%= button_to "Reactivate", user_deactivation_path(@person), method: :delete, class: "ui-button", data: { variant: "outline", size: "sm" } %>
            <% else %>
              <%= render "layouts/shared/confirm", trigger: "Deactivate #{@person.display_name}", title: "Deactivate #{@person.display_name}?",
                    body: "They’re signed out everywhere, their connected apps stop, and they can’t sign in. Their name stays on their work, and you can reactivate them.",
                    button: "Deactivate", path: user_deactivation_path(@person), method: :post, icon: "remove" %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
    <% else %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Details</h2>
      </header>
      <dl class="details settings-facts">
        <dt>Email address</dt><dd><%= mail_to @person.email_address %></dd>
        <dt>Role</dt><dd><%= @person.role.capitalize %>: <span class="muted"><%= User::ROLE_DESCRIPTIONS[@person.role] %></span></dd>
      </dl>
    </section>
    <% end %>
  <% end %>

  <% if manage %>
  <%= ui :card, class: "person-page__side" do %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Signed in</h2>
        <% unless me %>
          <% if @sessions.any? %>
            <div class="settings-section__actions">
              <%= button_to "Sign out everywhere", user_sessions_path(@person), method: :delete, class: "ui-button", data: { variant: "outline", size: "sm" } %>
            </div>
          <% end %>
        <% end %>
      </header>
      <% if @sessions.any? %>
        <ul class="settings-list settings-list--scroll">
          <% @sessions.each do |session| %>
            <%# herb:key session.id %>
            <li class="settings-item">
              <div class="settings-item__content">
                <p class="settings-item__title"><%= session.user_agent.to_s.truncate(80).presence || "A browser" %></p>
                <p class="settings-item__desc"><%= session.ip_address %> · since <%= l session.created_at, format: :short %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">Not signed in anywhere.</p>
      <% end %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Connected apps</h2>
        <% if @connections.any? %>
          <div class="settings-section__actions">
            <%= render "layouts/shared/delete_dialog", name: "every app #{@person.display_name} connected", path: user_connections_path(@person),
                  message: "Their personal tokens and connected apps stop working at once. Anything they already did stays." %>
          </div>
        <% end %>
      </header>
      <% if @connections.any? %>
        <ul class="settings-list">
          <% @connections.each do |token| %>
            <%# herb:key token.id %>
            <li class="settings-item">
              <div class="settings-item__content">
                <p class="settings-item__title"><%= token.name %></p>
                <p class="settings-item__desc"><%= token.kind == "oauth" ? "Connected app" : "Personal token" %><%= " · read only" if token.read_only? %> · <%= token.last_used_at ? "last used #{time_ago_in_words(token.last_used_at)} ago" : "never used" %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No apps or scripts connected.</p>
      <% end %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Two-factor sign-in</h2>
        <% if @person.two_factor? %>
          <% if !me && @person.active? %>
            <div class="settings-section__actions">
              <%= render "layouts/shared/delete_dialog", name: "two-factor sign-in for " + @person.display_name, path: user_two_factor_path(@person),
                    message: "Use this when they’ve lost their phone and their recovery codes. They’re signed out, sign in with just their password, and set it up again." %>
            </div>
          <% end %>
        <% end %>
      </header>
      <% if @person.two_factor? %>
        <p>On: a code from an authenticator app after their password.</p>
      <% elsif Setting.current.require_two_factor? %>
        <p class="muted">Not set up yet: they set it up on their next page.</p>
      <% else %>
        <p class="muted">Off.</p>
      <% end %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Recent sign-ins</h2>
      </header>
      <% if @sign_ins.any? %>
        <ul class="settings-list settings-list--scroll">
          <% @sign_ins.each do |event| %>
            <%# herb:key event.id %>
            <li class="settings-item">
              <div class="settings-item__content">
                <p class="settings-item__title"><%= event.kind == "user.signed_in" ? "Signed in" : "Failed to sign in" %><%= " with #{event.payload["method"]}" if event.payload["method"].present? %></p>
                <p class="settings-item__desc"><%= l event.occurred_at, format: :short %><%= " · #{event.payload["ip"]}" if event.payload["ip"].present? %></p>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">None recorded.</p>
      <% end %>
      <p><%= link_to "Everything in the audit log", settings_audit_log_path(person: @person.id) %></p>
    </section>
  <% end %>
  <% end %>
</div>
