<%# locals: (invitation:, modal: nil) %>
<%# Who to invite and as what: on the Invite page, or in a modal over Users (modal: true). %>
<%= form_with model: invitation, url: user_invitations_path, class: "settings-form", data: draft_data("new:invitation") do |form| %>
  <%= draft_notice %>
  <%= form.ui :field, :email_address, label: "Email address" do %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "off", placeholder: "name@example.com" %>
  <% end %>
  <%= form.ui :field, :role, label: "Role", description: "What they may do; see each role on the right." do %>
    <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] }, {} %>
  <% end %>
  <div class="form-actions">
    <% if modal %>
      <%= ui :button, type: :button, variant: :outline, content: "Cancel", data: { runeui_close: "modal_dialog" } %>
    <% end %>
    <%= ui :button, type: :submit, content: "Send invitation" %>
  </div>
<% end %>
