<% @page_title = "Invite someone" %>
<%= parent_page "Users", users_path %>

<div class="person-page person-page--split">
  <div class="card person-page__main">
    <section class="settings-section">
      <header class="settings-section__head">
        <h1><%= @page_title %></h1>
        <p class="settings-section__description">They get an email with a link to choose a name and password. It works once and expires in <%= distance_of_time_in_words(0, Invitation::EXPIRES_IN) %>.</p>
      </header>
      <%= form_with model: @invitation, url: user_invitations_path, class: "settings-form" do |form| %>
        <div class="field">
          <%= form.label :email_address, "Email address", class: "field__label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "off", placeholder: "name@example.com" %>
        </div>
        <div class="field">
          <%= form.label :role, "Role", class: "field__label" %>
          <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] }, {} %>
          <p class="field__hint">What they may do; see each role on the right.</p>
        </div>
        <div><button type="submit" class="btn btn--primary">Send invitation</button></div>
      <% end %>
    </section>
  </div>

  <aside class="card person-page__side">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>What each role can do</h2>
      </header>
      <dl class="settings-roles settings-roles--stacked">
        <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
          <%# herb:key role %>
          <dt><%= role.capitalize %></dt>
          <dd><%= description %></dd>
        <% end %>
      </dl>
    </section>

    <% if @invitations.any? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>Invitations out</h2>
        </header>
        <ul class="settings-list settings-list--scroll">
          <% @invitations.each do |invitation| %>
            <%# herb:key invitation.id %>
            <li class="list-row" data-filter-target="item">
              <div class="list-row__content">
                <p class="list-row__title"><%= invitation.email_address %></p>
                <p class="list-row__desc"><%= invitation.role.capitalize %> · <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></p>
              </div>
              <div class="list-row__actions">
                <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "btn btn--secondary btn--sm" %>
                <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation),
                      message: "The link they were sent stops working." %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </aside>
</div>
