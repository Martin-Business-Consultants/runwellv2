<% @page_title = "Invite someone" %>
<% if turbo_frame_request_id == "modal" %>
  <%= render layout: "layouts/shared/modal", locals: { title: @page_title, description: "They get an email with a link to choose a name and password." } do %>
    <%= render "layouts/shared/errors", record: @invitation %>
    <%= render "users/invitations/form", invitation: @invitation, modal: true %>
  <% end %>
<% else %>
<%= parent_page "Users", users_path %>

<div class="person-page person-page--split">
  <%= ui :card, class: "person-page__main" do %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h1><%= @page_title %></h1>
        <p class="settings-section__description">They get an email with a link to choose a name and password. It works once and expires in <%= distance_of_time_in_words(0, Invitation::EXPIRES_IN) %>.</p>
      </header>
      <%= render "users/invitations/form", invitation: @invitation %>
    </section>
  <% end %>

  <%= ui :card, class: "person-page__side" do %>
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>What each role can do</h2>
      </header>
      <dl class="settings-roles settings-roles--stacked">
        <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
          <%# herb:key role %>
          <dt><%= role.capitalize %></dt>
          <dd><%= description %></dd>
        <% end %>
      </dl>
    </section>

    <% if @invitations.any? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>Invitations out</h2>
        </header>
        <ul class="settings-list settings-list--scroll">
          <% @invitations.each do |invitation| %>
            <%# herb:key invitation.id %>
            <li class="settings-item" data-filter-target="item">
              <div class="settings-item__content">
                <p class="settings-item__title"><%= invitation.email_address %></p>
                <p class="settings-item__desc"><%= invitation.role.capitalize %> · <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></p>
              </div>
              <div class="settings-item__actions">
                <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "ui-button", data: { variant: "outline", size: "sm" } %>
                <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation),
                      message: "The link they were sent stops working." %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  <% end %>
</div>
<% end %>
