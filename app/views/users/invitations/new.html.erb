<% @page_title = "Invite someone" %>

<% content_for :header do %>
  <%= parent_page "Users", users_path %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= form_with model: @invitation, url: user_invitations_path, class: "flex flex-column gap-half txt-small" do |form| %>
      <%= form.label :email_address, "Email address", class: "record-form__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, class: "input full-width", autocomplete: "off", placeholder: "name@example.com" %>
      <%= form.label :role, "Role", class: "record-form__label" %>
      <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] }, {}, class: "input input--select" %>
      <span class="record-form__hint">They get an email with a link to choose a name and password. It works once and expires in <%= distance_of_time_in_words(0, Invitation::EXPIRES_IN) %>.</span>
      <div><button type="submit" class="btn btn--link">Send invitation</button></div>
    <% end %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section">
      <header>
        <h2 class="divider">What each role can do</h2>
      </header>
      <dl class="people__roles txt-small margin-none">
        <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
          <%# herb:key role %>
          <dt class="font-weight-bold"><%= role.capitalize %></dt>
          <dd class="txt-subtle margin-none"><%= description %></dd>
        <% end %>
      </dl>
    </section>

    <% if @invitations.any? %>
      <section class="settings__section">
        <header>
          <h2 class="divider">Invitations out</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% @invitations.each do |invitation| %>
            <%# herb:key invitation.id %>
            <li class="flex align-center gap-half txt-small" data-filter-target="item">
              <div class="txt-align-start overflow-ellipsis min-width">
                <strong><%= invitation.email_address %></strong>
                <div class="txt-x-small txt-subtle"><%= invitation.role.capitalize %> · <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></div>
              </div>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "btn txt-small" %>
              <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation), trigger_class: "txt-small",
                    message: "The link they were sent stops working." %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </aside>
</section>
