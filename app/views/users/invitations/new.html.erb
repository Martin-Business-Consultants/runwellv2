<% @page_title = "Invite someone" %>

<% content_for :header do %>
  <%= parent_page "Users", users_path %>
<% end %>

<section class="settings settings--split person-page">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section">
      <header class="settings__heading">
        <h1><%= @page_title %></h1>
        <p class="settings__description">They get an email with a link to choose a name and password. It works once and expires in <%= distance_of_time_in_words(0, Invitation::EXPIRES_IN) %>.</p>
      </header>
      <%= form_with model: @invitation, url: user_invitations_path, class: "settings__form" do |form| %>
        <div class="ui-field">
          <%= form.label :email_address, "Email address", class: "ui-label" %>
          <%= form.email_field :email_address, required: true, autofocus: true, class: "ui-input", autocomplete: "off", placeholder: "name@example.com" %>
        </div>
        <div class="ui-field">
          <%= form.label :role, "Role", class: "ui-label" %>
          <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] }, {}, class: "ui-select" %>
          <p class="ui-field__description">What they may do; see each role on the right.</p>
        </div>
        <div><button type="submit" class="ui-button">Send invitation</button></div>
      <% end %>
    </section>
  </div>

  <aside class="settings__panel settings__panel--side panel txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section">
      <header class="settings__heading">
        <h2>What each role can do</h2>
      </header>
      <dl class="settings-roles settings-roles--stacked">
        <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
          <%# herb:key role %>
          <dt><%= role.capitalize %></dt>
          <dd><%= description %></dd>
        <% end %>
      </dl>
    </section>

    <% if @invitations.any? %>
      <section class="settings__section">
        <header class="settings__heading">
          <h2>Invitations out</h2>
        </header>
        <ul class="settings__list settings__list--scroll">
          <% @invitations.each do |invitation| %>
            <%# herb:key invitation.id %>
            <li class="ui-item ui-item--sm" data-filter-target="item">
              <div class="ui-item__content">
                <p class="ui-item__title overflow-ellipsis"><%= invitation.email_address %></p>
                <p class="ui-item__description"><%= invitation.role.capitalize %> · <%= time_ago_in_words(invitation.sent_at) %> ago<%= " · expired" if invitation.expired? %></p>
              </div>
              <div class="ui-item__actions">
                <%= button_to "Resend", user_invitation_path(invitation), method: :patch, class: "ui-button ui-button--outline ui-button--sm" %>
                <%= render "layouts/shared/delete_dialog", name: "the invitation to " + invitation.email_address, path: user_invitation_path(invitation),
                      message: "The link they were sent stops working." %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </aside>
</section>
