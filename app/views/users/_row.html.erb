<%# locals: (person:, manage:) %>
<%# One person in the users index's data table (layouts/shared/_list_table): the cells in the columns' order.
    Someone at a client (the client role) shows their client and portal access and opens on their
    contact page; the bulk bar's roles are the team's, so they have no checkbox. %>
<% client = person.client? %>
<% path = client ? edit_contact_path(person) : user_path(person) %>
<tr id="<%= dom_id(person, :row) %>" data-filter-target="item">
  <% if manage %>
    <% if client %>
      <td data-slot="table-select"></td>
    <% else %>
      <%= ui :select_cell, value: person.id, label: person.display_name, checkbox: { data: { keys: "x" } } %>
    <% end %>
  <% end %>
  <td data-column="name" data-grow>
    <%= person_cell person, label: (person == Current.user ? "#{person.display_name} (you)" : nil), path: path %>
  </td>
  <td class="muted" data-column="email" data-truncate><%= person.email_address %></td>
  <td data-column="role"><%= client ? term(:client) : person.role.capitalize %></td>
  <td data-column="client" data-truncate>
    <% if person.client %>
      <%= link_to person.client.name, client_path(person.client) %>
    <% end %>
  </td>
  <td data-column="status">
    <% if person.deactivated? %>
      <%= status_tag(client ? "Archived" : "Deactivated") %>
    <% elsif client %>
      <% if person.portal_access? %>
        <%= badge "Portal", tone: :ok, title: "Signs in to the #{term(:client).downcase} portal by emailed link" %>
      <% else %>
        <%= status_tag "Active" %>
      <% end %>
    <% elsif person.two_factor? %>
      <%= badge "Two-factor", tone: :ok, title: "Signs in with a code from an authenticator app" %>
    <% elsif Setting.current.require_two_factor? %>
      <%= badge "Two-factor pending", tone: :attention, title: "Sets it up on their next page" %>
    <% else %>
      <%= status_tag "Active" %>
    <% end %>
  </td>
  <%= render "layouts/shared/row_actions", name: person.display_name, edit_path: (client ? path : (path if manage)) %>
</tr>
