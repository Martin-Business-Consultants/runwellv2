<%# locals: (person:, manage:) %>
<%# A person's name, role and state at the top of their page. Redrawn when a field saves in place
    (users/update.turbo_stream.erb). %>
<div class="person-page__heading" id="<%= dom_id(person, :heading) %>">
  <%= avatar_preview_tag person, hidden_for_screen_reader: true %>
  <div class="person-page__name">
    <h1><%= person.display_name %><%= " (you)" if person == Current.user %></h1>
    <div class="settings-chips">
      <%= badge person.role.capitalize, tone: :outline %>
      <% if person.deactivated? %>
        <%= ui :badge, variant: :secondary, content: "Deactivated" %>
      <% else %>
        <%= ui :badge, variant: :success, content: "Active" %>
      <% end %>
      <% if manage && person.two_factor? %>
        <%= ui :badge, variant: :success, content: "Two-factor" %>
      <% end %>
    </div>
  </div>
</div>
