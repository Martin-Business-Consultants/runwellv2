<% role = @invitation.role == "owner" ? "an owner" : "a " + @invitation.role %>
<% brand = Setting.current.brand_name %>
<% content_for :preheader, "Choose your name and password to get started." %>
<% content_for :reason, "#{@invitation.invited_by.display_name} invited this address. Not expecting it? Ignore this email and nothing happens." %>
<%= mail_heading "Join #{brand == "Runwell" ? "the team" : brand} on Runwell" %>
<p><%= @invitation.invited_by.display_name %> invited you to join as <%= role %>. Accept to choose your name and password.</p>
<%= mail_button "Accept the invitation", invitation_url(@invitation.generate_token_for(:acceptance)) %>
<%= mail_small "The link works once and expires in #{distance_of_time_in_words(0, Invitation::EXPIRES_IN)}." %>
