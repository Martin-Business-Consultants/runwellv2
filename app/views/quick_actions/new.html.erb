<%# The quick action as a modal: ui :dialog, open as it arrives in the tray's quick_action frame
    (which empties as it closes). A title and hint, where it goes (the picker), the action's own
    form. %>
<turbo-frame id="quick_action">
  <%= ui :dialog, id: "quick_action_dialog", open: true, size: :lg, class: "quick-action", title: @action.title,
        description: safe_join([ "Choose where it goes, then fill it in. ", ui(:kbd, keys: %w[⌘ ↵], class: "hide-on-touch"), " saves." ]) do %>
    <div class="quick-action__body">
      <%= ui :field, label: "Where it goes", class: "quick-action__where" do %>
        <%= render "quick_actions/record_picker", record: @record, form_id: "quick_action_form", types: @action.types %>
      <% end %>
      <%= render @action.partial, form_id: "quick_action_form" %>
    </div>
  <% end %>
</turbo-frame>
