<%# locals: (form_id:) %>
<%= form_with url: documents_path, id: form_id, multipart: true, data: { controller: "form", turbo_frame: "_top" } do |form| %>
  <label class="btn input--upload full-width txt-small quick-action__upload">
    <%= icon_tag "attachment" %>
    <span>Drop files here or choose…</span>
    <%= form.file_field :files, name: "document[files][]", multiple: true, id: nil, aria: { label: "Add documents" }, data: { action: "change->form#submit" } %>
  </label>
<% end %>
