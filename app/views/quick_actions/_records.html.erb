<%# locals: (records:, record: nil) %>
<%# A picker's choices (quick_actions/picker): the starting few, or what a search found. %>
<ul class="popup__list quick-action__records" role="listbox">
  <% records.each do |candidate| %>
    <%# herb:key QuickAction.value_for(candidate) %>
    <li class="popup__item" role="checkbox" aria-checked="<%= candidate == record %>" data-combobox-target="item" data-combobox-value="<%= QuickAction.value_for(candidate) %>" data-combobox-label="<%= record_label(candidate) %>">
      <button type="button" class="popup__btn" data-action="dialog#close combobox#change">
        <span class="quick-action__kind"><%= record_kind(candidate) %></span>
        <span class="popup__label"><%= record_label(candidate) %></span>
        <%= icon_tag "check", class: "checked" %>
      </button>
    </li>
  <% end %>
  <% if records.empty? %>
    <li class="popup__item quick-action__none">Nothing matches.</li>
  <% end %>
</ul>
