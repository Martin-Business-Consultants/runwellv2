<%# locals: (form_id:) %>
<%= form_with model: Note.new, url: notes_path, id: form_id, namespace: "quick_action", class: "quick-action__form", data: { turbo_frame: "_top" } do |form| %>
  <div class="field">
    <span class="field__label">Note</span>
    <%= rich_text_field form, :body, placeholder: "What was said or decided…", staff: true %>
  </div>
  <div class="field-row">
    <div class="field">
      <%= form.label :kind, "Kind", class: "field__label" %>
      <%= form.select :kind, Note::KINDS.map { |kind| [ kind.humanize, kind ] }, { selected: "internal" } %>
    </div>
    <div class="field">
      <%= form.label :source, "Source", class: "field__label" %>
      <%= form.text_field :source, autocomplete: "off", placeholder: "Call with Ann, 24 Sep" %>
    </div>
  </div>
  <div class="dialog__actions">
    <button type="button" class="btn btn--secondary" data-action="dialog#close">Cancel</button>
    <button type="submit" class="btn btn--primary">Add note</button>
  </div>
<% end %>
