<%# locals: () %>
<%# The quick action tray, bottom right (A): a popover menu: a record picker (the
    record on screen, or any other) over an entry per action. The entries submit one GET form
    carrying the picked record; each action's form opens in a modal (quick_actions#new).
    Plugins add actions with Runwell::Plugins.quick_action. Its toggle is a round + beside the
    bell (A clicks it), and the menu stacks in reverse, so the picker sits above the actions. %>
<% record = current_record %>
<section class="tray tray--actions" data-controller="dialog" data-dialog-sizing-value="false" data-action="keydown.esc->dialog#close:stop click@document->dialog#closeOnClickOutside">
  <form id="quick_actions_form" action="<%= new_quick_action_path %>" method="get" data-turbo-frame="quick_action" hidden></form>
  <%# g t n opens the task form, on the work or client on screen (or the task's work). %>
  <a href="<%= new_quick_action_path(kind: "task", record: (record && QuickAction.value_for(record))) %>" data-turbo-frame="quick_action" data-keys="g t n" class="visually-hidden">Add <%= term(:task).downcase %></a>

  <dialog class="tray__dialog" aria-label="Quick actions" data-dialog-target="dialog">
    <% QuickAction.all.each do |action| %>
      <%# herb:key action.key %>
      <div class="tray__item">
        <button type="submit" form="quick_actions_form" name="kind" value="<%= action.key %>" class="menu__item" data-action="dialog#close">
          <%= icon_tag action.icon %>
          <span><%= action.title %></span>
        </button>
      </div>
    <% end %>
    <div class="tray__item tray__item--picker">
      <%= render "quick_actions/picker", records: QuickAction.records(record), record: record, form_id: "quick_actions_form", prefix: "On" %>
    </div>
    <div class="tray__item">
      <span class="menu__label">Quick actions</span>
    </div>
  </dialog>

  <button type="button" class="tray__toggle" aria-label="Quick actions" title="Quick actions (A)" aria-haspopup="true" data-keys="a" data-action="dialog#toggle">
    <span class="tray__toggle-btn">
      <%= icon_tag "add" %>
      <span class="tray__toggle-text">Add <kbd class="hide-on-touch">A</kbd></span>
    </span>
  </button>
</section>
<turbo-frame id="quick_action"></turbo-frame>
