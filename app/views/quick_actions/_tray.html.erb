<%# locals: () %>
<%# The quick actions, at the right of the panel bar beside the bell: a + (A presses it) opening a
    popover below it (runeui's ui :popover): where it goes (a record picker, set to the record on
    screen and able to find any other) over an entry per action. The entries submit one GET form
    carrying the picked record; each action's form opens in a modal (quick_actions#new, into the
    quick_action frame). Plugins add actions with Runwell::Plugins.quick_action. %>
<% record = current_record %>
<form id="quick_actions_form" action="<%= new_quick_action_path %>" method="get" data-turbo-frame="quick_action" hidden></form>
<%# g t n opens the task form, on the work or client on screen (or the task's work). %>
<a href="<%= new_quick_action_path(kind: "task", record: (record && QuickAction.value_for(record))) %>" data-turbo-frame="quick_action" data-keys="g t n" class="visually-hidden">Add <%= term(:task).downcase %></a>

<% trigger = ui(:button, variant: :outline, size: :icon_sm, class: "tray__toggle", content: icon_tag("add"), aria: { label: "Quick actions" }, title: "Quick actions (A)", data: { keys: "a" }) %>
<%= ui :popover, id: "quick-actions", trigger: trigger, side: :bottom, align: :end, class: "quick-actions" do %>
  <p class="quick-actions__title">Quick actions</p>
  <div class="quick-actions__where">
    <span class="quick-actions__on">On</span>
    <%= render "quick_actions/record_picker", record: record, form_id: "quick_actions_form" %>
  </div>
  <div class="quick-actions__list" role="group" aria-label="Add">
    <% QuickAction.all.reverse_each do |action| %>
      <%# herb:key action.key %>
      <button type="submit" form="quick_actions_form" name="kind" value="<%= action.key %>" class="ui-item quick-actions__item" data-runeui-close="quick-actions">
        <%= icon_tag action.icon %>
        <span><%= action.title %></span>
      </button>
    <% end %>
  </div>
<% end %>
<turbo-frame id="quick_action" data-empties-on-close></turbo-frame>
