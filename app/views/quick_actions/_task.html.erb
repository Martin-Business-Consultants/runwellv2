<%# locals: (form_id:) %>
<%# A task from anywhere (g t n, or the tray): what needs doing, who leads it and who else is on it,
    and when, on the work or client picked above. Nobody leading it makes it a request. %>
<% me = Current.user.person %>
<%= form_with model: Task.new, url: tasks_path, id: form_id, namespace: "quick_action", class: "quick-action__form", data: { turbo_frame: "_top" } do |form| %>
  <div class="field">
    <%= form.label :title, "What needs doing", class: "field__label" %>
    <%= form.text_field :title, required: true, autocomplete: "off", placeholder: "Send the proposal…", autofocus: true %>
  </div>
  <div class="field">
    <span class="field__label">Details <span class="quick-action__optional">Optional</span></span>
    <%= rich_text_field form, :description, placeholder: "Anything that helps…" %>
  </div>
  <div class="field-row">
    <div class="field">
      <%= form.label :owner_id, "Lead", class: "field__label" %>
      <%= form.select :owner_id, task_owner_options, { include_blank: "Unassigned", selected: me.id } %>
    </div>
    <div class="field">
      <%= form.label :due_on, "Due", class: "field__label" %>
      <%= date_input form, :due_on %>
    </div>
  </div>
  <div class="field">
    <%= form.label :other_owner_ids, "Also on it", class: "field__label" %>
    <%= form.select :other_owner_ids, task_people.map { [ it.display_name, it.id ] }, { include_blank: "Nobody else" }, multiple: true %>
  </div>
  <div class="dialog__actions">
    <button type="button" class="btn btn--secondary" data-action="dialog#close">Cancel</button>
    <button type="submit" class="btn btn--primary">Add <%= term(:task).downcase %></button>
  </div>
<% end %>
