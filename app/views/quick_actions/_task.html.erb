<%# locals: (form_id:) %>
<%# A task from anywhere (g t n, or the tray): what needs doing, who leads it and who else is on it,
    when, and whether the client sees it, on the work or client picked above. Nobody leading it
    makes it a request.
    Its few fields go in rows: what needs doing (beside where it goes, in the dialog), the details,
    lead beside who else, due beside the client switch. The rows follow the order the install
    arranged a task's fields (template mode, RecordLayout: a row comes where its first field is),
    and a hidden field drops out of its row; the title is required, so it's always there. %>
<% me = Current.user.person %>
<% layout = record_layout(:task) %>
<% shown = layout.main + layout.aside %>
<% rows = [ %w[title], %w[description], %w[lead others], %w[due client_visible] ]
     .map { |row| row & shown }.reject(&:empty?)
     .sort_by { |row| shown.index(row.first) } %>
<%= form_with model: Task.new, url: tasks_path, id: form_id, namespace: "quick_action", class: "quick-action__form", data: { turbo_frame: "_top" } do |form| %>
  <% rows.each do |row| %>
    <%# herb:key row.join("-") %>
    <div class="<%= row.size > 1 ? "form-grid quick-action__row" : "quick-action__single" %>">
      <% row.each do |key| %>
        <%# herb:key key %>
        <% if key == "title" %>
          <%= form.ui :field, :title, label: "What needs doing", class: "quick-action__lead-field" do %>
            <%= form.text_field :title, required: true, autocomplete: "off", placeholder: "Send the proposal…", autofocus: true %>
          <% end %>
        <% elsif key == "description" %>
          <%= form.ui :field, :description, label: safe_join([ "Details ", tag.span("Optional", class: "quick-action__optional") ]) do %>
            <%= rich_text_field form, :description, placeholder: "Anything that helps…" %>
          <% end %>
        <% elsif key == "lead" %>
          <%= form.ui :field, :owner_id, label: "Lead" do %>
            <%= form.select :owner_id, task_owner_options, { include_blank: "Unassigned", selected: me.id }, search: true %>
          <% end %>
        <% elsif key == "others" %>
          <%= form.ui :field, :other_owner_ids, label: "Also on it" do %>
            <%= form.select :other_owner_ids, task_people.map { [ it.display_name, it.id ] }, { include_blank: "Nobody else" }, multiple: true %>
          <% end %>
        <% elsif key == "due" %>
          <%= form.ui :field, :due_on, label: "Due" do %>
            <%= date_input form, :due_on %>
          <% end %>
        <% elsif key == "client_visible" %>
          <div class="quick-action__switch">
            <%= switch_field form, :client_visible, label: "Visible to the #{term(:client).downcase}" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <div class="form-actions">
    <%= ui :button, type: :button, variant: :outline, content: "Cancel", data: { runeui_close: "quick_action_dialog" } %>
    <%= ui :button, type: :submit, content: "Add " + term(:task).downcase %>
  </div>
<% end %>
