<%# locals: (records:, record:, form_id:, prefix: nil) %>
<%# Where the action goes: Fizzy's combobox with a filter, writing "Type:id" into the form's
    record field. The blank field comes first so a pick (appended after it) wins. %>
<div class="<%= class_names("quick-action__picker flex align-center gap-half", "quick-action__picker--full": !prefix) %>" data-controller="dialog filter combobox" data-action="keydown.esc->dialog#close:stop:prevent click@document->dialog#closeOnClickOutside dialog:close->filter#clearInput">
  <input type="hidden" name="record" value="" form="<%= form_id %>">
  <% if prefix %>
    <span class="txt-small txt-subtle"><%= prefix %></span>
  <% end %>
  <button type="button" class="btn input input--select flex-inline txt-small min-width" data-action="click->dialog#toggle:stop">
    <span class="overflow-ellipsis" data-combobox-target="label"><%= record ? record_label(record) : "Choose…" %></span>
  </button>
  <template data-combobox-target="hiddenFieldTemplate">
    <input type="hidden" name="record" form="<%= form_id %>">
  </template>

  <dialog class="margin-block-start-half popup panel flex-column align-start gap-half fill-white shadow txt-small" aria-label="Where it goes" data-dialog-target="dialog">
    <input type="search" class="input input--transparent txt-small full-width" placeholder="Find a <%= records.map { record_type_term(it.class.name) }.uniq.to_sentence(last_word_connector: " or ", two_words_connector: " or ").downcase %>…" autocomplete="off" aria-label="Find a record" data-1p-ignore="true" data-filter-target="input" data-dialog-target="focusMouse" data-action="input->filter#filter">
    <ul class="popup__list quick-action__records" role="listbox">
      <% records.each do |candidate| %>
        <%# herb:key QuickAction.value_for(candidate) %>
        <li class="popup__item" role="checkbox" aria-checked="<%= candidate == record %>" data-filter-target="item" data-combobox-target="item" data-combobox-value="<%= QuickAction.value_for(candidate) %>" data-combobox-label="<%= record_label(candidate) %>">
          <button type="button" class="btn popup__btn" data-action="dialog#close combobox#change">
            <span class="txt-x-small txt-subtle txt-nowrap"><%= record_kind(candidate) %></span>
            <span class="overflow-ellipsis flex-item-grow"><%= record_label(candidate) %></span>
            <%= icon_tag "check", class: "checked flex-item-justify-end" %>
          </button>
        </li>
      <% end %>
    </ul>
  </dialog>
</div>
