<%# locals: (client:) %>
<%# A client's contacts, in its page's sidebar: each opens in the side panel (peek), and Add a contact
    opens its form in the modal; adding one redraws this card (contacts/create.turbo_stream.erb). %>
<% contacts = client.contacts.active.ordered.to_a %>
<%= record_card "Contacts", id: dom_id(client, :contacts), hint: "#{pluralize contacts.size, "person", plural: "people"} at #{client.name}",
      footer: ui(:button, variant: :outline, size: :sm, href: new_client_contact_path(client), content: safe_join([ icon_tag("person-add"), "Add a contact" ], " "), data: { turbo_frame: "modal" }) do %>
    <% if contacts.any? %>
      <ul class="record-list">
        <% contacts.each do |contact| %>
          <%# herb:key contact.id %>
          <li data-filter-target="item">
            <%= peek_link_to contact, class: "item-row" do %>
              <%= avatar contact.name, size: :md %>
              <span class="item-row__content">
                <span class="item-row__title"><%= contact.name %></span>
                <span class="item-row__desc"><%= [ contact.title, contact.email, contact.phone ].compact_blank.join(" · ") %></span>
              </span>
              <span class="contact-marks">
                <% if contact.portal? %>
                  <span class="contact-marks__mark" title="Can sign in to the portal"><%= icon_tag "globe" %><span class="visually-hidden">Portal</span></span>
                <% end %>
                <% if contact.can_approve? %>
                  <span class="contact-marks__mark contact-marks__mark--approve" title="Can approve"><%= icon_tag "check-circle" %><span class="visually-hidden">Can approve</span></span>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "No contacts yet." %>
    <% end %>
<% end %>
