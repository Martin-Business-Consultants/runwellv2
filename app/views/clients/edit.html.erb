<% @page_title = "Edit #{@client.name_was}" %>

<%= parent_page @client.name_was, @client %>

<% layout = record_layout(:client) %>
<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:client) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:client).downcase}’s" %>
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">Changes show everywhere they appear, the portal included.</p>
    </div>
    <div class="button-row">
      <%= render "record_fields/arrange_button" %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%= render "record_fields/main_card", layout: layout, record: @client, form_id: "client_form", title: term(:client), hint: "Their name, where they stand, and the time zone their portal uses.",
          submit: "Save changes", cancel: client_path(@client) %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @client, form_id: "client_form" %>

    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Details</h2>
      </header>
      <div class="card__content">
        <dl class="details">
          <dt>Contacts</dt><dd><%= @client.contacts.active.count %></dd>
          <dt><%= term(:work, count: 2) %></dt><dd><%= @client.works.count %></dd>
          <dt>Since</dt><dd><%= l @client.created_at.to_date, format: :long %></dd>
        </dl>
      </div>
    </section>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Delete this " + term(:client).downcase, title: "Delete #{@client.name_was}?",
            body: "This removes the #{term(:client).downcase} with its contacts, #{term(:task, count: 2).downcase} and notes. One with #{term(:work, count: 2).downcase} can’t be deleted.",
            button: "Delete " + term(:client).downcase, path: client_path(@client) %>
    <% end %>
  </aside>
</section>
