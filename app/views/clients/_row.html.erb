<%# locals: (client:, listed:, fresh: nil) %>
<%# One client in the index's data table (layouts/shared/_list_table): the cells in the columns' order. %>
<tr id="<%= dom_id(client, :row) %>" data-filter-target="item"<% if fresh %> class="is-fresh"<% end %>>
  <%= ui :select_cell, value: client.id, label: client.name, checkbox: { data: { keys: "x" } } %>
  <td data-column="name" data-grow><%= peek_link_to client, client.name, class: "row-link" %></td>
  <td data-column="status"><%= render "clients/status_picker", client: client %></td>
  <td data-column="contacts"><%= contact_stack client.contacts.reject(&:archived?).sort_by(&:name) %></td>
  <td data-align="end" data-column="works"><%= client.works.count { !it.closed? } %></td>
  <% listed.each do |field| %>
    <%# herb:key field.id %>
    <%= custom_field_cell(field, client.custom_value(field)) %>
  <% end %>
  <%= render "layouts/shared/row_actions", name: client.name, edit_path: edit_client_path(client), peek: client, delete_path: client_path(client),
        delete_message: "This removes its contacts, " + term(:task, count: 2).downcase + " and notes. A " + term(:client).downcase + " with " + term(:work, count: 2).downcase + " can’t be deleted." %>
</tr>
