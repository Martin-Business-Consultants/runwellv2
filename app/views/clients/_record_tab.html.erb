<%# locals: (client:, work_state:, task_state:, tabs: nil) %>
<%# A client's tabs and the one showing: on its page, and on its own when a tab is picked
    (ClientsController#show answers a record_tab frame request with just this, not the whole page). %>
<% tabs ||= client_record_tabs(client) %>
<% tab = current_record_tab(tabs, "works") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>
<turbo-frame id="record_tab" target="_top">
  <div class="record-tabs">
    <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
    <div class="record-tabs__panel">
      <% case tab %>
      <% when "works" %>
        <% works = Work.filtered(state: work_state, scope: client.works) %>
        <%= record_card term(:work, count: 2), id: "works", hint: "What we run for #{client.name}.",
              action: render("layouts/shared/segmented_filter", label: "Show " + term(:work, count: 2).downcase, param: :works, current: work_state, options: Work.filter_options, counts: Work.filter_counts(scope: client.works)),
              footer: ui(:button, variant: :outline, size: :sm, href: new_work_path(client_id: client.id), content: safe_join([ icon_tag("add"), "New #{term(:work).downcase}" ], " ")) do %>
          <% if works.any? %>
            <ul class="record-list">
              <% works.each do |work| %>
                <%# herb:key work.id %>
                <li data-filter-target="item">
                  <%= link_to work, class: "list-row" do %>
                    <span class="list-row__content">
                      <span class="list-row__title"><%= work.title %></span>
                      <span class="list-row__desc"><%= work.label_name %></span>
                    </span>
                    <span class="list-row__meta"><%= status_tag work.state_label, highlight: work.active? %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% elsif client.works.exists? %>
            <%= ui :empty, size: :sm, description: "None #{Work.filter_options.to_h.invert.fetch(work_state).downcase}.", action: link_to("Show all", client_path(client, works: "all")) %>
          <% else %>
            <%= ui :empty, size: :sm, description: "No #{term(:work, count: 2).downcase} yet." %>
          <% end %>
        <% end %>
      <% when "tasks" %>
        <%= render "tasks/client_section", client: client, state: task_state %>
      <% when "notes" %>
        <%= render "notes/section", subject: client %>
      <% when "documents" %>
        <%= render "documents/section", subject: client %>
      <% end %>
      <% if plugin_partial %>
        <%= render plugin_partial, client: client %>
      <% end %>
    </div>
  </div>
</turbo-frame>
