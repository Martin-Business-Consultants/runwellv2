<%# locals: (client:) %>
<%# A client's status on the clients table, changed in place: its badge opens a menu of the
    statuses (Fizzy's popup, like todos/status_dot); choosing one shows at once (picker) and saves
    it, answered with just this picker (ClientsController#update). %>
<% label = client.status.humanize %>
<div class="row-picker" id="<%= dom_id(client, :status) %>" data-controller="dialog fixed-popup picker" data-dialog-orient-value="false"
  data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside dialog:show->fixed-popup#place dialog:close->fixed-popup#close">
  <button type="button" class="status-tag-picker__trigger" title="<%= label %>: click to change" aria-haspopup="true" data-fixed-popup-target="trigger" data-action="click->dialog#toggle:stop">
    <span class="display-contents" data-picker-target="display" data-picker-part="tag"><%= status_tag client.status, highlight: client.status == "active" %></span>
    <span class="for-screen-reader">Status of <%= client.name %>: <%= label %>. Change it</span>
  </button>

  <dialog class="margin-block-start-half popup panel flex-column align-start gap-half fill-white shadow txt-small" aria-label="Status of <%= client.name %>" data-dialog-target="dialog" data-fixed-popup-target="popup">
    <strong class="popup__title pad-inline-half">Status</strong>
    <%= form_with url: client_path(client), method: :patch, class: "full-width" do %>
      <input type="hidden" name="from_list" value="1">
      <ul class="popup__list" role="group">
        <% Client::STATUSES.each do |status| %>
          <%# herb:key status %>
          <li class="popup__item" role="checkbox" aria-checked="<%= status == client.status %>">
            <button type="submit" name="client[status]" value="<%= status %>" class="btn popup__btn full-width" data-action="picker#choose">
              <span class="overflow-ellipsis flex-item-grow"><%= status.humanize %></span>
              <span hidden data-picker-part="tag"><%= status_tag status, highlight: status == "active" %></span>
              <%= icon_tag "check", class: "checked flex-item-justify-end" %>
            </button>
          </li>
        <% end %>
      </ul>
    <% end %>
  </dialog>
</div>
