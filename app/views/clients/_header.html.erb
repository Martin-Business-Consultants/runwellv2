<%# locals: (client:) %>
<%# A client's page header (record_header: ui :page_header): its name, changed in place, and its
    status and since when. Redrawn when it saves (clients/update.turbo_stream.erb). %>
<%= record_header id: dom_id(client, :header) do %>
  <%= render "layouts/shared/record_title", record: client, attribute: :name, label: "Name" %>
  <div class="record-header__line">
    <%= render "clients/status_picker", client: client %>
    <span><%= client.internal? ? "Internal: our own " + term(:work, count: 2).downcase : term(:client) %> since <%= l client.created_at.to_date, format: :long %></span>
  </div>
<% end %>
