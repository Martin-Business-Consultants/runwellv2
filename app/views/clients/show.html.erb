<% @page_title = @client.name %>
<% contacts = @client.contacts.active.ordered.to_a %>
<% tabs = [
     record_tab("works", term(:work, count: 2), count: @client.works.count),
     record_tab("tasks", term(:task, count: 2), count: @client.tasks.open.count),
     record_tab("notes", "Notes", count: @client.notes.count),
     record_tab("documents", "Documents", count: @client.documents.count)
   ] + plugin_record_tabs(:client_panel) %>
<% tab = current_record_tab(tabs, "works") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>

<%= parent_page term(:client, count: 2), clients_path %>
<%= turbo_stream_from @client %>

<% layout = record_layout(:client) %>
<section class="record-page record-page--tabbed" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:client) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:client).downcase}’s" %>
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <%= status_tag @client.status.humanize, highlight: @client.status == "active" %>
        <span><%= @client.internal? ? "Internal: our own projects" : term(:client) %> since <%= l @client.created_at.to_date, format: :long %></span>
      </p>
    </div>
    <div class="button-row">
      <%= render "record_fields/arrange_button" %>
      <%= link_to edit_client_path(@client), class: "btn btn--secondary", data: { keys: "e" } do %>
        <%= icon_tag "pencil" %>
        <span>Edit</span>
        <kbd class="hide-on-touch">E</kbd>
      <% end %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%# Its fields as the install arranged them (template mode): the working column's here; the
        sidebar's in Details. %>
    <section class="card record-card record-fields-card">
      <div class="card__content">
        <%= render "record_fields/zone", layout: layout, zone: "main", record: @client, stacked: true %>
      </div>
    </section>

    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "works" %>
            <section class="card record-card" id="works">
              <header class="card__head">
                <h2 class="card__title"><%= term(:work, count: 2) %></h2>
                <p class="card__hint">What we run for <%= @client.name %>.</p>
                <div class="card__action">
                  <%= render "layouts/shared/segmented_filter", label: "Show " + term(:work, count: 2).downcase, param: :works, current: @work_state,
                        options: Work.filter_options, counts: Work.filter_counts(scope: @client.works) %>
                </div>
              </header>

              <div class="card__content">
                <% works = Work.filtered(state: @work_state, scope: @client.works) %>
                <% if works.any? %>
                  <ul class="record-list">
                    <% works.each do |work| %>
                      <%# herb:key work.id %>
                      <li data-filter-target="item">
                        <%= link_to work, class: "list-row" do %>
                          <span class="list-row__content">
                            <span class="list-row__title"><%= work.title %></span>
                            <span class="list-row__desc"><%= work.label_name %></span>
                          </span>
                          <span class="list-row__meta"><%= status_tag work.state_label, highlight: work.active? %></span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% elsif @client.works.exists? %>
                  <p class="record-card__empty">
                    None <%= Work.filter_options.to_h.invert.fetch(@work_state).downcase %>.
                    <%= link_to "Show all", client_path(@client, works: "all") %>
                  </p>
                <% else %>
                  <p class="record-card__empty">No <%= term(:work, count: 2).downcase %> yet.</p>
                <% end %>
              </div>

              <footer class="card__footer">
                <%= link_to new_work_path(client_id: @client.id), class: "btn btn--secondary btn--sm" do %>
                  <%= icon_tag "add" %>
                  <span>New <%= term(:work).downcase %></span>
                <% end %>
              </footer>
            </section>
          <% when "tasks" %>
            <%= render "tasks/client_section", client: @client, state: @task_state %>
          <% when "notes" %>
            <%= render "notes/section", subject: @client %>
          <% when "documents" %>
            <%= render "documents/section", subject: @client %>
          <% end %>
          <% if plugin_partial %>
            <%= render plugin_partial, client: @client %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="record-page__aside">
    <%= plugin_slots(:client_aside, client: @client) %>
    <%= render "record_fields/aside_card", layout: layout, record: @client %>

    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Contacts</h2>
        <p class="card__hint"><%= pluralize contacts.size, "person", plural: "people" %> at <%= @client.name %></p>
      </header>
      <div class="card__content">
        <% if contacts.any? %>
          <ul class="record-list">
            <% contacts.each do |contact| %>
              <%# herb:key contact.id %>
              <li data-filter-target="item">
                <%= link_to edit_contact_path(contact), class: "list-row" do %>
                  <%= avatar contact.name, size: :md %>
                  <span class="list-row__content">
                    <span class="list-row__title"><%= contact.name %></span>
                    <span class="list-row__desc"><%= [ contact.title, contact.email, contact.phone ].compact_blank.join(" · ") %></span>
                  </span>
                  <span class="contact-marks">
                    <% if contact.portal? %>
                      <span class="contact-marks__mark" title="Can sign in to the portal"><%= icon_tag "globe" %><span class="visually-hidden">Portal</span></span>
                    <% end %>
                    <% if contact.can_approve? %>
                      <span class="contact-marks__mark contact-marks__mark--approve" title="Can approve"><%= icon_tag "check-circle" %><span class="visually-hidden">Can approve</span></span>
                    <% end %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="record-card__empty">No contacts yet.</p>
        <% end %>
      </div>
      <footer class="card__footer">
        <%= link_to new_client_contact_path(@client), class: "btn btn--secondary btn--sm" do %>
          <%= icon_tag "person-add" %>
          <span>Add a contact</span>
        <% end %>
      </footer>
    </section>

    <%= render "events/timeline", subject: @client %>
  </aside>
</section>
