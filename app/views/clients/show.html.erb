<% @page_title = @client.name %>
<% contacts = @client.contacts.active.ordered.to_a %>
<% tabs = [
     record_tab("engagements", term(:engagement, count: 2), count: @client.engagements.count),
     record_tab("work", term(:work, count: 2), count: @client.todos.open.count),
     record_tab("notes", "Notes", count: @client.notes.count),
     record_tab("documents", "Documents", count: @client.documents.count)
   ] + plugin_record_tabs(:client_panel) %>
<% tab = current_record_tab(tabs, "engagements") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>

<%= parent_page term(:client, count: 2), clients_path %>
<%= turbo_stream_from @client %>

<section class="record-page">
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <%= status_tag @client.status.humanize, highlight: @client.status == "active" %>
        <span><%= @client.internal? ? "Internal: our own projects" : term(:client) %> since <%= l @client.created_at.to_date, format: :long %></span>
      </p>
    </div>
    <div class="button-row">
      <%= link_to edit_client_path(@client), class: "btn btn--secondary", data: { keys: "e" } do %>
        <%= icon_tag "pencil" %>
        <span>Edit</span>
        <kbd class="hide-on-touch">E</kbd>
      <% end %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "engagements" %>
            <section class="card record-card" id="engagements">
              <header class="card__head">
                <h2 class="card__title"><%= term(:engagement, count: 2) %></h2>
                <p class="card__hint">What we run for <%= @client.name %>.</p>
                <div class="card__action">
                  <%= render "layouts/shared/segmented_filter", label: "Show " + term(:engagement, count: 2).downcase, param: :engagements, current: @engagement_state,
                        options: Engagement.filter_options, counts: Engagement.filter_counts(scope: @client.engagements) %>
                </div>
              </header>

              <div class="card__content">
                <% engagements = Engagement.filtered(state: @engagement_state, scope: @client.engagements) %>
                <% if engagements.any? %>
                  <ul class="record-list">
                    <% engagements.each do |engagement| %>
                      <%# herb:key engagement.id %>
                      <li data-filter-target="item">
                        <%= link_to engagement, class: "list-row" do %>
                          <span class="list-row__content">
                            <span class="list-row__title"><span class="record-list__ref"><%= engagement.ref %></span> <%= engagement.title %></span>
                            <span class="list-row__desc"><%= engagement.label_name %></span>
                          </span>
                          <span class="list-row__meta"><%= status_tag engagement.state_label, highlight: engagement.active? %></span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% elsif @client.engagements.exists? %>
                  <p class="record-card__empty">
                    None <%= Engagement.filter_options.to_h.invert.fetch(@engagement_state).downcase %>.
                    <%= link_to "Show all", client_path(@client, engagements: "all") %>
                  </p>
                <% else %>
                  <p class="record-card__empty">No <%= term(:engagement, count: 2).downcase %> yet.</p>
                <% end %>
              </div>

              <footer class="card__footer">
                <%= link_to new_engagement_path(client_id: @client.id), class: "btn btn--secondary btn--sm" do %>
                  <%= icon_tag "add" %>
                  <span>New <%= term(:engagement).downcase %></span>
                <% end %>
              </footer>
            </section>
          <% when "work" %>
            <%= render "todos/client_section", client: @client, state: @work_state %>
          <% when "notes" %>
            <%= render "notes/section", subject: @client %>
          <% when "documents" %>
            <%= render "documents/section", subject: @client %>
          <% end %>
          <% if plugin_partial %>
            <%= render plugin_partial, client: @client %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="record-page__aside">
    <%= plugin_slots(:client_aside, client: @client) %>
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Details</h2>
      </header>
      <div class="card__content record-card__stack">
        <dl class="details">
          <dt>Status</dt><dd><%= status_tag @client.status.humanize, highlight: @client.status == "active" %></dd>
          <% if @client.internal? %>
            <dt>Internal</dt><dd>This is us: our own projects</dd>
          <% end %>
          <dt>Since</dt><dd><%= l @client.created_at.to_date, format: :long %></dd>
          <dt>Time zone</dt>
          <dd>
            <% if @client.own_time_zone? %>
              <%= @client.time_zone %> · <%= l Time.current.in_time_zone(@client.zone), format: "%-l:%M %p" %> there now
            <% else %>
              Same as ours
            <% end %>
          </dd>
        </dl>
        <%= render "custom_fields/values", record: @client %>
      </div>
    </section>

    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Contacts</h2>
        <p class="card__hint"><%= pluralize contacts.size, "person", plural: "people" %> at <%= @client.name %></p>
      </header>
      <div class="card__content">
        <% if contacts.any? %>
          <ul class="record-list">
            <% contacts.each do |contact| %>
              <%# herb:key contact.id %>
              <li data-filter-target="item">
                <%= link_to edit_contact_path(contact), class: "list-row" do %>
                  <%= avatar contact.name, size: :md %>
                  <span class="list-row__content">
                    <span class="list-row__title"><%= contact.name %></span>
                    <span class="list-row__desc"><%= [ contact.role, contact.email, contact.phone ].compact_blank.join(" · ") %></span>
                  </span>
                  <span class="contact-marks">
                    <% if contact.portal? %>
                      <span class="contact-marks__mark" title="Can sign in to the portal"><%= icon_tag "globe" %><span class="visually-hidden">Portal</span></span>
                    <% end %>
                    <% if contact.can_approve? %>
                      <span class="contact-marks__mark contact-marks__mark--approve" title="Can approve"><%= icon_tag "check-circle" %><span class="visually-hidden">Can approve</span></span>
                    <% end %>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="record-card__empty">No contacts yet.</p>
        <% end %>
      </div>
      <footer class="card__footer">
        <%= link_to new_client_contact_path(@client), class: "btn btn--secondary btn--sm" do %>
          <%= icon_tag "person-add" %>
          <span>Add a contact</span>
        <% end %>
      </footer>
    </section>

    <%= render "events/timeline", subject: @client %>
  </aside>
</section>
