<%# locals: (client:, internal_aside: nil) %>
<%# internal_aside: the edit page puts the Internal switch in its sidebar, tied to this form by id. %>
<%= render "layouts/shared/errors", record: client %>

<%= form_with model: client, id: dom_id(client, :form), class: "ui-card record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <header class="ui-card__header">
    <h2 class="ui-card__title"><%= term(:client) %></h2>
    <p class="ui-card__description">Their name, where they stand, and the time zone their portal uses.</p>
  </header>

  <div class="ui-card__content record-form__body">
    <label class="ui-field">
      <span class="ui-label">Name</span>
      <%= form.text_field :name, required: true, class: "ui-input", autofocus: client.new_record?, autocomplete: "off", placeholder: "Acme Inc." %>
    </label>

    <div class="record-form__row record-form__row--narrow-first">
      <label class="ui-field">
        <span class="ui-label">Status</span>
        <%= form.select :status, Client::STATUSES.map { |status| [ status.humanize, status ] }, {}, class: "ui-select" %>
      </label>

      <label class="ui-field record-form__tz">
        <span class="ui-label">Time zone</span>
        <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, { include_blank: "Same as ours (#{Setting.zone.name})" }, class: "ui-select" %>
        <span class="ui-field__description">Their portal and emails show times in it.</span>
      </label>
    </div>

    <% unless internal_aside %>
      <%= switch_field form, :internal, label: "Internal", hint: "This is us. Its engagements are our own projects." %>
    <% end %>

    <%= custom_field_inputs form, client %>
  </div>

  <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
    <%= link_to "Cancel", client.new_record? ? clients_path : client_path(client), class: "ui-button ui-button--outline", data: { form_target: "cancel" } %>
    <button type="submit" class="ui-button" data-form-target="submit">
      <span><%= client.new_record? ? "Add client" : "Save changes" %></span>
    </button>
  </footer>
<% end %>
