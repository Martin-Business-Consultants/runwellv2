<%# locals: (client:, internal_aside: nil) %>
<%# internal_aside: the edit page puts the Internal switch in its sidebar, tied to this form by id. %>
<%= render "layouts/shared/errors", record: client %>

<%= form_with model: client, id: dom_id(client, :form), class: "record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <label class="record-form__field">
    <span class="record-form__label">Name</span>
    <%= form.text_field :name, required: true, class: "input full-width", autofocus: client.new_record?, autocomplete: "off", placeholder: "Acme Inc." %>
  </label>

  <div class="record-form__row record-form__row--narrow-first">
    <label class="record-form__field">
      <span class="record-form__label">Status</span>
      <%= form.select :status, Client::STATUSES.map { |status| [ status.humanize, status ] }, {}, class: "input input--select full-width" %>
    </label>

    <label class="record-form__field">
      <span class="record-form__label">Time zone</span>
      <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, { include_blank: "Same as ours (#{Setting.zone.name})" }, class: "input input--select full-width" %>
      <span class="record-form__hint">Their portal, approval pages and emails show times in it.</span>
    </label>
  </div>

  <% unless internal_aside %>
    <div class="record-form__toggle">
      <div class="record-form__toggle-text">
        <%= form.label :internal, "Internal", class: "record-form__label" %>
        <span class="record-form__hint">This is us. Its engagements are our own projects, with no agreement to send.</span>
      </div>
      <label class="switch flex-item-no-shrink">
        <%= form.check_box :internal, class: "switch__input" %>
        <span class="switch__btn"></span>
      </label>
    </div>
  <% end %>

  <% if Setting.current.ai_enabled? %>
    <div class="record-form__toggle">
      <div class="record-form__toggle-text">
        <%= form.label :ai_excluded, "Keep out of AI", class: "record-form__label" %>
        <span class="record-form__hint">No assistant or suggestions on this <%= term(:client).downcase %>’s records (Settings › AI).</span>
      </div>
      <label class="switch flex-item-no-shrink">
        <%= form.check_box :ai_excluded, class: "switch__input" %>
        <span class="switch__btn"></span>
      </label>
    </div>
  <% end %>

  <%= custom_field_inputs form, client %>

  <div class="record-form__footer">
    <%= link_to "Cancel", client.new_record? ? clients_path : client_path(client), class: "btn btn--plain record-form__cancel", data: { form_target: "cancel" } %>
    <button type="submit" class="btn btn--link" data-form-target="submit">
      <span><%= client.new_record? ? "Add client" : "Save changes" %></span>
    </button>
  </div>
<% end %>
