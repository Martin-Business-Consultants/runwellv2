<%# locals: (client:, internal_aside: nil, modal: nil) %>
<%# internal_aside: the edit page puts the Internal switch in its sidebar, tied to this form by id. %>
<%= render "layouts/shared/errors", record: client %>

<%= form_with model: client, id: dom_id(client, :form), class: "card record-form", data: { controller: "form", action: "keydown.esc->form#cancel" }.merge(modal ? { turbo_frame: "_top" } : {}) do |form| %>
  <header class="card__head">
    <h2 class="card__title"><%= term(:client) %></h2>
    <p class="card__hint">Their name, where they stand, and the time zone their portal uses.</p>
  </header>

  <div class="card__content record-form__body">
    <label class="field">
      <span class="field__label">Name</span>
      <%= form.text_field :name, required: true, autofocus: client.new_record?, autocomplete: "off", placeholder: "Acme Inc." %>
    </label>

    <div class="field-row record-form__row--narrow-first">
      <label class="field">
        <span class="field__label">Status</span>
        <%= form.select :status, Client::STATUSES.map { |status| [ status.humanize, status ] }, {} %>
      </label>

      <label class="field">
        <span class="field__label">Time zone</span>
        <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, { include_blank: "Same as ours (#{Setting.zone.name})" } %>
        <span class="field__hint">Their portal and emails show times in it.</span>
      </label>
    </div>

    <% unless internal_aside %>
      <%= switch_field form, :internal, label: "Internal", hint: "This is us. Its #{term(:work, count: 2).downcase} is our own." %>
    <% end %>

    <%= custom_field_inputs form, client %>
  </div>

  <footer class="card__footer card__footer--bordered">
    <% if modal %>
      <button type="button" class="btn btn--secondary" data-form-target="cancel" data-action="dialog#close">Cancel</button>
    <% else %>
      <%= link_to "Cancel", client.new_record? ? clients_path : client_path(client), class: "btn btn--secondary", data: { form_target: "cancel" } %>
    <% end %>
    <button type="submit" class="btn btn--primary" data-form-target="submit">
      <span><%= client.new_record? ? "Add client" : "Save changes" %></span>
    </button>
  </footer>
<% end %>
