<% @page_title = "New " + term(:client).downcase %>
<% recent = Client.order(created_at: :desc).limit(6).to_a %>

<% content_for :header do %>
  <%= parent_page term(:client, count: 2), clients_path %>
<% end %>

<section class="settings settings--split record-page">
  <header class="record-page__header page-heading">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">Someone you work for. Contacts, <%= term(:engagement, count: 2).downcase %> and <%= term(:work).downcase %> come next.</p>
    </div>
    <div class="page-heading__actions">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="settings__panel record-page__main">
    <%= render "clients/form", client: @client %>
  </div>

  <aside class="settings__panel settings__panel--side record-page__aside">
    <section class="ui-card record-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">What comes next</h2>
      </header>
      <div class="ui-card__content">
        <ol class="record-steps">
          <li>Add the people you deal with as contacts. Switch on portal access for those who should see their work.</li>
          <li>Start a <%= term(:engagement).downcase %>: something you run for them, in <%= term(:scope_item, count: 2).downcase %> if it has parts.</li>
          <li>Add its <%= term(:work).downcase %>, with who’s on it and when it’s due.</li>
        </ol>
      </div>
    </section>

    <% if recent.any? %>
      <section class="ui-card record-card">
        <header class="ui-card__header">
          <h2 class="ui-card__title">Recently added</h2>
        </header>
        <div class="ui-card__content">
          <ul class="record-list record-list--compact">
            <% recent.each do |client| %>
              <%# herb:key client.id %>
              <li data-filter-target="item">
                <%= link_to client, class: "record-list__row" do %>
                  <span class="record-list__main"><span class="record-list__title"><%= client.name %></span></span>
                  <span class="record-list__meta"><%= l client.created_at.to_date, format: :short %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>
  </aside>
</section>
