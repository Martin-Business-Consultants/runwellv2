<% @page_title = "New " + term(:client).downcase %>
<% recent = Client.order(created_at: :desc).limit(6).to_a %>
<% layout = record_layout(:client) %>
<% if turbo_frame_request_id == "modal" %>
  <%= render layout: "layouts/shared/modal", locals: { title: @page_title } do %>
    <%= render "record_fields/main_card", layout: layout, record: @client, form_id: "client_form", title: term(:client), hint: "Their name, where they stand, and the time zone their portal uses.",
          submit: "Add " + term(:client).downcase, cancel: clients_path, modal: true %>
  <% end %>
<% else %>
<%= parent_page term(:client, count: 2), clients_path %>

<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:client) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:client).downcase}’s" %>
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">Someone you work for. Contacts, <%= term(:work, count: 2).downcase %> and <%= term(:task, count: 2).downcase %> come next.</p>
    </div>
    <div class="button-row">
      <%= render "record_fields/arrange_button" %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%= render "record_fields/main_card", layout: layout, record: @client, form_id: "client_form", title: term(:client), hint: "Their name, where they stand, and the time zone their portal uses.",
          submit: "Add " + term(:client).downcase, cancel: clients_path %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @client, form_id: "client_form" %>
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">What comes next</h2>
      </header>
      <div class="card__content">
        <ol class="record-steps">
          <li>Add the people you deal with as contacts. Switch on portal access for those who should see their work.</li>
          <li>Start <%= term(:work, count: 2).downcase %> for them: what you run for them, in <%= term(:scope_item, count: 2).downcase %> if it has parts.</li>
          <li>Add its <%= term(:task, count: 2).downcase %>, with who’s on it and when it’s due.</li>
        </ol>
      </div>
    </section>

    <% if recent.any? %>
      <section class="card record-card">
        <header class="card__head">
          <h2 class="card__title">Recently added</h2>
        </header>
        <div class="card__content">
          <ul class="record-list">
            <% recent.each do |client| %>
              <%# herb:key client.id %>
              <li data-filter-target="item">
                <%= link_to client, class: "list-row" do %>
                  <span class="list-row__content"><span class="list-row__title"><%= client.name %></span></span>
                  <span class="list-row__meta"><%= l client.created_at.to_date, format: :short %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </section>
    <% end %>
  </aside>
</section>
<% end %>
