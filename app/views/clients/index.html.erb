<% @page_title = term(:client, count: 2) %>
<% listed = CustomField.for("Client").listed.to_a %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :status, current: @status, options: Client.filter_options %>
<% end %>
<% if @view == "table" %>
  <% content_for :index_bulk do %>
  <%= bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_clients_path, noun: term(:client, count: 2).downcase, message: "Any with engagements can’t be deleted, and are skipped and named.") : nil) do %>
    <%= bulk_menu bulk_clients_path, method: :patch, name: "client[status]", label: "Status", choices: Client::STATUSES.map { [ it.humanize, it ] } %>
  <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: "New " + term(:client).downcase, new_path: new_client_path %>

<% if @clients.any? && @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :clients_cards, @page do %>
        <% @clients.each do |client| %>
          <%# herb:key client.id %>
          <%= render "layouts/shared/card", path: client_path(client), title: client.name, id_label: term(:client),
                context: listed.first && custom_field_text(listed.first, client.custom_value(listed.first)),
                meta: [ pluralize(client.contacts.count { !it.archived? }, "contact"), pluralize(client.engagements.count { !it.closed? }, "open " + term(:engagement).downcase, plural: "open " + term(:engagement, count: 2).downcase) ],
                status: client.status, highlight: client.status == "active" %>
        <% end %>
      <% end %>
    </div>
  </section>
<% elsif @clients.any? %>
  <% columns = [ ui_column(:name, "Name", sort: :name, width: [ @column_widths[:name], "Name" ], hideable: false),
                 ui_column(:status, "Status", sort: :status, width: :status),
                 ui_column(:contacts, "Contacts", width: :avatars),
                 ui_column(:engagements, "Open " + term(:engagement, count: 2).downcase, width: :number, align: :end),
                 *listed.map { ui_column("field_#{it.id}", it.label) } ] %>
  <%= render "ui/data_table", id: "clients", columns: columns, rows: @clients, row: "clients/row", as: :client, row_locals: { listed: listed },
        page: @page, selectable: true, actions: true %>
<% elsif Client.exists? %>
  <%= render "layouts/shared/empty", text: "No #{@status} #{term(:client, count: 2).downcase}.", action_text: "Show all", action_path: clients_path(status: "all", view: params[:view]) %>
<% else %>
  <%= render "layouts/shared/empty", text: "No #{term(:client, count: 2).downcase} yet.", action_text: "Add your first #{term(:client).downcase}", action_path: new_client_path %>
<% end %>
