<% @page_title = "Sign in" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <%= auth_card title: "Welcome back", hint: "Sign in to pick up where you left off.", shake: flash[:alert] do %>
      <%= form_with url: session_path, class: "auth__form", data: { controller: "form" } do |form| %>
        <%= form.ui :field, :email_address, label: "Email" do %>
          <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address] %>
        <% end %>

        <%= form.ui :field, :password do %>
          <div class="auth__label-row">
            <ui-field-label data-slot="field-label">Password</ui-field-label>
            <%= link_to "Forgot password?", new_password_path, class: "auth__aside-link" %>
          </div>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %>
        <% end %>

        <%= bot_check_tag %>
        <%= ui :button, type: :submit, content: "Sign in", id: "log_in", "data-form-target": "submit", class: "auth__button" %>
      <% end %>

      <div class="auth__or"><%= ui :separator, decorative: true %><span>Or</span><%= ui :separator, decorative: true %></div>

      <%= ui :button, href: new_session_link_path(email_address: params[:email_address]), variant: :outline, class: "auth__button",
            content: safe_join([ icon_tag("email"), tag.span("Email me a sign-in link") ]) %>
  <% end %>

  <p class="auth__note">Joining a team? Ask an owner for an invitation.</p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
