<% @page_title = "Two-factor sign-in" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <%= auth_card title: "One more step", hint: "Enter the 6-digit code from your authenticator app.", shake: flash[:alert] do %>
      <%= form_with url: session_two_factor_path, class: "auth__form", data: { controller: "form" } do |form| %>
        <%= form.ui :field, :code, label: "Code", description: "Lost your phone? Enter one of your recovery codes instead. If you have none, an owner can reset two-factor sign-in for you in Users." do %>
          <%= form.text_field :code, required: true, class: "auth__code", autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", placeholder: "123456", maxlength: 11 %>
        <% end %>

        <%= ui :button, type: :submit, content: "Sign in", "data-form-target": "submit", class: "auth__button" %>
      <% end %>
  <% end %>

  <p class="auth__note"><%= link_to "Start over", new_session_path %></p>
</div>
