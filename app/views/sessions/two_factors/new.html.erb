<% @page_title = "Two-factor sign-in" %>

<div class="auth">
  <section class="ui-card auth__card <%= "shake" if flash[:alert] %>">
    <header class="ui-card__header auth__header">
      <h1 class="ui-card__title auth__title">One more step</h1>
      <p class="ui-card__description">Enter the 6-digit code from your authenticator app.</p>
    </header>

    <div class="ui-card__content auth__content">
      <%= form_with url: session_two_factor_path, class: "auth__form", data: { controller: "form" } do |form| %>
        <div class="ui-field">
          <%= form.label :code, "Code", class: "ui-label" %>
          <%= form.text_field :code, required: true, class: "ui-input auth__code", autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", placeholder: "123456", maxlength: 11 %>
          <p class="ui-field__description">Lost your phone? Enter one of your recovery codes instead. If you have none, an owner can reset two-factor sign-in for you in Users.</p>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Sign in</button>
      <% end %>
    </div>
  </section>

  <p class="auth__note"><%= link_to "Start over", new_session_path %></p>
</div>
