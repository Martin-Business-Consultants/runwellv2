<% @page_title = "Sign in" %>

<div class="auth">
  <section class="ui-card auth__card">
    <header class="ui-card__header auth__header">
      <h1 class="ui-card__title auth__title">Sign in as <%= @link_user.display_name %></h1>
      <p class="ui-card__description"><%= @link_user.email_address %></p>
    </header>

    <div class="ui-card__content auth__content">
      <%= button_to "Sign in", staff_session_link_path(params[:token]), class: "ui-button ui-button--block", form_class: "auth__form" %>
    </div>
  </section>
</div>
