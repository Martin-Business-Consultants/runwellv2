<% @page_title = "Sign in" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <%= auth_card title: "Sign in as #{@link_user.display_name}", hint: @link_user.email_address do %>
      <%= button_to "Sign in", staff_session_link_path(params[:token]), class: "ui-button auth__button", data: { variant: "default", size: "default" }, form_class: "auth__form" %>
  <% end %>
</div>
