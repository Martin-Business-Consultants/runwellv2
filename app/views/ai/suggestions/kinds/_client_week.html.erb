<%# locals: (suggestion:, frame_id:) %>
<div class="ai-message"><%= ai_text(suggestion.payload["summary"]) %></div>
<div class="flex gap-half">
  <%= button_to "Save as a note", ai_suggestion_path(suggestion), method: :patch, params: { decision: "accept" }, class: "btn btn--link txt-small", form: { data: { turbo_frame: "_top" } } %>
  <button type="button" class="btn txt-small" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="<%= suggestion.payload["summary"] %>" data-copy-to-clipboard-success-class="btn--reversed" data-action="copy-to-clipboard#copy">Copy</button>
  <%= render "ai/suggestions/dismiss", suggestion: suggestion, frame_id: frame_id %>
</div>
