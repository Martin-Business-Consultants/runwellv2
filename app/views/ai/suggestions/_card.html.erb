<%# locals: (kind:, subject:, suggestion: nil, row: nil) %>
<%# A suggestion from the in-app AI on a record (Ai::Suggestions): the button that asks for one,
    then, in the same frame, the suggestion as it's made and used. row: in a list, where the card
    starts as just its button (no lookup per row). %>
<% definition = Ai::Suggestions.find(kind) %>
<% record_ref = subject.is_a?(User) ? "User:me" : (subject.is_a?(Engagement) ? "Engagement:#{subject.ref}" : "#{subject.class.name}:#{subject.id}") %>
<% frame_id = "ai_" + kind + "_" + dom_id(subject) %>
<turbo-frame id="<%= frame_id %>" class="ai-suggestion">
  <% if suggestion.nil? || suggestion.state.in?(%w[accepted dismissed]) || (suggestion.state == "working" && !suggestion.working?) %>
    <%= button_to ai_suggestions_path, params: { kind: kind, record: record_ref, row: row }, class: "btn txt-small ai-suggestion__ask", form: { data: { turbo_frame: frame_id } } do %>
      <%= icon_tag "ai" %> <span><%= definition.label %></span>
    <% end %>
  <% elsif suggestion.working? %>
    <p class="ai-activity ai-activity--working" data-controller="poll" data-poll-interval-value="1.5">Thinking…</p>
  <% elsif suggestion.state == "failed" %>
    <p class="txt-small txt-negative margin-none">It couldn’t: <%= suggestion.error %></p>
    <%= button_to "Try again", ai_suggestions_path, params: { kind: kind, record: record_ref, row: row }, class: "btn txt-small", form: { data: { turbo_frame: frame_id } } %>
  <% else %>
    <div class="ai-suggestion__body">
      <%= render "ai/suggestions/kinds/#{kind}", suggestion: suggestion, frame_id: frame_id %>
    </div>
  <% end %>
</turbo-frame>
