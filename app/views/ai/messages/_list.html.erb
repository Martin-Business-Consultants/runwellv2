<%# locals: (chat:, decisions_path:) %>
<%# The Ask panel's conversation: questions, replies, what the AI looked at, and changes it proposes
    with Approve and Decline. Polls while a reply is coming. %>
  <% messages = chat.ai_messages.shown.includes({ ruby_llm_tool_calls: :result }, attachments_attachments: :blob).to_a %>
  <% pending = chat.proposals.map(&:tool_call_id) %>
  <% messages.each do |message| %>
    <%# herb:key message.id %>
    <% if message.role == "user" %>
      <div class="ai-message ai-message--user"><%= message.content %><% if message.attachments.attached? %><span class="ai-message__files"><%= icon_tag "attachment" %> <%= message.attachments.map { it.filename.to_s }.to_sentence %></span><% end %></div>
    <% else %>
      <% message.ruby_llm_tool_calls.each do |tool_call| %>
        <%# herb:key tool_call.id %>
        <% if ai_proposal?(tool_call) %>
          <div class="ai-proposal">
            <p class="ai-proposal__title"><%= icon_tag "pencil" %> <strong><%= ai_activity(tool_call) %></strong></p>
            <dl class="ai-proposal__details">
              <% ai_proposal_details(tool_call).each do |label, value| %>
                <%# herb:key label %>
                <dt><%= label %></dt><dd><%= value %></dd>
              <% end %>
            </dl>
            <% if pending.include?(tool_call.tool_call_id) %>
              <div class="flex gap-half">
                <%= button_to "Approve", decisions_path, params: { tool_call_id: tool_call.tool_call_id, decision: "approve" }, class: "btn btn--link txt-small", form: { data: { turbo_frame: "ai_panel" } } %>
                <%= button_to "Decline", decisions_path, params: { tool_call_id: tool_call.tool_call_id, decision: "decline" }, class: "btn txt-small", form: { data: { turbo_frame: "ai_panel" } } %>
              </div>
            <% elsif tool_call.approval == "denied" %>
              <p class="txt-x-small txt-subtle margin-none">Declined</p>
            <% elsif tool_call.result %>
              <p class="txt-x-small margin-none"><%= icon_tag "check" %> <%= ai_result_summary(tool_call) || "Done" %></p>
            <% else %>
              <p class="txt-x-small txt-subtle margin-none">Approved, running…</p>
            <% end %>
          </div>
        <% else %>
          <p class="ai-activity"><%= ai_activity(tool_call) %></p>
        <% end %>
      <% end %>
      <% if message.content.present? %>
        <div class="ai-message ai-message--assistant"><%= ai_text(message.content) %></div>
      <% end %>
    <% end %>
  <% end %>
  <% if chat.replying? %>
    <p class="ai-activity ai-activity--working" data-controller="poll" data-poll-interval-value="1">Thinking…</p>
  <% elsif messages.none? %>
    <p class="txt-small txt-subtle">Ask about <%= chat.subject ? "this, or anything else in Runwell" : "anything in Runwell" %>: what’s happening, what’s late, what to do next. It can draft and make changes too, each one shown to you first.</p>
  <% end %>
