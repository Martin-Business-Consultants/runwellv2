<%# locals: (chat:, title:, messages_path:, new_chat_path:, new_chat_params:, prompts:, documents:, note:) %>
<%# The Ask panel's inside, for staff (ai/chats) and the client portal (portal/ai_chats): its title, the
    conversation (reloading while a reply comes), one-click questions, and the box to ask in. %>
  <div class="ai-chat">
    <header class="ai-chat__header">
      <h2 class="ai-chat__title overflow-ellipsis"><%= title %></h2>
      <%= button_to new_chat_path, params: new_chat_params, class: "btn btn--plain", title: "Start a new chat" do %>
        <%= icon_tag "add" %>
        <span class="for-screen-reader">Start a new chat</span>
      <% end %>
      <button type="button" class="btn btn--plain" data-action="dialog#close" title="Close (Esc)">
        <%= icon_tag "close" %>
        <span class="for-screen-reader">Close</span>
      </button>
    </header>

    <turbo-frame id="ai_messages" src="<%= messages_path %>" class="ai-chat__messages">
      <p class="txt-small txt-subtle">Loading…</p>
    </turbo-frame>

    <% if flash[:alert] %>
      <p class="txt-small txt-negative margin-none"><%= flash[:alert] %></p>
    <% end %>

    <% if chat.ai_messages.none? %>
      <div class="ai-chat__prompts">
        <% prompts.each do |prompt| %>
          <%# herb:key prompt %>
          <%= button_to prompt, messages_path, params: { message: { content: prompt } }, class: "btn txt-small ai-chat__prompt" %>
        <% end %>
      </div>
    <% end %>

    <% if chat.proposals.any? %>
      <p class="txt-small txt-subtle margin-none">Approve or decline the change above, and it carries on.</p>
    <% else %>
    <%= form_with url: messages_path, scope: :message, class: "ai-chat__form", data: { controller: "form" } do |form| %>
      <div class="ai-chat__compose">
        <%= form.text_area :content, rows: 2, required: true, class: "input ai-chat__input", placeholder: "Ask, or ask it to do something…", autofocus: true,
              aria: { label: "Your question" }, data: { action: "keydown.meta+enter->form#submit keydown.ctrl+enter->form#submit" } %>
        <% if documents.any? %>
          <details class="ai-chat__documents txt-x-small">
            <summary class="txt-subtle"><%= icon_tag "attachment" %> Include documents</summary>
            <% documents.each do |document| %>
              <%# herb:key document.id %>
              <label class="ai-suggestion__pick"><%= check_box_tag "message[document_ids][]", document.id, false, id: nil %> <span class="overflow-ellipsis"><%= document.filename %></span></label>
            <% end %>
          </details>
        <% end %>
      </div>
      <button type="submit" class="btn btn--link txt-small" data-form-target="submit">Send</button>
    <% end %>
    <% end %>
    <p class="ai-chat__note txt-x-small txt-subtle margin-none"><%= note %></p>
  </div>
