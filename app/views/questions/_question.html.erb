<%# locals: (question:) %>
<%# A question for a person: what's asked and where it came from, Dismiss as a close button in
    the top right, then one-tap choices and a field to type an answer, sent with the arrow in it. %>
<div class="question">
  <div class="question__text txt-align-start">
    <strong><%= question.text %></strong>
    <div class="txt-x-small txt-subtle">
      Asked by <%= question.asked_by %> · <%= question.source %>
      <% if question.subject.is_a?(Engagement) || question.subject.is_a?(Client) %>
        · <%= link_to question_subject_label(question.subject), question.subject, class: "txt-link" %>
      <% end %>
    </div>
    <% if question.context.present? %>
      <div class="txt-x-small txt-subtle"><%= simple_format question.context %></div>
    <% end %>
  </div>

  <%= button_to dismiss_question_path(question), class: "btn btn--plain question__dismiss", form_class: "question__dismiss-form", title: "Dismiss" do %>
    <%= icon_tag "close" %>
    <span class="for-screen-reader">Dismiss this question</span>
  <% end %>

  <div class="question__answers">
    <% question.choices.each do |choice| %>
      <%# herb:key choice %>
      <%= button_to choice, answer_question_path(question), params: { answer: choice }, class: "btn txt-small" %>
    <% end %>

    <%= form_with url: answer_question_path(question), class: "input-action" do |form| %>
      <%= form.text_field :answer, required: true, class: "input txt-small", autocomplete: "off", placeholder: "Or type an answer", aria: { label: "Answer" } %>
      <button type="submit" class="btn btn--plain input-action__submit" title="Send answer">
        <%= icon_tag "arrow-right" %>
        <span class="for-screen-reader">Send answer</span>
      </button>
    <% end %>
  </div>
</div>
