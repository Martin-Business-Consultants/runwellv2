<%# locals: (commitment:) %>
<%# One commitment as a row of the Commitments table (open lanes and resolved alike). %>
<tr data-filter-target="item">
  <%= bulk_select_cell commitment, commitment.description.truncate(40) %>
  <td><%= commitment_sentence(commitment) %></td>
  <td class="txt-nowrap"><%= l commitment.due_on, format: :short %></td>
  <td class="txt-subtle">
    <%= link_to commitment.client.name, commitment.client, class: "txt-ink" %><% if commitment.engagement %> · <%= link_to commitment.engagement.ref, commitment.engagement, class: "txt-ink" %><% end %>
  </td>
  <td><%= status_tag(commitment.overdue? ? "Overdue" : (commitment.resolution&.humanize || "Open"), highlight: commitment.resolution == "done") %></td>
  <td>
    <% if commitment.open? %>
      <details>
        <summary class="btn txt-x-small">Resolve</summary>
        <%= form_with url: resolve_commitment_path(commitment), class: "flex flex-wrap align-center gap-half txt-small margin-block-start-half", data: { controller: "form" } do |form| %>
          <%= form.text_field :note, class: "input", autocomplete: "off", placeholder: "Note (optional)" %>
          <button type="submit" name="resolution" value="done" class="btn btn--link">Done</button>
          <button type="submit" name="resolution" value="missed" class="btn">Missed</button>
          <button type="submit" name="resolution" value="dropped" class="btn">Dropped</button>
        <% end %>
      </details>
    <% end %>
  </td>
  <%= render "layouts/shared/row_actions", name: "this #{term(:commitment).downcase}", edit_path: (edit_commitment_path(commitment) if commitment.open?), delete_path: (commitment_path(commitment) if commitment.open?) %>
</tr>
