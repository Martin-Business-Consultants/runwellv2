<%# locals: (commitment:, with_context: nil) %>
<li data-filter-target="item" class="flex flex-column gap-half">
  <div class="flex align-center gap-half">
    <div class="txt-align-start overflow-ellipsis min-width">
      <strong><%= commitment.description %></strong>
      <div class="txt-x-small txt-subtle"><%= commitment_details(commitment, with_context: with_context) %></div>
    </div>

    <% if commitment.overdue? %>
      <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
      <%= status_tag "Overdue", highlight: true %>
    <% elsif !commitment.open? %>
      <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
      <%= status_tag commitment.resolution.humanize, highlight: commitment.resolution == "done" %>
    <% end %>
  </div>

  <% if commitment.resolution_note.present? %>
    <div class="txt-x-small txt-subtle txt-align-start"><%= commitment.resolution_note %></div>
  <% end %>

  <% if commitment.open? %>
    <details class="txt-align-start">
      <summary class="btn txt-x-small">Resolve</summary>
      <%= form_with url: resolve_commitment_path(commitment), class: "flex flex-wrap align-center gap-half txt-small", data: { controller: "form" } do |form| %>
        <%= form.text_field :note, class: "input flex-item-grow", autocomplete: "off", placeholder: "Note (optional)" %>
        <button type="submit" name="resolution" value="done" class="btn btn--link">Done</button>
        <button type="submit" name="resolution" value="missed" class="btn">Missed</button>
        <button type="submit" name="resolution" value="dropped" class="btn">Dropped</button>
      <% end %>
    </details>
  <% end %>
</li>
