<%# locals: (subject:) %>
<section class="settings__section" id="commitments">
  <header>
    <h2 class="divider">Commitments</h2>
  </header>

  <% open_commitments = subject.commitments.open.ordered.includes(:client, :user, :contact) %>
  <ul class="settings__scrollable-list">
    <% open_commitments.each do |commitment| %>
      <%# herb:key commitment.id %>
      <%= render "commitments/commitment", commitment: commitment %>
    <% end %>
  </ul>

  <% if open_commitments.none? %>
    <p class="txt-subtle txt-small margin-none">No open commitments.</p>
  <% end %>

  <% resolved = subject.commitments.where.not(resolution: nil).order(resolved_at: :desc).includes(:client, :user, :contact) %>
  <% if resolved.any? %>
    <details class="txt-small txt-align-start">
      <summary class="txt-subtle"><%= pluralize resolved.size, "resolved commitment" %></summary>
      <ul class="settings__scrollable-list">
        <% resolved.each do |commitment| %>
          <%# herb:key commitment.id %>
          <%= render "commitments/commitment", commitment: commitment %>
        <% end %>
      </ul>
    </details>
  <% end %>

  <% client = subject.is_a?(Client) ? subject : subject.client %>
  <details class="section-actions">
    <summary class="btn txt-small"><%= icon_tag "add" %> Add a commitment</summary>
    <%= form_with model: Commitment.new, url: subject.is_a?(Client) ? client_commitments_path(subject) : engagement_commitments_path(subject),
          class: "flex flex-column gap txt-small", data: { controller: "form" } do |form| %>
      <%= form.text_field :description, required: true, class: "input full-width", autocomplete: "off", placeholder: "Who will do what…" %>
      <div class="flex flex-wrap gap-half">
        <%= date_input form, :due_on, required: true, class: "input flex-item-grow", aria: { label: "Due" } %>
        <%= form.select :owner, grouped_options_for_select(commitment_owner_options(client), "us"), {}, class: "input input--select flex-item-grow", aria: { label: "Owner" } %>
        <%= form.text_field :source, class: "input flex-item-grow", autocomplete: "off", placeholder: "Source, e.g. call 24 Sep" %>
      </div>
      <div class="flex gap-half justify-center">
        <button type="submit" class="btn btn--link">Add commitment</button>
      </div>
    <% end %>
  </details>
</section>
