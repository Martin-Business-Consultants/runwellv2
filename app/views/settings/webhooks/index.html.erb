<% @page_title = "Webhooks" %>
<%= render "settings/header", current: :webhooks %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Webhooks</h2>
      <p class="settings-section__description">
        Send each event (a <%= term(:client).downcase %> added, a piece of work closed, <%= term(:task, count: 2).downcase %> done…) as JSON to another tool: Zapier, Make, n8n, a spreadsheet script, your own server.
        Each request is signed with the endpoint’s secret: <code>X-Runwell-Signature</code> is <code>sha256=</code> and the HMAC-SHA256 of <code>X-Runwell-Timestamp</code>, a dot, and the body.
        Failed deliveries are retried for about a day; twenty failures in a row switch an endpoint off.
      </p>
    </header>

    <% if @endpoints.empty? %>
      <%= render "layouts/shared/empty", text: "No webhooks yet. Add one below." %>
    <% end %>

    <% @endpoints.each do |endpoint| %>
      <%# herb:key endpoint.id %>
      <% hint = capture do %>
        <code><%= endpoint.url %></code><br>
        <%= endpoint.kinds.present? ? endpoint.kinds_text : "Every event" %><%= ", with sign-in and security" if endpoint.include_security? %>
        <% if endpoint.failures_in_a_row.positive? %> · <%= pluralize(endpoint.failures_in_a_row, "failure") %> in a row<% end %>
      <% end %>
      <% actions = capture do %>
        <% if endpoint.active? %>
          <%= ui :badge, variant: :success, content: "On" %>
        <% else %>
          <%= ui :badge, variant: :destructive, content: "Off" %>
        <% end %>
        <%= render "layouts/shared/delete_dialog", name: "this webhook", path: settings_webhook_path(endpoint), message: "Events stop going to #{endpoint.url}." %>
      <% end %>
      <%= ui :card, id: dom_id(endpoint), class: "settings-webhook", title: tag.h3(endpoint.description.presence || endpoint.url, class: "settings-webhook__title"), description: hint, action: actions do %>
          <%= form_with model: endpoint, url: settings_webhook_path(endpoint), method: :patch, namespace: dom_id(endpoint), class: "settings-form" do |form| %>
            <%= form.ui :field, :secret, label: "Secret" do %>
              <%= secret_field form, :secret, readonly: true %>
            <% end %>
            <%= form.ui :field, :kinds_text, label: "Only these kinds" do %>
              <%= form.text_field :kinds_text, placeholder: "Blank for every event, or e.g. work.closed, task.*", autocomplete: "off" %>
            <% end %>
            <%= form.ui :checkbox, :include_security, label: "Include sign-ins and security changes" %>
            <%= form.ui :checkbox, :active, label: "On" %>
            <div class="settings-buttons">
              <%= ui :button, type: :submit, size: :sm, content: "Save" %>
              <%= ui :button, type: :submit, variant: :outline, size: :sm, content: "Send a test", name: "ping", value: "1" %>
            </div>
          <% end %>
          <% deliveries = @deliveries[endpoint.id] || [] %>
          <% if deliveries.any? %>
            <%= ui :table, class: "settings-table" do %>
                <thead><tr><th>When</th><th>Event</th><th data-grow>Result</th><th data-align="end">Tries</th></tr></thead>
                <tbody>
                  <% deliveries.each do |delivery| %>
                    <%# herb:key delivery.id %>
                    <tr>
                      <td><%= l delivery.created_at, format: :short %></td>
                      <td><code><%= delivery.kind %></code></td>
                      <td data-grow>
                        <% if delivery.ok? %>
                          <%= ui :badge, variant: :success, content: delivery.status_code.to_s %> <span class="settings-table__muted"><%= delivery.duration_ms %> ms</span>
                        <% elsif delivery.attempts.zero? %>
                          <%= ui :badge, variant: :warning, content: "Queued" %>
                        <% else %>
                          <%= ui :badge, variant: :destructive, content: (delivery.status_code || "Failed").to_s %> <span class="settings-table__muted"><%= delivery.error %></span>
                        <% end %>
                      </td>
                      <td data-align="end"><%= delivery.attempts %></td>
                    </tr>
                  <% end %>
                </tbody>
            <% end %>
          <% end %>
      <% end %>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Add a webhook</h2>
      <p class="settings-section__description">Event kinds are listed in the <%= link_to "plugin contract", "https://github.com/Martin-Business-Consultants/runwellv2/blob/main/docs/plugin-contract.md#events", target: "_blank", rel: "noopener" %>; sign-in ones in the audit log.</p>
    </header>
    <%= form_with model: @endpoint, url: settings_webhooks_path, class: "settings-form" do |form| %>
      <%= form.ui :field, :url, label: "Address" do %>
        <%= form.url_field :url, placeholder: "https://hooks.example.com/runwell", required: true, autocomplete: "off" %>
      <% end %>
      <%= form.ui :field, :description, label: "Name", description: "Optional." do %>
        <%= form.text_field :description, placeholder: "Zapier: closed work to the sales sheet", autocomplete: "off" %>
      <% end %>
      <%= form.ui :field, :kinds_text, label: "Only these kinds", description: "Optional: blank sends every event." do %>
        <%= form.text_field :kinds_text, placeholder: "Blank for every event, or e.g. work.closed, task.*", autocomplete: "off" %>
      <% end %>
      <%= form.ui :checkbox, :include_security, label: "Include sign-ins and security changes" %>
      <div><%= ui :button, type: :submit, content: "Add webhook" %></div>
    <% end %>
  </section>
</div>
