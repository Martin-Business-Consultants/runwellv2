<% @page_title = "Plugins" %>
<%= render "settings/header", current: :plugins %>

<turbo-frame id="plugins" target="_top">
  <div class="settings-page">
    <% if @change %>
      <section class="settings-section" data-controller="poll" data-action="turbo:frame-missing@document->poll#keep">
        <header class="settings-section__head">
          <h2><%= @change.summary %></h2>
        </header>
        <p>
          Started <%= time_ago_in_words(@change.created_at) %> ago<% if @change.requested_by %> by <%= person_tag @change.requested_by %><% end %>.
          Runwell restarts when it’s in place, which takes a few seconds. This page checks every few seconds.
        </p>
      </section>
    <% end %>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Installed plugins</h2>
        <p class="settings-section__description">Plugins add to Runwell without changing it. They live on this server, outside Runwell itself, so they stay through updates; each updates only when you press its Update button. Runwell comes with none, and a plugin starts off: switch it on here. Switching one off hides everything it adds and keeps its data.</p>
        <div class="settings-section__actions">
          <%= button_to settings_plugins_check_path, class: "ui-button", data: { variant: "outline", size: "sm" } do %>
            <%= icon_tag "refresh" %>
            <span>Check for updates</span>
          <% end %>
        </div>
      </header>

      <% if @plugins.any? %>
        <ul class="settings-plugins">
          <% @plugins.each do |plugin| %>
            <%# herb:key plugin.key %>
            <%= render "settings/plugins/plugin", plugin: plugin, enabled: Runwell::Plugins.enabled?(plugin.key) %>
          <% end %>
        </ul>
      <% else %>
        <%= render "layouts/shared/empty", text: "No plugins installed yet. Add one below." %>
      <% end %>

      <% InstalledPlugins.failed.each do |name, error| %>
        <%# herb:key name %>
        <p class="settings-error"><strong><%= name %></strong> is installed but didn’t load: <%= error %></p>
      <% end %>
    </section>

    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Add a plugin</h2>
        <p class="settings-section__description">By its GitHub repository, as owner/repo. Runwell installs its latest release; it starts off until you switch it on above.</p>
      </header>

      <%= form_with url: settings_plugins_installations_path do |form| %>
        <%= form.ui :field, :repo, label: "GitHub repository" do %>
          <div class="settings-inline">
            <%= form.text_field :repo, placeholder: "owner/runwell-thing", autocomplete: "off", required: true %>
            <%= ui :button, type: :submit, content: "Install" %>
          </div>
        <% end %>
      <% end %>
    </section>

    <% if @changes.any? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>Recent changes</h2>
        </header>
        <ul class="settings-list settings-list--scroll">
          <% @changes.each do |change| %>
            <%# herb:key change.id %>
            <li class="settings-item">
              <% if change.requested_by %>
                <div class="settings-item__media"><%= person_tag change.requested_by %></div>
              <% end %>
              <div class="settings-item__content">
                <p class="settings-item__title"><%= change.summary %> <%= ui_status_badge change.status %></p>
                <p class="settings-item__desc"><%= time_ago_in_words(change.created_at) %> ago</p>
                <% if change.message.present? %>
                  <pre class="settings-log"><%= change.message %></pre>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</turbo-frame>
