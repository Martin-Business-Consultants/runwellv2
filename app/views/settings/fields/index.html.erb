<% @page_title = "Fields" %>
<% tabs = CustomField::MODELS.map { record_tab(it.underscore, custom_field_model_name(it, count: 2), count: @fields.fetch(it, []).size) } %>
<% tab = current_record_tab(tabs, tabs.first.key) %>
<%= render "settings/header", current: :fields %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Fields</h2>
      <p class="settings-section__description">What you record beyond the basics, like a property address or a matter number. Fields are information only: nothing in Runwell acts on them. Every field is optional. Archiving one hides it and keeps its values.</p>
    </header>
  </section>

  <turbo-frame id="record_tab" class="settings-tabs" target="_top">
    <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
    <div class="settings-tabs__panel">
  <% CustomField::MODELS.select { it.underscore == tab }.each do |model| %>
    <%# herb:key model %>
    <% fields = @fields.fetch(model, []) %>
    <section class="settings-section">
      <header class="settings-section__head">
        <h2><%= custom_field_model_name(model, count: 2) %></h2>
        <div class="settings-section__actions">
          <%= ui :badge, variant: :outline, content: pluralize(fields.size, "field") %>
        </div>
      </header>

      <% if fields.any? %>
        <%# Dragged by the handle into a new place (the core's drag-and-drop controller, sortable:
            each drop posts the field it now sits before). Archived fields stay where they are. %>
        <ul class="settings-list settings-fields" data-controller="drag-and-drop"
          data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= settings_field_position_path("__id__") %>"
          data-drag-and-drop-dragged-item-class="drag-and-drop__dragged-item" data-drag-and-drop-hover-container-class="drag-and-drop__hover-container"
          data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
          <% fields.each do |field| %>
            <%# herb:key field.id %>
            <li class="settings-item settings-field" data-filter-target="item"<% unless field.archived? %> data-drag-and-drop-target="item" data-id="<%= field.id %>"<% end %>>
              <% if field.archived? %>
                <span class="settings-field__handle settings-field__handle--off" aria-hidden="true"></span>
              <% else %>
                <span class="settings-field__handle" draggable="true" title="Drag to move <%= field.label %>" aria-label="Drag to move <%= field.label %>"><%= icon_tag "move" %></span>
              <% end %>
              <div class="settings-item__content">
                <p class="settings-item__title">
                  <%= field.label %>
                  <% if field.archived? %>
                    <%= ui :badge, variant: :secondary, content: "Archived" %>
                  <% end %>
                </p>
                <p class="settings-item__desc"><%= field.kind_label %> · <code><%= field.key %></code><%= " · " + field.choices.join(", ") if field.kind == "choice" %><%= " · listed" if field.listed %><%= " · shown to " + term(:client, count: 2).downcase if field.client_visible %></p>
              </div>
              <div class="settings-item__actions">
                <% if field.archived? %>
                  <%= button_to "Restore", settings_field_path(field), method: :patch, params: { field: { archived: false } }, class: "ui-button", data: { variant: "outline", size: "sm" } %>
                <% else %>
                  <%= render "layouts/shared/delete_dialog", name: field.label, path: settings_field_path(field),
                        message: "It’s archived: hidden from forms, pages and agents, with its values kept. You can restore it." %>
                <% end %>
              </div>
              <% unless field.archived? %>
                <details class="settings-fold settings-field__change">
                  <summary class="ui-button" data-variant="outline" data-size="sm">Change</summary>
                  <%= form_with model: field, url: settings_field_path(field), method: :patch, scope: :field, namespace: dom_id(field), class: "settings-subform" do |form| %>
                    <%= form.ui :field, :label, label: "Label" do %>
                      <%= form.text_field :label, required: true, autocomplete: "off" %>
                    <% end %>
                    <% if field.kind == "choice" %>
                      <%= form.ui :field, :choices, label: "Choices", description: "Separated by commas." do %>
                        <%= form.text_field :choices, value: field.choices.join(", "), autocomplete: "off" %>
                      <% end %>
                    <% end %>
                    <%= form.ui :checkbox, :listed, label: "A column in the #{custom_field_model_name(model, count: 2).downcase} table" %>
                    <%= form.ui :checkbox, :client_visible, label: "Shown to the #{term(:client).downcase} in the portal" %>
                    <%= field_visibility_inputs "field[visible_to][]", field %>
                    <div><%= ui :button, type: :submit, size: :sm, content: "Save" %></div>
                  <% end %>
                </details>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "layouts/shared/empty", text: "No fields yet." %>
      <% end %>

      <details class="settings-fold">
        <summary class="ui-button" data-variant="outline" data-size="sm"><%= icon_tag "add" %> Add a field</summary>
        <%= form_with url: settings_fields_path, scope: :field, namespace: "new_#{model.downcase}", class: "settings-subform" do |form| %>
          <%= form.hidden_field :model_type, value: model %>
          <div class="form-grid">
            <%= form.ui :field, :label, label: "Label" do %>
              <%= form.text_field :label, required: true, autocomplete: "off", placeholder: "Property address" %>
            <% end %>
            <%= form.ui :field, :kind, label: "Kind" do %>
              <%= form.select :kind, CustomField::KINDS.map { [ CustomField::KIND_LABELS[it], it ] }, {} %>
            <% end %>
          </div>
          <%= form.ui :field, :choices, label: "Choices", description: "For a choice field, separated by commas. The kind can’t change once the field has values." do %>
            <%= form.text_field :choices, autocomplete: "off", placeholder: "Small, Medium, Large" %>
          <% end %>
          <%= form.ui :checkbox, :listed, label: "A column in the #{custom_field_model_name(model, count: 2).downcase} table" %>
          <%= form.ui :checkbox, :client_visible, label: "Shown to the #{term(:client).downcase} in the portal" %>
          <%= field_visibility_inputs "field[visible_to][]", CustomField.new, namespace: "new_#{model.downcase}" %>
          <div><%= ui :button, type: :submit, size: :sm, content: "Add field" %></div>
        <% end %>
      </details>
    </section>
  <% end %>
    </div>
  </turbo-frame>
</div>
