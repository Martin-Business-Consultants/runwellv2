<% @page_title = "Appearance" %>
<% tabs = [
     record_tab("style", "Style"),
     record_tab("brand", "Logo and favicon"),
     record_tab("css", "Custom CSS")
   ] %>
<% tab = current_record_tab(tabs, "style") %>
<%= render "settings/header", current: :appearance %>

<div class="settings-page">
  <turbo-frame id="record_tab" class="settings-tabs" target="_top">
    <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
    <div class="settings-tabs__panel">
      <% case tab %>
      <% when "style" %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Appearance</h2>
      <p class="settings-section__description">How Runwell looks for everyone: the theme, colors, corners, font and text size. A choice shows at once and saves itself.</p>
    </header>

    <%= form_with model: @setting, url: settings_appearance_path, method: :patch, class: "settings-form", data: { controller: "appearance" } do |form| %>
      <fieldset class="settings-fieldset">
        <legend class="field__label">Theme</legend>
        <p class="field__hint">Where everyone starts. Anyone can still flip it with the sun and moon in the menu; picking one here also resets yours.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :theme, choices: Setting::THEMES, current: @setting.theme, mock: true %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="field__label">Color</legend>
        <p class="field__hint">The accent on buttons, links, switches and the current item.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :scheme, choices: Setting::SCHEMES, current: @setting.scheme, sample_class: "appearance-swatch" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="field__label">Corners</legend>
        <p class="field__hint">How round cards, buttons and fields are.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :radius, choices: Setting::RADII, current: @setting.radius, sample_class: "appearance-corner" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="field__label">Font</legend>
        <p class="field__hint">Fonts already on each device: nothing is downloaded.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :font, choices: Setting::FONTS, current: @setting.font, sample_class: "appearance-font" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="field__label">Text size</legend>
        <p class="field__hint">Where everyone starts. Each person can choose their own in Settings › Your account.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :text_size, choices: Setting::TEXT_SIZES, current: @setting.text_size, sample_class: "appearance-size" %>
      </fieldset>
    <% end %>
  </section>

      <% when "brand" %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Logo and favicon</h2>
      <p class="settings-section__description">Your own marks in place of Runwell’s. Dropping an image saves it.</p>
    </header>
    <% [ [ :logo, "Logo", "Shown in the menu in place of the Runwell name. A wide PNG or SVG works best." ],
         [ :favicon, "Favicon", "The icon in the browser tab. A square PNG, at least 64 pixels." ] ].each do |attribute, title, hint| %>
      <%# herb:key attribute %>
      <% file = @setting.public_send(attribute) %>
      <div class="field">
        <span class="field__label"><%= title %></span>
        <p class="field__hint"><%= hint %></p>

        <% if file.attached? %>
          <div class="settings-upload__current">
            <% upload_class = "appearance-upload appearance-upload--" + attribute.to_s %>
            <%= image_tag rails_blob_path(file, disposition: :inline), alt: title, class: upload_class %>
            <%= button_to "Remove", settings_appearance_path, method: :patch, params: { remove: attribute }, class: "btn btn--danger btn--sm" %>
          </div>
        <% end %>

        <%= form_with model: @setting, url: settings_appearance_path, method: :patch, multipart: true, data: { controller: "form" } do |form| %>
          <label class="settings-upload">
            <%= icon_tag "picture-add" %>
            <span><%= file.attached? ? "Replace" : "Drop an image here or choose…" %></span>
            <%= form.file_field attribute, accept: "image/png, image/svg+xml, image/jpeg, image/webp, image/x-icon", data: { action: "change->form#submit" } %>
          </label>
        <% end %>
      </div>
    <% end %>
  </section>
      <% when "css" %>
  <section class="settings-section" id="custom-css">
    <header class="settings-section__head">
      <h2>Custom CSS</h2>
      <p class="settings-section__description">
        Make Runwell your own by giving its design tokens new values: colors, fonts, corners, spacing.
        Copy the brief, paste it into any AI with your logo or website, and paste its answer here. The rules are in
        <%= link_to "the theming guide", "https://github.com/Martin-Business-Consultants/runwellv2/blob/main/docs/theming.md", target: "_blank", rel: "noopener" %>.
        Add <code>?theme=off</code> to any address to see a page without it.
      </p>
      <div class="settings-section__actions">
        <button type="button" class="btn btn--secondary btn--sm" data-controller="copy-to-clipboard" data-copy-to-clipboard-url-value="<%= settings_theme_brief_path(format: :text) %>" data-copy-to-clipboard-success-class="settings-copied" data-action="copy-to-clipboard#copy">
          <%= icon_tag "ai" %> <span>Copy brief for AI</span>
        </button>
      </div>
    </header>
    <% if @setting.errors[:custom_css].any? %>
      <p class="settings-error">Custom CSS <%= @setting.errors[:custom_css].to_sentence %>. Nothing was saved.</p>
    <% end %>
    <%= form_with model: @setting, url: settings_appearance_path, method: :patch, namespace: "custom_css" do |form| %>
      <%= form.text_area :custom_css, class: "settings-css", rows: 12, spellcheck: false, autocomplete: "off", placeholder: ":root {\n  --lch-accent: 58% 0.14 40;\n  --radius-scale: 1.4;\n}", aria: { label: "Custom CSS" } %>
      <label class="checkbox">
        <%= form.check_box :custom_css_everywhere %>
        <span>Use it on <%= term(:client).downcase %> pages too: the portal</span>
      </label>
      <div><button type="submit" class="btn btn--primary">Save CSS</button></div>
    <% end %>
  </section>

      <% end %>
    </div>
  </turbo-frame>
</div>
