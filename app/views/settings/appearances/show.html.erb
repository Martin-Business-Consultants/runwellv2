<% @page_title = "Appearance" %>
<%= render "settings/header", current: :appearance %>

<section class="settings">
  <div class="settings__panel">
    <section class="settings__section">
      <header class="settings__heading">
        <h2>Appearance</h2>
        <p class="settings__description">How Runwell looks for everyone: the theme, colors, corners, font and text size. A choice shows at once and saves itself.</p>
      </header>

      <%= form_with model: @setting, url: settings_appearance_path, method: :patch, class: "settings__form", data: { controller: "appearance" } do |form| %>
        <fieldset class="settings__fieldset">
          <legend class="ui-label">Theme</legend>
          <p class="ui-field__description">Where everyone starts. Anyone can still flip it with the sun and moon in the menu; picking one here also resets yours.</p>
          <%= render "settings/appearances/choices", form: form, attribute: :theme, choices: Setting::THEMES, current: @setting.theme, mock: true %>
        </fieldset>

        <fieldset class="settings__fieldset">
          <legend class="ui-label">Color</legend>
          <p class="ui-field__description">The accent on buttons, links, switches and the current item.</p>
          <%= render "settings/appearances/choices", form: form, attribute: :scheme, choices: Setting::SCHEMES, current: @setting.scheme, sample_class: "appearance-swatch" %>
        </fieldset>

        <fieldset class="settings__fieldset">
          <legend class="ui-label">Corners</legend>
          <p class="ui-field__description">How round cards, buttons and fields are.</p>
          <%= render "settings/appearances/choices", form: form, attribute: :radius, choices: Setting::RADII, current: @setting.radius, sample_class: "appearance-corner" %>
        </fieldset>

        <fieldset class="settings__fieldset">
          <legend class="ui-label">Font</legend>
          <p class="ui-field__description">Fonts already on each device: nothing is downloaded.</p>
          <%= render "settings/appearances/choices", form: form, attribute: :font, choices: Setting::FONTS, current: @setting.font, sample_class: "appearance-font" %>
        </fieldset>

        <fieldset class="settings__fieldset">
          <legend class="ui-label">Text size</legend>
          <p class="ui-field__description">Where everyone starts. Each person can choose their own in Settings › Your account.</p>
          <%= render "settings/appearances/choices", form: form, attribute: :text_size, choices: Setting::TEXT_SIZES, current: @setting.text_size, sample_class: "appearance-size" %>
        </fieldset>
      <% end %>
    </section>

    <section class="settings__section" id="custom-css">
      <header class="settings__heading">
        <h2>Custom CSS</h2>
        <p class="settings__description">
          Make Runwell your own by giving its design tokens new values: colors, fonts, corners, spacing.
          Copy the brief, paste it into any AI with your logo or website, and paste its answer here. The rules are in
          <%= link_to "the theming guide", "https://github.com/Martin-Business-Consultants/runwellv2/blob/main/docs/theming.md", class: "txt-link", target: "_blank", rel: "noopener" %>.
          Add <code>?theme=off</code> to any address to see a page without it.
        </p>
        <div class="settings__heading-actions">
          <button type="button" class="ui-button ui-button--outline ui-button--sm" data-controller="copy-to-clipboard" data-copy-to-clipboard-url-value="<%= settings_theme_brief_path(format: :text) %>" data-copy-to-clipboard-success-class="settings-copied" data-action="copy-to-clipboard#copy">
            <%= icon_tag "ai" %> <span>Copy brief for AI</span>
          </button>
        </div>
      </header>
      <% if @setting.errors[:custom_css].any? %>
        <p class="settings__error">Custom CSS <%= @setting.errors[:custom_css].to_sentence %>. Nothing was saved.</p>
      <% end %>
      <%= form_with model: @setting, url: settings_appearance_path, method: :patch, class: "settings__form settings__form--tight", namespace: "custom_css" do |form| %>
        <%= form.text_area :custom_css, class: "ui-textarea custom-css", rows: 12, spellcheck: false, autocomplete: "off", placeholder: ":root {\n  --lch-accent: 58% 0.14 40;\n  --radius-scale: 1.4;\n}", aria: { label: "Custom CSS" } %>
        <label class="settings__check">
          <%= form.check_box :custom_css_everywhere, class: "ui-checkbox" %>
          <span>Use it on <%= term(:client).downcase %> pages too: the portal</span>
        </label>
        <div><button type="submit" class="ui-button">Save CSS</button></div>
      <% end %>
    </section>

    <section class="settings__section">
      <header class="settings__heading">
        <h2>Logo and favicon</h2>
        <p class="settings__description">Your own marks in place of Runwell’s. Dropping an image saves it.</p>
      </header>
      <% [ [ :logo, "Logo", "Shown in the menu in place of the Runwell name. A wide PNG or SVG works best." ],
           [ :favicon, "Favicon", "The icon in the browser tab. A square PNG, at least 64 pixels." ] ].each do |attribute, title, hint| %>
        <%# herb:key attribute %>
        <% file = @setting.public_send(attribute) %>
        <div class="ui-field">
          <span class="ui-label"><%= title %></span>
          <p class="ui-field__description"><%= hint %></p>

          <% if file.attached? %>
            <div class="settings__actions">
              <% upload_class = "appearance-upload appearance-upload--" + attribute.to_s %>
              <%= image_tag rails_blob_path(file, disposition: :inline), alt: title, class: upload_class %>
              <%= button_to "Remove", settings_appearance_path, method: :patch, params: { remove: attribute }, class: "ui-button ui-button--outline ui-button--sm txt-negative" %>
            </div>
          <% end %>

          <%= form_with model: @setting, url: settings_appearance_path, method: :patch, multipart: true, data: { controller: "form" } do |form| %>
            <label class="btn input--upload full-width">
              <%= icon_tag "picture-add" %>
              <span><%= file.attached? ? "Replace" : "Drop an image here or choose…" %></span>
              <%= form.file_field attribute, accept: "image/png, image/svg+xml, image/jpeg, image/webp, image/x-icon", data: { action: "change->form#submit" } %>
            </label>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</section>
