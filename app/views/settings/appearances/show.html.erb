<% @page_title = "Appearance" %>
<% tabs = [
     record_tab("style", "Style"),
     record_tab("brand", "Logo and favicon"),
     record_tab("css", "Custom CSS")
   ] %>
<% tab = current_record_tab(tabs, "style") %>
<%= render "settings/header", current: :appearance %>

<div class="settings-page">
  <turbo-frame id="record_tab" class="settings-tabs" target="_top">
    <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
    <div class="settings-tabs__panel">
      <% case tab %>
      <% when "style" %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Appearance</h2>
      <p class="settings-section__description">How Runwell looks for everyone: the theme, colors, corners, font and text size. A choice shows at once and saves itself.</p>
    </header>

    <%= form_with model: @setting, url: settings_appearance_path, method: :patch, class: "settings-form", data: { controller: "appearance", action: "change->appearance#preview" } do |form| %>
      <fieldset class="settings-fieldset">
        <legend class="settings-fieldset__legend">Theme</legend>
        <p class="settings-note">Where everyone starts. Anyone can still flip it with the sun and moon in the menu; picking one here also resets yours.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :theme, label: "Theme", choices: Setting::THEMES, current: @setting.theme, mock: true %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="settings-fieldset__legend">Color</legend>
        <p class="settings-note">The accent on buttons, links, switches and the current item.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :scheme, label: "Color", choices: Setting::SCHEMES, current: @setting.scheme, sample_class: "appearance-swatch" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="settings-fieldset__legend">Corners</legend>
        <p class="settings-note">How round cards, buttons and fields are.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :radius, label: "Corners", choices: Setting::RADII, current: @setting.radius, sample_class: "appearance-corner" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="settings-fieldset__legend">Font</legend>
        <p class="settings-note">Fonts already on each device: nothing is downloaded.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :font, label: "Font", choices: Setting::FONTS, current: @setting.font, sample_class: "appearance-font" %>
      </fieldset>

      <fieldset class="settings-fieldset">
        <legend class="settings-fieldset__legend">Text size</legend>
        <p class="settings-note">Where everyone starts. Each person can choose their own in Settings › Your account.</p>
        <%= render "settings/appearances/choices", form: form, attribute: :text_size, label: "Text size", choices: Setting::TEXT_SIZES, current: @setting.text_size, sample_class: "appearance-size" %>
      </fieldset>
    <% end %>
  </section>

      <% when "brand" %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Logo and favicon</h2>
      <p class="settings-section__description">Your own marks in place of Runwell’s. Dropping an image saves it.</p>
    </header>
    <% [ [ :logo, "Logo", "Shown in the menu in place of the Runwell name. A wide PNG or SVG works best." ],
         [ :favicon, "Favicon", "The icon in the browser tab. A square PNG, at least 64 pixels." ] ].each do |attribute, title, hint| %>
      <%# herb:key attribute %>
      <% file = @setting.public_send(attribute) %>
      <%= ui :field, label: title, description: hint, class: "settings-upload-field" do %>

        <% if file.attached? %>
          <div class="settings-upload__current">
            <% upload_class = "appearance-upload appearance-upload--" + attribute.to_s %>
            <%= image_tag rails_blob_path(file, disposition: :inline), alt: title, class: upload_class %>
            <%= button_to "Remove", settings_appearance_path, method: :patch, params: { remove: attribute }, class: "ui-button", data: { variant: "destructive", size: "sm" } %>
          </div>
        <% end %>

        <%= form_with model: @setting, url: settings_appearance_path, method: :patch, multipart: true, data: { controller: "form" } do |form| %>
          <label class="settings-upload">
            <%= icon_tag "picture-add" %>
            <span><%= file.attached? ? "Replace" : "Drop an image here or choose…" %></span>
            <%# runeui:allow native-control — invisible over the dashed drop box it sits in %>
            <%= form.file_field attribute, accept: "image/png, image/svg+xml, image/jpeg, image/webp, image/x-icon", data: { action: "change->form#submit" } %>
          </label>
        <% end %>
      <% end %>
    <% end %>
  </section>
      <% when "css" %>
  <section class="settings-section" id="custom-css">
    <header class="settings-section__head">
      <h2>Custom CSS</h2>
      <p class="settings-section__description">
        Make Runwell your own with a shadcn theme: its <code>:root</code> and <code>.dark</code> blocks of colors, fonts and corners
        (from tweakcn, ui.shadcn.com/themes, or an AI: copy the brief, paste it in with your logo or website, and paste its answer here). The rules are in
        <%= link_to "the theming guide", "https://github.com/Martin-Business-Consultants/runwellv2/blob/main/docs/theming.md", target: "_blank", rel: "noopener" %>.
        Add <code>?theme=off</code> to any address to see a page without it.
      </p>
      <div class="settings-section__actions">
        <%= ui :button, type: :button, variant: :outline, size: :sm, content: safe_join([ icon_tag("ai"), tag.span("Copy brief for AI") ], " "),
              data: { controller: "copy-to-clipboard", copy_to_clipboard_url_value: settings_theme_brief_path(format: :text), copy_to_clipboard_success_class: "settings-copied", action: "copy-to-clipboard#copy" } %>
      </div>
    </header>
    <% if @setting.errors[:custom_css].any? %>
      <p class="settings-error">Custom CSS <%= @setting.errors[:custom_css].to_sentence %>. Nothing was saved.</p>
    <% end %>
    <%= form_with model: @setting, url: settings_appearance_path, method: :patch, namespace: "custom_css" do |form| %>
      <%= form.text_area :custom_css, class: "settings-css", rows: 12, spellcheck: false, autocomplete: "off", placeholder: ":root {\n  --primary: oklch(0.58 0.14 40);\n  --radius: 0.875rem;\n}\n\n.dark {\n  --primary: oklch(0.72 0.13 45);\n}", aria: { label: "Custom CSS" } %>
      <%= form.ui :checkbox, :custom_css_everywhere, label: "Use it on #{term(:client).downcase} pages too: the portal" %>
      <div><%= ui :button, type: :submit, content: "Save CSS" %></div>
    <% end %>
  </section>

      <% end %>
    </div>
  </turbo-frame>
</div>
