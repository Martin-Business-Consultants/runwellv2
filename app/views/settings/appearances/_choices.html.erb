<%# locals: (form:, attribute:, choices:, current:, icons: nil, sample_class: nil, mock: nil, blank: nil, label: nil) %>
<%# One Appearance choice as cards: runeui's radio group (form.ui :radio_group), each radio a card
    with a preview of what it does and its name under it, the chosen one edged in the accent.
    Arrows move between them; choosing one previews it at once and saves (the appearance
    controller, on the form). blank: a first card for "" (Your account's Install default). %>
<% options = (blank ? [ [ "", blank ] ] : []) + choices.to_a %>
<% group_id = form.field_id(attribute, :choices) %>
<%= form.ui :radio_group, attribute, id: group_id, value: current.to_s, orientation: :horizontal, class: "settings-choices", aria: { label: label } do %>
  <% options.each do |value, text| %>
    <%# herb:key value %>
    <label data-slot="choice" class="settings-choice" id="<%= group_id %>-choice-<%= value.presence || "blank" %>">
      <span class="settings-choice__preview" aria-hidden="true">
        <% if value.blank? %>
          <%= icon_tag "settings-outline" %>
        <% elsif mock %>
          <% mock_class = "theme-mock theme-mock--" + value %>
          <span class="<%= mock_class %>">
            <span class="theme-mock__card"><span class="theme-mock__line theme-mock__line--short"></span><span class="theme-mock__line"></span></span>
            <span class="theme-mock__card"><span class="theme-mock__dot"></span><span class="theme-mock__line"></span></span>
            <span class="theme-mock__card"><span class="theme-mock__dot"></span><span class="theme-mock__line"></span></span>
          </span>
        <% elsif icons %>
          <%= icon_tag icons.fetch(value) %>
        <% elsif sample_class %>
          <% sample = "appearance-sample " + sample_class + "--" + value %>
          <span class="<%= sample %>">Aa</span>
        <% end %>
      </span>
      <ui-radio data-slot="radio" value="<%= value %>" class="settings-choice__radio"><ui-radio-indicator data-slot="radio-indicator"></ui-radio-indicator></ui-radio>
      <span data-slot="choice-label" class="settings-choice__label"><%= text %></span>
    </label>
  <% end %>
<% end %>
