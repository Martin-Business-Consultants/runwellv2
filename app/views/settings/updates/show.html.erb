<% @page_title = "Updates" %>
<%= render "settings/header", current: :updates %>

<turbo-frame id="updates" target="_top">
  <div class="settings-page">
    <section class="settings-section">
      <header class="settings-section__head">
        <h2>Updates</h2>
        <p class="settings-section__description">Which Runwell this is, and whether a newer release is out.</p>
        <% if @failed_count.positive? %>
          <div class="settings-section__actions">
            <%= confirm_button trigger: "Clear failed updates", title: "Clear #{pluralize(@failed_count, "failed update")}?",
                  body: "They leave Past updates, with what went wrong. Updates that worked stay.", button: "Clear",
                  path: settings_updates_failures_path, keys: nil, css: "btn btn--danger btn--sm" %>
          </div>
        <% end %>
      </header>
      <dl class="details settings-facts">
        <dt>Running</dt>
        <dd>Runwell <%= Runwell::VERSION %></dd>
        <dt>Newest release</dt>
        <dd>
          <% if @release %>
            <%= link_to "Runwell #{@release.version}", @release.url, target: "_blank", rel: "noopener" %>
            <span class="muted"><%= @release.newer? ? "(newer)" : "(up to date)" %></span>
          <% else %>
            <span class="muted">Not checked yet</span>
          <% end %>
        </dd>
        <dt>Checked</dt>
        <dd>
          <% if Release.checked_at %>
            <%= time_ago_in_words(Release.checked_at) %> ago<% if Release.checking? %>, and every night<% end %>
          <% else %>
            <span class="muted">Never</span>
          <% end %>
        </dd>
        <dt>Updates by</dt>
        <dd><%= update_method_description %></dd>
      </dl>
      <% if Release.check_pending? %>
        <p class="muted" data-controller="poll" data-poll-interval-value="2">Checking GitHub for a newer release…</p>
      <% elsif Release.check_error.present? %>
        <p class="settings-error">Couldn’t check: <%= Release.check_error %></p>
      <% end %>
      <div class="button-row">
        <%= button_to settings_updates_check_path, class: "btn btn--secondary btn--sm" do %>
          <%= icon_tag "refresh" %>
          <span>Check now</span>
        <% end %>
      </div>
    </section>

    <% if Upgrade::Hoster.placed? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>No-downtime updates</h2>
          <p class="settings-section__description">
            This install runs on KamalCloud. With a token from there, an update deploys the new release beside this one and
            switches over once it’s healthy: nobody sees an error page, and a release that can’t start never replaces this one.
          </p>
        </header>
        <% if ENV["HOSTER_TOKEN"].present? %>
          <p class="muted">Using the HOSTER_TOKEN set on KamalCloud.</p>
        <% else %>
          <%= form_with model: Setting.current, url: settings_updates_hoster_token_path, method: :patch, scope: :setting, class: "settings-form" do |form| %>
            <div class="field">
              <%= form.label :hoster_token, "KamalCloud token", class: "field__label" %>
              <%= secret_field form, :hoster_token, placeholder: "From KamalCloud, Settings > Connected apps" %>
              <p class="field__hint">An admin’s personal token from <%= link_to "KamalCloud", Upgrade::Hoster.url, target: "_blank", rel: "noopener" %> (Settings &gt; Connected apps), so it can change this app’s image and deploy it. Stored encrypted.</p>
            </div>
            <div class="button-row">
              <button type="submit" class="btn btn--primary btn--sm">Save</button>
            </div>
          <% end %>
          <% if Setting.current.hoster_token.present? %>
            <%= button_to "Remove the token", settings_updates_hoster_token_path, method: :delete, class: "btn btn--ghost btn--sm" %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <% if @upgrade %>
      <section class="settings-section" data-controller="poll" data-action="turbo:frame-missing@document->poll#keep">
        <header class="settings-section__head">
          <h2>Updating to <%= @upgrade.to_version %></h2>
        </header>
        <div class="list-row list-row--tall upgrade-status">
          <% if @upgrade.requested_by %>
            <div class="list-row__media"><%= person_tag @upgrade.requested_by %></div>
          <% end %>
          <div class="list-row__content">
            <p class="list-row__title">Started <%= time_ago_in_words(@upgrade.created_at) %> ago<% if @upgrade.requested_by %> by <%= @upgrade.requested_by.display_name %><% end %></p>
            <% if @upgrade.via == "hoster" %>
              <p class="list-row__desc">KamalCloud is starting <%= @upgrade.to_version %> beside this install. It backs up and migrates as it starts, and traffic moves to it once it’s healthy; until then <%= Runwell::VERSION %> keeps serving. This page checks every few seconds.</p>
            <% else %>
              <p class="list-row__desc">The install backs up its databases, migrates and restarts on <%= @upgrade.to_version %>; until then <%= Runwell::VERSION %> keeps running. This page checks every few seconds.</p>
            <% end %>
          </div>
        </div>
        <% if @upgrade.external_url %>
          <p><%= link_to(@upgrade.via == "hoster" ? "Follow the deploy on KamalCloud" : "Follow the deploy on GitHub", @upgrade.external_url, target: "_blank", rel: "noopener") %></p>
        <% end %>
      </section>
    <% elsif @release&.newer? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>Runwell <%= @release.version %></h2>
          <% if @release.published_at %>
            <p class="settings-section__description">Released <%= l @release.published_at.to_date, format: :long %>.</p>
          <% end %>
        </header>
        <% if @release.notes.present? %>
          <div class="settings-notes"><%= simple_format @release.notes %></div>
        <% end %>

        <% if Upgrade.available? %>
          <p class="muted">
            Runwell backs up its databases, updates and restarts. It’s unavailable for a minute or two; nobody is signed out.
            If anything fails, <%= Runwell::VERSION %> keeps running and this page says why.
          </p>
          <div class="button-row"><%= button_to "Update to " + @release.version, settings_updates_path, class: "btn btn--primary" %></div>
        <% else %>
          <p>Updating from here isn’t set up on this install. On the server:</p>
          <%= code_block manual_update_command(@release) %>
          <p class="muted">
            Runwell updates itself from here when it runs in its Docker image (from 2.0.3 on: deploy once more to get there) or from a checkout made by <code>bin/install</code>. See <code>docs/install.md</code>.
          </p>
        <% end %>
      </section>
    <% end %>

    <% if @upgrades.any? %>
      <section class="settings-section">
        <header class="settings-section__head">
          <h2>Past updates</h2>
        </header>
        <div class="table-wrap settings-table">
          <table class="table">
            <thead>
              <tr>
                <th>Update</th>
                <th>Status</th>
                <th>By</th>
                <th>When</th>
                <th><span class="visually-hidden">Deploy log</span></th>
              </tr>
            </thead>
            <tbody>
              <% @upgrades.each do |upgrade| %>
                <%# herb:key upgrade.id %>
                <tr>
                  <td class="nowrap"><strong><%= upgrade.from_version %> → <%= upgrade.to_version %></strong></td>
                  <td><%= ui_status_badge upgrade.status %></td>
                  <td><%= person_tag upgrade.requested_by, fallback: "Runwell" %></td>
                  <td class="muted nowrap"><time datetime="<%= upgrade.created_at.iso8601 %>" title="<%= l upgrade.created_at, format: :long %>"><%= time_ago_in_words(upgrade.created_at) %> ago</time></td>
                  <td class="settings-table__end">
                    <% if upgrade.external_url %>
                      <%= link_to "Deploy log", upgrade.external_url, target: "_blank", rel: "noopener" %>
                    <% end %>
                  </td>
                </tr>
                <% if upgrade.message.present? %>
                  <tr class="settings-table__detail">
                    <td colspan="5"><pre class="settings-log"><%= upgrade.message %></pre></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
</turbo-frame>
