<% @page_title = "Roles" %>
<%= render "settings/header", current: :roles %>

<section class="settings">
  <div class="settings__panel">
    <section class="settings__section">
      <header class="settings__heading">
        <h2>What each role can do</h2>
        <p class="settings__description">Everyone is an owner, a manager or a member. Change someone’s role on their page in Users.</p>
      </header>
      <dl class="settings-roles">
        <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
          <%# herb:key role %>
          <dt><%= role.capitalize %></dt>
          <dd><%= description %></dd>
        <% end %>
      </dl>
    </section>

    <section class="settings__section">
      <header class="settings__heading">
        <h2>Permissions</h2>
        <p class="settings__description">Everyone can work on <%= term(:client, count: 2).downcase %>, <%= term(:engagement, count: 2).downcase %>, <%= term(:work).downcase %>, notes and documents. Plugins that are on add their own permissions here.</p>
      </header>
      <div class="settings-table">
        <table class="ui-table people__permissions">
          <thead>
            <tr><th>Permission</th><% User::ROLES.each do |role| %><%# herb:key role %><th class="txt-align-center"><%= role.capitalize %></th><% end %></tr>
          </thead>
          <tbody>
            <% User.permissions.each do |key, permission| %>
              <%# herb:key key %>
              <tr>
                <td><%= permission[:name] %></td>
                <% User::ROLES.each do |role| %>
                  <%# herb:key role %>
                  <td class="txt-align-center">
                    <% if permission[:roles].include?(role) %>
                      <%= icon_tag "check" %><span class="for-screen-reader">Yes</span>
                    <% else %>
                      <span class="txt-subtle">—</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</section>
