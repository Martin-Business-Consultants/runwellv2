<% @page_title = "Roles" %>
<%= render "settings/header", current: :roles %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>What each role can do</h2>
      <p class="settings-section__description">Everyone is an owner, a manager or a member. Change someone’s role on their page in Users.</p>
    </header>
    <dl class="settings-roles">
      <% User::ROLE_DESCRIPTIONS.each do |role, description| %>
        <%# herb:key role %>
        <dt><%= role.capitalize %></dt>
        <dd><%= description %></dd>
      <% end %>
    </dl>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Permissions</h2>
      <p class="settings-section__description">Everyone can work on <%= term(:client, count: 2).downcase %>, <%= term(:work, count: 2).downcase %>, <%= term(:task, count: 2).downcase %>, notes and documents. Plugins that are on add their own permissions here.</p>
    </header>
    <%= ui :table, class: "settings-table" do %>
        <thead>
          <tr><th data-grow>Permission</th><% User::ROLES.each do |role| %><%# herb:key role %><th data-align="center"><%= role.capitalize %></th><% end %></tr>
        </thead>
        <tbody>
          <% User.permissions.each do |key, permission| %>
            <%# herb:key key %>
            <tr>
              <td data-grow><%= permission[:name] %></td>
              <% User::ROLES.each do |role| %>
                <%# herb:key role %>
                <td data-align="center">
                  <% if permission[:roles].include?(role) %>
                    <%= icon_tag "check" %><span class="visually-hidden">Yes</span>
                  <% else %>
                    <span class="settings-dash">—</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
    <% end %>
  </section>
</div>
