<% @page_title = "Set up two-factor sign-in" %>
<%= render "settings/header", current: :account %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Set up two-factor sign-in</h2>
      <p class="settings-section__description">After your password, Runwell will ask for a code from an app on your phone, so a stolen password isn’t enough to get in.</p>
    </header>
    <ol class="settings-steps">
      <li>Open an authenticator app: 1Password, Google Authenticator, Microsoft Authenticator, Authy or your phone’s built-in passwords app.</li>
      <li class="settings-steps__step">
        <span>Scan this code with it.</span>
        <div class="settings-steps__qr"><%= @qr_code %></div>
        <details class="settings-steps__key">
          <summary>Can’t scan? Enter this key instead</summary>
          <code><%= @secret.scan(/.{4}/).join(" ") %></code>
        </details>
      </li>
      <li>
        <%= form_with url: settings_two_factor_path, data: { controller: "form" } do %>
          <%= ui :field, label: "Enter the 6-digit code it shows." do %>
            <div class="settings-inline settings-inline--fit">
              <%= ui :otp_input, name: "code", id: "code", groups: [ 3, 3 ], required: true, autofocus: true, aria: { label: "The 6-digit code" } %>
              <%= ui :button, type: :submit, content: "Turn on" %>
            </div>
          <% end %>
        <% end %>
      </li>
    </ol>
    <% if Setting.current.require_two_factor? && can?(:manage_people) %>
      <%= form_with model: Setting.current, url: settings_two_factor_requirement_path, method: :patch do |form| %>
        <%= form.hidden_field :require_two_factor, value: "0" %>
        <p class="settings-note">This install requires two-factor sign-in. Changed your mind? <%= ui :button, type: :submit, variant: :link, size: :sm, content: "Stop requiring it", class: "settings-link" %></p>
      <% end %>
    <% end %>
  </section>
</div>
