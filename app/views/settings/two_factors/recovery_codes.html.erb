<% @page_title = "Recovery codes" %>
<%= render "settings/header", current: :account %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Save your recovery codes</h2>
      <p class="settings-section__description">If you lose your phone, each of these signs you in once in place of a code. Keep them somewhere safe, like your password manager.</p>
    </header>
    <div class="alert alert--attention" role="status">
      <%= icon_tag "lock", class: "alert__icon" %>
      <p class="alert__title">They won’t be shown again.</p>
    </div>
    <%= code_block @recovery_codes.join("\n"), language: "plain" %>
    <div class="button-row">
      <%= link_to "I’ve saved them", settings_account_path, class: "btn btn--primary" %>
    </div>
  </section>
</div>
