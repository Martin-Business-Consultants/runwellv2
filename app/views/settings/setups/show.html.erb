<% @page_title = "Setup" %>
<%= render "settings/header", current: :setup %>
<% setup = @setup %>

<div class="settings-page">
  <section class="settings-section setup">
    <header class="settings-section__head">
      <h2>Get set up</h2>
      <p class="settings-section__description">Each step checks itself off once it’s done.</p>
      <div class="settings-section__actions">
        <%= badge "#{setup.done_count} of #{setup.steps.size} done", tone: :outline %>
      </div>
    </header>

    <ol class="settings-list">
      <% setup.steps.each do |step| %>
        <%# herb:key step.key %>
        <li class="list-row">
          <div class="list-row__media">
            <% if step.done %>
              <span class="settings-setup__check settings-setup__check--done" aria-hidden="true"><%= icon_tag "check" %></span>
            <% else %>
              <span class="settings-setup__check" aria-hidden="true"></span>
            <% end %>
          </div>
          <div class="list-row__content">
            <% if step.done %>
              <p class="list-row__title settings-setup__title--done"><%= step.title %><span class="visually-hidden">(done)</span></p>
            <% else %>
              <p class="list-row__title">
                <%= link_to step.title, step.path %>
                <% if step.optional %>
                  <%= badge "Optional", tone: :neutral %>
                <% end %>
              </p>
              <p class="list-row__desc"><%= step.text %></p>
            <% end %>
          </div>
          <% unless step.done %>
            <div class="list-row__actions">
              <%= link_to step.path, class: "icon-button", title: step.title, tabindex: -1, aria: { hidden: true } do %>
                <%= icon_tag "arrow-right" %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ol>
  </section>
</div>
