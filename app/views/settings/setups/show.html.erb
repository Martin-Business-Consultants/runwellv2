<% @page_title = "Setup" %>
<%= render "settings/header", current: :setup %>
<% setup = @setup %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start settings__section setup">
    <header>
      <h2 class="divider">Get set up <span class="txt-subtle"><%= setup.done_count %> of <%= setup.steps.size %></span></h2>
    </header>
    <p class="txt-small txt-subtle margin-none">Each step checks itself off once it’s done.</p>

    <ol class="setup__steps">
      <% setup.steps.each do |step| %>
        <%# herb:key step.key %>
        <li class="setup__step flex align-start gap-half">
          <% if step.done %>
            <span class="setup__check setup__check--done" aria-hidden="true"><%= icon_tag "check" %></span>
          <% else %>
            <span class="setup__check" aria-hidden="true"></span>
          <% end %>
          <div class="min-width flex-item-grow">
            <% if step.done %>
              <span class="txt-subtle setup__title--done"><%= step.title %></span>
              <span class="for-screen-reader">(done)</span>
            <% else %>
              <%= link_to step.title, step.path, class: "setup__link font-weight-bold" %>
              <% if step.optional %>
                <span class="txt-x-small txt-subtle">optional</span>
              <% end %>
              <div class="txt-x-small txt-subtle"><%= step.text %></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  </div>
</section>
