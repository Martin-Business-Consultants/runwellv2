<% @page_title = "Views" %>
<%= render "settings/header", current: :views %>

<section class="settings">
  <div class="settings__panel">
    <section class="settings__section">
      <header class="settings__heading">
        <h2>How lists open</h2>
        <p class="settings__description">
          <%= term(:client, count: 2) %>, <%= term(:engagement, count: 2).downcase %>, <%= term(:work).downcase %> and requests open as cards or as a table.
          Anyone can switch a list with its View menu; this sets where it starts.
        </p>
      </header>

      <%= form_with url: settings_views_path, method: :patch, data: { controller: "form" } do %>
        <fieldset class="settings__fieldset">
          <legend class="ui-label">Default view</legend>
          <div class="settings-choices settings-choices--wide">
            <label class="settings-choice">
              <span class="settings-choice__preview" aria-hidden="true"><%= icon_tag "grid" %></span>
              <span class="settings-choice__label">Cards</span>
              <%= radio_button_tag :index_view, "cards", @setting.index_view == "cards", data: { action: "change->form#submit" } %>
            </label>
            <label class="settings-choice">
              <span class="settings-choice__preview" aria-hidden="true"><%= icon_tag "column-left" %></span>
              <span class="settings-choice__label">Table</span>
              <%= radio_button_tag :index_view, "table", @setting.index_view == "table", data: { action: "change->form#submit" } %>
            </label>
          </div>
        </fieldset>
      <% end %>
    </section>
  </div>
</section>
