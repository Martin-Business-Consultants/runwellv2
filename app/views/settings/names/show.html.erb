<% @page_title = "Names" %>
<%= render "settings/header", current: :names %>

<%= form_with url: settings_names_path, method: :patch, class: "settings-page", data: { controller: "form" } do %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>What things are called</h2>
      <p class="settings-section__description">Use your own words for the core things. Leave a field blank to keep the default.</p>
    </header>

    <div class="stack settings-form">
      <% Setting::TERMS.each do |key| %>
        <%# herb:key key %>
        <% field = "terminology[" + key + "]" %>
        <div class="field">
          <span class="field__label"><%= t("terms.#{key}.one") %></span>
          <div class="field-row">
            <%= text_field_tag field + "[one]", @setting.terminology.dig(key, "one"), id: "terminology_#{key}_one", placeholder: t("terms.#{key}.one"), autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", singular" } %>
            <%= text_field_tag field + "[other]", @setting.terminology.dig(key, "other"), id: "terminology_#{key}_other", placeholder: t("terms.#{key}.other"), autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", plural" } %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2><%= term(:engagement) %> types</h2>
      <p class="settings-section__description">Each type has its own name and ref prefix. A new prefix applies to new refs only; existing refs keep theirs. Switch off a type you don’t use.</p>
    </header>

    <div class="stack">
      <div class="settings-names__type settings-names__type--head" aria-hidden="true">
        <span>Use</span><span>Singular</span><span>Plural</span><span>Prefix</span>
      </div>
      <% Engagement::LABELS.each do |label| %>
        <%# herb:key label %>
        <% field = "terminology[labels][" + label + "]" %>
        <% id = "terminology_labels_" + label %>
        <div class="settings-names__type">
          <%= switch_tag(title: "Use this type", screen_reader_label: "Use #{t("terms.labels.#{label}.one")}") { hidden_field_tag(field + "[enabled]", "0", id: id + "_enabled_off") + check_box_tag(field + "[enabled]", "1", @setting.label_enabled?(label), id: id + "_enabled", role: "switch") } %>
          <%= text_field_tag field + "[one]", @setting.terminology.dig("labels", label, "one"), id: id + "_one", placeholder: t("terms.labels.#{label}.one"), autocomplete: "off", aria: { label: "Singular" } %>
          <%= text_field_tag field + "[other]", @setting.terminology.dig("labels", label, "other"), id: id + "_other", placeholder: t("terms.labels.#{label}.other"), autocomplete: "off", aria: { label: "Plural" } %>
          <%= text_field_tag field + "[prefix]", @setting.terminology.dig("labels", label, "prefix"), id: id + "_prefix", placeholder: t("terms.labels.#{label}.prefix"), autocomplete: "off", maxlength: 4, aria: { label: "Ref prefix" } %>
        </div>
      <% end %>
    </div>
  </section>

  <div><button type="submit" class="btn btn--primary" data-form-target="submit">Save names</button></div>
<% end %>
