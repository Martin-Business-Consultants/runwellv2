<% @page_title = "Names" %>
<%= render "settings/header", current: :names %>

<section class="settings">
  <div class="settings__panel">
    <%= form_with url: settings_names_path, method: :patch, class: "settings__panel", data: { controller: "form" } do %>
      <section class="settings__section">
        <header class="settings__heading">
          <h2>What things are called</h2>
          <p class="settings__description">Use your own words for the core things. Leave a field blank to keep the default.</p>
        </header>

        <div class="settings__form">
          <% Setting::TERMS.each do |key| %>
            <%# herb:key key %>
            <% field = "terminology[" + key + "]" %>
            <div class="ui-field">
              <span class="ui-label"><%= t("terms.#{key}.one") %></span>
              <div class="settings__row">
                <%= text_field_tag field + "[one]", @setting.terminology.dig(key, "one"), id: nil, placeholder: t("terms.#{key}.one"), class: "ui-input", autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", singular" } %>
                <%= text_field_tag field + "[other]", @setting.terminology.dig(key, "other"), id: nil, placeholder: t("terms.#{key}.other"), class: "ui-input", autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", plural" } %>
              </div>
            </div>
          <% end %>
        </div>
      </section>

      <section class="settings__section">
        <header class="settings__heading">
          <h2><%= term(:engagement) %> types</h2>
          <p class="settings__description">Each type has its own name and ref prefix. A new prefix applies to new refs only; existing refs keep theirs. Switch off a type you don’t use.</p>
        </header>

        <div class="settings__form settings__form--tight">
          <div class="settings-names__type settings__note" aria-hidden="true">
            <span>Use</span><span>Singular</span><span>Plural</span><span>Prefix</span>
          </div>
          <% Engagement::LABELS.each do |label| %>
            <%# herb:key label %>
            <% field = "terminology[labels][" + label + "]" %>
            <div class="settings-names__type">
              <%= switch_tag(title: "Use this type", screen_reader_label: "Use #{t("terms.labels.#{label}.one")}") { hidden_field_tag(field + "[enabled]", "0", id: nil) + check_box_tag(field + "[enabled]", "1", @setting.label_enabled?(label), class: "switch__input", id: nil) } %>
              <%= text_field_tag field + "[one]", @setting.terminology.dig("labels", label, "one"), id: nil, placeholder: t("terms.labels.#{label}.one"), class: "ui-input", autocomplete: "off", aria: { label: "Singular" } %>
              <%= text_field_tag field + "[other]", @setting.terminology.dig("labels", label, "other"), id: nil, placeholder: t("terms.labels.#{label}.other"), class: "ui-input", autocomplete: "off", aria: { label: "Plural" } %>
              <%= text_field_tag field + "[prefix]", @setting.terminology.dig("labels", label, "prefix"), id: nil, placeholder: t("terms.labels.#{label}.prefix"), class: "ui-input names-prefix", autocomplete: "off", maxlength: 4, aria: { label: "Ref prefix" } %>
            </div>
          <% end %>
        </div>
      </section>

      <div><button type="submit" class="ui-button" data-form-target="submit">Save names</button></div>
    <% end %>
  </div>
</section>
