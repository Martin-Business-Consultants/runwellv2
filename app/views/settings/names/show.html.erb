<% @page_title = "Names" %>
<% tabs = [
     record_tab("things", "Things"),
     record_tab("types", term(:work) + " types")
   ] %>
<% tab = current_record_tab(tabs, "things") %>
<%= render "settings/header", current: :names %>

<div class="settings-page">
  <turbo-frame id="record_tab" class="settings-tabs" target="_top">
    <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
    <div class="settings-tabs__panel">
      <% case tab %>
      <% when "things" %>
<%= form_with url: settings_names_path, method: :patch, class: "settings-form", data: { controller: "form" } do %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>What things are called</h2>
      <p class="settings-section__description">Use your own words for the core things. Leave a field blank to keep the default.</p>
    </header>

    <div class="stack settings-form">
      <% Setting::TERMS.each do |key| %>
        <%# herb:key key %>
        <% field = "terminology[" + key + "]" %>
        <div class="field">
          <span class="field__label"><%= t("terms.#{key}.one") %></span>
          <div class="field-row">
            <%= ui :input, name: field + "[one]", value: @setting.terminology.dig(key, "one"), id: "terminology_#{key}_one", placeholder: t("terms.#{key}.one"), autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", singular" } %>
            <%= ui :input, name: field + "[other]", value: @setting.terminology.dig(key, "other"), id: "terminology_#{key}_other", placeholder: t("terms.#{key}.other"), autocomplete: "off", aria: { label: t("terms.#{key}.one") + ", plural" } %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <div><button type="submit" class="btn btn--primary" data-form-target="submit">Save names</button></div>
<% end %>
      <% when "types" %>
  <section class="settings-section">
    <header class="settings-section__head">
      <h2><%= term(:work) %> types</h2>
      <p class="settings-section__description">The kinds of <%= term(:work, count: 2).downcase %> you run: each with its own name, ref prefix and way of running. New <%= term(:work).downcase %> starts as its type says. A new prefix applies to new refs only. <%= WorkType.cached.select(&:system?).map(&:name_one).to_sentence %> are always there: switch off any you don’t use.</p>
      <div class="settings-section__actions">
        <span class="badge badge--outline"><%= pluralize(@work_types.count { !it.archived? }, "type") %> in use</span>
      </div>
    </header>

    <%# Dragged by the handle into a new place (the core's drag-and-drop controller, sortable: each
        drop posts the type it now sits before). The order is the pickers' and filters'. %>
    <ul class="settings-list settings-fields" data-controller="drag-and-drop"
      data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= settings_work_type_position_path("__id__") %>"
      data-drag-and-drop-dragged-item-class="drag-and-drop__dragged-item" data-drag-and-drop-hover-container-class="drag-and-drop__hover-container"
      data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
      <%= render partial: "settings/work_types/work_type", collection: @work_types, as: :work_type, locals: { others: @work_types } %>
    </ul>

    <details class="settings-fold">
      <summary class="ui-button" data-variant="outline" data-size="sm"><%= icon_tag "add" %> Add a type</summary>
      <%= form_with model: WorkType.new, url: settings_work_types_path, scope: :work_type, namespace: "new_work_type", class: "settings-subform" do |form| %>
        <div class="field-row">
          <div class="field">
            <%= form.label :name_one, "Name", class: "field__label" %>
            <%= form.text_field :name_one, required: true, autocomplete: "off", placeholder: "Retainer", maxlength: 40 %>
          </div>
          <div class="field">
            <%= form.label :name_other, "Plural", class: "field__label" %>
            <%= form.text_field :name_other, autocomplete: "off", placeholder: "Retainers", maxlength: 40 %>
          </div>
          <div class="field">
            <%= form.label :prefix, "Ref prefix", class: "field__label" %>
            <%= form.text_field :prefix, required: true, autocomplete: "off", placeholder: "R", maxlength: 4 %>
          </div>
        </div>
        <div class="field">
          <%= form.label :description, "What it’s for", class: "field__label" %>
          <%= form.text_field :description, autocomplete: "off", placeholder: "A monthly arrangement for ongoing help" %>
        </div>
        <div class="field-row">
          <div class="field">
            <%= form.label :shape, "Runs as", class: "field__label" %>
            <%= form.select :shape, WorkType::SHAPES.invert.to_a, {} %>
          </div>
          <div class="field">
            <%= form.label :cadence, "How often", class: "field__label" %>
            <%= form.select :cadence, Cadence.options, { include_blank: "No set period" } %>
          </div>
        </div>
        <label class="checkbox">
          <%= form.check_box :check_in %>
          <span>A check-in each period: a task repeating for whoever starts the <%= term(:work).downcase %>, to look back on the period just gone (recurring only)</span>
        </label>
        <div class="field">
          <%= form.label :starting_sections, "Starts with these " + term(:scope_item, count: 2).downcase, class: "field__label" %>
          <%= form.text_field :starting_sections, autocomplete: "off", placeholder: "Monthly report, Requests" %>
          <p class="field__hint">Separated by commas. Leave blank to start with none.</p>
        </div>
        <div><button type="submit" class="btn btn--primary btn--sm">Add type</button></div>
      <% end %>
    </details>
  </section>
      <% end %>
    </div>
  </turbo-frame>
</div>
