<% @page_title = "Address" %>
<%= render "settings/header", current: :address %>

<div class="settings-page">
  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Where people reach Runwell</h2>
      <p class="settings-section__description">
        Every link Runwell sends points here: portal sign-ins, invitations and notifications.
        Use the address your team and <%= term(:client, count: 2).downcase %> type to open it.
      </p>
    </header>
    <% if !Runwell.host_set? %>
      <% not_set = capture do %>Links use <%= Runwell.url %><% if Setting.current.seen_host.blank? %>, which nobody else can open<% else %>, the address you’ve been using<% end %>. Save it below to keep it.<% end %>
      <%= ui :alert, variant: :warning, icon: :info, title: "Not set yet", description: not_set, role: "status" %>
    <% end %>

    <%= form_with model: @setting, url: settings_address_path, method: :patch do |form| %>
      <% hint = ENV["APP_HOST"].present? ? "The server’s APP_HOST is #{ENV["APP_HOST"]}; the address saved here takes its place." : nil %>
      <%= form.ui :field, :app_url, label: "Runwell’s address", description: hint do %>
        <div class="settings-inline">
          <%= form.ui :input, :app_url, type: :url, value: (Runwell.url unless Runwell.host == "localhost"), placeholder: "https://#{request.host}", required: true, autocomplete: "off" %>
          <%= ui :button, content: "Save", type: :submit %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section class="settings-section" id="time_zone">
    <header class="settings-section__head">
      <h2>Your time zone</h2>
      <p class="settings-section__description">
        Times on your pages, in emails and in what agents read are shown here. A <%= term(:client).downcase %> in another zone can have its own; theirs is used in their portal and emails.
      </p>
    </header>
    <%= form_with model: @setting, url: settings_address_path, method: :patch, namespace: "zone" do |form| %>
      <% us = ActiveSupport::TimeZone.us_zones %>
      <% zones = { "United States" => us.map { [ it.to_s, it.name ] }, "Everywhere else" => (ActiveSupport::TimeZone.all - us).map { [ it.to_s, it.name ] } } %>
      <% unsaved = @setting.time_zone.blank? ? "Not saved yet: #{Setting.zone.name} is the #{ENV["TIME_ZONE"].present? ? "server’s TIME_ZONE" : "default"}." : nil %>
      <%= form.ui :field, :time_zone, label: "Time zone", description: unsaved do %>
        <div class="settings-inline">
          <%= form.ui :combobox, :time_zone, options: zones, value: (@setting.time_zone.presence || Setting.zone.name), placeholder: "Search time zones" %>
          <%= ui :button, content: "Save", type: :submit %>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
