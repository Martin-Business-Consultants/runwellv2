<%# locals: (event:) %>
<%# One event in the audit log's table (layouts/shared/_list_table). %>
<tr data-filter-target="item">
  <td data-column="when" title="<%= event.occurred_at.utc.iso8601 %>"><%= l event.occurred_at, format: :short %></td>
  <td data-column="what"><%= event_title(event) %></td>
  <td data-column="who"><%= event.actor_name %><% if event.source == "agent" %> <span class="muted"><%= event.source_label %></span><% end %></td>
  <td data-column="on"><%= audit_subject_name(event) %></td>
  <td class="muted list-table__wrap" data-column="details" data-grow><%= event_details(event) %></td>
</tr>
