<% @page_title = "Email" %>
<%= render "settings/header", current: :email %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Who mail comes from</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        The sender on every email Runwell sends: approval links, portal sign-ins, invitations and notifications.
        Use an address on a domain your mail server can send for, or mail lands in spam.
        Leave a field blank to use <%= Setting.default_mail_sender %>.
      </p>

      <%= form_with model: @setting, url: settings_email_path, method: :patch, class: "flex flex-column gap txt-small" do |form| %>
        <div class="flex flex-wrap gap-half">
          <label class="flex flex-column gap-half flex-item-grow">
            <span class="font-weight-bold">From name</span>
            <%= form.text_field :mail_from_name, class: "input full-width", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).display_name %>
          </label>
          <label class="flex flex-column gap-half flex-item-grow">
            <span class="font-weight-bold">From email</span>
            <%= form.email_field :mail_from_email, class: "input full-width", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).address %>
          </label>
        </div>
        <button type="submit" class="btn btn--link center">Save</button>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">How it goes out</h2>
      </header>
      <p class="txt-small margin-none">
        <% if ActionMailer::Base.delivery_method == :letter_opener_web %>
          In development, mail opens in <%= link_to "letter_opener", "/letter_opener", class: "txt-link" %> instead of being sent.
        <% elsif Setting.smtp_from_environment? %>
          Through the mail server at <%= ENV["SMTP_ADDRESS"] %>, from the server’s SMTP settings.
        <% elsif @setting.smtp_address.present? %>
          Through the mail server at <%= @setting.smtp_address %>, saved below.
        <% else %>
          No mail server yet, so mail isn’t sent. Give one below, or let a plugin such as Outsend send it (<%= link_to "Plugins", settings_plugins_path, class: "txt-link" %>).
        <% end %>
        <% if Setting.smtp_from_environment? || @setting.smtp_address.present? %>
          A plugin such as Outsend, when it’s on, sends instead.
        <% end %>
      </p>

      <% unless Setting.smtp_from_environment? %>
        <%= tag.details class: "txt-align-start", open: @setting.smtp_address.blank? do %>
          <summary class="btn txt-small"><%= @setting.smtp_address.present? ? "Change the mail server" : "Add a mail server" %></summary>
          <%= form_with model: @setting, url: settings_email_smtp_path, method: :patch, scope: :smtp, class: "flex flex-column gap txt-small margin-block-start" do |form| %>
            <div class="flex flex-wrap gap-half">
              <label class="flex flex-column gap-half flex-item-grow">
                <span class="font-weight-bold">Server</span>
                <%= form.text_field :smtp_address, value: @setting.smtp_address, class: "input full-width", autocomplete: "off", placeholder: "smtp.example.com" %>
              </label>
              <label class="flex flex-column gap-half">
                <span class="font-weight-bold">Port</span>
                <%= form.number_field :smtp_port, value: @setting.smtp_port, class: "input", placeholder: "587", min: 1, max: 65535 %>
              </label>
              <label class="flex flex-column gap-half">
                <span class="font-weight-bold">Security</span>
                <%= form.select :smtp_security, Setting::SMTP_SECURITIES.invert, { selected: @setting.smtp_security }, class: "input input--select" %>
              </label>
            </div>
            <div class="flex flex-wrap gap-half">
              <label class="flex flex-column gap-half flex-item-grow">
                <span class="font-weight-bold">Username</span>
                <%= form.text_field :smtp_username, value: @setting.smtp_username, class: "input full-width", autocomplete: "off" %>
              </label>
              <label class="flex flex-column gap-half flex-item-grow">
                <span class="font-weight-bold">Password</span>
                <%= secret_field form, :smtp_password, placeholder: (@setting.smtp_password.present? ? "Saved: leave blank to keep it" : "") %>
              </label>
            </div>
            <span class="txt-x-small txt-subtle">The password is stored encrypted. Save, then send a test email below to check it.</span>
            <button type="submit" class="btn btn--link center">Save</button>
          <% end %>
        <% end %>
      <% end %>

      <%= form_with url: settings_email_test_message_path, class: "flex flex-wrap align-center gap-half txt-small" do |form| %>
        <%= form.email_field :to, value: Current.user.email_address, class: "input", autocomplete: "off", placeholder: "you@example.com" %>
        <button type="submit" class="btn">
          <%= icon_tag "paper-plane" %>
          <span>Send a test email</span>
        </button>
      <% end %>

      <%# The test message is sent from a job (TestEmailJob); this frame reloads until it's gone or failed. %>
      <turbo-frame id="test_email">
        <% test = @setting.test_email %>
        <% if test["error"].present? %>
          <p class="txt-small txt-negative margin-none">Couldn’t send to <%= test["to"] %>: <%= test["error"] %></p>
        <% elsif test["sent_at"].present? %>
          <p class="txt-small txt-subtle margin-none">Sent a test email to <%= test["to"] %> <%= time_ago_in_words(Time.zone.parse(test["sent_at"])) %> ago.</p>
        <% elsif test["requested_at"].present? && Time.zone.parse(test["requested_at"]) > 5.minutes.ago %>
          <p class="txt-small txt-subtle margin-none" data-controller="poll" data-poll-interval-value="2">Sending a test email to <%= test["to"] %>…</p>
        <% end %>
      </turbo-frame>
    </section>

    <section class="settings__section flex flex-column gap" id="requests_by_email">
      <header>
        <h2 class="divider"><%= term(:client, count: 2) %> email requests</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        Mail sent to this address becomes a request to triage: the subject is its title, the message its description (without the quoted mail and signature), and attachments its documents.
        A known contact gets a short reply saying it came in; their replies to that land on the same request as notes. Automatic replies are ignored.
      </p>

      <%= form_with model: @setting, url: settings_email_path, method: :patch, namespace: "requests", class: "flex flex-wrap align-end gap-half txt-small" do |form| %>
        <label class="flex flex-column gap-half flex-item-grow">
          <span class="font-weight-bold">Requests address</span>
          <%= form.email_field :requests_email, class: "input full-width", autocomplete: "off", placeholder: "requests@yourcompany.com" %>
        </label>
        <button type="submit" class="btn btn--link">Save</button>
      <% end %>

      <% ingress = Setting.inbound_ingress %>
      <% if ingress %>
        <p class="txt-small margin-none">
          <%= status_tag "Receiving" %>
          Mail comes in through <%= inbound_ingress_name(ingress) %>. Forward the requests address there (plus addresses too, for replies), to:
        </p>
        <%= code_block inbound_ingress_url(ingress) %>
        <p class="txt-small txt-subtle margin-none"><%= inbound_ingress_secret_hint(ingress) %> See <code>docs/install.md</code>.</p>
      <% else %>
        <p class="txt-small margin-none">
          <%= status_tag "Off" %>
          Runwell can’t receive mail on its own: a service (Cloudflare Email Routing, Postmark, SendGrid) or your own mail server forwards the address here.
          Choose it below, or let a plugin set it up.
        </p>
      <% end %>

      <%= plugin_slots(:email_inbound) %>

      <% unless Setting.inbound_from_environment? %>
        <%= form_with url: settings_email_inbound_path, method: :patch, scope: :inbound, class: "flex flex-wrap align-end gap-half txt-small" do |form| %>
          <label class="flex flex-column gap-half">
            <span class="font-weight-bold">Comes in through</span>
            <%= form.select :ingress, [ [ "Nothing yet", "" ], [ "Relay (Cloudflare Email Routing, your mail server)", "relay" ], [ "Postmark", "postmark" ], [ "SendGrid", "sendgrid" ] ], { selected: @setting.inbound_ingress.to_s }, class: "input input--select" %>
          </label>
          <button type="submit" class="btn btn--link">Save</button>
        <% end %>
        <% if @setting.inbound_password.present? %>
          <%= form_with model: @setting, url: settings_email_path, class: "flex flex-column gap-half txt-small" do |form| %>
            <span class="font-weight-bold">Password</span>
            <%= secret_field form, :inbound_password, readonly: true %>
            <span class="txt-x-small txt-subtle">The service signs in with it as <code>actionmailbox</code>. It was made for this install; it isn’t shown anywhere else.</span>
          <% end %>
        <% end %>
      <% end %>
    </section>
  </div>
</section>
