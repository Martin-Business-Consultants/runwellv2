<% @page_title = "Email" %>
<% tabs = [
     record_tab("sender", "Sender"),
     record_tab("server", "Mail server"),
     record_tab("receiving", "Receiving")
   ] %>
<% tab = current_record_tab(tabs, "sender") %>
<%= render "settings/header", current: :email %>

<section class="settings">
  <div class="settings__panel">
    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs settings-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "sender" %>
          <section class="settings__section">
            <header class="settings__heading">
              <h2>Who mail comes from</h2>
              <p class="settings__description">
                The sender on every email Runwell sends: portal sign-ins, invitations and notifications.
                Use an address on a domain your mail server can send for, or mail lands in spam.
                Leave a field blank to use <%= Setting.default_mail_sender %>.
              </p>
            </header>

            <%= form_with model: @setting, url: settings_email_path, method: :patch, class: "settings__form" do |form| %>
              <div class="settings__row">
                <div class="ui-field">
                  <%= form.label :mail_from_name, "From name", class: "ui-label" %>
                  <%= form.text_field :mail_from_name, class: "ui-input", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).display_name %>
                </div>
                <div class="ui-field">
                  <%= form.label :mail_from_email, "From email", class: "ui-label" %>
                  <%= form.email_field :mail_from_email, class: "ui-input", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).address %>
                </div>
              </div>
              <div><button type="submit" class="ui-button">Save</button></div>
            <% end %>
          </section>
          <% when "server" %>
          <section class="settings__section">
            <header class="settings__heading">
              <h2>How it goes out</h2>
              <p class="settings__description">The mail server Runwell sends through, and a test to check it.</p>
            </header>
            <p class="settings__text">
              <% if ActionMailer::Base.delivery_method == :letter_opener_web %>
                In development, mail opens in <%= link_to "letter_opener", "/letter_opener", class: "txt-link" %> instead of being sent.
              <% elsif Setting.smtp_from_environment? %>
                Through the mail server at <%= ENV["SMTP_ADDRESS"] %>, from the server’s SMTP settings.
              <% elsif @setting.smtp_address.present? %>
                Through the mail server at <%= @setting.smtp_address %>, saved below.
              <% else %>
                No mail server yet, so mail isn’t sent. Give one below, or let a plugin such as Outsend send it (<%= link_to "Plugins", settings_plugins_path, class: "txt-link" %>).
              <% end %>
              <% if Setting.smtp_from_environment? || @setting.smtp_address.present? %>
                A plugin such as Outsend, when it’s on, sends instead.
              <% end %>
            </p>

            <% unless Setting.smtp_from_environment? %>
              <%= tag.details class: "txt-align-start", open: @setting.smtp_address.blank? do %>
                <summary class="ui-button ui-button--outline ui-button--sm"><%= @setting.smtp_address.present? ? "Change the mail server" : "Add a mail server" %></summary>
                <%= form_with model: @setting, url: settings_email_smtp_path, method: :patch, scope: :smtp, class: "settings__form settings__subform" do |form| %>
                  <div class="settings__row">
                    <div class="ui-field">
                      <%= form.label :smtp_address, "Server", class: "ui-label" %>
                      <%= form.text_field :smtp_address, value: @setting.smtp_address, class: "ui-input", autocomplete: "off", placeholder: "smtp.example.com" %>
                    </div>
                    <div class="ui-field">
                      <%= form.label :smtp_port, "Port", class: "ui-label" %>
                      <%= form.number_field :smtp_port, value: @setting.smtp_port, class: "ui-input", placeholder: "587", min: 1, max: 65535 %>
                    </div>
                    <div class="ui-field">
                      <%= form.label :smtp_security, "Security", class: "ui-label" %>
                      <%= form.select :smtp_security, Setting::SMTP_SECURITIES.invert, { selected: @setting.smtp_security }, class: "ui-select" %>
                    </div>
                  </div>
                  <div class="settings__row">
                    <div class="ui-field">
                      <%= form.label :smtp_username, "Username", class: "ui-label" %>
                      <%= form.text_field :smtp_username, value: @setting.smtp_username, class: "ui-input", autocomplete: "off" %>
                    </div>
                    <div class="ui-field">
                      <%= form.label :smtp_password, "Password", class: "ui-label" %>
                      <%= secret_field form, :smtp_password, placeholder: (@setting.smtp_password.present? ? "Saved: leave blank to keep it" : "") %>
                    </div>
                  </div>
                  <p class="ui-field__description">The password is stored encrypted. Save, then send a test email below to check it.</p>
                  <div><button type="submit" class="ui-button">Save</button></div>
                <% end %>
              <% end %>
            <% end %>

            <%= form_with url: settings_email_test_message_path, class: "ui-field" do |form| %>
              <%= form.label :to, "Send a test to", class: "ui-label" %>
              <div class="settings__inline">
              <%= form.email_field :to, value: Current.user.email_address, class: "ui-input", autocomplete: "off", placeholder: "you@example.com" %>
              <button type="submit" class="ui-button ui-button--outline">
                <%= icon_tag "paper-plane" %>
                <span>Send a test email</span>
              </button>
              </div>
            <% end %>

            <%# The test message is sent from a job (TestEmailJob); this frame reloads until it's gone or failed. %>
            <turbo-frame id="test_email">
              <% test = @setting.test_email %>
              <% if test["error"].present? %>
                <p class="settings__error">Couldn’t send to <%= test["to"] %>: <%= test["error"] %></p>
              <% elsif test["sent_at"].present? %>
                <p class="settings__note">Sent a test email to <%= test["to"] %> <%= time_ago_in_words(Time.zone.parse(test["sent_at"])) %> ago.</p>
              <% elsif test["requested_at"].present? && Time.zone.parse(test["requested_at"]) > 5.minutes.ago %>
                <p class="settings__note" data-controller="poll" data-poll-interval-value="2">Sending a test email to <%= test["to"] %>…</p>
              <% end %>
            </turbo-frame>
          </section>
          <% when "receiving" %>
          <section class="settings__section" id="requests_by_email">
            <header class="settings__heading">
              <h2><%= term(:client, count: 2) %> email requests</h2>
              <p class="settings__description">
                Mail sent to this address becomes a request (work nobody has taken on yet): the subject is its title, the message its description (without the quoted mail and signature), and attachments its documents.
                A known contact gets a short reply saying it came in; their replies to that land on the same request as notes. Automatic replies are ignored.
              </p>
            </header>

            <%= form_with model: @setting, url: settings_email_path, method: :patch, namespace: "requests", class: "ui-field" do |form| %>
              <%= form.label :requests_email, "Requests address", class: "ui-label" %>
              <div class="settings__inline">
                <%= form.email_field :requests_email, class: "ui-input", autocomplete: "off", placeholder: "requests@yourcompany.com" %>
                <button type="submit" class="ui-button">Save</button>
              </div>
            <% end %>

            <% ingress = Setting.inbound_ingress %>
            <% if ingress %>
              <p class="settings__text">
                <%= ui_badge "Receiving", :positive %>
                Mail comes in through <%= inbound_ingress_name(ingress) %>. Forward the requests address there, to:
              </p>
              <%= code_block inbound_ingress_url(ingress) %>
              <p class="settings__note"><%= inbound_ingress_secret_hint(ingress) %> See <code>docs/install.md</code>.</p>
            <% else %>
              <p class="settings__text">
                <%= ui_badge "Off", :neutral %>
                Runwell can’t receive mail on its own: a service (Cloudflare Email Routing, Postmark, SendGrid) or your own mail server forwards the address here.
                Choose it below, or let a plugin set it up.
              </p>
            <% end %>

            <%= plugin_slots(:email_inbound) %>

            <% unless Setting.inbound_from_environment? %>
              <%= form_with url: settings_email_inbound_path, method: :patch, scope: :inbound, class: "ui-field" do |form| %>
                <%= form.label :ingress, "Comes in through", class: "ui-label" %>
                <div class="settings__inline">
                  <%= form.select :ingress, [ [ "Nothing yet", "" ], [ "Relay (Cloudflare Email Routing, your mail server)", "relay" ], [ "Postmark", "postmark" ], [ "SendGrid", "sendgrid" ] ], { selected: @setting.inbound_ingress.to_s }, class: "ui-select" %>
                  <button type="submit" class="ui-button">Save</button>
                </div>
              <% end %>
              <% if @setting.inbound_password.present? %>
                <%= form_with model: @setting, url: settings_email_path, class: "ui-field" do |form| %>
                  <%= form.label :inbound_password, "Password", class: "ui-label" %>
                  <%= secret_field form, :inbound_password, readonly: true %>
                  <p class="ui-field__description">The service signs in with it as <code>actionmailbox</code>. It was made for this install; it isn’t shown anywhere else.</p>
                <% end %>
              <% end %>
            <% end %>
          </section>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>
</section>
