<% @page_title = "Email" %>
<%= render "settings/header", current: :email %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Who mail comes from</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">
        The sender on every email Runwell sends: approval links, portal sign-ins, invitations and notifications.
        Use an address on a domain your mail server can send for, or mail lands in spam.
        Leave a field blank to use <%= Setting.default_mail_sender %>.
      </p>

      <%= form_with model: @setting, url: settings_email_path, method: :patch, class: "flex flex-column gap txt-small" do |form| %>
        <div class="flex flex-wrap gap-half">
          <label class="flex flex-column gap-half flex-item-grow">
            <span class="font-weight-bold">From name</span>
            <%= form.text_field :mail_from_name, class: "input full-width", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).display_name %>
          </label>
          <label class="flex flex-column gap-half flex-item-grow">
            <span class="font-weight-bold">From email</span>
            <%= form.email_field :mail_from_email, class: "input full-width", autocomplete: "off", placeholder: Mail::Address.new(Setting.default_mail_sender).address %>
          </label>
        </div>
        <button type="submit" class="btn btn--link center">Save</button>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">How it goes out</h2>
      </header>
      <p class="txt-small margin-none">
        <% case ActionMailer::Base.delivery_method %>
        <% when :smtp %>
          Through the mail server at <%= ActionMailer::Base.smtp_settings[:address] %>, from the server’s SMTP settings.
        <% when :letter_opener_web %>
          In development, mail opens in <%= link_to "letter_opener", "/letter_opener", class: "txt-link" %> instead of being sent.
        <% else %>
          The server has no SMTP settings (SMTP_ADDRESS), so mail isn’t sent.
        <% end %>
        A plugin such as Outsend can send it instead; see <%= link_to "Plugins", settings_plugins_path, class: "txt-link" %>.
      </p>

      <%= form_with url: settings_email_test_message_path, class: "flex flex-wrap align-center gap-half txt-small" do |form| %>
        <%= form.email_field :to, value: Current.user.email_address, class: "input", autocomplete: "off", placeholder: "you@agency.example" %>
        <button type="submit" class="btn">
          <%= icon_tag "paper-plane" %>
          <span>Send a test email</span>
        </button>
      <% end %>
    </section>
  </div>
</section>
