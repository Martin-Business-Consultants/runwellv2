<% @page_title = "Your account" %>
<%= render "settings/header", current: :account %>
<% install_size = Setting.current.text_size %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap-half" id="sign-in">
      <header>
        <h2 class="divider">Ways to sign in</h2>
      </header>
      <%= form_with model: @user, url: settings_passwordless_path, method: :patch, class: "record-form__toggle txt-small", data: { controller: "form" } do |form| %>
        <div class="record-form__toggle-text">
          <%= form.label :passwordless, "Sign in with an emailed link", class: "record-form__label" %>
          <span class="record-form__hint">“Email me a sign-in link” on the sign-in page sends you a link that works once, for 15 minutes. Your password keeps working too.</span>
        </div>
        <label class="switch flex-item-no-shrink">
          <%= form.check_box :passwordless, class: "switch__input", data: { action: "change->form#submit" } %>
          <span class="switch__btn"></span>
        </label>
      <% end %>
      <% providers = SignInProvider.usable_keys %>
      <% identities = @user.identities.index_by(&:provider) %>
      <% if providers.any? || identities.any? %>
        <ul class="settings__scrollable-list">
          <% (providers | identities.keys).each do |key| %>
            <%# herb:key key %>
            <% identity = identities[key] %>
            <li class="flex align-center gap-half txt-small">
              <div class="txt-align-start overflow-ellipsis min-width">
                <strong><%= SignInProvider.name_for(key) %></strong>
                <div class="txt-x-small txt-subtle overflow-ellipsis">
                  <% if identity %>
                    Connected<%= " as #{identity.email}" if identity.email.present? %><% if identity.last_used_at %> · last used <%= time_ago_in_words(identity.last_used_at) %> ago<% end %>
                  <% else %>
                    Not connected
                  <% end %>
                </div>
              </div>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <% if identity %>
                <%= render "layouts/shared/delete_dialog", name: "the connection to " + identity.provider_name, path: settings_identity_path(identity), trigger_class: "txt-small",
                      message: "You won’t be able to sign in with this account until you connect it again." %>
              <% elsif providers.include?(key) %>
                <%= button_to "Connect", "/auth/#{key}", class: "btn txt-small", data: { turbo: false } %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap-half" id="two-factor">
      <header>
        <h2 class="divider">Two-factor sign-in</h2>
      </header>
      <% if @user.two_factor? %>
        <p class="margin-none"><span class="status-tag status-tag--positive">On</span> since <%= l @user.otp_enabled_at.to_date, format: :long %>. After your password, Runwell asks for a code from your authenticator app.</p>
        <p class="txt-small txt-subtle margin-none"><%= pluralize(@user.recovery_codes_left, "recovery code") %> left.</p>
        <details>
          <summary class="btn txt-small">New recovery codes</summary>
          <%= form_with url: settings_two_factor_recovery_codes_path, class: "flex flex-wrap align-center gap-half txt-small", namespace: "recovery" do |form| %>
            <%= form.password_field :password, required: true, class: "input", autocomplete: "current-password", placeholder: "Your password", aria: { label: "Your password" } %>
            <button type="submit" class="btn btn--link">Show new codes</button>
          <% end %>
          <p class="txt-x-small txt-subtle margin-none margin-block-start-half">Your old codes stop working.</p>
        </details>
        <% if Setting.current.require_two_factor? %>
          <p class="txt-x-small txt-subtle margin-none">This install requires two-factor sign-in, so it stays on.</p>
        <% else %>
          <details>
            <summary class="btn txt-small">Turn off</summary>
            <%= form_with url: settings_two_factor_path, method: :delete, class: "flex flex-wrap align-center gap-half txt-small", namespace: "disable" do |form| %>
              <%= form.password_field :password, required: true, class: "input", autocomplete: "current-password", placeholder: "Your password", aria: { label: "Your password" } %>
              <button type="submit" class="btn txt-negative">Turn off two-factor sign-in</button>
            <% end %>
          </details>
        <% end %>
      <% else %>
        <p class="margin-none">Off. Turn it on and Runwell asks for a code from an app on your phone after your password, so a stolen password isn’t enough to get in.</p>
        <div class="section-actions">
          <%= link_to new_settings_two_factor_path, class: "btn btn--link txt-small" do %>
            <%= icon_tag "lock" %> <span>Set up two-factor sign-in</span>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Text size</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">Yours alone, on every device you sign in on. The install’s default is <%= Setting::TEXT_SIZES[install_size] %>.</p>
      <%= form_with model: @user, url: settings_account_path, method: :patch, data: { controller: "appearance", install_text_size: install_size } do |form| %>
        <div class="theme-switcher appearance-choices flex flex-wrap gap max-width justify-center txt-small">
          <label class="btn theme-switcher__btn">
            <span class="appearance-sample" aria-hidden="true"><%= icon_tag "settings" %></span>
            <span class="overflow-ellipsis">Install default</span>
            <%= form.radio_button :text_size, "", checked: @user.text_size.blank?, data: { action: "click->appearance#preview" } %>
          </label>
          <% Setting::TEXT_SIZES.each do |value, label| %>
            <%# herb:key value %>
            <label class="btn theme-switcher__btn">
              <% sample_class = "appearance-sample appearance-size--" + value %>
              <span class="<%= sample_class %>" aria-hidden="true">Aa</span>
              <span class="overflow-ellipsis"><%= label %></span>
              <%= form.radio_button :text_size, value, checked: @user.text_size == value, data: { action: "click->appearance#preview" } %>
            </label>
          <% end %>
        </div>
      <% end %>
    </section>

    <%# Your menu: the plugins that are on, in this person's order, each shown or hidden in their nav.
        One form: the switches save as they change; ↑ and ↓ move one place (User::NavPlugins). %>
    <% menu = @user.person.ordered_nav_items(Runwell::Plugins.enabled_nav_items) %>
    <section class="settings__section flex flex-column gap-half" id="menu">
      <header>
        <h2 class="divider">Your menu</h2>
      </header>
      <p class="txt-small txt-subtle margin-none">Which plugins show in the menu on the left, and in what order: yours alone. The first shown is <kbd>g</kbd> <kbd>1</kbd>, the next <kbd>g</kbd> <kbd>2</kbd>, and so on.</p>
      <% if menu.empty? %>
        <p class="txt-small txt-subtle margin-none">No plugin with a page is switched on.</p>
      <% else %>
        <%= form_with url: settings_menu_path, method: :patch, class: "menu-arranger", data: { controller: "form" } do %>
          <ul class="settings__scrollable-list menu-arranger__list">
            <% shown_index = 0 %>
            <% menu.each_with_index do |(key, (label, _path, icon)), index| %>
              <%# herb:key key %>
              <% hidden = @user.person.nav_plugin_hidden?(key) %>
              <% shown_index += 1 unless hidden %>
              <li class="<%= class_names("menu-arranger__item txt-small", "menu-arranger__item--hidden": hidden) %>">
                <input type="hidden" name="order[]" value="<%= key %>">
                <%= icon_tag icon || "grid" %>
                <strong class="overflow-ellipsis"><%= label %></strong>
                <% unless hidden %>
                  <span class="txt-x-small txt-subtle">g <%= shown_index %></span>
                <% end %>
                <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
                <button type="submit" name="move" value="<%= key %>:up" class="btn btn--circle txt-small" title="Move <%= label %> up" <% if index.zero? %>disabled<% end %>>
                  <%= icon_tag "arrow-up" %> <span class="for-screen-reader">Move <%= label %> up</span>
                </button>
                <button type="submit" name="move" value="<%= key %>:down" class="btn btn--circle txt-small menu-arranger__down" title="Move <%= label %> down" <% if index == menu.size - 1 %>disabled<% end %>>
                  <%= icon_tag "arrow-up" %> <span class="for-screen-reader">Move <%= label %> down</span>
                </button>
                <label class="switch flex-item-no-shrink" title="Show <%= label %> in your menu">
                  <input type="checkbox" name="shown[]" value="<%= key %>" class="switch__input" <% unless hidden %>checked<% end %> aria-label="Show <%= label %> in your menu" data-action="change->form#submit">
                  <span class="switch__btn"></span>
                </label>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </section>
  </div>
</section>
