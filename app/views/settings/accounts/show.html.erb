<% @page_title = "Your account" %>
<%= render "settings/header", current: :account %>
<% install_size = Setting.current.text_size %>

<div class="settings-page">
  <section class="settings-section" id="sign-in">
    <header class="settings-section__head">
      <h2>Ways to sign in</h2>
      <p class="settings-section__description">Your password always works. These add to it.</p>
    </header>
    <%= form_with model: @user, url: settings_passwordless_path, method: :patch, class: "settings-switches", data: { controller: "form" } do |form| %>
      <%= switch_field form, :passwordless, label: "Sign in with an emailed link", submit_on_change: true,
            hint: "“Email me a sign-in link” on the sign-in page sends you a link that works once, for 15 minutes. Your password keeps working too." %>
    <% end %>
  </section>

  <%# Notifications on this device: pushed by the install (PushSubscription), switched on per browser
      or installed app by the push controller, which alone knows whether this one is. %>
  <section class="settings-section" id="notifications-device">
    <header class="settings-section__head">
      <h2>Notifications on this device</h2>
      <p class="settings-section__description">When someone mentions you, this browser (or Runwell installed as an app) shows it, as well as the email. Switch it on on each device you want them on.</p>
    </header>
    <div class="settings-switches" data-controller="push" data-push-key-value="<%= Setting.current.push_keys[:public_key] %>" data-push-url-value="<%= settings_push_subscription_path %>">
      <%= ui :field, label: "Show my notifications here", description: "Your browser asks first. Clicking one opens what it’s about.", class: "switch-field", control_id: "push_switch",
            control: ui(:switch, name: "push", id: "push_switch", data: { push_target: "switch", action: "change->push#toggle" }) %>
      <p class="settings-note push-note" hidden data-push-target="note"
        data-unsupported="This browser can’t show notifications from a website. On an iPhone or iPad, add Runwell to your Home Screen first."
        data-denied="Notifications are blocked for Runwell in this browser’s settings."
        data-failed="That didn’t work. Try again in a moment."></p>
    </div>
  </section>

  <section class="settings-section" id="two-factor">
    <header class="settings-section__head">
      <h2>Two-factor sign-in</h2>
      <p class="settings-section__description">A code from an app on your phone after your password, so a stolen password isn’t enough to get in.</p>
    </header>
    <div class="settings-list">
      <div class="settings-item">
        <div class="settings-item__media"><%= icon_tag "lock" %></div>
        <div class="settings-item__content">
          <% if @user.two_factor? %>
            <p class="settings-item__title">Authenticator app <%= ui :badge, variant: :success, content: "On" %></p>
            <p class="settings-item__desc">Since <%= l @user.otp_enabled_at.to_date, format: :long %>. <%= pluralize(@user.recovery_codes_left, "recovery code") %> left.</p>
          <% else %>
            <p class="settings-item__title">Authenticator app <%= ui :badge, variant: :secondary, content: "Off" %></p>
            <p class="settings-item__desc">Turn it on and Runwell asks for a code after your password.</p>
          <% end %>
        </div>
        <% unless @user.two_factor? %>
          <div class="settings-item__actions">
            <%= link_to "Set up", new_settings_two_factor_path, class: "ui-button", data: { variant: "default", size: "sm" } %>
          </div>
        <% end %>
      </div>
    </div>
    <% if @user.two_factor? %>
      <%= render "settings/accounts/two_factor_changes", required: Setting.current.require_two_factor? %>
    <% end %>
    <% if can?(:manage_people) %>
      <%= form_with model: Setting.current, url: settings_two_factor_requirement_path, method: :patch, class: "settings-switches", data: { controller: "form" } do |form| %>
        <%= switch_field form, :require_two_factor, label: "Require it for everyone", submit_on_change: true,
              hint: "On unless you turn it off. After their password, everyone enters a code from an authenticator app; anyone without it sets it up on their next page. #{term(:client, count: 2).upcase_first} sign in by emailed link and aren’t affected." %>
      <% end %>
    <% end %>
  </section>

  <section class="settings-section">
    <header class="settings-section__head">
      <h2>Text size</h2>
      <p class="settings-section__description">Yours alone, on every device you sign in on. The install’s default is <%= Setting::TEXT_SIZES[install_size] %>.</p>
    </header>
    <%= form_with model: @user, url: settings_account_path, method: :patch, data: { controller: "appearance", action: "change->appearance#preview", install_text_size: install_size } do |form| %>
      <%= render "settings/appearances/choices", form: form, attribute: :text_size, choices: Setting::TEXT_SIZES, current: @user.text_size, sample_class: "appearance-size", blank: "Install default", label: "Text size" %>
    <% end %>
  </section>

  <%# Your menu: the plugins that are on, in the install's sidebar order (Settings > Sidebar), each
      shown or hidden in this person's nav. The switches save as they change (User::NavPlugins). %>
  <% menu = nav_menu_items %>
  <section class="settings-section" id="menu">
    <header class="settings-section__head">
      <h2>Your menu</h2>
      <p class="settings-section__description">Which plugins show in the menu on the left: yours alone. Where they sit is the same for everyone<% if can?(:manage_settings) %> (<%= link_to "Settings › Sidebar", settings_sidebar_path %>)<% end %>. The first shown is <kbd>g</kbd> <kbd>1</kbd>, the next <kbd>g</kbd> <kbd>2</kbd>, and so on.</p>
    </header>
    <% if menu.empty? %>
      <%= render "layouts/shared/empty", text: "No plugin with a page is switched on." %>
    <% else %>
      <%= form_with url: settings_menu_path, method: :patch, class: "settings-menu", data: { controller: "form" } do %>
        <ul class="settings-list">
          <% menu.each do |key, label, icon| %>
            <%# herb:key key %>
            <% hidden = @user.person.nav_plugin_hidden?(key) %>
            <li class="<%= class_names("settings-item", "settings-menu__item--hidden": hidden) %>">
              <div class="settings-item__media"><%= icon_tag icon %></div>
              <div class="settings-item__content">
                <p class="settings-item__title"><%= label %></p>
              </div>
              <div class="settings-item__actions">
                <%= ui :switch, name: "shown[]", value: key, checked: !hidden, id: "shown_#{key}", title: "Show #{label} in your menu", aria: { label: "Show #{label} in your menu" }, data: { action: "change->form#submit" } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </section>
</div>
