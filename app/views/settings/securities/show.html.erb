<% @page_title = "Security" %>
<%= render "settings/header", current: :security %>

<section class="settings">
  <div class="settings__panel">
    <section class="settings__section" id="two-factor">
      <header class="settings__heading">
        <h2>Two-factor sign-in</h2>
        <p class="settings__description">A code from an authenticator app after the password, so a stolen password isn’t enough to get in.</p>
      </header>
      <%= form_with model: Setting.current, url: settings_two_factor_requirement_path, method: :patch, data: { controller: "form" } do |form| %>
        <%= switch_field form, :require_two_factor, label: "Require it for everyone", submit_on_change: true,
              hint: "After their password, everyone enters a code from an authenticator app. Anyone without it sets it up on their next page. #{term(:client, count: 2).upcase_first} sign in by emailed link and aren’t affected." %>
      <% end %>
    </section>
  </div>
</section>
