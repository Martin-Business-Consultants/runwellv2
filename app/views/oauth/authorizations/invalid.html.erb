<% @page_title = "Can’t connect" %>

<div class="auth auth--wide">
  <section class="card auth__card">
    <header class="card__head auth__header">
      <h1 class="card__title auth__title">This app can’t connect</h1>
      <p class="card__hint">The sign-in link it opened isn’t one Runwell recognizes: an unknown app, or a return address it didn’t register. Try connecting again from the app.</p>
    </header>
  </section>
</div>
