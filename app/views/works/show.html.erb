<% @page_title = @work.title %>
<% tabs = work_record_tabs(@work) %>
<% tab = current_record_tab(tabs, "tasks") %>

<%= parent_page term(:work, count: 2), works_path %>
<%= turbo_stream_from @work %>

<% layout = record_layout(:work) %>
<section class="record-page record-page--tabbed" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:work) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:work).downcase}’s" %>
  <%= render "works/header", work: @work %>

  <div class="record-page__main">
    <%# Fields the install put in the working column (template mode), changed in place; the
        sidebar's sit in its general pane (works/sidebar). Title, client, shape and description
        are the header and its info button. %>
    <%= record_card css: "record-fields-card" do %>
      <%= render "record_fields/zone", layout: layout, zone: "main", record: @work, in_place: true, except: header_fields(:work) %>
    <% end %>

    <%= render "works/record_tab", work: @work, tabs: tabs, task_state: @task_state, task_item: @task_item, task_view: @task_view, board: @board %>
  </div>

  <aside class="record-page__aside">
    <%= render "works/sidebar", work: @work, current: (tab == "tasks" ? (@task_item || "all") : nil) %>
    <%= plugin_slots(:work_aside, work: @work) %>

    <% if can?(:close_works) || (@work.closed? && can?(:erase_works)) %>
      <%= record_card (@work.closed? ? @work.state_label : "Finish"),
            hint: (@work.closed? ? "Off the open list. Its #{term(:task, count: 2).downcase} and history stay." : "Mark it complete once it’s delivered, or cancel it.") do %>
          <% if can?(:close_works) %>
            <% if @work.reopenable? %>
              <%= form_with url: reopen_work_path(@work), class: "work-reopen" do %>
                <%= ui :button, type: :submit, variant: :outline, size: :sm, content: safe_join([ icon_tag("refresh"), "Reopen" ], " ") %>
              <% end %>
            <% end %>
            <% if @work.closable? %>
              <%= render "works/close", work: @work %>
            <% end %>
          <% end %>

          <% if @work.closed? && can?(:erase_works) %>
            <%= render "works/erase", work: @work %>
          <% end %>
      <% end %>
    <% end %>
  </aside>
</section>
