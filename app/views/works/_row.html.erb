<%# locals: (work:, listed:) %>
<%# One work in the index's data table (layouts/shared/_list_table): the cells in the columns' order. %>
<tr id="<%= dom_id(work, :row) %>" data-filter-target="item">
  <%= ui :select_cell, value: work.id, label: work.title, checkbox: { data: { keys: "x" } } %>
  <td data-column="title" data-grow><%= peek_link_to work, work.title, class: "work-row__title" %></td>
  <td data-column="type"><%= badge work.label_name, tone: :outline %></td>
  <td data-column="client" data-truncate><%= peek_link_to work.client, work.client.name, class: "work-row__client" %></td>
  <td data-column="state"><%= status_tag work.state_label, highlight: work.active? %></td>
  <% listed.each do |field| %>
    <%# herb:key field.id %>
    <%= custom_field_cell(field, work.custom_value(field)) %>
  <% end %>
  <%= render "layouts/shared/row_actions", name: work.title, edit_path: edit_work_path(work), peek: work, delete_path: (work_path(work) if work.deletable?),
        delete_message: "Nothing has been done on it yet, so its notes and documents go with it." %>
</tr>
