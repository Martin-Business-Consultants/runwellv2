<%# locals: (work:) %>
<%# herb:slots client %>
<%# herb:state (erasing: false) %>
<%# Deleting a closed work for good (Works::ErasuresController), for owners: the form
    asks for the ref so it can't happen by accident. It's always on the page and state only shows
    it, so opening it never waits on the server. %>
<div class="erase-work" data-controller="state-focus" data-state-focus-state-value="erasing">
  <button type="button" class="btn btn--ghost btn--sm work-finish__danger" data-herb-set="erasing=true" hidden="<%= erasing %>">
    <%= icon_tag "trash" %>
    <span>Delete permanently</span>
  </button>
  <div hidden="<%= !erasing %>">
    <%= form_with url: work_erasure_path(work), class: "work-finish__form erase-work__form", data: { turbo_action: "advance" } do |form| %>
      <strong>Delete <%= work.title %> for good?</strong>
      <span class="work-finish__text">
        It removes the <%= term(:work).downcase %> with its <%= term(:scope_item, count: 2).downcase %>, its <%= term(:task, count: 2).downcase %>,
        notes, documents and history. There’s no undo; the <%= term(:client).downcase %> keeps one note that it was deleted.
      </span>
      <label class="field">
        <span class="field__label">Type <strong><%= work.title %></strong> to confirm</span>
        <%= form.text_field :confirm_ref, autocomplete: "off", required: true, autofocus: true, aria: { label: "Type #{work.title} to confirm" } %>
      </label>
      <div class="work-finish__actions">
        <button type="submit" class="btn btn--danger btn--sm">Delete <%= work.title %> permanently</button>
        <button type="button" class="btn btn--ghost btn--sm" data-keys="esc" data-herb-reset="erasing">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
