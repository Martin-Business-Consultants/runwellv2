<% @page_title = term(:work, count: 2) %>
<%= turbo_stream_from :works %>
<% listed = CustomField.for("Work").listed.to_a %>

<% content_for :index_filters do %>
  <%= ui :filter, param: :state, label: "Show", value: @state, any: false, options: Work.filter_options(Work.filter_counts(label: @label)) %>
  <%= ui :filter, param: :label, label: "Type", value: @label, any: false,
        options: [ [ "All types", "all" ] ] + Setting.current.enabled_labels.map { [ label_term(it, count: 2), it ] } %>
<% end %>
<% bar = bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_works_path, noun: term(:work, count: 2).downcase, message: "Only those with no work yet are deleted; the rest are skipped (close them instead).") : nil) do %>
  <% if can?(:close_works) %>
    <%= bulk_menu bulk_works_closure_path, method: :post, name: "outcome", label: "Close as", choices: [ [ "Completed", "completed" ], [ "Cancelled", "cancelled" ] ], params: { list_state: @state, list_label: @label } %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: "New " + term(:work).downcase, new_path: new_work_path, new_modal: true %>

<% if @works.any? %>
  <% columns = [ ui_column(:title, "Title", sort: :title, hideable: false),
                 ui_column(:type, "Type", sort: :type),
                 ui_column(:client, term(:client), sort: :client),
                 ui_column(:state, "State"),
                 *custom_field_columns(listed) ] %>
  <%= render "layouts/shared/list_table", id: "works", columns: columns, rows: @works, row: "works/row", as: :work,
        row_locals: { listed: listed }, page: @page, selectable: true, noun: term(:work).downcase, bulk: bar, actions: true %>
<% end %>

<% if @works.none? %>
  <%= ui :empty, description: "No #{term(:work, count: 2).downcase} match." %>
<% end %>
