<%# locals: (work:) %>
<%# Finishing a piece of work: Mark complete (delivered) or Cancel (stopped before then), each
    asked in runeui's alert dialog with an optional note (its field joins the dialog's form by
    id). Either closes it: off the open list, its work and history kept, and it can be reopened.
    d opens Mark complete. %>
<div class="work-finish">
  <% [ [ "completed", "Mark complete", "check", :outline, "Mark #{work.title} complete?", "Delivered and done.", :default ],
       [ "cancelled", "Cancel it", "close-circle", :ghost, "Cancel #{work.title}?", "Stopped before it was delivered.", :destructive ] ].each do |outcome, label, icon, look, question, what, variant| %>
    <%# herb:key outcome %>
    <% dialog_id = dom_id(work, outcome == "completed" ? :complete : :cancel) %>
    <%= ui :alert_dialog, id: dialog_id, title: question, class: "work-finish__dialog",
          description: "#{what} It leaves the open list; its #{term(:task, count: 2).downcase} and history stay, and it can be reopened.",
          trigger: ui(:button, variant: look, size: :sm, class: ("work-finish__danger" if outcome == "cancelled"), content: safe_join([ icon_tag(icon), label ], " "), title: (outcome == "cancelled" ? "Cancel #{work.title}" : nil), data: { keys: (outcome == "completed" ? "d" : nil) }),
          cancel: "Not now", action: label, variant: variant, href: close_work_path(work), params: { outcome: outcome } do %>
      <%= ui :input, name: "reason", form: "#{dialog_id}-form", id: "#{dialog_id}_reason", autofocus: true, autocomplete: "off", placeholder: "A note (optional)", aria: { label: "A note (optional)" } %>
    <% end %>
  <% end %>
</div>
