<%# locals: (work:) %>
<%# herb:slots client %>
<%# herb:state (closing: "") %>
<%# Finishing a piece of work: Mark complete (delivered) or Cancel (stopped before then), each with an
    optional note. Either closes it: off the open list, its work and history kept. Both forms
    are always on the page and state only shows one, so opening them never waits on the server. %>
<div class="work-finish" data-controller="state-focus" data-state-focus-state-value="closing">
  <div class="work-finish__choices" hidden="<%= closing != "" %>">
    <button type="button" class="btn btn--secondary btn--sm" data-keys="d" data-herb-set="closing=completed"><%= icon_tag "check" %> <span>Mark complete</span></button>
    <button type="button" class="btn btn--ghost btn--sm work-finish__danger" title="Cancel <%= work.title %>" data-herb-set="closing=cancelled">
      <%= icon_tag "close-circle" %>
      <span>Cancel it</span>
    </button>
  </div>

  <div hidden="<%= closing != "completed" %>">
    <%= form_with url: close_work_path(work), namespace: dom_id(work, :complete), class: "work-finish__form" do |form| %>
      <strong>Mark <%= work.title %> complete?</strong>
      <span class="work-finish__text">Delivered and done. It leaves the open list; its work and history stay, and it can be reopened.</span>
      <input type="hidden" name="outcome" value="completed">
      <%= form.text_field :reason, autofocus: true, autocomplete: "off", placeholder: "A note (optional)" %>
      <div class="work-finish__actions">
        <button type="submit" class="btn btn--primary btn--sm">Mark complete</button>
        <button type="button" class="btn btn--ghost btn--sm" data-keys="esc" data-herb-reset="closing">Not now</button>
      </div>
    <% end %>
  </div>

  <div hidden="<%= closing != "cancelled" %>">
    <%= form_with url: close_work_path(work), namespace: dom_id(work, :cancel), class: "work-finish__form" do |form| %>
      <strong>Cancel <%= work.title %>?</strong>
      <span class="work-finish__text">Stopped before it was delivered. It leaves the open list; its work and history stay, and it can be reopened.</span>
      <input type="hidden" name="outcome" value="cancelled">
      <%= form.text_field :reason, autofocus: true, autocomplete: "off", placeholder: "A note (optional)" %>
      <div class="work-finish__actions">
        <button type="submit" class="btn btn--danger btn--sm">Cancel it</button>
        <button type="button" class="btn btn--ghost btn--sm" data-keys="esc" data-herb-reset="closing">Not now</button>
      </div>
    <% end %>
  </div>
</div>
