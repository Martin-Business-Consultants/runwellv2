<% @page_title = "New " + term(:work).downcase %>
<% client = @work.client %>
<% existing = client ? client.works.includes(:client).order(created_at: :desc).limit(8).to_a : [] %>
<% layout = record_layout(:work) %>
<% if turbo_frame_request_id == "modal" %>
  <%= render layout: "layouts/shared/modal", locals: { title: @page_title } do %>
    <%= render "record_fields/main_card", layout: layout, record: @work, form_id: "work_form", title: term(:work), hint: "Who it’s for, what kind it is, and what it covers.",
          submit: "Start " + term(:work).downcase, cancel: works_path, modal: true, head_key: "client" %>
  <% end %>
<% else %>
<%= parent_page term(:work, count: 2), works_path %>

<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:work) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:work).downcase}’s" %>
  <%= record_header id: "record_header" do %>
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-header__line">
        <% if client&.internal? %>
          <%= client.name %> is internal: its <%= term(:work, count: 2).downcase %> are your own.
        <% else %>
          It’s active from the start: add its <%= term(:scope_item, count: 2).downcase %> and <%= term(:task, count: 2).downcase %> next.
        <% end %>
      </p>
  <% end %>

  <div class="record-page__main">
    <%= render "record_fields/main_card", layout: layout, record: @work, form_id: "work_form", title: term(:work), hint: "Who it’s for, what kind it is, and what it covers.",
          submit: "Start " + term(:work).downcase, cancel: works_path %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @work, form_id: "work_form" %>

    <%= record_card "How it goes" do %>
        <% steps = [ "Add #{term(:scope_item, count: 2).downcase} if it has parts, to group its #{term(:task, count: 2).downcase}.",
             "Add #{term(:task, count: 2).downcase} with owners and due dates, whenever something needs doing.", "Track it on the #{term(:task, count: 2)} table or board like any other.",
             "Close the #{term(:work).downcase} when it’s done." ] %>
        <ol class="record-steps">
          <% steps.each do |step| %>
            <%# herb:key step %>
            <li><%= step %></li>
          <% end %>
        </ol>
    <% end %>

    <% if client %>
      <%= record_card "#{client.name}’s #{term(:work, count: 2).downcase}", hint: (existing.empty? ? "This is their first." : pluralize(existing.size, "so far", plural: "so far")) do %>
        <% if existing.any? %>
            <ul class="record-list">
              <% existing.each do |work| %>
                <%# herb:key work.id %>
                <li data-filter-target="item">
                  <%= link_to work, class: "item-row" do %>
                    <span class="item-row__content"><span class="item-row__title"><%= work.title %></span></span>
                    <span class="item-row__meta"><%= status_tag work.state_label, highlight: work.active? %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
        <% end %>
      <% end %>
    <% end %>
  </aside>
</section>
<% end %>
