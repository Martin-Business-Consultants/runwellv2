<%# locals: (work:, current: nil) %>
<%# herb:slots client %>
<%# herb:state (pane: "scope") %>
<%# A piece of work's sidebar card: its sections (works/_scope) by default, or General, its
    facts and custom fields. Both are always on the page and state shows one, so switching never
    waits on the server. current: the scope item whose work is shown (works/_scope). %>
<section class="card record-card work-sidebar">
  <header class="card__head">
    <nav class="tabs tabs--pills work-sidebar__tabs" aria-label="Sidebar">
      <button type="button" class="tabs__tab" aria-pressed="<%= pane == "scope" %>" data-herb-set="pane=scope"><%= term(:scope_item, count: 2) %></button>
      <button type="button" class="tabs__tab" aria-pressed="<%= pane == "general" %>" data-herb-set="pane=general">General</button>
    </nav>
  </header>

  <div class="card__content record-card__stack" hidden="<%= pane != "general" %>">
    <dl class="details">
      <dt>Status</dt><dd><%= status_tag work.state_label, highlight: work.active? %></dd>
      <dt><%= term(:client) %></dt><dd><%= link_to work.client.name, work.client %></dd>
      <dt>Type</dt><dd><%= work.label_name %> · <%= work.runs %></dd>
      <dt>Started</dt><dd><%= l work.created_at.to_date, format: :long %></dd>
      <% if work.closed? %>
        <dt><%= work.state_label %></dt><dd><%= l work.closed_at.to_date, format: :long %><%= ": #{work.close_reason}" if work.close_reason.present? %></dd>
      <% end %>
    </dl>
    <%= render "record_fields/zone", layout: record_layout(:work), zone: "aside", record: work, in_place: true, except: header_fields(:work) %>
  </div>

  <div class="card__content record-card__stack" hidden="<%= pane != "scope" %>">
    <%= render "works/scope", work: work, current: current %>
  </div>
</section>
