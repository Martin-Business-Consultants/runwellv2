<%# locals: (work:, current: nil) %>
<%# A piece of work's sidebar card: its sections (works/_scope) by default, or General, its facts
    and custom fields, in runeui's tabs (ui :tabs: both panels on the page, the tabs switch them in
    the browser and keep the choice through a morph). current: the scope item whose tasks are
    shown (works/_scope). %>
<% general = capture do %>
  <div class="record-card__stack" data-morph="replace">
    <dl class="details">
      <dt>Status</dt><dd><%= status_tag work.state_label, highlight: work.active? %></dd>
      <dt><%= term(:client) %></dt><dd><%= link_to work.client.name, work.client %></dd>
      <dt>Type</dt><dd><%= work.label_name %> · <%= work.runs %></dd>
      <dt>Started</dt><dd><%= l work.created_at.to_date, format: :long %></dd>
      <% if work.closed? %>
        <dt><%= work.state_label %></dt><dd><%= l work.closed_at.to_date, format: :long %><%= ": #{work.close_reason}" if work.close_reason.present? %></dd>
      <% end %>
    </dl>
    <%= render "record_fields/zone", layout: record_layout(:work), zone: "aside", record: work, in_place: true, except: header_fields(:work) %>
  </div>
<% end %>
<%= record_card css: "work-sidebar" do %>
  <%= ui :tabs, label: "Sidebar", value: "scope", id: dom_id(work, :sidebar_tabs), class: "work-sidebar__tabs", tabs: [
        { value: "scope", label: term(:scope_item, count: 2), content: render("works/scope", work: work, current: current) },
        { value: "general", label: "General", content: general }
      ] %>
<% end %>
