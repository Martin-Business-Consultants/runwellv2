<%# locals: (work:) %>
<%# A piece of work's page header (record_header: ui :page_header): its title, changed in place;
    its description, read and changed in the dialog its info button opens (ui :dialog; saved with
    Save or ⌘/Ctrl+Enter, Esc puts it back, the save-when-dirty behavior); its facts on one line,
    and its next step. Redrawn when it saves (works/update.turbo_stream.erb). %>
<% next_step = work_next_step(work) %>
<%= record_header id: dom_id(work, :header) do %>
  <div class="record-header__title-row">
    <%= render "layouts/shared/record_title", record: work, attribute: :title, label: "Title" %>
    <%= ui :dialog, id: dom_id(work, :about), size: :lg, title: work.title, class: "work-about",
          trigger: ui(:button, variant: :ghost, size: :icon, content: icon_tag("info"), title: "About this #{term(:work).downcase}", aria: { label: "About #{work.title}" }) do %>
      <%= form_with model: work, method: :patch, id: dom_id(work, :description_form), class: "rich-text-in-place", data: draft_data("description:work:#{work.id}").merge(save_when_dirty: true) do |form| %>
        <%= hidden_field_tag :inline, "field", id: nil %>
        <%= rich_text_field form, :description, staff: true, placeholder: "What it is, what’s agreed, what done looks like" %>
        <%= draft_notice %>
        <div class="rich-text-in-place__actions">
          <span class="rich-text-in-place__hint"><kbd>Esc</kbd> puts it back</span>
          <%= ui :button, type: :submit, size: :sm, content: safe_join([ tag.span("Save"), tag.kbd("⌘↵", class: "hide-on-touch") ], " ") %>
        </div>
      <% end %>
      <% unless work.internal? %>
        <p class="field-note">Shown to the <%= term(:client).downcase %> in the portal.</p>
      <% end %>
    <% end %>
  </div>
  <p class="record-meta record-header__line">
    <%= status_tag work.state_label, highlight: work.active? %>
    <%= link_to work.client.name, work.client %>
    <span><%= work.label_name %> · <%= work.runs %></span>
    <% if work.internal? %>
      <span>Internal</span>
    <% end %>
    <%= plugin_slots(:work_meta, work: work) %>
    <% if work.closed? %>
      <span><%= work.state_label %> <%= l work.closed_at.to_date, format: :long %><%= ": #{work.close_reason}" if work.close_reason.present? %></span>
    <% end %>
  </p>
  <% if next_step %>
    <p class="record-header__next"><%= next_step %></p>
  <% end %>
<% end %>
