<% @page_title = "Edit #{@work.title_was}" %>

<%= parent_page @work.title_was, @work %>

<% layout = record_layout(:work) %>
<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:work) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:work).downcase}’s" %>
  <%= record_header id: "record_header" do %>
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-header__line"><%= @work.title_was %> for <%= @work.client.name %></p>
  <% end %>

  <div class="record-page__main">
    <%= render "record_fields/main_card", layout: layout, record: @work, form_id: "work_form", title: term(:work), hint: "Who it’s for, what kind it is, and what it covers.",
          submit: "Save changes", cancel: work_path(@work) %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @work, form_id: "work_form" %>

    <%= record_card "Details" do %>
        <dl class="details">
          <dt>Status</dt><dd><%= status_tag @work.state_label, highlight: @work.active? %></dd>
          <dt><%= term(:client) %></dt><dd><%= link_to @work.client.name, @work.client %></dd>
          <dt><%= term(:task, count: 2) %></dt><dd><%= @work.tasks.count %> (<%= @work.tasks.open.count %> open)</dd>
        </dl>
    <% end %>
  </aside>
</section>
