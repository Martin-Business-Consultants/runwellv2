<%# locals: (record:, form: nil, form_id: nil) %>
<% if form %>
  <%= switch_field form, :client_visible, label: "Visible to the #{term(:client).downcase}", form: form_id %>
<% else %>
  <dt><%= term(:client) %> sees it</dt><dd><%= record.client_visible? ? "Yes, in the portal" : "No, internal" %></dd>
<% end %>
