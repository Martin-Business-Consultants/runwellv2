<%# locals: (record:, form: nil, form_id: nil) %>
<% if form %>
  <label class="field">
    <span class="field__label">Description</span>
    <%= rich_text_field form, :description, staff: true, form_id: form_id %>
  </label>
<% else %>
  <dt>Description</dt>
  <dd class="record-fields__prose">
    <% if record.description.present? %>
      <%= rich_text record.description %>
    <% else %>
      <span class="muted">No description.</span>
    <% end %>
  </dd>
<% end %>
