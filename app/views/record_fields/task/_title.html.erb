<%# locals: (form: nil, form_id: nil, **) %>
<%# A task's title: the page's heading on show. %>
<% if form %>
  <%= form.ui :field, :title, label: "Title", class: "field" do %>
    <%= form.text_field :title, required: true, autofocus: true, autocomplete: "off", form: form_id %>
  <% end %>
<% end %>
