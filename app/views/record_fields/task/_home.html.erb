<%# locals: (record:, form: nil, form_id: nil) %>
<%# Where it sits: the piece of work it's on (filed from Intake: its client follows), its section
    there, or (straight on a client) which client. A new task's home comes from where it's added. %>
<% if form %>
  <% if record.persisted? %>
    <label class="field">
      <span class="field__label"><%= term(:work) %></span>
      <%= form.select :work_id, task_work_options(record), { include_blank: "None (straight on the #{term(:client).downcase})" }, form: form_id %>
    </label>
  <% end %>
  <% if record.work %>
    <label class="field">
      <span class="field__label"><%= term(:scope_item) %></span>
      <%= form.select :scope_item_id, record.work.scope_items.map { |item| [ item.description, item.id ] }, { include_blank: "None" }, form: form_id %>
    </label>
  <% else %>
    <label class="field">
      <span class="field__label"><%= term(:client) %></span>
      <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "None yet" }, form: form_id %>
    </label>
  <% end %>
<% else %>
  <dt><%= term(:client) %></dt>
  <dd>
    <% if record.client %>
      <%= link_to record.client.name, record.client %>
    <% else %>
      <span class="muted">None matched</span>
    <% end %>
  </dd>
<% end %>
