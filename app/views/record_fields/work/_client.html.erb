<%# locals: (record:, form: nil, form_id: nil) %>
<%# Fixed once it exists. On show it's in the line under the title. %>
<% if form %>
  <%= form.ui :field, :client_id, label: term(:client), class: "field" do %>
    <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "Choose a " + term(:client).downcase }, required: true, disabled: record.persisted?, form: form_id, search: true %>
  <% end %>
<% end %>
