<%# locals: (layout:, record:, form_id: nil, scope: nil, title: nil, in_place: nil, except: nil, url: nil) %>
<%# A record page's sidebar column of fields (template mode, RecordLayout's aside): inputs joined
    to the page's form on new and edit (form_id), inputs that save as they change on a record's
    own page (in_place), values otherwise. It shows only when it has something in it, or while
    arranging. %>
<section class="card record-card record-fields-card">
  <header class="card__head">
    <%= layout_text_tag layout, "aside.title", title || (form_id ? "Properties" : "Details"), class: "card__title" %>
  </header>
  <div class="card__content">
    <% if in_place %>
      <%= render "record_fields/zone", layout: layout, zone: "aside", record: record, in_place: true, scope: scope, url: url, except: except %>
    <% elsif form_id %>
      <%= render "record_fields/zone", layout: layout, zone: "aside", record: record, form: record_fields_builder(record, scope: scope), form_id: form_id %>
    <% else %>
      <%= render "record_fields/zone", layout: layout, zone: "aside", record: record %>
    <% end %>
  </div>
</section>
