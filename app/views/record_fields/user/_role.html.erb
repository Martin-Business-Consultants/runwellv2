<%# locals: (record:, form: nil, form_id: nil) %>
<% if form %>
  <label class="field">
    <span class="field__label">Role</span>
    <%= form.select :role, User::ROLES.map { [ it.capitalize, it ] }, {}, form: form_id %>
    <span class="field__hint"><%= User::ROLE_DESCRIPTIONS[record.role] %></span>
  </label>
<% end %>
