<%# locals: (record:, form: nil, form_id: nil) %>
<%# A client's name: the page's heading on show. %>
<% if form %>
  <%= form.ui :field, :name, label: "Name", class: "field" do %>
    <%= form.text_field :name, required: true, autofocus: record.new_record?, autocomplete: "off", placeholder: "Acme Inc.", form: form_id %>
  <% end %>
<% end %>
