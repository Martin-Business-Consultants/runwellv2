<%# locals: (layout:, record:, form_id:, title:, submit:, cancel:, hint: nil, url: nil, scope: nil, hidden: nil, modal: nil, head_key: nil) %>
<%# A new or edit page's working column (template mode): its fields (RecordLayout's main, and in a
    modal, which has no sidebar, the aside's too), then the <form> itself as the card's footer.
    Every field sits outside the form and joins it by form_id, so the sidebar's can too.
    head_key: one field drawn beside the heading instead (a modal's who-it's-for: the work's
    client), and left out of the columns below; the modal's sidebar fields go two to a row. In the
    modal the form submits inside its frame: refused, it comes back there with what was typed;
    saved, the answer either stays on the page (a stream with the new row) or goes to the new
    record's page (the frame's breaks-out behavior). %>
<% builder = record_fields_builder(record, scope: scope) %>
<% draft_key = record.persisted? ? "edit:#{record.model_name.param_key}:#{record.id}" : [ "new", record.model_name.param_key, url ].compact.join(":") %>
<%= render "layouts/shared/errors", record: record %>
<section class="card record-form">
  <header class="<%= class_names("card__head", "record-form__head--field": head_key) %>">
    <%= layout_text_tag layout, "main.title", title, class: "card__title" %>
    <%= layout_text_tag layout, "main.hint", hint, tag: :p, class: "card__hint" %>
    <% if head_key %>
      <div class="card__action record-form__head-field">
        <%= render record_field_partial(layout, head_key), record: record, form: builder, form_id: form_id %>
      </div>
    <% end %>
  </header>
  <div class="card__content">
    <%= render "record_fields/zone", layout: layout, zone: "main", record: record, form: builder, form_id: form_id, except: head_key %>
    <% if modal %>
      <%= render "record_fields/zone", layout: layout, zone: "aside", record: record, form: builder, form_id: form_id, except: head_key, paired: true %>
    <% end %>
  </div>
  <%= form_with model: record, url: url, scope: scope, id: form_id, class: "card__footer card__footer--bordered record-form__footer",
        data: { controller: "form draft", draft_key_value: draft_key, action: "keydown.esc->form#cancel" } do %>
    <%= draft_notice %>
    <% (hidden || {}).each do |name, value| %>
      <%# herb:key name %>
      <%= hidden_field_tag name, value, id: nil %>
    <% end %>
    <% if modal %>
      <button type="button" class="btn btn--secondary" data-form-target="cancel" data-action="dialog#close">Cancel</button>
    <% else %>
      <%= link_to "Cancel", cancel, class: "btn btn--secondary", data: { form_target: "cancel" } %>
    <% end %>
    <button type="submit" class="btn btn--primary" data-form-target="submit"><span><%= submit %></span></button>
  <% end %>
</section>
