<%# locals: (field:) %>
<%# Template mode's "who sees it" for a custom field (owners): a button naming who, opening a
    popover (ui :popover) of the roles to tick; Save sets the field's visible_to at once
    (record-layout#saveVisibility), apart from the arrangement's Done. Shown only while arranging,
    and never made inert with the field. %>
<% if can?(:manage_settings) %>
  <span class="layout-field__control" data-layout-control>
    <% trigger = capture do %>
      <button type="button" class="ui-button layout-field__visibility" data-variant="outline" data-size="xs">
        <%= icon_tag "lock" %>
        <span data-visibility-label><%= field.visible_to_label %></span>
      </button>
    <% end %>
    <%= ui :popover, id: "field_visibility_#{field.id}", trigger: trigger, align: :start, class: "layout-visibility", data: { url: settings_field_path(field) } do %>
      <%= field_visibility_inputs "field[visible_to][]", field, namespace: "layout" %>
      <span class="layout-visibility__actions">
        <%= ui :button, type: :button, variant: :outline, size: :sm, content: "Cancel", data: { runeui_close: "field_visibility_#{field.id}" } %>
        <%= ui :button, type: :button, size: :sm, content: "Save", data: { action: "record-layout#saveVisibility" } %>
      </span>
    <% end %>
  </span>
<% end %>
