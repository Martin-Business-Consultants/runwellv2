<% @page_title = "Sign up" %>

<div class="panel panel--centered flex flex-column gap-half <%= "shake" if @user.errors.any? %>">
  <h1 class="txt-x-large font-weight-black margin-block-end">Sign up</h1>

  <%= form_with model: @user, url: signup_path, scope: :signup, class: "flex flex-column gap txt-medium", data: { controller: "form" } do |form| %>
    <label class="flex align-center gap input input--actor">
      <%= form.text_field :name, required: true, class: "input txt-large full-width", autofocus: true, autocomplete: "name", placeholder: "Enter your full name…", maxlength: 240 %>
    </label>

    <label class="flex align-center gap input input--actor">
      <%= form.email_field :email_address, required: true, class: "input txt-large full-width", autocomplete: "username", placeholder: "Enter your email address…" %>
    </label>

    <label class="flex align-center gap input input--actor">
      <%= form.password_field :password, required: true, class: "input txt-large full-width", autocomplete: "new-password", placeholder: "Choose a password…", maxlength: 72 %>
    </label>

    <%= render "layouts/shared/errors", record: @user %>

    <p><strong>Already have an account?</strong> <%= link_to "Sign in", new_session_path, class: "txt-link" %>.</p>

    <button type="submit" class="btn btn--link center txt-medium" data-form-target="submit">
      <span>Create my account</span>
      <%= icon_tag "arrow-right" %>
    </button>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
