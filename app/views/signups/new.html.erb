<% @page_title = "Sign up" %>

<div class="auth">
  <section class="ui-card auth__card <%= "shake" if @user.errors.any? %>">
    <header class="ui-card__header auth__header">
      <h1 class="ui-card__title auth__title">Create your account</h1>
      <p class="ui-card__description">You’ll be the owner. Everyone else joins by invitation.</p>
    </header>

    <div class="ui-card__content auth__content">
      <%= render "layouts/shared/errors", record: @user %>

      <%= form_with model: @user, url: signup_path, scope: :signup, class: "auth__form", data: { controller: "form" } do |form| %>
        <div class="ui-field">
          <%= form.label :name, "Full name", class: "ui-label" %>
          <%= form.text_field :name, required: true, class: "ui-input", autofocus: true, autocomplete: "name", maxlength: 240 %>
        </div>

        <div class="ui-field">
          <%= form.label :email_address, "Email", class: "ui-label" %>
          <%= form.email_field :email_address, required: true, class: "ui-input", autocomplete: "username", placeholder: "you@example.com" %>
        </div>

        <div class="ui-field">
          <%= form.label :password, "Password", class: "ui-label" %>
          <%= form.password_field :password, required: true, class: "ui-input", autocomplete: "new-password", maxlength: 72 %>
        </div>

        <button type="submit" class="ui-button ui-button--block" data-form-target="submit">Create my account</button>
      <% end %>
    </div>
  </section>

  <p class="auth__note">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
