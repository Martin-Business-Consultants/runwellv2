<% @page_title = "Sign up" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <%= auth_card title: "Create your account", hint: "You’ll be the owner. Everyone else joins by invitation.", shake: @user.errors.any? do %>
      <%= render "layouts/shared/errors", record: @user %>

      <%= form_with model: @user, url: signup_path, scope: :signup, class: "auth__form", data: { controller: "form" } do |form| %>
        <%= form.ui :field, :name, label: "Full name" do %>
          <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 240 %>
        <% end %>

        <%= form.ui :field, :email_address, label: "Email" do %>
          <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com" %>
        <% end %>

        <%= form.ui :field, :password, label: "Password" do %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>

        <%= bot_check_tag %>
        <%= ui :button, type: :submit, content: "Create my account", "data-form-target": "submit", class: "auth__button" %>
      <% end %>
  <% end %>

  <p class="auth__note">Already have an account? <%= link_to "Sign in", new_session_path %></p>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
