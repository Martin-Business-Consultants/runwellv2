<% @page_title = term(:work, count: 2) %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What we are working on for you.</p>
<% end %>

<% if @todos.any? %>
  <section class="card card--flush portal-card">
    <div class="table-wrap">
      <table class="table portal-table">
        <thead>
          <tr>
            <th>Title</th>
            <th class="portal-table__secondary"><%= term(:engagement) %></th>
            <th class="portal-table__date">Due</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @todos.each do |todo| %>
            <%# herb:key todo.id %>
            <tr>
              <td class="portal-table__title"><%= todo.title %></td>
              <td class="portal-table__secondary muted">
                <% if todo.engagement %>
                  <%= link_to "#{todo.engagement.ref} #{todo.engagement.title}", portal_engagement_path(todo.engagement), class: "portal-table__link" %>
                <% else %>
                  General
                <% end %>
              </td>
              <td class="portal-table__date muted nowrap">
                <% if todo.due_on %>
                  <%= l todo.due_on, format: :short %>
                <% end %>
              </td>
              <td class="portal-table__status"><%= status_tag todo.status.humanize, highlight: todo.status == "done" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <%= render "layouts/shared/empty", text: "No work to show yet." %>
<% end %>
