<% @page_title = "Requests" %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What you’ve asked us for, newest first. Open one to see how it’s going or to add to it.</p>
<% end %>

<% if @requests.any? %>
  <section class="card card--flush portal-card">
    <div class="table-wrap">
      <table class="table portal-table">
        <thead>
          <tr>
            <th>Subject</th>
            <th class="portal-table__secondary"><%= term(:work) %></th>
            <th class="portal-table__date portal-table__secondary">Sent</th>
            <th class="portal-table__date">Needed by</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |request_record| %>
            <%# herb:key request_record.id %>
            <tr>
              <td class="portal-table__title">
                <%= portal_task_link_to(request_record) { request_record.title } %>
                <%= portal_unread_mark(request_record) %>
              </td>
              <td class="portal-table__secondary muted">
                <% if request_record.work %>
                  <%= link_to request_record.work.title, portal_work_path(request_record.work), class: "portal-table__link" %>
                <% end %>
              </td>
              <td class="portal-table__date portal-table__secondary muted nowrap"><%= l request_record.created_at.in_time_zone.to_date, format: :short %></td>
              <td class="portal-table__date muted nowrap"><%= portal_due(request_record) %></td>
              <td class="portal-table__status"><%= portal_status_tag(request_record) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <%= table_pagination @page %>
<% else %>
  <%= render "layouts/shared/empty", text: "Nothing yet.", action_text: "Ask for something", action_path: new_portal_request_path, action_frame: "modal" %>
<% end %>
