<% @page_title = "Requests" %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What you’ve asked us for, newest first.</p>
<% end %>

<% if @requests.any? %>
  <section class="ui-card ui-card--flush portal-card">
    <div class="ui-table-container">
      <table class="ui-table portal-table">
        <thead>
          <tr>
            <th>Subject</th>
            <th class="portal-table__date">Sent</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |request_record| %>
            <%# herb:key request_record.id %>
            <tr>
              <td class="font-weight-medium"><%= request_record.title %></td>
              <td class="portal-table__date txt-subtle txt-nowrap"><%= l request_record.created_at.in_time_zone, format: :long %></td>
              <td class="portal-table__status"><%= status_tag portal_request_status(request_record), highlight: request_record.status == "done" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <%= render "layouts/shared/empty", text: "Nothing yet.", action_text: "Ask for something", action_path: new_portal_request_path %>
<% end %>
