<%# locals: (request_record:, modal: nil) %>
<%# A request: its subject and details, the piece of work it's about (if any), when it's needed by,
    and any files to send with it. In the modal (New request over the page) Cancel closes it and
    the form submits inside it: refused, it comes back there; sent, the modal closes over the page
    (Portal::RequestsController). On its own page Cancel goes back to the requests. What's typed
    is kept in the browser until it's sent (the draft controller). %>
<% works = current_contact.portal_works.open.by_client_priority.ordered.map { [ it.title, it.ref ] } %>
<%= render "layouts/shared/errors", record: request_record %>
<%= form_with model: request_record, scope: :request, url: portal_requests_path, multipart: true, class: "portal-form",
      data: { controller: "form draft", draft_key_value: "portal:request:#{request_record.client_id}", action: "keydown.esc->form#cancel" } do |form| %>
  <%= draft_notice %>
  <%= form.ui :field, :subject, label: "Subject" do %>
    <%= form.text_field :subject, value: request_record.title, required: true, autofocus: true, autocomplete: "off" %>
  <% end %>

  <%= form.ui :field, :body, label: "Details" do %>
    <%= rich_text_field_tag form.field_name(:body), request_record.description, id: form.field_id(:body) %>
  <% end %>

  <div class="form-grid">
    <% if works.any? %>
      <%= form.ui :field, :work, label: "About" do %>
        <%= form.select :work, works, { include_blank: "Nothing in particular", selected: request_record.work&.ref }, search: true %>
      <% end %>
    <% end %>
    <%= form.ui :field, :due_on, label: "Needed by", description: "Leave it empty if there’s no rush." do %>
      <%= date_input form, :due_on %>
    <% end %>
  </div>

  <%= form.ui :field, :files, label: "Files" do %>
    <%= form.ui :file_input, :files, multiple: true, dropzone: false, class: "portal-form__files" %>
    <ui-field-description data-slot="field-description">A screenshot, a document, anything that helps. Up to <%= number_to_human_size(Document::MAX_SIZE) %> each.</ui-field-description>
  <% end %>

  <div class="form-actions">
    <% if modal %>
      <%= ui :button, type: :button, variant: :outline, content: "Cancel", "data-form-target": "cancel", "data-runeui-close": "modal_dialog" %>
    <% else %>
      <%= ui :button, href: portal_requests_path, variant: :outline, content: "Cancel", data: { form_target: "cancel" } %>
    <% end %>
    <%= ui :button, type: :submit, content: "Send request", "data-form-target": "submit" %>
  </div>
<% end %>
