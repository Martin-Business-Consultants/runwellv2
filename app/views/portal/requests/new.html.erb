<% @page_title = "Ask for something" %>
<% if turbo_frame_request_id == "modal" %>
  <%= render layout: "layouts/shared/modal", locals: { title: @page_title, description: "A change, a question, something new. We’ll get back to you." } do %>
    <%= render "portal/requests/form", request_record: @request_record, modal: true %>
  <% end %>
<% else %>
  <% content_for :header do %>
    <h1 class="portal-page-header__title"><%= @page_title %></h1>
    <p class="portal-page-header__description">A change, a question, something new. We’ll get back to you.</p>
  <% end %>

  <%= portal_card css: "portal-form-card" do %>
    <%= render "portal/requests/form", request_record: @request_record %>
  <% end %>
<% end %>
