<% @page_title = term(:task, count: 2) %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What we are working on for you.</p>
<% end %>

<% if @tasks.any? %>
  <section class="card card--flush portal-card">
    <div class="table-wrap">
      <table class="table portal-table">
        <thead>
          <tr>
            <th>Title</th>
            <th class="portal-table__secondary"><%= term(:work) %></th>
            <th class="portal-table__date">Due</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody>
          <% @tasks.each do |task| %>
            <%# herb:key task.id %>
            <tr>
              <td class="portal-table__title"><%= task.title %></td>
              <td class="portal-table__secondary muted">
                <% if task.work %>
                  <%= link_to "#{task.work.ref} #{task.work.title}", portal_work_path(task.work), class: "portal-table__link" %>
                <% else %>
                  General
                <% end %>
              </td>
              <td class="portal-table__date muted nowrap">
                <% if task.due_on %>
                  <%= l task.due_on, format: :short %>
                <% end %>
              </td>
              <td class="portal-table__status"><%= status_tag task.status.humanize, highlight: task.status == "done" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <%= render "layouts/shared/empty", text: "No " + term(:task, count: 2).downcase + " to show yet." %>
<% end %>
