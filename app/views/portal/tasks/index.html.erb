<% @page_title = term(:task, count: 2) %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What we are working on for you. Put them in the order that matters most to you: we’ll see it.</p>
<% end %>

<%# Open by default (the filter swaps ?status=), found by title (?q=); a task opens in the side
    sheet, read-only, with its discussion. %>
<div class="portal-filter">
  <%= render "layouts/shared/segmented_filter", label: "Show " + term(:task, count: 2).downcase, param: :status, current: @state,
        options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ], counts: @counts %>
  <%= portal_search "Search #{term(:task, count: 2).downcase}" %>
</div>

<% if @tasks.any? %>
  <%# In the client's order of priority (ClientPrioritized), each row moved by its grip. %>
  <% sortable = @tasks.size > 1 && params[:q].blank? %>
  <section class="card card--flush portal-card" data-controller="drag-and-drop" data-drag-and-drop-dragged-item-class="portal-sortable--dragging" data-drag-and-drop-hover-container-class="portal-sortable--hover" data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
    <div class="table-wrap">
      <table class="table portal-table" data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= portal_task_priority_path("__id__") %>">
        <thead>
          <tr>
            <th>Title</th>
            <th class="portal-table__secondary"><%= term(:work) %></th>
            <th class="portal-table__date">Due</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody data-drag-drop-item-container>
          <% @tasks.each do |task| %>
            <%# herb:key task.id %>
            <tr data-drag-and-drop-target="item" data-id="<%= task.id %>">
              <td class="portal-table__title portal-sortable__cell">
                <% if sortable %>
                  <%= portal_priority_grip(task.title) %>
                <% end %>
                <%= portal_task_link_to(task) { task.title } %>
                <%= portal_unread_mark(task) %>
              </td>
              <td class="portal-table__secondary muted">
                <% if task.work %>
                  <%= link_to task.work.title, portal_work_path(task.work), class: "portal-table__link", draggable: "false" %>
                <% else %>
                  General
                <% end %>
              </td>
              <td class="portal-table__date muted nowrap"><%= portal_due(task) %></td>
              <td class="portal-table__status"><%= portal_status_tag(task) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  <%= table_pagination @page %>
<% elsif params[:q].present? %>
  <%= render "layouts/shared/empty", text: "Nothing matches “#{params[:q]}”." %>
<% elsif @state == "open" %>
  <%= render "layouts/shared/empty", text: "Nothing open right now. Need something?", action_text: "Ask for it", action_path: new_portal_request_path, action_frame: "modal" %>
<% else %>
  <%= render "layouts/shared/empty", text: (@state == "done" ? "Nothing done yet." : "No " + term(:task, count: 2).downcase + " to show yet.") %>
<% end %>
