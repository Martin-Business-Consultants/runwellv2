<% @page_title = term(:task, count: 2) %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">What we are working on for you. Drag them into the order that matters most to you: we’ll see it.</p>
<% end %>

<%# Open by default (the filter swaps ?status=); a task opens in the side sheet, read-only. %>
<div class="portal-filter">
  <%= render "layouts/shared/segmented_filter", label: "Show " + term(:task, count: 2).downcase, param: :status, current: @state,
        options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ], counts: @counts %>
</div>

<% if @tasks.any? %>
  <%# In the client's order of priority (ClientPrioritized), each row dragged by its grip. %>
  <% sortable = !Current.previewing? && @tasks.size > 1 %>
  <section class="card card--flush portal-card" data-controller="drag-and-drop" data-drag-and-drop-dragged-item-class="portal-sortable--dragging" data-drag-and-drop-hover-container-class="portal-sortable--hover" data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
    <div class="table-wrap">
      <table class="table portal-table" data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= portal_task_priority_path("__id__") %>">
        <thead>
          <tr>
            <th class="portal-sortable__grip-cell"><span class="visually-hidden">Order</span></th>
            <th>Title</th>
            <th class="portal-table__secondary"><%= term(:work) %></th>
            <th class="portal-table__date">Due</th>
            <th class="portal-table__status">Status</th>
          </tr>
        </thead>
        <tbody data-drag-drop-item-container>
          <% @tasks.each do |task| %>
            <%# herb:key task.id %>
            <tr data-drag-and-drop-target="item" data-id="<%= task.id %>">
              <td class="portal-sortable__grip-cell">
                <% if sortable %>
                  <span class="portal-sortable__grip" draggable="true" title="Drag to put <%= task.title %> in your order"><%= icon_tag "grip" %></span>
                <% end %>
              </td>
              <td class="portal-table__title"><%= portal_task_link_to(task) { task.title } %></td>
              <td class="portal-table__secondary muted">
                <% if task.work %>
                  <%= link_to task.work.title, portal_work_path(task.work), class: "portal-table__link", draggable: "false" %>
                <% else %>
                  General
                <% end %>
              </td>
              <td class="portal-table__date muted nowrap">
                <% if task.due_on %>
                  <%= l task.due_on, format: :short %>
                <% end %>
              </td>
              <td class="portal-table__status"><%= status_tag task.status.humanize, highlight: task.status == "done" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% else %>
  <%= render "layouts/shared/empty", text: (@state == "done" ? "Nothing done yet." : @state == "open" ? "Nothing open right now." : "No " + term(:task, count: 2).downcase + " to show yet.") %>
<% end %>
