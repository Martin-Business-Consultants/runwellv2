<%# locals: (task:) %>
<%# A shared task in the portal's side sheet: the staff panel's component (tasks/_panel), in two
    halves. Above, read-only and only what the client may see: where it sits, its status and date,
    what they asked, its description, its client-visible documents and custom fields. Below, the
    discussion: the notes either side shared on it (Note.discussion), oldest first, and a reply in
    the editor (Portal::Tasks::NotesController). Staff viewing as the client see the editor as the
    client does, with Send off: a preview writes nothing. Esc or ✕ closes it. Opening it reads its
    discussion (Portal::BaseController), so the dot on its row wherever it's listed comes off. %>
<section class="task-panel portal-task" data-morph="replace" id="<%= dom_id(task, :portal_panel) %>" aria-label="<%= task.title %>">
  <turbo-stream action="remove" targets="[data-unread-task='<%= task.id %>']"><template></template></turbo-stream>
  <header class="task-panel__header">
    <p class="task-panel__context">
      <% if task.work %>
        <%= link_to task.work.title, portal_work_path(task.work), data: { turbo_frame: "_top" } %>
      <% else %>
        <span><%= term(:task) %></span>
      <% end %>
    </p>
    <div class="task-panel__actions">
      <button type="button" class="ui-button" data-variant="ghost" data-size="icon-sm" title="Close (Esc)" aria-label="Close" data-keys="esc" data-action="side-panel#close keydown.esc@document->side-panel#close">
        <%= icon_tag "close" %>
      </button>
    </div>
  </header>

  <div class="portal-task__about">
  <h2 class="task-panel__title task-panel__title--static"><%= task.title %></h2>

  <dl class="task-panel__details">
    <dt>Status</dt><dd><%= portal_status_tag(task) %></dd>
    <% if task.status == "done" && task.completed_at %>
      <dt>Done</dt><dd><%= l task.completed_at.in_time_zone.to_date, format: :long %></dd>
    <% else %>
      <dt>Due</dt>
      <dd>
        <% if task.due_on %>
          <%= portal_due(task, format: :long) %>
        <% else %>
          <span class="portal-muted">No date</span>
        <% end %>
      </dd>
    <% end %>
    <% people = portal_task_people(task) %>
    <% if people %>
      <dt>With</dt><dd><%= people %></dd>
    <% end %>
    <% if task.scope_item %>
      <dt><%= term(:scope_item) %></dt><dd><%= task.scope_item.description %></dd>
    <% end %>
    <% if task.contact && task.contact.client_id == current_contact.client_id %>
      <dt>Asked by</dt><dd><%= task.contact.name %></dd>
    <% end %>
  </dl>

  <div class="task-panel__description">
    <% if task.description.present? %>
      <div class="record-card__prose"><%= rich_text task.description %></div>
    <% else %>
      <p class="portal-muted">No description.</p>
    <% end %>
  </div>

  <%= render "custom_fields/values", record: task, client: true %>

  <%# What a plugin adds to a shared task for the client (:portal_task): something to decide or do on it. %>
  <%= plugin_slots(:portal_task, task: task, contact: current_contact) %>

  <% documents = task.documents.client_visible.recent.includes(file_attachment: :blob).to_a %>
  <% if documents.any? %>
    <%= render "portal/works/documents", documents: documents %>
  <% end %>
  </div>

  <%= render "portal/tasks/discussion", task: task %>
</section>
