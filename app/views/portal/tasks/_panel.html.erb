<%# locals: (task:) %>
<%# A shared task in the portal's side sheet: the staff panel's component (tasks/_panel), in two
    halves. Above, read-only and only what the client may see: where it sits, its status and date,
    what they asked, its description, its client-visible documents and custom fields. Below, the
    discussion: the notes either side shared on it (Note.discussion), oldest first, and a reply in
    the editor (Portal::Tasks::NotesController). Staff viewing as the client see the editor as the
    client does, with Send off: a preview writes nothing. Esc or ✕ closes it. %>
<section class="task-panel portal-task" id="<%= dom_id(task, :portal_panel) %>" aria-label="<%= task.title %>">
  <header class="task-panel__header">
    <p class="task-panel__context">
      <% if task.work %>
        <%= link_to task.work.title, portal_work_path(task.work), data: { turbo_frame: "_top" } %>
      <% else %>
        <span><%= term(:task) %></span>
      <% end %>
    </p>
    <div class="task-panel__actions">
      <button type="button" class="icon-button" title="Close (Esc)" data-keys="esc" data-action="side-panel#close keydown.esc@document->side-panel#close">
        <%= icon_tag "close" %>
        <span class="visually-hidden">Close</span>
      </button>
    </div>
  </header>

  <div class="portal-task__about">
  <h2 class="task-panel__title task-panel__title--static"><%= task.title %></h2>

  <dl class="details task-panel__details">
    <dt>Status</dt><dd><%= status_tag task.status.humanize, highlight: task.status == "done" %></dd>
    <dt>Due</dt>
    <dd>
      <% if task.due_on %>
        <%= l task.due_on, format: :long %>
      <% else %>
        <span class="muted">No date</span>
      <% end %>
    </dd>
    <% if task.scope_item %>
      <dt><%= term(:scope_item) %></dt><dd><%= task.scope_item.description %></dd>
    <% end %>
    <% if task.contact && task.contact.client_id == current_contact.client_id %>
      <dt>Asked by</dt><dd><%= task.contact.name %></dd>
    <% end %>
  </dl>

  <div class="task-panel__description">
    <% if task.description.present? %>
      <div class="record-card__prose"><%= rich_text task.description %></div>
    <% else %>
      <p class="muted">No description.</p>
    <% end %>
  </div>

  <%= render "custom_fields/values", record: task, client: true %>

  <% documents = task.documents.select(&:client_visible) %>
  <% if documents.any? %>
    <%= render "portal/works/documents", documents: documents %>
  <% end %>
  </div>

  <% messages = task.notes.discussion.includes(:author) %>
  <section class="portal-task__discussion" aria-label="Discussion">
    <h3 class="portal-task__discussion-title">Discussion</h3>
    <% if messages.any? %>
      <ol class="portal-thread">
        <% messages.each do |note| %>
          <%# herb:key note.id %>
          <li class="<%= class_names("portal-thread__message", "portal-thread__message--mine": note.author_id == current_contact.id) %>">
            <p class="portal-thread__meta">
              <strong><%= note.author&.display_name || "The team" %></strong>
              <time datetime="<%= note.occurred_at.iso8601 %>"><%= l(note.occurred_at.in_time_zone, format: :short) %></time>
            </p>
            <div class="portal-thread__text"><%= rich_text note.body %></div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <p class="muted portal-thread__empty">Nothing here yet. Ask a question or add something, and the team sees it on this <%= term(:task).downcase %>.</p>
    <% end %>
    <%= form_with url: portal_task_notes_path(task), scope: :note, class: "portal-thread__reply", namespace: dom_id(task, :portal_reply),
          data: { controller: "form", action: "turbo:submit-end->form#resetOnSuccess" } do |form| %>
      <%= rich_text_field_tag form.field_name(:body), nil, id: form.field_id(:body), placeholder: "Write a message…" %>
      <div class="portal-thread__actions">
        <% if Current.previewing? %>
          <span class="portal-thread__preview muted small">You’re viewing as <%= current_contact.name %>, so nothing is sent.</span>
        <% end %>
        <%= tag.button "Send", type: "submit", class: "btn btn--primary btn--sm", disabled: Current.previewing? %>
      </div>
    <% end %>
  </section>
</section>
