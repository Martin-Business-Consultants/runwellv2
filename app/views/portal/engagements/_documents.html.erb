<%# locals: (documents:) %>
<% if documents.any? %>
  <section class="settings__section">
    <header>
      <h2 class="divider">Documents</h2>
    </header>

    <ul class="settings__scrollable-list">
      <% documents.each do |document| %>
        <%# herb:key document.id %>
        <li class="flex align-center gap-half">
          <%= render "documents/link", document: document, meta: "#{number_to_human_size(document.byte_size)} · #{l document.created_at.to_date, format: :long}" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
