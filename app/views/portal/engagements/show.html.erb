<% @page_title = "#{@engagement.ref} #{@engagement.title}" %>

<% content_for :header do %>
  <%= parent_page term(:engagement, count: 2), portal_root_path %>
  <nav aria-label="Breadcrumb">
    <ol class="ui-breadcrumb">
      <li><%= link_to term(:engagement, count: 2), portal_root_path %></li>
      <li><span aria-current="page"><%= @engagement.ref %></span></li>
    </ol>
  </nav>
  <h1 class="page-title"><%= @page_title %></h1>
  <div class="portal-page-header__meta">
    <%= status_tag @engagement.state_label, highlight: @engagement.active? %>
  </div>
<% end %>

<% items = @engagement.scope_items %>
<% todos = @engagement.todos.client_visible %>
<% panels = plugin_slots(:portal_engagement_panel, engagement: @engagement) %>

<div class="portal-grid">
  <div class="portal-grid__main">
    <% if @engagement.description.present? %>
      <section class="ui-card portal-card">
        <header class="ui-card__header">
          <h2 class="ui-card__title">Overview</h2>
        </header>
        <div class="ui-card__content portal-prose">
          <%= rich_text @engagement.description %>
        </div>
      </section>
    <% end %>

    <section class="ui-card ui-card--flush portal-card">
      <header class="ui-card__header ui-card__header--bordered">
        <h2 class="ui-card__title"><%= term(:scope_item, count: 2) %></h2>
        <p class="ui-card__description">What this covers, and how far along each part is.</p>
      </header>
      <% if items.any? %>
        <ul class="ui-item-group">
          <% items.each do |item| %>
            <%# herb:key item.id %>
            <li class="ui-item ui-item--sm">
              <div class="ui-item__content">
                <p class="ui-item__title"><%= item.description %></p>
              </div>
              <div class="ui-item__actions">
                <%= status_tag item.delivery_state.humanize, highlight: item.delivery_state == "done" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="portal-card__empty">Nothing listed yet.</p>
      <% end %>
    </section>

    <section class="ui-card ui-card--flush portal-card">
      <header class="ui-card__header ui-card__header--bordered">
        <h2 class="ui-card__title"><%= term(:work) %></h2>
        <p class="ui-card__description">What we’re doing on it for you.</p>
      </header>
      <% if todos.any? %>
        <ul class="ui-item-group">
          <% todos.each do |todo| %>
            <%# herb:key todo.id %>
            <li class="ui-item ui-item--sm">
              <div class="ui-item__content">
                <p class="ui-item__title"><%= todo.title %></p>
                <% if todo.due_on %>
                  <p class="ui-item__description">Due <%= l todo.due_on, format: :short %></p>
                <% end %>
              </div>
              <div class="ui-item__actions">
                <%= status_tag todo.status.humanize, highlight: todo.status == "done" %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="portal-card__empty">No work to show yet.</p>
      <% end %>
    </section>
  </div>

  <aside class="portal-grid__side">
    <section class="ui-card portal-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">Details</h2>
      </header>
      <div class="ui-card__content">
        <dl class="portal-facts">
          <div class="portal-facts__row">
            <dt>Type</dt>
            <dd><%= @engagement.label_name %></dd>
          </div>
        </dl>
        <%= render "custom_fields/values", record: @engagement, client: true %>
      </div>
    </section>

    <%= render "portal/engagements/documents", documents: @engagement.client_documents %>

    <% if panels.present? %>
      <section class="ui-card portal-card portal-slot">
        <%= panels %>
      </section>
    <% end %>
  </aside>
</div>
