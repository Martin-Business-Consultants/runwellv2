<% @page_title = "Documents" %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">Every file we’ve shared with you, newest first.</p>
<% end %>

<% if @documents.any? || params[:q].present? %>
  <div class="portal-filter">
    <%= portal_search "Search documents by name" %>
  </div>
<% end %>

<% if @documents.any? %>
  <%= portal_card flush: true do %>
    <ul class="portal-list portal-documents">
      <% @documents.each do |document| %>
        <%# herb:key document.id %>
        <li class="portal-row">
          <%= render "documents/link", document: document, meta: portal_document_meta(document) %>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= table_pagination @page %>
<% elsif params[:q].present? %>
  <%= render "layouts/shared/empty", text: "No file’s name matches “#{params[:q]}”." %>
<% else %>
  <%= render "layouts/shared/empty", text: "Nothing shared yet. Files we share with you show here." %>
<% end %>
