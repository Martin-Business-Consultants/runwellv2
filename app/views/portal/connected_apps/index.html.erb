<% @page_title = "Connected apps" %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">Your own assistant (Muse, Claude, ChatGPT and the like) can see what you see here and ask us for things, as you.</p>
<% end %>

<div class="portal-stack">
  <% if @new_token %>
    <%= portal_card title: "Your new token", hint: "Copy it now: it won’t be shown again. It acts as you, in this portal only, until you disconnect it.", css: "portal-card--highlight" do %>
        <div class="portal-copy">
          <code><%= @new_token.plaintext %></code>
          <%= ui :button, type: :button, variant: :outline, content: safe_join([ icon_tag("copy-paste"), tag.span("Copy") ]),
                data: { controller: "copy-to-clipboard", copy_to_clipboard_content_value: @new_token.plaintext, copy_to_clipboard_success_class: "portal-copied", action: "copy-to-clipboard#copy" } %>
        </div>
    <% end %>
  <% end %>

  <%= portal_card title: "Your AI, connected", hint: "Everything it does is recorded as done through it.", flush: true do %>
    <% if @tokens.any? %>
      <ul class="portal-list">
        <% @tokens.each do |token| %>
          <%# herb:key token.id %>
          <li class="portal-row">
            <div class="portal-row__content">
              <p class="portal-row__title portal-token__title">
                <span class="portal-token__name"><%= token.name %></span>
                <% if token.paused? %>
                  <%= status_tag "Paused" %>
                <% end %>
              </p>
              <p class="portal-row__desc">
                <%= token.kind == "oauth" ? "Connected app" : "Personal token" %><%= " · read only" if token.read_only? %> · <%= token.last_used_at ? "last used #{time_ago_in_words(token.last_used_at)} ago" : "never used" %>
              </p>
            </div>
            <div class="portal-row__actions">
              <%= render "layouts/shared/delete_dialog", name: token.name, path: portal_connected_app_path(token),
                    message: "It stops working at once. Anything it already did stays." %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "Nothing is connected yet." %>
    <% end %>
  <% end %>

  <%= portal_card title: "Connect one", hint: "Give your assistant this address. If it can sign in by itself, it sends you here to approve it, after the usual emailed sign-in link.", css: "portal-stack" do %>
      <%= code_block portal_mcp_url %>
      <p class="portal-muted">If it asks for a key instead (Muse does, for a server you describe to it), make one here and paste it in.</p>
      <%= form_with url: portal_connected_apps_path, scope: :access_token, class: "portal-token-form" do |form| %>
        <%= form.text_field :name, class: "portal-token-form__name", autocomplete: "off", placeholder: "Name it, like “Muse”", aria: { label: "Token name" } %>
        <%= form.ui :checkbox, :read_only, label: "Read only" %>
        <%= ui :button, type: :submit, content: "Make a key" %>
      <% end %>
  <% end %>
</div>
