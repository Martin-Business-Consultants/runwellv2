<% @page_title = "Connect " + @client.name %>

<div class="auth auth--wide">
  <% hint = capture do %><strong class="auth__strong"><%= @client.name %></strong> will act as you, <strong class="auth__strong"><%= current_contact.name %></strong>, in <%= Setting.current.brand_name %>’s portal for <%= current_contact.client.name %>:
        seeing your <%= term(:work, count: 2).downcase %>, <%= term(:task, count: 2).downcase %> and documents, and sending requests.<% end %>
  <%= auth_card title: "Connect #{@client.name}?", hint: hint do %>
      <p class="auth__muted">
        It sees only what you see here. What it does is marked as done through <%= @client.name %>. You can disconnect it any time under Connected apps.
      </p>

      <%= form_with url: portal_oauth_authorization_path, method: :post, class: "auth__form", data: { turbo: false } do %>
        <%= ui :field, label: "Read only", description: "It can look, and change nothing.",
              control: ui(:checkbox, name: "read_only", value: "1", id: "read_only", checked: params[:scope].to_s.split.include?("runwell:read")), control_id: "read_only" %>
        <% %w[client_id redirect_uri response_type code_challenge code_challenge_method state scope resource].each do |key| %>
          <%# herb:key key %>
          <input type="hidden" name="<%= key %>" value="<%= params[key] %>">
        <% end %>
        <div class="auth__actions">
          <%= ui :button, type: :submit, variant: :outline, content: "Cancel", name: "approve", value: "0" %>
          <%= ui :button, type: :submit, content: "Connect", name: "approve", value: "1" %>
        </div>
      <% end %>

      <p class="auth__return">
        Returning to
        <% if OauthClient.loopback?(@redirect_uri) %>
          <%= @client.name %> on this computer
        <% else %>
          <%= URI(@redirect_uri).host %>
        <% end %>
      </p>
  <% end %>
</div>
