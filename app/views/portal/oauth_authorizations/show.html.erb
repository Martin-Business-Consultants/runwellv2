<% @page_title = "Connect " + @client.name %>

<div class="auth auth--wide">
  <section class="card auth__card">
    <header class="card__head auth__header">
      <h1 class="card__title auth__title">Connect <%= @client.name %>?</h1>
      <p class="card__hint">
        <strong class="auth__strong"><%= @client.name %></strong> will act as you, <strong class="auth__strong"><%= current_contact.name %></strong>, in <%= Setting.current.brand_name %>’s portal for <%= current_contact.client.name %>:
        seeing your <%= term(:work, count: 2).downcase %>, <%= term(:task, count: 2).downcase %> and documents, and sending requests.
      </p>
    </header>

    <div class="card__content auth__content">
      <p class="muted">
        It sees only what you see here. What it does is marked as done through <%= @client.name %>. You can disconnect it any time under Connected apps.
      </p>

      <%= form_with url: portal_oauth_authorization_path, method: :post, class: "auth__form", data: { turbo: false } do %>
        <div class="field">
          <label class="checkbox">
            <%= check_box_tag :read_only, "1", params[:scope].to_s.split.include?("runwell:read"), id: "read_only" %>
            <span class="field__label">Read only</span>
          </label>
          <p class="field__hint">It can look, and change nothing.</p>
        </div>
        <% %w[client_id redirect_uri response_type code_challenge code_challenge_method state scope resource].each do |key| %>
          <%# herb:key key %>
          <input type="hidden" name="<%= key %>" value="<%= params[key] %>">
        <% end %>
        <div class="auth__actions">
          <button type="submit" name="approve" value="0" class="btn btn--secondary">Cancel</button>
          <button type="submit" name="approve" value="1" class="btn btn--primary">Connect</button>
        </div>
      <% end %>

      <p class="faint small auth__return">
        Returning to
        <% if OauthClient.loopback?(@redirect_uri) %>
          <%= @client.name %> on this computer
        <% else %>
          <%= URI(@redirect_uri).host %>
        <% end %>
      </p>
    </div>
  </section>
</div>
