<% @page_title = "Sign in" %>
<% content_for :showcase, "client" %>

<div class="auth">
  <%= auth_card title: "Sign in as #{@link_contact.name}", hint: @link_contact.email do %>
      <%= button_to "Sign in", portal_session_link_path(params[:token], return_to: params[:return_to].presence), class: "ui-button auth__button", data: { variant: "default", size: "default" }, form_class: "auth__form" %>
  <% end %>
</div>
