<% @page_title = term(:client) + " sign in" %>
<% content_for :showcase, "client" %>

<div class="auth">
  <section class="card auth__card <%= "auth__card--shake" if flash[:alert] %>">
    <header class="card__head auth__header">
      <h1 class="card__title auth__title">Sign in to your portal</h1>
      <p class="card__hint">Enter the email we have for you and we’ll send you a link. No password needed.</p>
    </header>

    <div class="card__content auth__content">
      <%= form_with url: portal_session_path, class: "auth__form" do |form| %>
        <div class="field">
          <%= form.label :email, "Email", class: "field__label" %>
          <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>

        <%= bot_check_tag %>
        <button type="submit" class="btn btn--primary btn--block">
          <%= icon_tag "email" %>
          <span>Email me a link</span>
        </button>
      <% end %>
    </div>
  </section>
</div>

<% content_for :footer do %>
  <p class="auth-footer">Your portal at <%= Setting.current.brand_name %>: everything we’re doing for you, and a way to ask for anything.</p>
<% end %>
