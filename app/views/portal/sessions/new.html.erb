<% @page_title = "Client sign in" %>

<div class="auth">
  <section class="ui-card auth__card <%= "shake" if flash[:alert] %>">
    <header class="ui-card__header auth__header">
      <h1 class="ui-card__title auth__title">Client sign in</h1>
      <p class="ui-card__description">Enter the email we have on file and we’ll send you a sign-in link. No password needed.</p>
    </header>

    <div class="ui-card__content auth__content">
      <%= form_with url: portal_session_path, class: "auth__form" do |form| %>
        <div class="ui-field">
          <%= form.label :email, "Email", class: "ui-label" %>
          <%= form.email_field :email, required: true, class: "ui-input", autofocus: true, autocomplete: "email", placeholder: "you@example.com" %>
        </div>

        <button type="submit" class="ui-button ui-button--block">
          <%= icon_tag "email" %>
          <span>Email me a link</span>
        </button>
      <% end %>
    </div>
  </section>
</div>
