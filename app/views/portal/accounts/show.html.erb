<% @page_title = "Your account" %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">How we know you at <%= client.name %>, what we email you, and where you’re signed in.</p>
<% end %>

<div class="portal-stack portal-account">
  <%= render "layouts/shared/errors", record: current_contact %>
  <% details_hint = capture do %>You sign in as <strong><%= current_contact.email %></strong>. To change that address, ask us.<% end %>
  <%= portal_card title: "Your details", hint: details_hint do %>
      <%= form_with model: current_contact, scope: :account, url: portal_account_path, method: :patch, class: "portal-form" do |form| %>
        <%= form.ui :field, :name, label: "Name" do %>
          <%= form.text_field :name, required: true, autocomplete: "name" %>
        <% end %>
        <div class="form-grid">
          <%= form.ui :field, :title, label: "Job title" do %>
            <%= form.text_field :title, autocomplete: "organization-title" %>
          <% end %>
          <%= form.ui :field, :phone, label: "Phone" do %>
            <%= form.telephone_field :phone, autocomplete: "tel" %>
          <% end %>
        </div>
        <%= switch_field form, :portal_emails, label: "Email me about my work", hint: "When we write to you on something, pick up or finish what you asked for, or share a file. Sign-in links always come." %>
        <div class="form-actions">
          <%= ui :button, type: :submit, content: "Save", disabled: Current.previewing? %>
        </div>
      <% end %>
  <% end %>

  <% sign_out = capture do %>
    <% if @sessions.size > 1 %>
      <%= button_to "Sign out everywhere else", portal_account_sessions_path, method: :delete, class: "ui-button", data: { variant: "outline", size: "sm" } %>
    <% end %>
  <% end %>
  <%= portal_card title: "Where you’re signed in", hint: "A browser nobody has used in three months is signed out by itself.", action: sign_out, flush: true do %>
    <% if @sessions.any? %>
      <ul class="portal-list">
        <% @sessions.each do |session_record| %>
          <%# herb:key session_record.id %>
          <li class="portal-row">
            <div class="portal-row__content">
              <p class="portal-row__title"><%= portal_browser_name(session_record.user_agent) %><% if session_record.id == Current.portal_session&.id %> <%= status_tag "This one", highlight: true %><% end %></p>
              <p class="portal-row__desc">Signed in <%= l session_record.created_at.in_time_zone.to_date, format: :long %> · last used <%= time_ago_in_words(session_record.updated_at) %> ago</p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "No browser is signed in." %>
    <% end %>
  <% end %>
</div>
