<% @page_title = term(:work, count: 2) %>

<% content_for :header do %>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <p class="portal-page-header__description">Everything we run for you, and where each one stands. Put them in the order that matters most to you: we’ll see it.</p>
<% end %>

<%# The client's work fills the main column. Beside it, whatever plugins add to this page: a
    dashboard for the client (:portal_dashboard: what's new, what's coming up; the core draws none
    of its own) and their other cards (:portal_home). With neither, the work takes the page. %>
<% dashboard = visible_plugin_slots(:portal_dashboard, client: current_contact.client, contact: current_contact) %>
<% plugins = visible_plugin_slots(:portal_home, client: current_contact.client) %>
<div class="<%= class_names("portal-grid", "portal-grid--alone": dashboard.blank? && plugins.blank?) %>">
  <div class="portal-grid__main">
    <%# Active work by default; the filter swaps ?state=. %>
    <div class="portal-filter">
      <%= render "layouts/shared/segmented_filter", label: "Show " + term(:work, count: 2).downcase, param: :state, current: @state,
            options: [ [ "Active", "active" ], [ "Closed", "closed" ], [ "All", "all" ] ], counts: @counts %>
    </div>

    <% if @works.any? %>
      <%# In the client's order of priority (ClientPrioritized): each row drags by its grip (the core's
          drag-and-drop), posting the row it now sits above; the keys and, on touch, buttons move it
          too. Staff viewing as them see the grips inactive. Beside each, how far along it is from the
          tasks shared with them, and the next date due. %>
      <% sortable = @works.size > 1 %>
      <section class="card card--flush portal-card" data-controller="drag-and-drop" data-drag-and-drop-dragged-item-class="portal-sortable--dragging" data-drag-and-drop-hover-container-class="portal-sortable--hover" data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
        <div class="table-wrap">
          <table class="table portal-table" data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= portal_work_priority_path("__id__") %>">
            <thead>
              <tr>
                <th>Title</th>
                <th class="portal-table__secondary">Type</th>
                <th class="portal-table__progress">Done</th>
                <th class="portal-table__date portal-table__secondary">Next due</th>
                <th class="portal-table__status">Status</th>
              </tr>
            </thead>
            <tbody data-drag-drop-item-container>
              <% @works.each do |work| %>
                <%# herb:key work.id %>
                <% progress = @progress[work.id] %>
                <tr data-drag-and-drop-target="item" data-id="<%= work.ref %>">
                  <td class="portal-table__title portal-sortable__cell">
                    <% if sortable %>
                      <%= portal_priority_grip(work.title) %>
                    <% end %>
                    <%= link_to work.title, portal_work_path(work), class: "row-link", draggable: "false" %>
                  </td>
                  <td class="portal-table__secondary"><%= badge work.label_name, tone: :outline %></td>
                  <td class="portal-table__progress"><%= portal_progress(progress) %></td>
                  <td class="portal-table__date portal-table__secondary muted nowrap">
                    <% if progress[:next_due] %>
                      <span class="<%= class_names("portal-due", "portal-due--late": progress[:next_due] < Date.current) %>"><%= l progress[:next_due], format: :short %></span>
                    <% end %>
                  </td>
                  <td class="portal-table__status"><%= status_tag work.state_label, highlight: work.active? %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% elsif @state == "active" %>
      <%= render "layouts/shared/empty", text: "Nothing active right now. Need something?", action_text: "Ask for it", action_path: new_portal_request_path, action_frame: "modal" %>
    <% else %>
      <%= render "layouts/shared/empty", text: { "closed" => "Nothing closed yet." }.fetch(@state, "Nothing here yet.") %>
    <% end %>
  </div>

  <% if dashboard.present? || plugins.present? %>
    <aside class="portal-grid__side">
      <% if dashboard.present? %>
        <section class="portal-dashboard portal-slot">
          <%= dashboard %>
        </section>
      <% end %>
      <% if plugins.present? %>
        <section class="card portal-card portal-slot">
          <%= plugins %>
        </section>
      <% end %>
    </aside>
  <% end %>
</div>
