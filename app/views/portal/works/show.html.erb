<% @page_title = "#{@work.ref} #{@work.title}" %>

<% content_for :header do %>
  <%= parent_page term(:work, count: 2), portal_root_path %>
  <nav class="crumbs portal-page-header__crumbs" aria-label="Breadcrumb">
    <%= link_to term(:work, count: 2), portal_root_path %>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current" aria-current="page"><%= @work.ref %></span>
  </nav>
  <h1 class="portal-page-header__title"><%= @page_title %></h1>
  <div class="portal-page-header__meta">
    <%= status_tag @work.state_label, highlight: @work.active? %>
    <% if Current.previewing? %>
      <%= render "record_fields/arrange_button" %>
    <% end %>
  </div>
<% end %>

<%# Its cards in the order an owner arranged them while viewing the portal as a client (template
    mode, RecordLayout "portal_work"; hidden ones left out). The arranging bar and button show only
    then: a client never sees them. %>
<% layout = record_layout(:portal_work) %>
<div class="portal-grid" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:portal_work) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <% if Current.previewing? %>
    <%= render "record_fields/arrange", layout: layout, noun: "this page’s" %>
  <% end %>
  <div class="portal-grid__main" data-record-layout-target="zone" data-zone="main">
    <% layout.main.each do |key| %>
      <%# herb:key key %>
      <div class="layout-field" data-layout-key="<%= key %>" data-layout-label="<%= layout_field_label(layout, key) %>">
        <% if key == "tasks" %>
          <%= render "portal/works/cards/tasks", work: @work, state: @task_state %>
        <% else %>
          <%= render "portal/works/cards/#{key}", work: @work %>
        <% end %>
      </div>
    <% end %>
  </div>

  <aside class="portal-grid__side" data-record-layout-target="zone" data-zone="aside">
    <% layout.aside.each do |key| %>
      <%# herb:key key %>
      <div class="layout-field" data-layout-key="<%= key %>" data-layout-label="<%= layout_field_label(layout, key) %>">
        <% if key == "tasks" %>
          <%= render "portal/works/cards/tasks", work: @work, state: @task_state %>
        <% else %>
          <%= render "portal/works/cards/#{key}", work: @work %>
        <% end %>
      </div>
    <% end %>
  </aside>
</div>
