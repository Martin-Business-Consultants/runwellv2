<%# locals: (work:, state:, section: nil) %>
<%# The tasks shared with the client, open by default (the filter swaps ?tasks=), grouped by section
    in the client's order and, within each, in their order of priority (ClientPrioritized: one
    order for all their tasks, the same as on Tasks). Each drags by its grip within its section;
    each opens in the side sheet, read-only. section: only that section's tasks (picked in the
    sections card). %>
<% shared = work.tasks.client_visible %>
<% shared = shared.where(scope_item_id: section.id) if section %>
<% counts = { "open" => shared.open.count, "done" => shared.where(status: "done").count, "all" => shared.count } %>
<% tasks = Task.state_scope(shared, state).by_client_priority.order(:due_on, :position, :id).to_a %>
<% by_section = tasks.group_by(&:scope_item_id) %>
<% groups = ScopeItem.in_client_order(work.scope_items).filter_map { |item| [ item.description, by_section[item.id], dom_id(item, :tasks) ] if by_section[item.id] } %>
<% groups << [ (groups.any? ? "Other " + term(:task, count: 2).downcase : nil), by_section[nil], "other_tasks" ] if by_section[nil] %>
<% sortable = true %>
<% title = capture do %>
  <% if section %>
    <h2 class="portal-card__title"><%= section.description %></h2>
  <% else %>
    <%= layout_text_tag record_layout(:portal_work), "tasks.title", term(:task, count: 2), class: "portal-card__title" %>
  <% end %>
<% end %>
<% hint = capture do %>
  <%= layout_text_tag record_layout(:portal_work), "tasks.hint", "What we’re doing on it for you.", tag: :span, class: "portal-card__hint" %>
  <% if tasks.size > 1 %>
    <span class="portal-card__hint portal-sortable__hint">Move them by <%= icon_tag "grip" %> into the order that matters most to you.</span>
  <% end %>
<% end %>
<% filter = render("layouts/shared/segmented_filter", label: "Show " + term(:task, count: 2).downcase, param: :tasks, current: state,
     options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ], counts: counts) %>
<%= portal_card title: title, hint: hint, action: filter, flush: true do %>
  <% if tasks.any? %>
    <% groups.each do |heading, group, anchor| %>
      <%# herb:key anchor %>
      <%# Its own drag-and-drop, so a task moves only within its section. %>
      <div class="portal-task-group" id="<%= anchor %>" data-controller="drag-and-drop" data-drag-and-drop-dragged-item-class="portal-sortable--dragging" data-drag-and-drop-hover-container-class="portal-sortable--hover" data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
        <% if heading && section.nil? %>
          <h3 class="portal-task-group__heading"><%= heading %></h3>
        <% end %>
        <div data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= portal_task_priority_path("__id__") %>">
          <ul class="portal-list" data-drag-drop-item-container>
            <% group.each do |task| %>
              <%# herb:key task.id %>
              <li class="portal-sortable__item" data-drag-and-drop-target="item" data-id="<%= task.id %>">
                <% if sortable && group.size > 1 %>
                  <%= portal_priority_grip(task.title) %>
                <% end %>
                <%= portal_task_link_to(task) do %>
                  <span class="portal-row">
                    <span class="portal-row__content">
                      <span class="portal-row__title"><%= task.title %> <%= portal_unread_mark(task) %></span>
                      <% if task.due_on %>
                        <span class="portal-row__desc"><%= portal_due(task, prefix: "Due ") %></span>
                      <% end %>
                    </span>
                    <span class="portal-row__actions">
                      <%= portal_status_tag(task) %>
                    </span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= ui :empty, size: :sm, description: (state == "done" ? "Nothing done yet." : "Nothing open right now. If you need something on this, send a request.") %>
  <% end %>
<% end %>
