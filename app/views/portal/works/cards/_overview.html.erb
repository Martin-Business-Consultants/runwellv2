<%# locals: (work:) %>
<% if work.description.present? %>
  <section class="card portal-card">
    <header class="card__head">
      <%= layout_text_tag record_layout(:portal_work), "overview.title", "Overview", class: "card__title" %>
      <%= layout_text_tag record_layout(:portal_work), "overview.hint", nil, tag: :p, class: "card__hint" %>
    </header>
    <div class="card__content portal-prose">
      <%= rich_text work.description %>
    </div>
  </section>
<% end %>
