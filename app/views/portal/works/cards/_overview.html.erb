<%# locals: (work:) %>
<% if work.description.present? %>
  <% layout = record_layout(:portal_work) %>
  <%= portal_card title: layout_text_tag(layout, "overview.title", "Overview", class: "portal-card__title"), hint: layout_text_tag(layout, "overview.hint", nil, tag: :p, class: "portal-card__hint"), css: "portal-prose" do %>
    <%= rich_text work.description %>
  <% end %>
<% end %>
