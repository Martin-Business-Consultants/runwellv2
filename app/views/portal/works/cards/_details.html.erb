<%# locals: (work:) %>
<section class="card portal-card">
  <header class="card__head">
    <%= layout_text_tag record_layout(:portal_work), "details.title", "Details", class: "card__title" %>
    <%= layout_text_tag record_layout(:portal_work), "details.hint", nil, tag: :p, class: "card__hint" %>
  </header>
  <div class="card__content">
    <dl class="details portal-details">
      <dt>Type</dt>
      <dd><%= work.label_name %></dd>
    </dl>
    <%= render "custom_fields/values", record: work, client: true %>
  </div>
</section>
