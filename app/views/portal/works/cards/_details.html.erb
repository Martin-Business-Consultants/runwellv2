<%# locals: (work:) %>
<% layout = record_layout(:portal_work) %>
<%= portal_card title: layout_text_tag(layout, "details.title", "Details", class: "portal-card__title"), hint: layout_text_tag(layout, "details.hint", nil, tag: :p, class: "portal-card__hint") do %>
  <dl class="portal-details">
    <dt>Type</dt>
    <dd><%= work.label_name %></dd>
  </dl>
  <%= render "custom_fields/values", record: work, client: true %>
<% end %>
