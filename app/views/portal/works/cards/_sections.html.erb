<%# locals: (work:, current: nil) %>
<%# The work's sections in the client's order of priority (ClientPrioritized), down the side of the
    page: each drags by its grip into the order that matters most to them, which the team sees, and
    the tasks beside follow it. Clicking one shows only its tasks (?section=, current: the one chosen),
    and All shows them all again. Staff viewing as them see the grips inactive. %>
<% items = ScopeItem.in_client_order(work.scope_items) %>
<% sortable = items.size > 1 %>
<% hint = capture do %>
  <%= layout_text_tag record_layout(:portal_work), "sections.hint", "What this covers, and how far along each part is.", tag: :span, class: "portal-card__hint" %>
  <% if sortable %>
    <span class="portal-card__hint portal-sortable__hint">Move them by <%= icon_tag "grip" %> into the order that matters most to you; we’ll see it.</span>
  <% end %>
<% end %>
<%= portal_card title: layout_text_tag(record_layout(:portal_work), "sections.title", term(:scope_item, count: 2), class: "portal-card__title"), hint: hint, flush: true,
      data: { controller: "drag-and-drop", drag_and_drop_dragged_item_class: "portal-sortable--dragging", drag_and_drop_hover_container_class: "portal-sortable--hover",
              action: "dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd" } do %>
  <% if items.any? %>
    <%= link_to url_for(request.query_parameters.except("section")), class: "portal-row portal-section-filter", aria: { current: current ? "false" : "page" }, data: { turbo_action: "replace" } do %>
      <span class="portal-row__content"><span class="portal-row__title">All <%= term(:task, count: 2).downcase %></span></span>
    <% end %>
    <div data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= portal_scope_item_priority_path("__id__") %>">
      <ul class="portal-list" data-drag-drop-item-container>
        <% items.each do |item| %>
          <%# herb:key item.id %>
          <li class="portal-row portal-sortable__item portal-section-filter" data-drag-and-drop-target="item" data-id="<%= item.id %>"<% if current&.id == item.id %> aria-current="page"<% end %>>
            <% if sortable %>
              <%= portal_priority_grip(item.description) %>
            <% end %>
            <div class="portal-row__content">
              <a href="<%= url_for(request.query_parameters.merge("section" => item.id)) %>" class="portal-row__title portal-section-link" data-turbo-action="replace"><%= item.description %></a>
            </div>
            <div class="portal-row__actions">
              <%= status_tag item.delivery_state.humanize, highlight: item.delivery_state == "done" %>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <%= ui :empty, size: :sm, description: "Nothing listed yet." %>
  <% end %>
<% end %>
