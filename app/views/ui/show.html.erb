<% @page_title = "UI" %>

<%= page_header "Runwell UI", "rune_ui (../rune_ui), in Runwell's theme: every colour comes from the palette, so Settings › Appearance and custom CSS reach all of it. The gem's README lists every helper." %>

<%= card "Buttons" do %>
  <%= button_row do %>
    <%= button_link "Primary", ui_path, variant: :primary %>
    <%= button_link "Accent", ui_path, variant: :primary, class: "btn--accent" %>
    <%= button_link "Secondary", ui_path %>
    <%= button_link "Ghost", ui_path, variant: :ghost %>
    <%= button_link "Danger", ui_path, variant: :danger %>
    <%= button_link "New client", ui_path, variant: :primary, icon: :plus %>
  <% end %>
  <%= button_row do %>
    <%= button_link "Small", ui_path, size: :sm %>
    <%= button_link "Small ghost", ui_path, size: :sm, variant: :ghost %>
    <%= icon_button :settings, label: "Settings" %>
    <%= icon_button :copy, label: "Copy" %>
    <button type="button" class="<%= button_classes %>" disabled>Disabled</button>
    <button type="button" class="<%= button_classes %>" aria-busy="true">Saving</button>
  <% end %>
<% end %>

<%= card "Marks" do %>
  <div class="button-row">
    <%= badge "Neutral" %>
    <%= badge "Done", tone: :ok %>
    <%= badge "Overdue", tone: :danger %>
    <%= badge "Waiting", tone: :attention %>
    <%= badge "In progress", tone: :accent %>
    <%= badge "Running", tone: :busy %>
    <%= badge "Outline", tone: :outline %>
    <%= ui_status_badge "blocked" %>
    <span class="count">3</span>
    <span class="count count--quiet">12</span>
  </div>
  <div class="button-row">
    <%= avatar "Ted Martin" %>
    <%= avatar "Priya Nair", size: :md %>
    <%= avatar "Jordan Blake", size: :lg %>
    <%= empty_avatar "Unassigned", size: :md %>
    <%= avatar_stack do %><%= avatar "Ted Martin", size: :md %><%= avatar "Sarah Producer", size: :md %><%= avatar "Marcus Webb", size: :md %><% end %>
    <%= status_dot :ok %> <%= status_dot :attention %> <%= status_dot :failed %> <%= status_dot :busy %>
    <span>Press <kbd>g</kbd> <kbd>w</kbd> for work</span>
    <span data-tooltip="A tooltip">Hover me</span>
  </div>
<% end %>

<div class="grid-2">
  <%= card "Fields", hint: "Bare inputs are styled; field() adds the label and hint." do %>
    <%= form_with url: ui_path, method: :get do |form| %>
      <%= field form, :name, hint: "As clients see it." do %><%= form.text_field :name, placeholder: "Acme" %><% end %>
      <%= field form, :status do %><%= form.select :status, %w[Active Paused] %><% end %>
      <%= field form, :notes do %><%= form.text_area :notes, rows: 3 %><% end %>
      <label class="checkbox"><%= form.check_box :portal %> Portal access</label>
    <% end %>
  <% end %>

  <%= card "Menus and dialogs" do %>
    <%= button_row do %>
      <%= menu "More" do %>
        <%= menu_label "Record" %>
        <%= menu_link "Edit", ui_path %>
        <%= menu_link "Copy for AI", ui_path %>
        <%= menu_divider %>
        <%= menu_button "Delete", ui_path, method: :get, danger: true %>
      <% end %>
      <%= popover_menu "Status", align: :start do %>
        <%= menu_link "Planned", ui_path %>
        <%= menu_link "In progress", ui_path %>
        <%= menu_link "Done", ui_path %>
      <% end %>
      <%= dialog "Rename", trigger: "Open a dialog" do %>
        <p class="muted">A dialog holds a short form or a decision.</p>
        <%= dialog_actions do %><button type="button" class="<%= button_classes(variant: :primary) %>">Save</button><% end %>
      <% end %>
      <%= sheet "Filters", trigger: "Open a sheet" do %>
        <p class="muted">A sheet slides in from the side.</p>
      <% end %>
    <% end %>
  <% end %>
</div>

<%= card "Tabs, callouts and progress" do %>
  <%= tabs([ [ "Work", ui_path, current: true, count: 4 ], [ "Notes", ui_path ], [ "History", ui_path ] ]) %>
  <%= callout "Your trial ends Friday.", tone: :attention, title: "Heads up" %>
  <%= callout "Saved.", tone: :ok %>
  <%= progress_bar 60, label: "3 of 5 done" %>
  <span class="skeleton styleguide-skeleton"></span>
<% end %>

<%= card "List", flush: true do %>
  <div class="list">
    <%= list_row ui_path, title: "Acme Storage", sub: "3 works · 12 open", meta: badge("Active", tone: :ok), avatar: avatar("Acme Storage", size: :md) %>
    <%= list_row ui_path, title: "Biofuse", sub: "1 work · 46 requests", meta: badge("Busy", tone: :attention), avatar: avatar("Biofuse", size: :md) %>
  </div>
<% end %>

<%= settings_group "Settings rows", hint: "A heading above a card of label / control rows." do %>
  <%= setting_row "Portal", hint: "Clients see their work." do %><span class="switch"><input type="checkbox" role="switch" checked aria-label="Portal"><span class="switch__track" aria-hidden="true"></span></span><% end %>
  <%= setting_row "Default view", hint: "For every index." do %><select class="select--sm" aria-label="Default view"><option>Cards</option><option>Table</option></select><% end %>
<% end %>

<%= empty_state "No clients yet. They come from the quick action (g c n)." do %>
  <%= button_link "New client", ui_path, variant: :primary, icon: :plus %>
<% end %>

<%= card "Runwell’s own", hint: "Pieces rune_ui gained for Runwell, and Runwell’s shared partials (layouts/shared, runwell/components.css)." do %>
  <div class="index-toolbar">
    <%= ui :filter_bar, clear: false do %>
      <%= ui :filter, param: :status, label: "Show", value: "active", any: false, options: [ [ "Active", "active" ], [ "Dormant", "dormant" ], [ "All", "all" ] ] %>
    <% end %>
    <div class="index-toolbar__end">
      <%= render "layouts/shared/view_toggle", current: "table", extra: [ [ "board", "Board", "board" ] ] %>
      <%= render "layouts/shared/new_link", text: "New client", path: ui_path %>
    </div>
  </div>
  <%= render "layouts/shared/segmented_filter", label: "Status", param: :tab, current: "open", options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ], counts: { "open" => 4, "done" => 9, "all" => 13 } %>
  <div class="list">
    <a class="list-row" href="<%= ui_path %>">
      <span class="list-row__media"><%= avatar "Priya Nair", size: :md %></span>
      <span class="list-row__content">
        <span class="list-row__title">Priya mentioned you</span>
        <span class="list-row__desc">P-12 · Website refresh</span>
      </span>
      <span class="list-row__actions"><%= badge "Overdue", tone: :danger %></span>
    </a>
  </div>
  <section class="card card--sm">
    <header class="card__head">
      <h3 class="card__title">A card with an action</h3>
      <p class="card__hint">Its action sits beside the title and hint.</p>
      <div class="card__action"><%= icon_button :settings, label: "Settings" %></div>
    </header>
  </section>
  <p class="separator separator--label">Or</p>
  <div class="field-row">
    <div class="field"><label class="field__label" for="ui_first">First name</label><input id="ui_first" type="text"></div>
    <div class="field"><label class="field__label" for="ui_last">Last name</label><input id="ui_last" type="text"></div>
  </div>
  <div class="alert alert--danger" role="alert">
    <%= icon_tag "close-circle", class: "alert__icon" %>
    <p class="alert__title">That didn’t work</p>
    <p class="alert__body">Name can’t be blank.</p>
  </div>
  <%= ui :empty, description: "No dormant clients.", action: ui(:button, href: ui_path, variant: :outline, size: :sm, content: "Show all") %>
<% end %>
