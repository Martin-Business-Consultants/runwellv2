<%# locals: (id:, columns:, rows:, row:, as:, row_locals: nil, page: nil, selectable: nil, actions: nil, fixed: nil, empty: nil) %>
<%# Runwell's data table (on rune_ui's .table): sortable headers, a checkbox
    column for bulk actions, a Columns menu and pages underneath.

      columns = [ ui_column(:name, "Name", sort: :name, width: [ @column_widths[:name], "Name" ], hideable: false),
                  ui_column(:status, "Status", sort: :status, width: :status) ]
      render "ui/data_table", id: "clients", columns:, rows: @clients, row: "clients/row", as: :client,
        page: @page, selectable: true, actions: true

    row is a partial rendering one <tr data-filter-target="item">: bulk_select_cell first when
    selectable, then a <td data-column="key"> per column in order, then layouts/shared/row_actions
    when actions. The Columns menu sits in the actions column's header, or above the table. row_locals go to every row (what all rows share, so it's read once). Unless
    fixed: false, the columns' widths hold still (ui_data_table_colgroup: the identifying column
    takes the leftover width, the rest fit their content). %>
<% hideable = columns.select(&:hideable) %>
<% fixed = true if fixed.nil? %>
<div class="data-table-wrap" data-controller="<%= actions ? "data-table row-delete" : "data-table" %>" data-data-table-key-value="<%= id %>">
  <% if hideable.size > 1 && !actions %>
    <div class="data-table-wrap__toolbar">
      <%= render "ui/data_table_columns", id: id, columns: hideable %>
    </div>
  <% end %>

  <div class="table-wrap">
    <% min_width = (ui_data_table_min_width_class(columns, selectable: selectable, actions: actions) if fixed) %>
    <table class="<%= class_names("table data-table", min_width, "data-table--fixed": fixed) %>" id="<%= id %>_table" data-data-table-target="table">
      <% if fixed %>
        <%= ui_data_table_colgroup columns, selectable: selectable, actions: actions %>
      <% end %>
      <thead>
        <tr>
          <% if selectable %>
            <%= bulk_select_all_header %>
          <% end %>
          <% columns.each do |column| %>
            <%# herb:key column.key %>
            <%= ui_data_table_th column %>
          <% end %>
          <% if actions %>
            <th class="data-table__actions-header">
              <% if hideable.size > 1 %>
                <%= render "ui/data_table_columns", id: id, columns: hideable, icon: true %>
              <% else %>
                <span class="visually-hidden">Actions</span>
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody id="<%= page ? pagination_frame_id_for("#{id}_rows", page.number) : "#{id}_rows" %>">
        <%= render partial: row, collection: rows, as: as, locals: row_locals || {} %>
      </tbody>
    </table>
  </div>

  <% if actions %>
    <%= render "layouts/shared/row_delete_dialog" %>
  <% end %>
  <% if empty && rows.none? %>
    <%= render "layouts/shared/empty", text: empty %>
  <% end %>
  <% if page %>
    <%= table_pagination page %>
  <% end %>
</div>
