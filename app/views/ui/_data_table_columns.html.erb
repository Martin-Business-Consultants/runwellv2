<%# locals: (id:, columns:, icon: nil) %>
<%# A data table's Columns menu (ui/_data_table): a checkbox per column that can be hidden, in a
    rune_ui popover (it stays open while columns are ticked: the items aren't .menu__item). %>
<div class="popover-menu data-table__columns" data-controller="rune-popover" data-rune-popover-align-value="end">
  <% if icon %>
    <button type="button" class="icon-button" popovertarget="<%= id %>_columns" title="Columns" aria-label="Columns" data-rune-popover-target="trigger">
      <%= icon_tag "sliders" %>
    </button>
  <% else %>
    <button type="button" class="btn btn--secondary btn--sm" popovertarget="<%= id %>_columns" data-rune-popover-target="trigger">
      <%= icon_tag "sliders" %>
      <span>Columns</span>
    </button>
  <% end %>
  <div class="popover menu__items" id="<%= id %>_columns" popover data-rune-popover-target="popover">
    <div class="menu__label">Show columns</div>
    <div class="menu__divider" role="separator"></div>
    <% columns.each do |column| %>
      <%# herb:key column.key %>
      <label class="menu__check">
        <input type="checkbox" value="<%= column.key %>" checked data-data-table-target="toggle" data-action="data-table#toggle">
        <span><%= column.label %></span>
      </label>
    <% end %>
  </div>
</div>
