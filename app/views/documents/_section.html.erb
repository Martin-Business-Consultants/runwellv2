<%# locals: (subject:) %>
<%= record_card "Documents", id: "documents", hint: "Files kept here. The switch shows one to the #{term(:client).downcase} in their portal." do %>
    <%# Drop files on the box (or click it to choose): the file input covers it, so a drop fills the
        input, each file uploads with its progress on the box, and the form sends them to the same
        documents#create as the quick action tray. %>
    <%= form_with url: documents_path, multipart: true, namespace: dom_id(subject, :documents), class: "document-drop",
          data: document_upload_data.merge(turbo_action: "advance") do |form| %>
      <%= hidden_field_tag :record, QuickAction.value_for(subject), id: nil %>
      <%= document_drop_target form %>
    <% end %>

    <% documents = subject.documents.recent.preloaded %>
    <% if documents.any? %>
      <ul class="record-list">
        <% documents.each do |document| %>
          <%# herb:key document.id %>
          <li class="list-row document-row" id="<%= dom_id(document, :row) %>" data-filter-target="item">
            <%= render "documents/link", document: document, meta: safe_join([ number_to_human_size(document.byte_size), person_tag(document.uploaded_by).presence, "#{time_ago_in_words(document.created_at)} ago" ].compact, " · ") %>

            <span class="list-row__actions">
              <%= form_with model: document, namespace: dom_id(document), class: "document-row__visible", data: { controller: "form" } do |form| %>
                <%= form.ui :switch, :client_visible, title: "Visible to the #{term(:client).downcase}", aria: { label: "Visible to the #{term(:client).downcase}" }, data: { action: "change->form#submit" } %>
              <% end %>
              <% if document.deletable_by?(Current.user) %>
                <%= render "layouts/shared/delete_dialog", name: document.filename.to_s, path: document_path(document), keys: "d",
                      message: "The file is removed for everyone, including the #{term(:client).downcase}’s portal." %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= ui :empty, size: :sm, description: "No documents yet." %>
    <% end %>
<% end %>
