<%# locals: (document:, meta:) %>
<%# A document's name as the thing to click: an image opens in a preview dialog (ui :dialog, with open
    and download links), a PDF opens in a new tab, anything else downloads. %>
<% kind = document_preview_kind(document) %>
<% if kind == :image %>
  <% trigger = capture do %>
    <button type="button" class="document-link" title="Preview <%= document.filename %>">
      <%= render "documents/file", document: document, meta: meta %>
    </button>
  <% end %>
  <% footer = capture do %>
    <%= ui :button, variant: :outline, size: :sm, href: rails_blob_path(document.file, disposition: :inline), content: "Open", target: "_blank", rel: "noopener" %>
    <%= ui :button, variant: :outline, size: :sm, href: rails_blob_path(document.file, disposition: :attachment), content: "Download", download: document.filename.to_s %>
  <% end %>
  <%= ui :dialog, trigger: trigger, title: document.filename.to_s, size: :lg, class: "document-preview", footer: footer do %>
    <%= image_tag rails_blob_path(document.file, disposition: :inline), class: "document-preview__image", alt: document.filename, loading: "lazy" %>
  <% end %>
<% elsif kind == :tab %>
  <%= link_to rails_blob_path(document.file, disposition: :inline), class: "document-link", title: "Open #{document.filename} in a new tab", target: "_blank", rel: "noopener" do %>
    <%= render "documents/file", document: document, meta: meta %>
  <% end %>
<% else %>
  <%= link_to rails_blob_path(document.file, disposition: :attachment), class: "document-link", title: "Download #{document.filename}", download: document.filename.to_s do %>
    <%= render "documents/file", document: document, meta: meta %>
  <% end %>
<% end %>
