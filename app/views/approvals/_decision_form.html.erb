<%# locals: (url:) %>
<%= form_with url: url, class: "flex flex-column gap txt-medium txt-align-start" do |form| %>
  <label class="flex flex-column gap-half">
    <span class="record-form__label">Your name</span>
    <%= form.text_field :approver_name, required: true, class: "input full-width", autocomplete: "name", placeholder: "Type your full name to confirm" %>
  </label>

  <label class="flex flex-column gap-half">
    <span class="record-form__label">Comment (optional)</span>
    <%= rich_text_field form, :comment %>
  </label>

  <div class="flex flex-wrap gap-half justify-center">
    <button type="submit" name="decision" value="approved" class="btn btn--link">
      <%= icon_tag "check" %>
      <span>Approve</span>
    </button>
    <button type="submit" name="decision" value="changes_requested" class="btn">
      <span>Request changes</span>
    </button>
  </div>
<% end %>
