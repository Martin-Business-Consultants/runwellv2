<% @page_title = "AI activity" %>
<%= parent_page "Intake", intake_path %>
<%# Each teammate's agent by its own name ("Amir's agent"), yours first as Your agent. %>
<% agents = User.people.active.ordered.where.not(id: Current.user.person.id).includes(:agent).filter_map(&:agent) %>

<% content_for :index_filters do %>
  <%= ui :filter, param: :whose, label: "Agent", value: @whose, any: false, search: true,
        options: [ [ "Your agent", "me" ], [ "Every agent", "any" ] ] + agents.map { [ it.display_name, it.agent_owner_id.to_s ] } %>
  <%= ui :filter, param: :area, label: "What", value: @area, any: false,
        options: AgentActivitiesController::AREAS.map { [ agent_activity_area_label(it), it ] } %>
  <%= ui :filter, param: :days, label: "When", value: @days, any: false,
        options: AgentActivitiesController::PERIODS.map { |key, label| [ label, key ] } %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view %>

<% if @events.any? %>
  <% columns = [ ui_column(:who, "Agent"),
                 ui_column(:what, "What"),
                 ui_column(:on, "On", hideable: false),
                 ui_column(:details, "Details"),
                 ui_column(:when, "When") ] %>
  <%= render "layouts/shared/list_table", id: "agent_activity", columns: columns, rows: @events, row: "agent_activities/row", as: :event, page: @page %>
<% else %>
  <%= ui :empty, description: agent_activity_empty_text(@person, @whose),
        action: (ui(:button, href: settings_connected_apps_path, variant: :outline, size: :sm, content: "Connect an AI") if @whose == "me") %>
<% end %>
