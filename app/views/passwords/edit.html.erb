<% @page_title = "Choose a new password" %>
<% content_for :showcase, "team" %>

<div class="auth">
  <%= auth_card title: @page_title, hint: "Up to 72 characters. You’ll sign in with it from now on.", shake: flash[:alert] do %>
      <%= form_with url: password_path(params[:token]), method: :put, class: "auth__form" do |form| %>
        <%= form.ui :field, :password, label: "New password" do %>
          <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>

        <%= form.ui :field, :password_confirmation, label: "Repeat it" do %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
        <% end %>

        <%= ui :button, type: :submit, content: "Save", class: "auth__button" %>
      <% end %>
  <% end %>
</div>

<% content_for :footer do %>
  <%= render "sessions/footer" %>
<% end %>
