<% @page_title = @contact.name_was %>

<%= parent_page @contact.client.name, @contact.client %>

<%# A contact's page: their fields change in place, each saving as it changes
    (record_fields/_zone in_place, answered by contacts/update.turbo_stream.erb). %>
<% layout = record_layout(:contact) %>
<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:contact) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a contact’s" %>
  <%= render "contacts/header", contact: @contact %>

  <div class="record-page__main">
    <%= render "layouts/shared/errors", record: @contact %>
    <%= record_card css: "record-fields-card", title: layout_text_tag(layout, "main.title", "Contact", class: "record-card__title"),
          hint: layout_text_tag(layout, "main.hint", "Someone at #{@contact.client.name} you deal with.", tag: :p, class: "record-card__hint") do %>
      <%= render "record_fields/zone", layout: layout, zone: "main", record: @contact, in_place: true, except: header_fields(:contact) %>
    <% end %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @contact, title: "Access", in_place: true, except: header_fields(:contact) %>
    <%= render "contacts/sidebar", client: @contact.client, contact: @contact %>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Archive this contact", title: "Archive #{@contact.name_was}?",
            body: "They drop off the #{term(:client).downcase}’s contacts and can no longer sign in to the portal or approve. Their past requests stay.",
            button: "Archive contact", path: contact_path(@contact), icon: "remove" %>
    <% end %>
  </aside>
</section>
