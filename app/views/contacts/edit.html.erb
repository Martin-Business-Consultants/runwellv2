<% @page_title = "Edit #{@contact.name_was}" %>

<% content_for :header do %>
  <%= parent_page @contact.client.name, @contact.client %>
<% end %>

<section class="settings settings--split record-page">
  <header class="record-page__header page-heading">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">A contact at <%= link_to @contact.client.name, @contact.client, class: "txt-link" %></p>
    </div>
    <div class="page-heading__actions">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="settings__panel record-page__main">
    <%= render "contacts/form", contact: @contact %>
  </div>

  <aside class="settings__panel settings__panel--side record-page__aside">
    <%= render "contacts/sidebar", client: @contact.client, contact: @contact %>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Archive this contact", title: "Archive #{@contact.name_was}?",
            body: "They drop off the client’s contacts and can no longer sign in to the portal or approve. Their past requests stay.",
            button: "Archive contact", path: contact_path(@contact), icon: "remove" %>
    <% end %>
  </aside>
</section>
