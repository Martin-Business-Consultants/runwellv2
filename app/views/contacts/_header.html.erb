<%# locals: (contact:) %>
<%# A contact's page header (record_header: ui :page_header): their name, changed in place, where
    they work, inviting them to the portal and View as. Redrawn when it saves
    (contacts/update.turbo_stream.erb). %>
<% actions = capture do %>
  <% if contact.portal? %>
    <%= form_with url: contact_portal_invitation_path(contact), class: "record-header__form" do %>
      <%= ui :button, type: :submit, variant: :outline, title: "Email #{contact.name} what the portal is and a link that signs them in",
            content: safe_join([ icon_tag("paper-plane"), (contact.link_signed_in_at ? "Invite again" : "Invite to the portal") ], " ") %>
    <% end %>
  <% end %>
  <%= form_with url: contact_preview_path(contact), class: "record-header__form", data: { turbo: false } do %>
    <%= ui :button, type: :submit, variant: :outline, title: "Open the #{term(:client).downcase} portal as #{contact.name}, read-only",
          content: safe_join([ icon_tag("eye"), "View as #{contact.name}" ], " ") %>
  <% end %>
<% end %>
<%= record_header id: dom_id(contact, :header), actions: actions do %>
  <%= render "layouts/shared/record_title", record: contact, attribute: :name, label: "Name" %>
  <p class="record-header__line">A contact at <%= link_to contact.client.name, contact.client %></p>
<% end %>
