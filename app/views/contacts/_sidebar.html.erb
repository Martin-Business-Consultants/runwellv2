<%# locals: (client:, contact:) %>
<%# Beside a contact's form: their use of the portal (when they last signed in, the browsers
    signed in now and a way to sign them all out), then who else is at the client (what the two
    switches allow is under each switch in the form). %>
<% if contact.portal_access? %>
  <% sessions = contact.portal_sessions.count %>
  <section class="card record-card">
    <header class="card__head">
      <h2 class="card__title">Portal</h2>
      <p class="card__hint">
        <% if !contact.portal? %>
          Can’t sign in yet: they need an email address.
        <% elsif contact.link_signed_in_at %>
          Last signed in <%= time_ago_in_words(contact.link_signed_in_at) %> ago<% if sessions.positive? %>, on <%= pluralize sessions, "browser" %> now<% end %>.
        <% else %>
          Hasn’t signed in yet. Invite them, above.
        <% end %>
      </p>
    </header>
    <div class="card__content contact-portal">
      <%# What they see there (Contact::PortalScope): everything shared, or only chosen work. %>
      <% works = client.works.ordered.map { [ it.title, it.ref ] } %>
      <%= form_with url: contact_portal_scope_path(contact), scope: :scope, method: :patch, class: "contact-portal__scope", namespace: dom_id(contact, :portal_scope) do |form| %>
        <%= hidden_field_tag "scope[limited]", "0", id: nil %>
        <label class="checkbox">
          <%= check_box_tag "scope[limited]", "1", contact.portal_limited?, id: dom_id(contact, :portal_limited) %>
          <span>Only some of the <%= term(:work).downcase %></span>
        </label>
        <div class="field">
          <%= form.label :works, "Which", class: "field__label" %>
          <%= form.select :works, works, { selected: contact.limited_works.map(&:ref) }, multiple: true %>
          <p class="field__hint">Ticked, they see only these, the <%= term(:task, count: 2).downcase %> and files on them, and what they asked for themselves. Unticked, everything shared with <%= client.name %>.</p>
        </div>
        <div class="button-row"><button type="submit" class="btn btn--secondary btn--sm">Save what they see</button></div>
      <% end %>
      <% if sessions.positive? %>
        <%= button_to "Sign out everywhere", contact_portal_sessions_path(contact), method: :delete, class: "btn btn--secondary btn--sm" %>
      <% end %>
    </div>
  </section>
<% end %>
<% others = client.contacts.active.ordered.where.not(id: contact.id).to_a %>
<section class="card record-card">
  <header class="card__head">
    <h2 class="card__title">At <%= client.name %></h2>
    <p class="card__hint">
      <% if others.empty? %>
        No one else yet.
      <% else %>
        <%= pluralize others.size, "other contact" %>
      <% end %>
    </p>
  </header>
  <% if others.any? %>
    <div class="card__content">
      <ul class="record-list">
        <% others.each do |other| %>
          <%# herb:key other.id %>
          <li data-filter-target="item">
            <%= link_to edit_contact_path(other), class: "list-row" do %>
              <%= avatar other.name, size: :md %>
              <span class="list-row__content">
                <span class="list-row__title"><%= other.name %></span>
                <% if other.title.present? %>
                  <span class="list-row__desc"><%= other.title %></span>
                <% end %>
                <% if other.portal? || other.can_approve? %>
                  <span class="record-list__badges">
                    <% if other.portal? %>
                      <%= status_tag "Portal" %>
                    <% end %>
                    <% if other.can_approve? %>
                      <%= status_tag "Can approve", highlight: true %>
                    <% end %>
                  </span>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
