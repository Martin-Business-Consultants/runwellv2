<%# locals: (client:, contact:) %>
<%# Beside a contact's form: who else is at the client (what the two switches allow is under each
    switch in the form). %>
<% others = client.contacts.active.ordered.where.not(id: contact.id).to_a %>
<section class="card record-card">
  <header class="card__head">
    <h2 class="card__title">At <%= client.name %></h2>
    <p class="card__hint">
      <% if others.empty? %>
        No one else yet.
      <% else %>
        <%= pluralize others.size, "other contact" %>
      <% end %>
    </p>
  </header>
  <% if others.any? %>
    <div class="card__content">
      <ul class="record-list">
        <% others.each do |other| %>
          <%# herb:key other.id %>
          <li data-filter-target="item">
            <%= link_to edit_contact_path(other), class: "list-row" do %>
              <%= avatar other.name, size: :md %>
              <span class="list-row__content">
                <span class="list-row__title"><%= other.name %></span>
                <% if other.title.present? %>
                  <span class="list-row__desc"><%= other.title %></span>
                <% end %>
                <% if other.portal? || other.can_approve? %>
                  <span class="record-list__badges">
                    <% if other.portal? %>
                      <%= status_tag "Portal" %>
                    <% end %>
                    <% if other.can_approve? %>
                      <%= status_tag "Can approve", highlight: true %>
                    <% end %>
                  </span>
                <% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</section>
