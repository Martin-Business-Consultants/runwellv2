<%# locals: (engagement:) %>
<%# herb:slots server %>
<%# herb:state (starting: false) %>
<div class="txt-align-center margin-block-start">
  <%# Nothing to start while a draft is open: finish or discard it first. %>
  <% if engagement.draft_version.nil? %>
    <% if starting %>
      <% kinds = new_version_kinds(engagement) %>
      <%= form_with url: engagement_agreement_versions_path(engagement), class: "panel fill-white shadow flex flex-column gap txt-align-start", data: { turbo_action: "advance" } do |form| %>
        <h3 class="txt-medium font-weight-bold margin-none">Start a new version</h3>
        <label class="flex flex-column gap-half">
          <span class="record-form__label">Kind</span>
          <%= form.select :kind, kinds, {}, class: "input input--select full-width" %>
        </label>
        <label class="flex flex-column gap-half">
          <span class="record-form__label">Summary</span>
          <%= form.text_field :summary, class: "input full-width", autocomplete: "off", placeholder: "Add a blog section" %>
        </label>
        <label class="flex flex-column gap-half">
          <span class="record-form__label">Reason</span>
          <%= rich_text_field form, :reason, placeholder: "Why this is changing, in the client’s words if you have them.", staff: true %>
        </label>
        <div class="flex gap-half justify-center">
          <button type="button" class="btn" data-herb-reset="starting">Cancel</button>
          <button type="submit" class="btn btn--link">Start draft</button>
        </div>
      <% end %>
    <% else %>
      <button type="button" class="btn btn--link txt-small" data-herb-toggle="starting">
        <%= icon_tag "add" %>
        <span><%= engagement.agreement_versions.none? ? "Start the agreement" : (engagement.recurring? ? "Start a revision or add-on" : "Start a change order") %></span>
      </button>
    <% end %>
  <% end %>
</div>
