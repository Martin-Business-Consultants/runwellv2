<% @page_title = "Link a workspace" %>
<%= parent_page "Workspaces", settings_workspaces_path %>
<%# Another install sent someone here after they added this one to their rail: Link puts each on
    the other's rail (WorkspaceLink.accept!). %>
<div class="settings-page">
  <section class="card workspace-confirm">
    <header class="card__head">
      <h2 class="card__title">Link <%= URI.parse(@from).host %> and this workspace?</h2>
      <p class="card__hint">
        Each goes on the other’s workspace rail, for you (<%= Current.user.email_address %>): its icon, your unread notifications there and whether anything’s waiting in its Intake.
        Nothing else is shared, and you still sign in to each on its own. Only link a workspace you added yourself.
      </p>
    </header>
    <div class="card__content button-row">
      <%= button_to "Link them", workspace_link_path, params: { from: @from, nonce: @nonce }, class: "btn btn--primary", data: { turbo: false } %>
      <%= link_to "Not now", root_path, class: "btn btn--ghost" %>
    </div>
  </section>
</div>
