<%# locals: (item:) %>
<%# One line in Waiting on you: a piece of work, or a mention of the person. %>
<% if item.is_a?(Notification) %>
  <% ref, name = notification_target_label(item.notifiable_target) %>
  <%= link_to notification_path(item), class: "home-list__link" do %>
    <%= person_tag item.creator %>
    <span class="home-list__title overflow-ellipsis"><%= name || ref %></span>
    <span class="home-list__meta txt-subtle"><%= time_ago_in_words(item.created_at) %> ago</span>
  <% end %>
<% else %>
  <%= link_to todo_path(item), class: "home-list__link" do %>
    <%= person_tag item.owner, fallback: "Unassigned" %>
    <span class="home-list__title overflow-ellipsis"><%= item.title %></span>
    <span class="home-list__meta txt-subtle overflow-ellipsis"><%= home_work_where(item) %></span>
  <% end %>
<% end %>
