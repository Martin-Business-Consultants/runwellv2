<% @page_title = "Needs you" %>

<% content_for :header do %>
  <h1 class="header__title"><%= @page_title %></h1>
<% end %>

<div class="flex flex-column gap align-center">
  <% if @release&.newer? %>
    <%= render "briefings/update", release: @release %>
  <% end %>

  <% if @setup.show? %>
    <%= render "briefings/setup", setup: @setup %>
  <% end %>

  <% if Ai.available_for? %>
    <section class="panel panel--wide shadow txt-align-start settings__section">
      <header>
        <h2 class="divider">Your day</h2>
      </header>
      <%= render "ai/suggestions/card", kind: "day", subject: Current.user,
            suggestion: Current.user.ai_suggestions.where(kind: "day", created_at: Date.current.all_day).latest_first.first %>
    </section>
  <% end %>

  <% if @sections.empty? && !@setup.show? %>
    <div class="panel panel--centered">
      <div class="blank-slate">Nothing needs you.</div>
    </div>
  <% end %>

  <% @sections.each do |section| %>
    <%# herb:key section.key %>
    <section class="panel panel--wide shadow txt-align-start settings__section">
      <header>
        <h2 class="divider"><%= section.title %> <span class="txt-subtle"><%= section.count %></span></h2>
      </header>

      <%# The first few of each, with the way to the rest: a large install has hundreds overdue. %>
      <ul class="settings__scrollable-list">
        <% section.items.each do |item| %>
          <%# herb:key "#{item.class.name}-#{item.id}" %>
          <li data-filter-target="item" class="flex flex-column gap-half">
            <% if section.partial %>
              <%= render section.partial, item: item %>
            <% else %>
              <%= render "briefings/item", key: section.key, item: item %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if section.count > section.items.size %>
        <% more_path = briefing_more_path(section.key) %>
        <p class="txt-small txt-subtle margin-none">
          And <%= section.count - section.items.size %> more.
          <% if more_path %>
            <%= link_to "See all #{section.count}", more_path, class: "txt-link" %>
          <% end %>
        </p>
      <% end %>
    </section>
  <% end %>
</div>
