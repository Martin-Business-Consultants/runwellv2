<% @page_title = "Needs you" %>

<% needs = @sections.sum(&:count) %>
<div class="home">
  <%= render "briefings/home/greeting", home: @home, needs: needs %>

  <% if @release&.newer? %>
    <%= render "briefings/update", release: @release %>
  <% end %>

  <% if @setup.show? %>
    <%= render "briefings/setup", setup: @setup %>
  <% end %>

  <%= plugin_slots(:home_top) %>

  <%= render "briefings/home/today", home: @home %>

  <div class="home-grid">
    <%= render "briefings/home/coming_up", home: @home %>
    <%= render "briefings/home/discussion", home: @home %>
  </div>

  <% @sections.each do |section| %>
    <%# herb:key section.key %>
    <section class="panel shadow txt-align-start settings__section home-panel">
      <header class="home-panel__header">
        <h2 class="home-panel__title"><%= section.title %> <span class="txt-subtle"><%= section.count %></span></h2>
      </header>

      <%# The first few of each, with the way to the rest: a large install has hundreds overdue. %>
      <ul class="settings__scrollable-list">
        <% section.items.each do |item| %>
          <%# herb:key "#{item.class.name}-#{item.id}" %>
          <li data-filter-target="item" class="flex flex-column gap-half">
            <% if section.partial %>
              <%= render section.partial, item: item %>
            <% else %>
              <%= render "briefings/item", key: section.key, item: item %>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if section.count > section.items.size %>
        <% more_path = briefing_more_path(section.key) %>
        <p class="txt-small txt-subtle margin-none">
          And <%= section.count - section.items.size %> more.
          <% if more_path %>
            <%= link_to "See all #{section.count}", more_path, class: "txt-link" %>
          <% end %>
        </p>
      <% end %>
    </section>
  <% end %>

  <%= render "briefings/home/engagements", home: @home %>

  <% if can?(:triage_requests) %>
    <%= render "briefings/home/team", home: @home %>
  <% end %>
</div>
