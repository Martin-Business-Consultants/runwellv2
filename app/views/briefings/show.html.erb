<% @page_title = "Needs you" %>

<%# Home: a greeting with the two ways in to work, the four counts that matter, then Your work
    (a table grouped by when it's due) beside what's waiting on the person. %>
<div class="home">
  <% if @release&.newer? %>
    <%= render "briefings/update", release: @release %>
  <% end %>

  <header class="page-header home-heading">
    <div class="page-header__text">
      <h1 class="home-heading__title"><%= briefing_greeting(Current.user) %></h1>
      <p class="page-header__subtitle">
        <% if @briefing.empty? %>
          Nothing needs you right now.
        <% else %>
          Here’s what needs you today.
        <% end %>
      </p>
    </div>
    <div class="button-row">
      <%= link_to todos_path(owner: "me", view: "table", sort: "due"), class: button_classes(variant: :secondary) do %>
        <%= icon_tag "board" %> All your <%= term(:work).downcase %>
      <% end %>
      <%= link_to new_quick_action_path(kind: "work"), class: button_classes(variant: :primary), data: { turbo_frame: "quick_action" } do %>
        <%= icon_tag "add" %> Add <%= term(:work).downcase %>
      <% end %>
    </div>
  </header>

  <%= plugin_slots(:home_top) %>

  <div class="home-stats">
    <% briefing_stats(@briefing).each do |stat| %>
      <%# herb:key stat[:key] %>
      <%= link_to stat[:path], class: class_names("card home-stat", "home-stat--alert": stat[:alert]) do %>
        <span class="card__head">
          <span class="card__hint"><%= stat[:label] %></span>
          <span class="card__title home-stat__value"><%= stat[:count] %></span>
          <span class="card__action"><%= icon_tag stat[:icon], class: "home-stat__icon" %></span>
        </span>
        <span class="home-stat__note"><%= stat[:note] %></span>
      <% end %>
    <% end %>
  </div>

  <% if @briefing.empty? %>
    <div class="empty home-empty">
      <span class="home-empty__icon"><%= icon_tag "check-circle" %></span>
      <h2>You’re all caught up</h2>
      <p>Nothing needs you right now. <%= term(:work) %> that’s due, waiting on you or mentions you shows up here.</p>
    </div>
  <% else %>
    <div class="home-grid">
      <section class="card card--flush home-work" aria-labelledby="home-work-title">
        <header class="card__head">
          <h2 class="card__title" id="home-work-title">Your <%= term(:work).downcase %></h2>
          <p class="card__hint">Due this week, or in progress.</p>
          <div class="card__action">
            <%= link_to "View all", todos_path(owner: "me", view: "table", sort: "due"), class: button_classes(variant: :secondary, size: :sm) %>
          </div>
        </header>
        <% if @briefing.work_sections.any? %>
          <%# The status menus' options, once for the page rather than once per row. %>
          <%= todo_status_options_template %>
          <div class="home-work__scroll">
            <table class="table home-work__table">
              <colgroup>
                <col class="home-work__col--status">
                <col>
                <col class="home-work__col--where">
                <col class="home-work__col--due">
              </colgroup>
              <% @briefing.work_sections.each do |section| %>
                <%# herb:key section.key %>
                <tbody>
                  <tr class="home-work__group">
                    <th colspan="4" scope="rowgroup">
                      <span class="home-work__group-label">
                        <%= section.title %>
                        <span class="count count--quiet"><%= section.count %></span>
                        <% if section.count > section.items.size %>
                          <%= link_to "See all", briefing_more_path(section.key), class: "home-work__more" %>
                        <% end %>
                      </span>
                    </th>
                  </tr>
                  <% section.items.each do |todo| %>
                    <%# herb:key todo.id %>
                    <tr data-filter-target="item">
                      <td class="home-work__status"><%= render "todos/status_dot", todo: todo, options_on_page: true %></td>
                      <td class="home-work__title"><%= link_to todo.title, todo_path(todo), class: "row-link" %></td>
                      <td class="home-work__where"><%= home_work_where(todo) %></td>
                      <td class="<%= class_names("home-work__due", "home-work__due--late": todo.due_on&.past?) %>"><%= home_due(todo.due_on) if todo.due_on %></td>
                    </tr>
                  <% end %>
                </tbody>
              <% end %>
            </table>
          </div>
        <% else %>
          <div class="card__content home-work__empty">
            <p>Nothing of yours is due this week or in progress.</p>
          </div>
        <% end %>
      </section>

      <% if @briefing.waiting_sections.any? %>
        <div class="home-side">
          <% @briefing.waiting_sections.each do |section| %>
            <%# herb:key section.key %>
            <section class="card card--flush home-panel">
              <header class="card__head">
                <h2 class="card__title home-panel__title"><%= section.title %> <span class="count count--quiet"><%= section.count %></span></h2>
                <% if section.count > section.items.size %>
                  <% more_path = briefing_more_path(section.key) %>
                  <% if more_path %>
                    <div class="card__action">
                      <%= link_to "See all", more_path, class: button_classes(variant: :ghost, size: :sm) %>
                    </div>
                  <% end %>
                <% end %>
              </header>
              <ul class="list home-list">
                <%# A plugin's items needn't be records (Account management's alerts are Data), so no id. %>
                <% section.items.each_with_index do |item, index| %>
                  <%# herb:key "#{item.class.name}-#{item.respond_to?(:id) ? item.id : index}" %>
                  <li class="home-list__item" data-filter-target="item">
                    <% if section.partial %>
                      <%= render section.partial, item: item %>
                    <% else %>
                      <%= render "briefings/item", item: item %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
