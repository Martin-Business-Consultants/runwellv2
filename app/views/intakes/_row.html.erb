<%# locals: (task:) %>
<%# One thing that came in, in Intake's data table (layouts/shared/_list_table): where it came from, the task
    (it opens in the side panel, where it's put on a piece of work), what it's for (its work, else its
    client with "file it", which opens the panel to put it on a piece of work), who's on it (a picker), when it came in, and
    Accept or Decline (Tasks::AcceptancesController, DeclinesController), then an empty cell under the
    header's corner (the Columns menu). %>
<tr id="<%= dom_id(task, :intake) %>" class="intake-row" data-filter-target="item">
  <%= ui :select_cell, value: task.id, label: task.title, checkbox: { data: { keys: "x" } } %>
  <td data-column="source"><%= intake_source_tag(task) %></td>
  <td data-column="title" data-grow="wrap"><%= side_panel_link_to task, task.title %></td>
  <td data-column="home" data-truncate>
    <% if task.work %>
      <%= peek_link_to task.work, task.work.title, class: "task-table__work", title: task.client&.name %>
    <% else %>
      <span class="intake__home">
        <% if task.client %><span class="muted"><%= task.client.name %></span><% end %>
        <%= side_panel_link_to task, task.client ? "· file it" : "No #{term(:client).downcase} yet: file it", class: "intake__file", open: false %>
      </span>
    <% end %>
  </td>
  <td data-column="owner"><%= render "tasks/owner_picker", task: task %></td>
  <td class="muted" data-column="came_in" title="<%= task.created_at.iso8601 %>"><%= activity_time(task.created_at, short: true) %></td>
  <td data-column="decide">
    <span class="intake__decide">
      <%= button_to task_acceptance_path(task), params: { inline: "row" }, class: button_classes(variant: :secondary, size: :sm), title: "Accept: #{task.owner ? "#{task.owner.display_name} owns it" : "you take it on"}" do %>
        <%= icon_tag "check" %><span>Accept</span>
      <% end %>
      <%= render "intakes/decline", task: task, inline: "row" %>
    </span>
  </td>
  <td></td>
</tr>
