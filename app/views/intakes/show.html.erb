<% @page_title = "Intake" %>
<%= turbo_stream_from :tasks %>

<% content_for :index_filters do %>
  <%= ui :filter, param: :source, label: "Source", value: @source, any: false,
        options: [ [ "Any source", "any" ], [ term(:client, count: 2), "clients" ], [ "AI", "agents" ], [ "The team", "team" ] ] %>
  <%= ui :filter, param: :needs, label: "Needs", value: @needs, any: false,
        options: [ [ "Anything", "any" ], [ "Someone on it", "owner" ], [ "A " + term(:work).downcase, "work" ] ] %>
  <%= ui :button, href: agent_activity_path(whose: "any"), variant: :ghost, size: :sm, content: safe_join([ icon_tag("ai"), "AI activity" ]) %>
  <%= ui :button, href: intake_shifts_path, variant: :ghost, size: :sm, title: "Who hears what comes in, and when", content: safe_join([ icon_tag("calendar"), "Schedule" ]) %>
<% end %>
<% bar = bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_tasks_path, noun: term(:task, count: 2).downcase) : nil) do %>
  <%= bulk_menu bulk_tasks_acceptance_path, method: :post, name: "owner_id", label: "Accept for…", choices: [ [ "You", "me" ] ] + task_owner_options.reject { |_, id| id == Current.user.person.id } %>
  <%= bulk_text bulk_tasks_decline_path, method: :post, name: "note", label: "Decline", placeholder: "Why? (optional, internal)", submit: "Decline" %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view %>

<% columns = [ ui_column(:source, "Source"),
               ui_column(:title, term(:task), sort: :title, hideable: false),
               ui_column(:home, "For", sort: :work),
               ui_column(:owner, "Owner"),
               ui_column(:came_in, "Came in", sort: :came_in),
               ui_column(:decide, "Decide", hideable: false) ] %>
<%# The empty state is always there and shows by CSS once no row is left (.intake:has), so a row
    leaving by stream needs no reload to say so. %>
<div class="intake">
  <%= render "layouts/shared/list_table", id: "intake", columns: columns, rows: @tasks, row: "intakes/row", as: :task, page: @page,
        selectable: true, noun: term(:task).downcase, bulk: bar %>
  <div class="intake__empty">
    <%= ui :empty, description: "Nothing waiting. Everything that came in has been accepted or declined." %>
  </div>
</div>
