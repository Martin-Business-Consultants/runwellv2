<% @page_title = @query ? "Search results for \"#{@query}\"" : "Search" %>
<%# The breadcrumb (Home › Search) is the page's title. %>
<%= parent_page term(:task, count: 2), tasks_path %>

<%# /search: the bar's search box and results, framed on the page. %>
<div class="search-page">
  <%= render "searches/form", query_terms: @query, turbo_action: "advance", target_turbo_frame: "bar_content", cancel_path: root_path %>
  <%= turbo_frame_tag "bar_content" do %>
    <%= render "searches/results", results: @search.results, query: @query, people: @search.people %>
  <% end %>
</div>
