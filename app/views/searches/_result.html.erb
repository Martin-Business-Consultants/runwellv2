<%# locals: (result:) %>
<%# Records must come from a search: ActiveSearch sets #hit only on ones it hydrated. One row:
    the kind's icon, the title over a line of the match, and the client on the right. %>
<li>
  <%= search_result_link_to result, class: "search-results__result" do %>
    <%= icon_tag search_result_icon(result), class: "search-results__icon" %>
    <span class="search-results__text">
      <span class="search-results__title"><%= result.hit.highlight(:title) || result.search_title %></span>
      <% if content = result.hit.highlight(:content) || result.search_content.presence %>
        <span class="search-results__excerpt"><%= content.html_safe? ? content : content.truncate(200) %></span>
      <% end %>
    </span>
    <span class="search-results__context"><%= search_result_context(result) %></span>
  <% end %>
</li>
