<%# locals: (result:) %>
<%# Records must come from a search: ActiveSearch sets #hit only on ones it hydrated. A Command
    item: the kind's icon, the title over a line of the match, and the client on the right. %>
<li>
  <%= link_to search_result_path(result), class: "search__result", data: { turbo_frame: "_top", action: "bar#reset" } do %>
    <%= icon_tag search_result_icon(result), class: "search__result-icon" %>
    <span class="search__result-text">
      <span class="search__title"><%= result.hit.highlight(:title) || result.search_title %></span>
      <% if content = result.hit.highlight(:content) || result.search_content.presence %>
        <span class="search__excerpt"><%= content.html_safe? ? content : content.truncate(200) %></span>
      <% end %>
    </span>
    <span class="search__context"><%= search_result_context(result) %></span>
  <% end %>
</li>
