<%# locals: (request_record:) %>
<%# herb:slots server %>
<%# herb:state (triage: "") %>
<% engagement_options = request_engagement_options(request_record) %>
<section class="settings__section flex flex-column gap">
  <header>
    <h2 class="divider">Triage</h2>
  </header>
  <p class="txt-small txt-subtle margin-none">Turn this into scope, work or a promise, or dismiss it.</p>

  <div class="flex flex-wrap gap-half">
    <button type="button" class="btn txt-small <%= "btn--reversed" if triage == "engagement" %>" data-herb-set="triage=engagement">New <%= term(:engagement).downcase %></button>
    <button type="button" class="btn txt-small <%= "btn--reversed" if triage == "change" %>" data-herb-set="triage=change">Add as scope</button>
    <button type="button" class="btn txt-small <%= "btn--reversed" if triage == "todo" %>" data-herb-set="triage=todo">Add as work</button>
    <button type="button" class="btn txt-small <%= "btn--reversed" if triage == "commitment" %>" data-herb-set="triage=commitment">Make a commitment</button>
    <button type="button" class="btn txt-small txt-negative <%= "btn--reversed" if triage == "dismiss" %>" data-herb-set="triage=dismiss">Dismiss</button>
  </div>

  <% if triage == "engagement" %>
    <%= form_with url: promote_engagement_request_path(request_record), class: "flex flex-column gap" do |form| %>
      <p class="txt-small txt-subtle margin-none">A new agreement whose first scope item is this request.</p>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Kind</span>
        <%= form.select :label, label_options, { selected: "work_order" }, class: "input input--select full-width" %>
      </label>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Title (optional)</span>
        <%= form.text_field :title, class: "input full-width", autocomplete: "off", placeholder: request_record.subject %>
      </label>
      <% if request_record.unmatched? %>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold">Client</span>
          <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "Choose a client" }, required: true, class: "input input--select full-width" %>
        </label>
      <% end %>
      <div class="flex gap-half">
        <button type="submit" class="btn btn--link">Draft <%= term(:engagement).downcase %></button>
        <button type="button" class="btn" data-herb-reset="triage">Cancel</button>
      </div>
    <% end %>
  <% elsif triage == "change" %>
    <% if engagement_options.any? %>
      <%= form_with url: promote_change_request_path(request_record), class: "flex flex-column gap" do |form| %>
        <p class="txt-small txt-subtle margin-none">Adds it to the engagement’s open draft, opening a change order if there isn’t one.</p>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold"><%= term(:engagement) %></span>
          <%= form.select :engagement_ref, engagement_options, {}, class: "input input--select full-width" %>
        </label>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold">Price</span>
          <%= money_field form, :price_cents, value: 0, class: "input full-width", placeholder: "0.00" %>
        </label>
        <div class="flex gap-half">
          <button type="submit" class="btn btn--link">Add as scope</button>
          <button type="button" class="btn" data-herb-reset="triage">Cancel</button>
        </div>
      <% end %>
    <% else %>
      <p class="txt-small txt-subtle margin-none">This request’s client has no open engagements. Draft one instead.</p>
    <% end %>
  <% elsif triage == "todo" %>
    <% if engagement_options.any? %>
      <%= form_with url: promote_todo_request_path(request_record), class: "flex flex-column gap" do |form| %>
        <p class="txt-small txt-subtle margin-none">A todo on an engagement already agreed.</p>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold"><%= term(:engagement) %></span>
          <%= form.select :engagement_ref, engagement_options, {}, class: "input input--select full-width" %>
        </label>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold">Owner</span>
          <%= form.select :owner_id, User.active.people.ordered.pluck(:name, :id), { include_blank: "Unowned" }, class: "input input--select full-width" %>
        </label>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold">Due</span>
          <%= date_input form, :due_on, class: "input full-width" %>
        </label>
        <div class="flex gap-half">
          <button type="submit" class="btn btn--link">Add as work</button>
          <button type="button" class="btn" data-herb-reset="triage">Cancel</button>
        </div>
      <% end %>
    <% else %>
      <p class="txt-small txt-subtle margin-none">This request’s client has no open engagements. Draft one instead.</p>
    <% end %>
  <% elsif triage == "commitment" %>
    <%= form_with url: promote_commitment_request_path(request_record), class: "flex flex-column gap" do |form| %>
      <p class="txt-small txt-subtle margin-none">A promise with an owner and a date.</p>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Due</span>
        <%= date_input form, :due_on, required: true, class: "input full-width" %>
      </label>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Whose promise</span>
        <%= form.select :owner_kind, [ [ "Ours", "us" ], [ "The client’s", "client" ] ], {}, class: "input input--select full-width" %>
      </label>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Person (when it’s ours)</span>
        <%= form.select :user_id, User.active.people.ordered.pluck(:name, :id), { include_blank: "Anyone" }, class: "input input--select full-width" %>
      </label>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold"><%= term(:engagement) %> (optional)</span>
        <%= form.select :engagement_ref, engagement_options, { include_blank: "None" }, class: "input input--select full-width" %>
      </label>
      <% if request_record.unmatched? %>
        <label class="flex flex-column gap-half">
          <span class="txt-small font-weight-bold">Client</span>
          <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "Choose a client" }, required: true, class: "input input--select full-width" %>
        </label>
      <% end %>
      <div class="flex gap-half">
        <button type="submit" class="btn btn--link">Make commitment</button>
        <button type="button" class="btn" data-herb-reset="triage">Cancel</button>
      </div>
    <% end %>
  <% elsif triage == "dismiss" %>
    <%= form_with url: dismiss_request_path(request_record), class: "flex flex-column gap" do |form| %>
      <label class="flex flex-column gap-half">
        <span class="txt-small font-weight-bold">Reason</span>
        <%= form.text_field :reason, class: "input full-width", autocomplete: "off", placeholder: "Not needed" %>
      </label>
      <div class="flex gap-half">
        <button type="submit" class="btn txt-negative">Dismiss request</button>
        <button type="button" class="btn" data-herb-reset="triage">Cancel</button>
      </div>
    <% end %>
  <% end %>
</section>
