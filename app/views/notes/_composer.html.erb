<%# locals: (subject:, permanent: nil) %>
<%# Write a note right here, above the ones already written: the editor (with @mentions and
    files), what kind of note it is and where it came from, and Add note. ⌘/Ctrl+Enter
    saves. The composer is permanent, so the page morphing in the new note leaves the editor
    in place (no flicker) and a saved note just clears it. permanent: false for a page that
    shows one record's notes, then another's, in the same place (Turbo keeps a permanent
    element through a morph even when the new page doesn't have it). %>
<%= form_with model: Note.new, url: notes_path, namespace: dom_id(subject, :note), id: dom_id(subject, :note_composer), class: "note-composer",
      data: { controller: "form", turbo_frame: "_top", turbo_permanent: (true unless permanent == false), action: "turbo:submit-end->form#resetOnSuccess" } do |form| %>
  <%= hidden_field_tag :record, QuickAction.value_for(subject), id: nil %>
  <%= hidden_field_tag :inline, "notes", id: nil %>
  <%= rich_text_field form, :body, placeholder: "Add a note: what was said or decided… @ to mention someone", staff: true %>
  <div class="note-composer__footer">
    <%= form.select :kind, Note::KINDS.map { |kind| [ kind.humanize, kind ] }, { selected: "internal" }, class: "select--sm note-composer__kind", aria: { label: "Kind" } %>
    <%= form.text_field :source, class: "input--sm note-composer__source", autocomplete: "off", placeholder: "Source, e.g. call with Ann", aria: { label: "Source" } %>
    <% if subject.is_a?(Task) && subject.client_visible? && subject.client %>
      <%# The same note, sent to the client instead: shared on the task's discussion in their portal. %>
      <button type="submit" class="btn btn--secondary btn--sm" formaction="<%= task_discussion_path(subject) %>"
        title="The client reads it on this <%= term(:task).downcase %> in their portal, and can reply">Send to client</button>
    <% end %>
    <button type="submit" class="btn btn--primary btn--sm note-composer__submit">Add note</button>
  </div>
<% end %>
