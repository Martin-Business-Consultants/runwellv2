<%# locals: (subject:, permanent: nil) %>
<section class="ui-card record-card" id="notes">
  <header class="ui-card__header">
    <h2 class="ui-card__title">Notes</h2>
    <p class="ui-card__description">What was said or decided. @ mentions the person.</p>
  </header>

  <div class="ui-card__content record-card__stack">
    <%# Write a note right here, above the ones already written: the editor (with @mentions and
        files), what kind of note it is and where it came from, and Add note. ⌘/Ctrl+Enter
        saves. The composer is permanent, so the page morphing in the new note leaves the editor
        in place (no flicker) and a saved note just clears it. permanent: false for a page that
        shows one record's notes, then another's, in the same place (Turbo keeps a permanent
        element through a morph even when the new page doesn't have it). %>
    <%= form_with model: Note.new, url: notes_path, namespace: dom_id(subject, :note), id: dom_id(subject, :note_composer), class: "note-composer",
          data: { controller: "form", turbo_frame: "_top", turbo_permanent: (true unless permanent == false), action: "turbo:submit-end->form#resetOnSuccess" } do |form| %>
      <%= hidden_field_tag :record, QuickAction.value_for(subject), id: nil %>
      <%= rich_text_field form, :body, placeholder: "Add a note: what was said or decided… @ to mention someone", staff: true %>
      <div class="note-composer__footer">
        <%= form.select :kind, Note::KINDS.map { |kind| [ kind.humanize, kind ] }, { selected: "internal" }, class: "ui-select ui-select--sm note-composer__kind", aria: { label: "Kind" } %>
        <%= form.text_field :source, class: "ui-input ui-input--sm note-composer__source", autocomplete: "off", placeholder: "Source, e.g. call with Ann", aria: { label: "Source" } %>
        <button type="submit" class="ui-button ui-button--sm note-composer__submit">Add note</button>
      </div>
    <% end %>

    <% notes = subject.notes.recent.includes(:author) %>
    <% if notes.any? %>
      <ul class="record-feed notes-list">
        <% notes.each do |note| %>
          <%# herb:key note.id %>
          <li data-filter-target="item" class="record-feed__item">
            <span class="record-feed__avatar"><%= person_tag note.author %></span>
            <div class="record-feed__body">
              <div class="record-feed__head">
                <p class="record-feed__meta">
                  <span class="ui-badge ui-badge--outline"><%= note.kind.humanize %></span>
                  <time datetime="<%= note.occurred_at.iso8601 %>"><%= l(note.occurred_at, format: :short) %></time>
                  <% if note.source.present? %>
                    <span>· <%= note.source %></span>
                  <% end %>
                </p>
                <% if note.deletable_by?(Current.user) %>
                  <%= render "layouts/shared/delete_dialog", name: "this note", path: note_path(note), trigger_class: "txt-x-small" %>
                <% end %>
              </div>
              <div class="record-feed__text"><%= rich_text note.body %></div>
              <%= plugin_slots(:note_row, note: note) %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="record-card__empty">No notes yet.</p>
    <% end %>
  </div>
</section>
