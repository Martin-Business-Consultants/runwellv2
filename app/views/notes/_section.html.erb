<%# locals: (subject:, permanent: nil, deferred: nil) %>
<section class="card record-card" id="notes">
  <header class="card__head">
    <h2 class="card__title">Notes</h2>
    <p class="card__hint">What was said or decided. @ mentions the person.</p>
  </header>

  <div class="card__content record-card__stack">
    <%= render "notes/pending" %>
    <% if deferred %>
      <%# In the side panel the editor waits until it's wanted: opening a task to read it doesn't
          boot an editor. Clicking the line stamps the composer in its place (deferred-template). %>
      <div class="note-composer-deferred" data-controller="deferred-template">
        <button type="button" class="note-composer__trigger" data-deferred-template-target="trigger" data-action="deferred-template#stamp">
          Add a note: what was said or decided… @ to mention someone
        </button>
        <template data-deferred-template-target="template">
          <%= render "notes/composer", subject: subject, permanent: permanent %>
        </template>
      </div>
    <% else %>
      <%= render "notes/composer", subject: subject, permanent: permanent %>
    <% end %>

    <%= render "notes/feed", subject: subject %>
  </div>
</section>
