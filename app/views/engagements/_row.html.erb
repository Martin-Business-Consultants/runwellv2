<%# locals: (engagement:, listed:) %>
<%# One engagement in the index's data table (ui/_data_table): the cells in the columns' order. %>
<tr data-filter-target="item">
  <%= bulk_select_cell engagement, engagement.ref %>
  <td class="txt-nowrap" data-column="ref"><%= link_to engagement.ref, engagement, class: "txt-ink font-weight-bold" %></td>
  <td data-column="title"><%= link_to engagement.title, engagement, class: "txt-ink" %></td>
  <td data-column="client"><%= link_to engagement.client.name, engagement.client, class: "txt-ink txt-subtle" %></td>
  <td class="txt-subtle" data-column="type"><%= engagement.label_name %></td>
  <td data-column="state"><%= status_tag engagement.state_label, highlight: engagement.active? %></td>
  <% listed.each do |field| %>
    <%# herb:key field.id %>
    <td class="txt-subtle" data-column="field_<%= field.id %>"><%= custom_field_text(field, engagement.custom_value(field)) %></td>
  <% end %>
  <%= render "layouts/shared/row_actions", name: engagement.ref, edit_path: edit_engagement_path(engagement), delete_path: (engagement_path(engagement) if engagement.deletable?),
        delete_message: "Nothing has been done on it yet, so its notes and documents go with it." %>
</tr>
