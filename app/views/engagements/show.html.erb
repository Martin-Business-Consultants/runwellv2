<% @page_title = "#{@engagement.ref} #{@engagement.title}" %>
<% tabs = [
     record_tab("work", term(:work), count: @engagement.todos.open.count),
     record_tab("notes", "Notes", count: @engagement.notes.count),
     record_tab("documents", "Documents", count: @engagement.documents.count),
     record_tab("history", "History")
   ].compact + plugin_record_tabs(:engagement_panel) %>
<% tab = current_record_tab(tabs, "work") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>
<% next_step = engagement_next_step(@engagement) %>

<%= parent_page term(:engagement, count: 2), engagements_path %>

<section class="record-page">
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-meta record-page__description">
        <%= status_tag @engagement.state_label, highlight: @engagement.active? %>
        <%= link_to @engagement.client.name, @engagement.client %>
        <span><%= @engagement.label_name %> · <%= @engagement.recurring? ? "Recurring" : "Fixed scope" %></span>
        <% if @engagement.internal? %>
          <span>Internal</span>
        <% end %>
        <%= plugin_slots(:engagement_meta, engagement: @engagement) %>
        <% if @engagement.closed? %>
          <span><%= @engagement.state_label %> <%= l @engagement.closed_at.to_date, format: :long %><%= ": #{@engagement.close_reason}" if @engagement.close_reason.present? %></span>
        <% end %>
      </p>
    </div>
    <div class="button-row">
      <%= link_to edit_engagement_path(@engagement), class: "btn btn--secondary", data: { keys: "e" } do %>
        <%= icon_tag "pencil" %>
        <span>Edit</span>
        <kbd class="hide-on-touch">E</kbd>
      <% end %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Overview</h2>
        <% if next_step %>
          <p class="card__hint"><%= next_step %></p>
        <% end %>
      </header>
      <% if @engagement.description.present? %>
        <div class="card__content">
          <div class="record-card__prose"><%= rich_text @engagement.description %></div>
        </div>
      <% end %>
    </section>

    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "work" %>
            <%= render "todos/section", engagement: @engagement, state: @work_state, item: @work_item %>
          <% when "notes" %>
            <%= render "notes/section", subject: @engagement %>
          <% when "documents" %>
            <%= render "documents/section", subject: @engagement %>
          <% when "history" %>
            <%= render "events/timeline", subject: @engagement, expanded: true %>
          <% end %>
          <% if plugin_partial %>
            <%= render plugin_partial, engagement: @engagement %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="record-page__aside">
    <%= render "engagements/sidebar", engagement: @engagement, current: (tab == "work" ? (@work_item || "all") : nil) %>
    <%= plugin_slots(:engagement_aside, engagement: @engagement) %>

    <% if can?(:close_engagements) || (@engagement.closed? && can?(:erase_engagements)) %>
      <section class="card record-card">
        <header class="card__head">
          <% if @engagement.closed? %>
            <h2 class="card__title"><%= @engagement.state_label %></h2>
            <p class="card__hint">Off the open list. Its <%= term(:work).downcase %> and history stay.</p>
          <% else %>
            <h2 class="card__title">Finish</h2>
            <p class="card__hint">Mark it complete once it’s delivered, or cancel it.</p>
          <% end %>
        </header>
        <div class="card__content record-card__stack">
          <% if can?(:close_engagements) %>
            <% if @engagement.closed? %>
              <%= button_to reopen_engagement_path(@engagement), class: "btn btn--secondary btn--sm" do %>
                <%= icon_tag "refresh" %> <span>Reopen</span>
              <% end %>
            <% else %>
              <%= render "engagements/close", engagement: @engagement %>
            <% end %>
          <% end %>

          <% if @engagement.closed? && can?(:erase_engagements) %>
            <%= render "engagements/erase", engagement: @engagement %>
          <% end %>
        </div>
      </section>
    <% end %>
  </aside>
</section>
