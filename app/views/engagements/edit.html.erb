<% @page_title = "Edit #{@engagement.ref}" %>

<%= parent_page @engagement.ref, @engagement %>

<section class="record-page">
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description"><%= @engagement.title_was %> for <%= @engagement.client.name %></p>
    </div>
    <div class="button-row">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%= render "engagements/form", engagement: @engagement %>
  </div>

  <aside class="record-page__aside">
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Details</h2>
      </header>
      <div class="card__content">
        <dl class="details">
          <dt>Status</dt><dd><%= status_tag @engagement.state_label, highlight: @engagement.active? %></dd>
          <dt><%= term(:client) %></dt><dd><%= link_to @engagement.client.name, @engagement.client %></dd>
          <dt><%= term(:work, count: 2) %></dt><dd><%= @engagement.todos.count %> (<%= @engagement.todos.open.count %> open)</dd>
        </dl>
      </div>
    </section>
  </aside>
</section>
