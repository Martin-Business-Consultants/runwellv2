<%# locals: (engagement:, current: nil) %>
<%# herb:slots client %>
<%# herb:state (pane: "scope") %>
<%# An engagement's sidebar: its scope items (engagements/_scope) by default, or General, its facts
    and custom fields. Both are always on the page and state shows one, so switching never waits on
    the server. current: the scope item whose work is shown (engagements/_scope). %>
<nav class="record-tabs__nav sidebar-tabs" aria-label="Sidebar">
  <button type="button" class="record-tabs__tab" aria-pressed="<%= pane == "general" %>" data-herb-set="pane=general">General</button>
  <button type="button" class="record-tabs__tab" aria-pressed="<%= pane == "scope" %>" data-herb-set="pane=scope"><%= term(:scope_item, count: 2) %></button>
</nav>

<div hidden="<%= pane != "general" %>">
  <section class="settings__section flex flex-column gap-half">
    <dl class="record-facts">
      <dt>Status</dt><dd><%= status_tag engagement.state_label, highlight: engagement.active? %></dd>
      <dt><%= term(:client) %></dt><dd><%= link_to engagement.client.name, engagement.client, class: "txt-link" %></dd>
      <dt>Type</dt><dd><%= engagement.label_name %> · <%= engagement.recurring? ? "Recurring" : "Fixed scope" %></dd>
      <% unless engagement.internal? %>
        <% if priced_engagement?(engagement) %>
          <dt>Agreed</dt><dd><strong><%= money engagement.agreed_amount_cents %></strong><%= " / period" if engagement.recurring? %></dd>
        <% end %>
      <% end %>
      <dt>Started</dt><dd><%= l engagement.created_at.to_date, format: :long %></dd>
      <% if engagement.closed? %>
        <dt><%= engagement.state_label %></dt><dd><%= l engagement.closed_at.to_date, format: :long %><%= ": #{engagement.close_reason}" if engagement.close_reason.present? %></dd>
      <% end %>
    </dl>
    <%= render "custom_fields/values", record: engagement %>
  </section>
</div>

<div hidden="<%= pane != "scope" %>">
  <%= render "engagements/scope", engagement: engagement, current: current %>
</div>
