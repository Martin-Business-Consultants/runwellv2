<%# locals: (engagement:, current: nil) %>
<%# herb:slots client %>
<%# herb:state (pane: "scope") %>
<%# An engagement's sidebar card: its sections (engagements/_scope) by default, or General, its
    facts and custom fields. Both are always on the page and state shows one, so switching never
    waits on the server. current: the scope item whose work is shown (engagements/_scope). %>
<section class="card record-card engagement-sidebar">
  <header class="card__head">
    <nav class="tabs tabs--pills engagement-sidebar__tabs" aria-label="Sidebar">
      <button type="button" class="tabs__tab" aria-pressed="<%= pane == "scope" %>" data-herb-set="pane=scope"><%= term(:scope_item, count: 2) %></button>
      <button type="button" class="tabs__tab" aria-pressed="<%= pane == "general" %>" data-herb-set="pane=general">General</button>
    </nav>
  </header>

  <div class="card__content record-card__stack" hidden="<%= pane != "general" %>">
    <dl class="details">
      <dt>Status</dt><dd><%= status_tag engagement.state_label, highlight: engagement.active? %></dd>
      <dt><%= term(:client) %></dt><dd><%= link_to engagement.client.name, engagement.client %></dd>
      <dt>Type</dt><dd><%= engagement.label_name %> · <%= engagement.recurring? ? "Recurring" : "Fixed scope" %></dd>
      <dt>Started</dt><dd><%= l engagement.created_at.to_date, format: :long %></dd>
      <% if engagement.closed? %>
        <dt><%= engagement.state_label %></dt><dd><%= l engagement.closed_at.to_date, format: :long %><%= ": #{engagement.close_reason}" if engagement.close_reason.present? %></dd>
      <% end %>
    </dl>
    <%= render "custom_fields/values", record: engagement %>
  </div>

  <div class="card__content record-card__stack" hidden="<%= pane != "scope" %>">
    <%= render "engagements/scope", engagement: engagement, current: current %>
  </div>
</section>
