<%# locals: (engagement:) %>
<%# herb:slots client %>
<%# herb:state (erasing: false) %>
<%# Deleting a closed engagement for good (Engagements::ErasuresController), for owners: the form
    asks for the ref so it can't happen by accident. It's always on the page and state only shows
    it, so opening it never waits on the server. %>
<div class="erase-engagement" data-controller="state-focus" data-state-focus-state-value="erasing">
  <button type="button" class="btn btn--ghost btn--sm engagement-finish__danger" data-herb-set="erasing=true" hidden="<%= erasing %>">
    <%= icon_tag "trash" %>
    <span>Delete permanently</span>
  </button>
  <div hidden="<%= !erasing %>">
    <%= form_with url: engagement_erasure_path(engagement), class: "engagement-finish__form erase-engagement__form", data: { turbo_action: "advance" } do |form| %>
      <strong>Delete <%= engagement.ref %> for good?</strong>
      <span class="engagement-finish__text">
        It removes the <%= term(:engagement).downcase %> with its <%= term(:scope_item, count: 2).downcase %>, its <%= term(:work, count: 2).downcase %>,
        notes, documents and history. There’s no undo; the <%= term(:client).downcase %> keeps one note that it was deleted.
      </span>
      <label class="field">
        <span class="field__label">Type <strong><%= engagement.ref %></strong> to confirm</span>
        <%= form.text_field :confirm_ref, autocomplete: "off", required: true, autofocus: true, aria: { label: "Type #{engagement.ref} to confirm" } %>
      </label>
      <div class="engagement-finish__actions">
        <button type="submit" class="btn btn--danger btn--sm">Delete <%= engagement.ref %> permanently</button>
        <button type="button" class="btn btn--ghost btn--sm" data-keys="esc" data-herb-reset="erasing">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
