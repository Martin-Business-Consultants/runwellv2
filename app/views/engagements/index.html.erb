<% @page_title = term(:engagement, count: 2) %>
<% listed = CustomField.for("Engagement").listed.to_a %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :state, current: @state,
        options: Engagement.filter_options(Engagement.filter_counts(label: @label)) %>
  <%= render "layouts/shared/quick_filter", title: "Type…", param: :label, current: @label,
        options: [ [ "All types", "all" ] ] + Setting.current.enabled_labels.map { [ label_term(it, count: 2), it ] } %>
<% end %>
<% if @view == "table" %>
  <% content_for :index_bulk do %>
  <%= bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_engagements_path, noun: term(:engagement, count: 2).downcase, message: "Only those never sent to the client are deleted; sent ones are skipped (close them instead).") : nil) do %>
    <% if can?(:close_engagements) %>
      <%= bulk_button bulk_engagements_closure_path, method: :post, label: "Close" %>
    <% end %>
  <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: "New " + term(:engagement).downcase, new_path: new_engagement_path %>

<% if @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :engagements_cards, @page do %>
        <% @engagements.each do |engagement| %>
          <%# herb:key engagement.id %>
          <%= render "layouts/shared/card", path: engagement_path(engagement), title: engagement.title, id_label: engagement.ref,
                context: engagement.client.name,
                meta: [ engagement.label_name, engagement_amount(engagement) ].compact,
                status: engagement.state.humanize, highlight: engagement.active? %>
        <% end %>
      <% end %>
    </div>
  </section>
<% elsif @engagements.any? %>
  <section class="panel center index-table">

    <table class="data-table data-table--fixed">
      <%= table_colgroup :select, [ @column_widths[:ref], "Ref" ], [ @column_widths[:title], "Title" ], [ @column_widths[:client], term(:client) ], :pill, *([ :number ] if prices_on?), :status, *listed.map { :text }, :actions %>
      <thead>
        <tr><%= bulk_select_all_header %><%= sortable_th "Ref", :ref %><%= sortable_th "Title", :title %><%= sortable_th term(:client), :client %><%= sortable_th "Type", :type %><% if prices_on? %><th class="data-table__number">Agreed</th><% end %><th>State</th><% listed.each do |field| %><%# herb:key field.id %><th><%= field.label %></th><% end %><th></th></tr>
      </thead>
      <tbody id="<%= pagination_frame_id_for(:engagements_rows, @page.number) %>">
        <% @engagements.each do |engagement| %>
          <%# herb:key engagement.id %>
          <tr data-filter-target="item">
            <%= bulk_select_cell engagement, engagement.ref %>
            <td class="txt-nowrap"><%= link_to engagement.ref, engagement, class: "txt-ink font-weight-bold" %></td>
            <td><%= link_to engagement.title, engagement, class: "txt-ink" %></td>
            <td><%= link_to engagement.client.name, engagement.client, class: "txt-ink txt-subtle" %></td>
            <td class="txt-subtle"><%= engagement.label_name %></td>
            <% if prices_on? %>
              <td class="data-table__number"><%= engagement_amount(engagement) %></td>
            <% end %>
            <td><%= status_tag engagement.state.humanize, highlight: engagement.active? %></td>
            <% listed.each do |field| %>
              <%# herb:key field.id %>
              <td class="txt-subtle"><%= custom_field_text(field, engagement.custom_value(field)) %></td>
            <% end %>
            <%= render "layouts/shared/row_actions", name: engagement.ref, edit_path: edit_engagement_path(engagement), delete_path: (engagement_path(engagement) if engagement.deletable?),
                  delete_message: "It was never sent, so its draft agreement, work and notes go with it." %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <%= table_pagination @page %>
<% end %>

<% if @engagements.none? %>
  <div class="blank-slate">No <%= term(:engagement, count: 2).downcase %> match.</div>
<% end %>
