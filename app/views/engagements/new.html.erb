<% @page_title = "New " + term(:engagement).downcase %>
<% client = @engagement.client %>
<% existing = client ? client.engagements.includes(:client).order(created_at: :desc).limit(8).to_a : [] %>

<% content_for :header do %>
  <%= parent_page term(:engagement, count: 2), engagements_path %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <div class="flex flex-column gap-half">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="txt-small txt-subtle margin-none">
        <% if client&.internal? %>
          <%= client.name %> is internal: one of your own projects.
        <% else %>
          It’s active from the start: add its <%= term(:scope_item, count: 2).downcase %> and <%= term(:work).downcase %> next.
        <% end %>
      </p>
    </div>
    <%= render "engagements/form", engagement: @engagement %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">

    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section">
      <header>
        <h2 class="divider">How it goes</h2>
      </header>
      <% steps = [ "Add #{term(:scope_item, count: 2).downcase} if it has parts, to group its #{term(:work).downcase}.",
           "Add #{term(:work).downcase} as it comes up, with owners and due dates.", "Track it on the #{term(:work)} table or board like any other.",
           "Close the #{term(:engagement).downcase} when it’s done." ] %>
      <ol class="record-steps txt-small">
        <% steps.each do |step| %>
          <%# herb:key step %>
          <li><%= step %></li>
        <% end %>
      </ol>
    </section>

    <% if client %>
      <section class="settings__section">
        <header>
          <h2 class="divider"><%= client.name %>’s <%= term(:engagement, count: 2).downcase %> <span class="txt-subtle"><%= existing.size %></span></h2>
        </header>
        <ul class="settings__scrollable-list">
          <% existing.each do |engagement| %>
            <%# herb:key engagement.id %>
            <li class="flex align-center gap-half txt-small" data-filter-target="item">
              <%= link_to engagement, class: "txt-ink overflow-ellipsis min-width" do %>
                <strong><%= engagement.ref %></strong> <%= engagement.title %>
              <% end %>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <%= status_tag engagement.state_label, highlight: engagement.active? %>
            </li>
          <% end %>
        </ul>
        <% if existing.empty? %>
          <p class="txt-subtle txt-small margin-none">This is their first.</p>
        <% end %>
      </section>
    <% end %>
  </aside>
</section>
