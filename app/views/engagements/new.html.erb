<% @page_title = "New " + term(:engagement).downcase %>
<% client = @engagement.client %>
<% existing = client ? client.engagements.includes(:client).order(created_at: :desc).limit(8).to_a : [] %>

<%= parent_page term(:engagement, count: 2), engagements_path %>

<section class="record-page">
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <% if client&.internal? %>
          <%= client.name %> is internal: one of your own projects.
        <% else %>
          It’s active from the start: add its <%= term(:scope_item, count: 2).downcase %> and <%= term(:work, count: 2).downcase %> next.
        <% end %>
      </p>
    </div>
    <div class="button-row">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%= render "engagements/form", engagement: @engagement %>
  </div>

  <aside class="record-page__aside">
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">How it goes</h2>
      </header>
      <div class="card__content">
        <% steps = [ "Add #{term(:scope_item, count: 2).downcase} if it has parts, to group its #{term(:work, count: 2).downcase}.",
             "Add #{term(:work, count: 2).downcase} with owners and due dates, whenever something needs doing.", "Track it on the #{term(:work, count: 2)} table or board like any other.",
             "Close the #{term(:engagement).downcase} when it’s done." ] %>
        <ol class="record-steps">
          <% steps.each do |step| %>
            <%# herb:key step %>
            <li><%= step %></li>
          <% end %>
        </ol>
      </div>
    </section>

    <% if client %>
      <section class="card record-card">
        <header class="card__head">
          <h2 class="card__title"><%= client.name %>’s <%= term(:engagement, count: 2).downcase %></h2>
          <p class="card__hint"><%= existing.empty? ? "This is their first." : pluralize(existing.size, "so far", plural: "so far") %></p>
        </header>
        <% if existing.any? %>
          <div class="card__content">
            <ul class="record-list">
              <% existing.each do |engagement| %>
                <%# herb:key engagement.id %>
                <li data-filter-target="item">
                  <%= link_to engagement, class: "list-row" do %>
                    <span class="list-row__content"><span class="list-row__title"><span class="record-list__ref"><%= engagement.ref %></span> <%= engagement.title %></span></span>
                    <span class="list-row__meta"><%= status_tag engagement.state_label, highlight: engagement.active? %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </section>
    <% end %>
  </aside>
</section>
