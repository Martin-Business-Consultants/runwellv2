<% @page_title = "New " + term(:engagement).downcase %>
<% client = @engagement.client %>
<% existing = client ? client.engagements.includes(:client).order(created_at: :desc).limit(8).to_a : [] %>

<% content_for :header do %>
  <%= parent_page term(:engagement, count: 2), engagements_path %>
<% end %>

<section class="settings settings--split record-page">
  <header class="record-page__header page-heading">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <% if client&.internal? %>
          <%= client.name %> is internal: one of your own projects.
        <% else %>
          It’s active from the start: add its <%= term(:scope_item, count: 2).downcase %> and <%= term(:work).downcase %> next.
        <% end %>
      </p>
    </div>
    <div class="page-heading__actions">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="settings__panel record-page__main">
    <%= render "engagements/form", engagement: @engagement %>
  </div>

  <aside class="settings__panel settings__panel--side record-page__aside">
    <section class="ui-card record-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">How it goes</h2>
      </header>
      <div class="ui-card__content">
        <% steps = [ "Add #{term(:scope_item, count: 2).downcase} if it has parts, to group its #{term(:work).downcase}.",
             "Add #{term(:work).downcase} as it comes up, with owners and due dates.", "Track it on the #{term(:work)} table or board like any other.",
             "Close the #{term(:engagement).downcase} when it’s done." ] %>
        <ol class="record-steps">
          <% steps.each do |step| %>
            <%# herb:key step %>
            <li><%= step %></li>
          <% end %>
        </ol>
      </div>
    </section>

    <% if client %>
      <section class="ui-card record-card">
        <header class="ui-card__header">
          <h2 class="ui-card__title"><%= client.name %>’s <%= term(:engagement, count: 2).downcase %></h2>
          <p class="ui-card__description"><%= existing.empty? ? "This is their first." : pluralize(existing.size, "so far", plural: "so far") %></p>
        </header>
        <% if existing.any? %>
          <div class="ui-card__content">
            <ul class="record-list record-list--compact">
              <% existing.each do |engagement| %>
                <%# herb:key engagement.id %>
                <li data-filter-target="item">
                  <%= link_to engagement, class: "record-list__row" do %>
                    <span class="record-list__main"><span class="record-list__title"><span class="record-list__ref"><%= engagement.ref %></span> <%= engagement.title %></span></span>
                    <%= status_tag engagement.state_label, highlight: engagement.active? %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>
      </section>
    <% end %>
  </aside>
</section>
