<%# locals: (engagement:) %>
<%= render "layouts/shared/errors", record: engagement %>

<%= form_with model: engagement, class: "ui-card record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <header class="ui-card__header">
    <h2 class="ui-card__title"><%= term(:engagement) %></h2>
    <p class="ui-card__description">Who it’s for, what kind it is, and what it covers.</p>
  </header>

  <div class="ui-card__content record-form__body">
    <label class="ui-field">
      <span class="ui-label"><%= term(:client) %></span>
      <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "Choose a client" },
            required: true, disabled: engagement.persisted?, class: "ui-select" %>
    </label>

    <div class="ui-field-row">
      <label class="ui-field">
        <span class="ui-label">Label</span>
        <%= form.select :label, label_options(engagement.label), {}, class: "ui-select" %>
      </label>

      <label class="ui-field">
        <span class="ui-label">Shape</span>
        <%= form.select :shape, [ [ "Fixed scope", "fixed" ], [ "Recurring", "recurring" ] ], {},
              disabled: engagement.persisted?, class: "ui-select" %>
      </label>
    </div>

    <label class="ui-field">
      <span class="ui-label">Title</span>
      <%= form.text_field :title, required: true, class: "ui-input", autofocus: true, autocomplete: "off", placeholder: "Spring landing page" %>
    </label>

    <label class="ui-field">
      <span class="ui-label">Description</span>
      <%= rich_text_field form, :description, staff: true %>
      <% unless engagement.internal? %>
        <span class="ui-field__description">Shown to the <%= term(:client).downcase %> in the portal.</span>
      <% end %>
    </label>

    <label class="ui-field">
      <span class="ui-label">Estimate notes</span>
      <%= rich_text_field form, :estimate_notes, staff: true %>
      <span class="ui-field__description">Internal. Never shown to clients.</span>
    </label>

    <%= custom_field_inputs form, engagement %>
  </div>

  <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
    <%= link_to "Cancel", engagement.persisted? ? engagement_path(engagement) : engagements_path, class: "ui-button ui-button--outline", data: { form_target: "cancel" } %>
    <button type="submit" class="ui-button" data-form-target="submit">
      <span><%= engagement.new_record? ? "Draft engagement" : "Save changes" %></span>
    </button>
  </footer>
<% end %>
