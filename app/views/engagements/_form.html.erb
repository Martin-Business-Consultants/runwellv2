<%# locals: (engagement:) %>
<%= render "layouts/shared/errors", record: engagement %>

<%= form_with model: engagement, class: "card record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <header class="card__head">
    <h2 class="card__title"><%= term(:engagement) %></h2>
    <p class="card__hint">Who it’s for, what kind it is, and what it covers.</p>
  </header>

  <div class="card__content record-form__body">
    <label class="field">
      <span class="field__label"><%= term(:client) %></span>
      <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "Choose a client" },
            required: true, disabled: engagement.persisted? %>
    </label>

    <div class="field-row">
      <label class="field">
        <span class="field__label">Label</span>
        <%= form.select :label, label_options(engagement.label), {} %>
      </label>

      <label class="field">
        <span class="field__label">Shape</span>
        <%= form.select :shape, [ [ "Fixed scope", "fixed" ], [ "Recurring", "recurring" ] ], {},
              disabled: engagement.persisted? %>
      </label>
    </div>

    <label class="field">
      <span class="field__label">Title</span>
      <%= form.text_field :title, required: true, autofocus: true, autocomplete: "off", placeholder: "Spring landing page" %>
    </label>

    <label class="field">
      <span class="field__label">Description</span>
      <%= rich_text_field form, :description, staff: true %>
      <% unless engagement.internal? %>
        <span class="field__hint">Shown to the <%= term(:client).downcase %> in the portal.</span>
      <% end %>
    </label>

    <%= custom_field_inputs form, engagement %>
  </div>

  <footer class="card__footer card__footer--bordered">
    <%= link_to "Cancel", engagement.persisted? ? engagement_path(engagement) : engagements_path, class: "btn btn--secondary", data: { form_target: "cancel" } %>
    <button type="submit" class="btn btn--primary" data-form-target="submit">
      <span><%= engagement.new_record? ? "Draft engagement" : "Save changes" %></span>
    </button>
  </footer>
<% end %>
