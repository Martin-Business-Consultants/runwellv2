<% @page_title = @item.description %>
<% done, total = @item.progress %>
<% tabs = [
     record_tab("tasks", term(:task, count: 2), count: @tasks.size),
     record_tab("notes", "Notes", count: @item.notes.count),
     record_tab("documents", "Documents", count: @item.documents.count)
   ] %>
<% tab = current_record_tab(tabs, "tasks") %>

<%= parent_page @work.title, @work %>
<%= turbo_stream_from @item %>

<section class="record-page record-page--tabbed">
  <%= render "scope_items/header", item: @item %>

  <div class="record-page__main">
    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "tasks" %>
            <section class="card record-card" id="tasks">
              <header class="card__head">
                <h2 class="card__title"><%= term(:task, count: 2) %></h2>
                <p class="card__hint"><%= done %> of <%= total %> done</p>
              </header>

              <div class="card__content">
                <% if @tasks.any? %>
                  <ul class="record-list">
                    <%= render partial: "tasks/task", collection: @tasks, as: :task %>
                  </ul>
                <% else %>
                  <p class="record-card__empty">No work under this yet.</p>
                <% end %>
              </div>

              <% unless @work.closed? %>
                <footer class="card__footer">
                  <%= render "tasks/add", work: @work, scope_item: @item, inline: false %>
                </footer>
              <% end %>
            </section>
          <% when "notes" %>
            <%= render "notes/section", subject: @item %>
          <% when "documents" %>
            <%= render "documents/section", subject: @item %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="record-page__aside">
    <%= plugin_slots(:scope_item_aside, scope_item: @item) %>
    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Details</h2>
      </header>
      <div class="card__content">
        <dl class="details">
          <dt>Delivery</dt><dd><%= status_tag @item.delivery_state.humanize, highlight: @item.delivery_state == "done" %></dd>
          <dt>Progress</dt><dd><strong><%= done %> of <%= total %></strong> done</dd>
          <dt><%= term(:work) %></dt><dd><%= link_to @work.title, @work %></dd>
          <dt><%= term(:client) %></dt><dd><%= link_to @work.client.name, @work.client %></dd>
        </dl>
      </div>
    </section>

    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Remove</h2>
        <p class="card__hint">Removing it keeps its <%= term(:task, count: 2).downcase %> on the <%= term(:work).downcase %>.</p>
      </header>
      <div class="card__content">
        <%= render "scope_items/item", item: @item %>
      </div>
    </section>
  </aside>
</section>
