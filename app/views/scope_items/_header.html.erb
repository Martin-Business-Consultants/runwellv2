<%# locals: (item:) %>
<%# A section's page header: its name, changed in place, how its delivery stands and the work it's
    part of. Redrawn when it saves (scope_items/update.turbo_stream.erb). %>
<%= record_header id: dom_id(item, :header), arrange: false do %>
    <%= render "layouts/shared/record_title", record: item, attribute: :description, label: "Name" %>
    <p class="record-header__line">
      <%= status_tag item.delivery_state.humanize, highlight: item.delivery_state == "done" %>
      <span>A <%= term(:scope_item).downcase %> of <%= link_to item.work.title, item.work %></span>
    </p>
<% end %>
