<%# locals: (item:) %>
<div class="scope-item-fields txt-small">
  <%= form_with model: item, namespace: dom_id(item) do |form| %>
    <%= form.text_field :description, required: true, class: "ui-input", autocomplete: "off", aria: { label: "Name" } %>
    <button type="submit" class="ui-button ui-button--outline ui-button--icon" title="Save">
      <%= icon_tag "check" %>
      <span class="for-screen-reader">Save</span>
    </button>
  <% end %>
  <%= render "layouts/shared/delete_dialog", name: item.description, path: scope_item_path(item),
        message: "Its #{term(:work).downcase} stays on the #{term(:engagement).downcase}, under no #{term(:scope_item).downcase}." %>
</div>
