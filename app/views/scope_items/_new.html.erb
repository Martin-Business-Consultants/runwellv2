<%# locals: (engagement:) %>
<%# A new scope item: its name and Add, on one line. %>
<div class="scope-item-fields">
  <%= form_with model: [ engagement, ScopeItem.new ], namespace: dom_id(engagement, :new_item) do |form| %>
    <%= form.text_field :description, required: true, autocomplete: "off", placeholder: "New #{term(:scope_item).downcase}", aria: { label: "New #{term(:scope_item).downcase}" } %>
    <button type="submit" class="btn btn--primary btn--sm" title="Add">
      <span>Add</span>
      <%= icon_tag "add" %>
    </button>
  <% end %>
</div>
