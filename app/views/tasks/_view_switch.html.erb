<%# locals: (current:, work: nil) %>
<%# A piece of work's tasks as a list by section or as the board: runeui's toggle group as links,
    in its card's head, each swapping ?task_view= and reloading only the record tab's frame (the
    frame targets _top, so the link names it), never the whole page. work: the piece of work, so
    an answer drawn for another address (a quick add's stream) still links to its page. %>
<% view_url = ->(key) { params = request.query_parameters.except("task", "peek").merge("tab" => "tasks", "task_view" => key); work ? work_path(work, params) : url_for(params) } %>
<%= ui :toggle_group, value: current, variant: :outline, size: :sm, label: "Show as", class: "view-toggle", data: { picks_current: true }, options: [
      [ "List", "list", { icon: icon_tag("column-left"), title: "List", href: view_url.call("list"), data: { turbo_frame: "record_tab", turbo_action: "replace" } } ],
      [ "Board", "board", { icon: icon_tag("board"), title: "Board", href: view_url.call("board"), data: { turbo_frame: "record_tab", turbo_action: "replace" } } ]
    ] %>
