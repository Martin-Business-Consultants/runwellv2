<%# locals: (current:) %>
<%# A piece of work's work as a list by section or as the Work board: icon tabs in its card's head,
    each a link swapping ?task_view= that reloads only the record tab's frame (the frame targets
    _top, so the link names it), never the whole page. %>
<nav class="tabs tabs--icons" aria-label="Show as" data-picks-current>
  <% [ [ "list", "List", "column-left" ], [ "board", "Board", "board" ] ].each do |key, label, icon| %>
    <%# herb:key key %>
    <%= link_to url_for(request.query_parameters.except("task").merge("tab" => "tasks", "task_view" => key)), class: "tabs__tab", title: label,
          aria: { current: (key == current) ? "page" : "false", label: label }, data: { turbo_frame: "record_tab", turbo_action: "replace" } do %>
      <%= icon_tag icon %>
    <% end %>
  <% end %>
</nav>
