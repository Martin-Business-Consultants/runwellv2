<%# locals: (client:, state: nil) %>
<%# A client's work: on its work and straight on the client. Open by default; the filter
    shows done or all. Work added here is on the client, not on any work. %>
<% state ||= "open" %>
<% all = client.tasks.includes(:owner, :work, :client, :custom_values, assignments: :user).order(:due_on, :position, :id).to_a %>
<% shown = all.select { |task| state == "all" || (state == "done") == (task.status == "done") } %>
<%= record_card term(:task, count: 2), id: "tasks", hint: "On their #{term(:work, count: 2).downcase} and straight on #{client.name}.",
      action: render("layouts/shared/segmented_filter", label: "Show " + term(:task, count: 2).downcase, param: :tasks, current: state, options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ]),
      footer: render("tasks/add", client: client), data: { task_list: "client", task_list_state: state, task_list_keeps: task_list_keeps(state) } do %>
    <% if shown.any? %>
      <ul class="record-list">
        <% shown.each do |task| %>
          <%# herb:key task.id %>
          <%= render "tasks/task", task: task, with_work: true %>
        <% end %>
      </ul>
    <% elsif all.any? %>
      <%= ui :empty, size: :sm, description: (state == "open" ? "Nothing open: all #{all.size} done." : "Nothing done yet."), action: link_to("Show all", client_path(client, request.query_parameters.merge("tab" => "tasks", "tasks" => "all"))) %>
    <% else %>
      <%= ui :empty, size: :sm, description: "No #{term(:task, count: 2).downcase} yet. Add it here, on one of their #{term(:work, count: 2).downcase}, or it arrives as a request." %>
    <% end %>
<% end %>
