<% @page_title = "Edit #{@task.title_was}" %>

<%= parent_page @task.title_was, @task %>

<% layout = record_layout(:task) %>
<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:task) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:task).downcase}’s" %>
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">What it is, and beside it who’s on it, when it’s due and where it came from.</p>
    </div>
    <div class="button-row">
      <%= render "record_fields/arrange_button" %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <%# Fields as the install arranged them (template mode, RecordLayout): the working column's in
      the form's card, the sidebar's in Properties, all saved by the one form (task_form). %>
  <div class="record-page__main">
    <%= render "record_fields/main_card", layout: layout, record: @task, form_id: "task_form", title: term(:task),
          submit: "Save changes", cancel: task_path(@task), hidden: { from_edit: "1" } %>
  </div>

  <aside class="record-page__aside">
    <%= render "record_fields/aside_card", layout: layout, record: @task, form_id: "task_form" %>

    <section class="card record-card">
      <header class="card__head">
        <h2 class="card__title">Details</h2>
      </header>
      <div class="card__content">
        <dl class="details">
          <% if @task.work %>
            <dt><%= term(:work) %></dt><dd><%= link_to "#{@task.work.ref} #{@task.work.title}", @task.work %></dd>
          <% end %>
          <% if @task.client %>
            <dt><%= term(:client) %></dt><dd><%= link_to @task.client.name, @task.client %></dd>
          <% end %>
          <dt>Added</dt><dd><%= l @task.created_at.to_date, format: :long %><%= " by #{@task.created_by.display_name}" if @task.created_by %></dd>
          <% if @task.completed_at %>
            <dt>Done</dt><dd><%= l @task.completed_at.to_date, format: :long %></dd>
          <% end %>
        </dl>
      </div>
    </section>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Remove this " + term(:task).downcase, title: "Remove #{@task.title_was}?",
            body: "It comes off the #{term(:work).downcase} and the #{term(:client).downcase}’s portal. Its history stays.",
            button: "Remove", path: task_path(@task) %>
    <% end %>
  </aside>
</section>
