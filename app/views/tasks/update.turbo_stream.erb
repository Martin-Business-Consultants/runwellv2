<%# Saved from the side panel: the task redrawn wherever it shows (the panel, its table row, its
    line in a Tasks section, its board card), and the notice. Targets the page lacks are skipped. %>
<%= turbo_stream.replace dom_id(@task, :panel), method: :morph, partial: "tasks/panel", locals: { task: @task } %>
<%= turbo_stream.replace dom_id(@task, :row), method: :morph, partial: "tasks/row", locals: { task: @task, listed: CustomField.for("Task").listed.to_a } %>
<%= turbo_stream.replace dom_id(@task, :item), method: :morph, partial: "tasks/task", locals: { task: @task } %>
<%= turbo_stream.replace "board-card-#{@task.id}", method: :morph, partial: "tasks/display/preview", locals: { task: @task } %>
<%= intake_streams(@task) %>
<%= turbo_stream_flash(notice: (@alert ? nil : "Saved."), alert: @alert) %>
<%# A repeating task marked done made the next one: the page reloads in place to show it. %>
<% if @task.repeated_task %>
  <%= turbo_stream.refresh(request_id: nil) %>
<% end %>
