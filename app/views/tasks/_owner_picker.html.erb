<%# locals: (task:, labelled: nil, options_on_page: nil) %>
<%# Who's on a task, changed in place (Fizzy's assignments): the avatars (or an empty circle) open
    a menu of the team. Type to narrow it (fuzzy: "sp" finds Sarah Producer); each click puts that
    person on or takes them off, and the menu stays open. The first on leads (the owner); taking
    off the lead hands it to whoever came on next. The team's list is on the page once
    (task_assignee_options_template) and copied into the menu when it first opens. %>
<% unless options_on_page %>
  <%= task_assignee_options_template %>
<% end %>
<div class="row-picker owner-picker" id="<%= dom_id(task, labelled ? :owner_labelled : :owner) %>" data-controller="dialog fixed-popup filter picker" data-dialog-orient-value="false" data-filter-fuzzy-value="true"
  data-picker-multiple-value="true" data-picker-current-value="<%= task.owners.map(&:id).join(",") %>" data-picker-options-value="task-assignee-options"
  data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside dialog:show->fixed-popup#place dialog:show->picker#fill dialog:close->fixed-popup#close dialog:close->filter#clearInput">
  <%= render "tasks/owners", task: task, labelled: labelled %>

  <%= popup_menu label: "Who’s on #{task.title}", fixed: true do %>
    <input type="search" class="owner-picker__search" placeholder="Who’s on it…" autocomplete="off" aria-label="Find a person" data-1p-ignore="true"
      data-filter-target="input" data-dialog-target="focusMouse" data-action="input->filter#filter">
    <%= form_with url: task_assignments_path(task), method: :post do %>
      <% if labelled %>
        <input type="hidden" name="labelled" value="1">
      <% end %>
      <ul class="popup__list" role="group" data-picker-target="list"></ul>
    <% end %>
    <p class="owner-picker__hint">The first on leads.</p>
  <% end %>
</div>
