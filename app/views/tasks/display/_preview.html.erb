<%# locals: (task:) %>
<%# A task on the board (runeui's ui :board_card): its work and client on a faint line, the title
    (a link that opens it in the side panel, side_panel_link_data), then the due date and the people
    on it. The column names the status, so the card carries no colour of its own. Its element is
    board-card-<id>, which tasks/update.turbo_stream.erb redraws. %>
<% overdue = task.status != "done" && task.due_on&.past? %>
<% context = capture do %>
  <% if task_ref(task).present? %>
    <span class="task-card__ref"><span class="visually-hidden"><%= term(:work) %></span> <%= task_ref(task) %></span>
  <% end %>
  <span class="task-card__client"><%= task_client_name(task) %></span>
<% end %>
<% footer = capture do %>
  <span class="task-card__badges">
    <%= agent_made_tag(task) %>
    <% if task.status == "done" && task.completed_at %>
      <%= ui :badge, variant: :success, content: "Done #{l task.completed_at.to_date, format: :short}" %>
    <% elsif overdue %>
      <%= ui :badge, variant: :destructive, content: "Due #{l task.due_on, format: :short}", title: "Overdue" %>
    <% elsif task.due_on %>
      <%= ui :badge, variant: :outline, content: "Due #{l task.due_on, format: :short}" %>
    <% end %>
  </span>
  <% if task.owners.any? %>
    <span class="task-card__people"><%= task_owners_tag task %></span>
  <% end %>
<% end %>
<%= ui :board_card, id: task.id, title: task.title, href: task_path(task), meta: context,
      footer: footer, link: { data: side_panel_link_data(task) }, class: class_names("task-card", "task-card--active": task.status == "in_progress"),
      data: { filter_target: "item", task: task.id } %>
