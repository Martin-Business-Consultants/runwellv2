<%# locals: (task:, labelled: nil, options_on_page: nil) %>
<%# A task's status as a colored circle, in the Work board's colors. Clicking it opens a menu
    of the statuses (Fizzy's popup, like the quick filters); choosing one shows at once (picker)
    and saves it with one form for the menu, answered with just this picker (TasksController#update).
    The statuses are on the page once (task_status_options_template), copied into the menu when it
    opens. %>
<% label = task.status.humanize %>
<% unless options_on_page %>
  <%= task_status_options_template %>
<% end %>
<div class="row-picker status-dot-picker" id="<%= dom_id(task, labelled ? :status_labelled : :status) %>" data-controller="dialog fixed-popup picker" data-dialog-orient-value="false"
  data-picker-current-value="<%= task.status %>" data-picker-options-value="task-status-options"
  data-action="keydown.esc->dialog#close picker:chosen->dialog#close click@document->dialog#closeOnClickOutside dialog:show->picker#fill dialog:show->fixed-popup#place dialog:close->fixed-popup#close">
  <button type="button" class="status-dot-picker__trigger" title="<%= label %>: click to change" aria-haspopup="true" data-fixed-popup-target="trigger" data-action="click->dialog#toggle:stop">
    <span class="status-dot-picker__dot" data-picker-target="display" data-picker-part="dot"><%= tag.span class: "status-dot status-dot--#{task.status.dasherize}", aria: { hidden: true } %></span>
    <% if labelled %>
      <span class="status-dot-picker__label" data-picker-target="display" data-picker-part="label"><%= label %></span>
    <% end %>
    <span class="visually-hidden">Status of <%= task.title %>: <%= label %>. Change it</span>
  </button>

  <%= popup_menu label: "Status of #{task.title}", title: "Status", fixed: true do %>
    <%= form_with url: task_path(task), method: :patch do %>
      <input type="hidden" name="inline" value="status">
      <% if labelled %>
        <input type="hidden" name="labelled" value="1">
      <% end %>
      <ul class="popup__list" role="group" data-picker-target="list"></ul>
    <% end %>
  <% end %>
</div>
