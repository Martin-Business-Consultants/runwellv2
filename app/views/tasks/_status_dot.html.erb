<%# locals: (task:, labelled: nil, options_on_page: nil) %>
<%# A task's status as a colored circle, in the Work board's colors. Clicking it opens the page's
    one menu of the statuses beside it (task_picker_menus, a ui :menu opened by data-runeui-open);
    choosing one shows at once (picker), fading its row if the list it's in won't keep it (task
    value), and saves it (Tasks::StatusesController), whose answer redraws the task wherever it
    shows. A row carries only this button. %>
<% label = task.status.humanize %>
<% unless options_on_page %>
  <%= task_picker_menus %>
<% end %>
<span class="row-picker status-dot-picker" id="<%= dom_id(task, labelled ? :status_labelled : :status) %>" data-controller="picker" data-picker-kind-value="status"
  data-picker-current-value="<%= task.status %>" data-picker-menu-value="task-status-menu" data-picker-form-value="task-status-form"
  data-picker-url-value="<%= task_status_path(task) %>" data-picker-task-value="<%= task.id %>"<% if labelled %> data-picker-labelled-value="true"<% end %>>
  <button type="button" class="status-dot-picker__trigger" id="<%= dom_id(task, labelled ? :status_labelled_button : :status_button) %>" title="<%= label %>: click to change" aria-haspopup="menu" data-runeui-open="task-status-menu" data-action="click->picker#open">
    <span class="status-dot-picker__dot" data-picker-target="display" data-picker-part="dot"><span class="status-dot status-dot--<%= task.status.dasherize %>" aria-hidden="true"></span></span>
    <% if labelled %>
      <span class="status-dot-picker__label" data-picker-target="display" data-picker-part="label"><%= label %></span>
    <% end %>
    <span class="visually-hidden">Status of <%= task.title %>: <%= label %>. Change it</span>
  </button>
</span>
