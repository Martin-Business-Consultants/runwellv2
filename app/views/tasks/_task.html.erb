<%# locals: (task:, with_work: nil) %>
<%# A piece of work in a record's Work card: its status to change in place, its title and details
    (the link), then Overdue, who's on it and Copy for AI. The rows are the record pages'
    record-list; work.css adds what's particular to work. %>
<li data-filter-target="item" class="record-list__row task-item">
  <%= render "tasks/status_dot", task: task %>
  <%= side_panel_link_to task, class: "record-list__main" do %>
    <span class="record-list__title"><%= task.title %></span>
    <span class="record-list__description"><%= task_details(task, with_work: with_work) %></span>
  <% end %>

  <span class="record-list__actions">
    <% if task.status != "done" && task.due_on&.past? %>
      <%= status_tag "Overdue", highlight: true %>
    <% end %>
    <%= render "tasks/owner_picker", task: task %>
    <%= render "tasks/ai_brief", task: task %>
  </span>
</li>
