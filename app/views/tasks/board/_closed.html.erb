<%# locals: (count:, board:) %>
<%= column_tag id: "done-tasks", name: "Done", drop_url: columns_task_drops_closure_path("__id__", task_board_filters), class: "cards--closed",
  card_color: "var(--color-card-complete)",
  data: {
    drag_and_strum_target: "container",
    collapsible_columns_target: "column",
    action: "focus->collapsible-columns#focusOnColumn"
  } do %>
  <header class="cards__header">
    <%= render "tasks/board/expander", title: "Done", count: count, column_id: "done-tasks", status: "done" %>
    <%= render "tasks/board/maximize", column_path: tasks_column_path("done", task_board_filters) %>
  </header>
  <%= column_frame_tag "done_cards" do %>
    <%= render "tasks/board/cards", status: "done", page: task_board_page(board, "done") %>
  <% end %>
<% end %>
