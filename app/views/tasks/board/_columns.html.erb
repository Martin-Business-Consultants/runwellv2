<%# locals: (board:) %>
<%# The Tasks board (and a piece of work's, ?task_view=board): runeui's board, a column per status
    (tasks/board/column). A card is dragged between columns and up and down one, or moved from the
    keys (H / L a column, J / K up and down; the keyboard controller hands h j k l to the card as
    arrows); each move posts to its column's own drop endpoint (Columns::Tasks::Drops::*) with the
    card it now sits before, which answers by redrawing that column. The doing columns and Done
    fold to strips from their titles, remembered per browser. %>
<% counts = board.reorder(nil).group(:status).count %>
<%= ui :board, id: "tasks-board", method: :post, label: "#{term(:task, count: 2)} by status", class: "task-board" do %>
  <% task_board_statuses.each do |status| %>
    <%# herb:key status %>
    <%= render "tasks/board/column", status: status, count: counts.fetch(status, 0), board: board %>
  <% end %>
<% end %>
