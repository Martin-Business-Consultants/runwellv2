<%# locals: (status:, count:, board:) %>
<%# One column of the Tasks board (runeui's ui :board_column): its status's dot, name and how many,
    the way to its own page (maximize), its first page of cards, and the next page loading as it
    scrolls (task_board_more). Moves into it post to its drop endpoint (task_drop_url), whose
    answer redraws it (columns/tasks/drops/*/create). Planned stays open; the rest fold. %>
<% page = task_board_page(board, status) %>
<% records = page.records.to_a %>
<%= ui :board_column, id: status, title: status.humanize, total: count, tone: task_column_tone(status), url: task_drop_url(status),
      collapsible: (status != "planned"), collapsed: (status != "planned"), class: "task-column task-column--#{status.dasherize}",
      empty: (status == "done" ? "No #{term(:task, count: 2).downcase} here" : "Drag #{term(:task, count: 2).downcase} here"),
      action: render("tasks/board/maximize", column_path: tasks_column_path(status, task_board_filters)),
      more: task_board_more(status, page, shown: records.size, total: count) do %>
  <%= render partial: "tasks/display/preview", collection: records, as: :task %>
<% end %>
