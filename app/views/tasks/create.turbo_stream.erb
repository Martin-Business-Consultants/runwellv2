<%# Added in a piece of work's or a client's Tasks section: that section again (its filter, open
    by default, and the section it was focused on), and the notice. %>
<% if @home.is_a?(Work) %>
  <%= turbo_stream.replace "tasks", method: :morph, partial: "tasks/section", locals: { work: @home, state: Task.state_filter(params[:inline_state]), item: Task.section_focus(params[:inline_item]) } %>
<% else %>
  <%= turbo_stream.replace "tasks", method: :morph, partial: "tasks/client_section", locals: { client: @home } %>
<% end %>
<%= turbo_stream_flash(notice: "Added.") %>
