<%# locals: (task:) %>
<%# A task in the side panel (layouts/shared/_side_panel), beside the page you opened it from:
    where it sits, its title, then its fields in the install's order (status, who's on it, due
    date and section saved as you change them), and its notes. Saving refreshes the page under it in place
    (TasksController#update), and others' changes arrive live (turbo_stream_from). Open goes to
    its own page; Esc or ✕ closes it. It sits in runeui's side panel (a ui-* element), so it opts
    out of runeui's morph guard (data-morph="replace"): a refresh redraws it as the server has it. %>
<section class="task-panel" id="<%= dom_id(task, :panel) %>" aria-label="<%= task.title %>" data-morph="replace">
  <%= turbo_stream_from task %>
  <header class="task-panel__header">
    <p class="task-panel__context">
      <% if task.work %>
        <%= peek_link_to task.work, task.work.title %>
      <% elsif task.client %>
        <%= peek_link_to task.client, task.client.name %>
      <% else %>
        <span>No <%= term(:client).downcase %> yet</span>
      <% end %>
      <%= agent_made_tag(task, label: true) %>
    </p>
    <div class="task-panel__actions">
      <%= render "tasks/ai_brief", task: task %>
      <%= ui :button, href: task_path(task), variant: :ghost, size: :icon_sm, title: "Open its page", aria: { label: "Open #{task.title} on its own page" }, data: { turbo_frame: "_top" }, content: icon_tag("maximize") %>
      <%= ui :button, variant: :ghost, size: :icon_sm, title: "Close (Esc)", aria: { label: "Close" }, data: { keys: "esc", action: "side-panel#close" }, content: icon_tag("close") %>
    </div>
  </header>

  <%= form_with model: task, url: task_path(task), method: :patch, namespace: dom_id(task, :panel_title), class: "task-panel__title-form", data: { controller: "form" } do |form| %>
    <%= hidden_field_tag :inline, "panel", id: nil %>
    <%= form.text_field :title, class: "task-panel__title", required: true, autocomplete: "off", aria: { label: "Title" }, data: { action: "change->form#submit" } %>
  <% end %>
  <%= plugin_slots(:task_notice, task: task) %>

  <%# Its fields in the install's order (template mode, RecordLayout: the working column's, then
      the sidebar's; hidden ones left out). Due, repeats and the section save as you change them; the rest
      are the show page's own (record_fields/task/*), pickers included. %>
  <% layout = record_layout(:task) %>
  <dl class="details task-panel__details">
    <% (layout.main + layout.aside).each do |key| %>
      <%# herb:key key %>
      <% if key == "due" %>
        <dt>Due</dt>
        <dd>
          <%= form_with model: task, url: task_path(task), method: :patch, namespace: dom_id(task, :panel_due), class: "task-panel__field", data: { controller: "form" } do |form| %>
            <%= hidden_field_tag :inline, "panel", id: nil %>
            <%= date_input form, :due_on, aria: { label: "Due" }, data: { action: "change->form#submit" } %>
          <% end %>
        </dd>
      <% elsif key == "repeat" %>
        <dt>Repeats</dt>
        <dd>
          <%= form_with model: task, url: task_path(task), method: :patch, namespace: dom_id(task, :panel_repeat), class: "task-panel__field", data: { controller: "form" } do |form| %>
            <%= hidden_field_tag :inline, "panel", id: nil %>
            <%= form.select :repeat, Cadence.options, { include_blank: "Never" }, aria: { label: "Repeats" }, data: { action: "change->form#submit" } %>
          <% end %>
        </dd>
      <% elsif key == "home" %>
        <%# The piece of work it's on, picked here to file it (from Intake): its client follows. %>
        <dt><%= term(:work) %></dt>
        <dd>
          <%= form_with model: task, url: task_path(task), method: :patch, namespace: dom_id(task, :panel_work), class: "task-panel__field", data: { controller: "form" } do |form| %>
            <%= hidden_field_tag :inline, "panel", id: nil %>
            <%= form.select :work_id, task_work_options(task), { include_blank: "None yet" }, aria: { label: term(:work) }, search: true, data: { action: "change->form#submit" } %>
          <% end %>
        </dd>
        <% if task.work %>
          <dt><%= term(:scope_item) %></dt>
          <dd>
            <%= form_with model: task, url: task_path(task), method: :patch, namespace: dom_id(task, :panel_section), class: "task-panel__field", data: { controller: "form" } do |form| %>
              <%= hidden_field_tag :inline, "panel", id: nil %>
              <%= form.select :scope_item_id, task.work.scope_items.map { |item| [ item.description, item.id ] }, { include_blank: "Other " + term(:task, count: 2).downcase }, aria: { label: term(:scope_item) }, data: { action: "change->form#submit" } %>
            <% end %>
          </dd>
        <% else %>
          <%= render "record_fields/task/home", record: task %>
        <% end %>
      <% elsif layout.custom?(key) %>
        <%= render "record_fields/custom", record: task, field: layout.custom_field(key) %>
      <% else %>
        <%= render record_field_partial(layout, key), record: task %>
      <% end %>
    <% end %>
    <%# Where the client puts it, once they've ordered their tasks in the portal (ClientPrioritized). %>
    <% if task.client_visible? && task.client_priority %>
      <dt><%= term(:client) %>’s priority</dt><dd><%= task.client_rank_label %> on their list</dd>
    <% end %>
  </dl>

  <%= render "intakes/bar", task: task %>

  <div class="task-panel__description">
    <%= ui :button, href: edit_task_path(task), variant: :outline, size: :sm, data: { turbo_frame: "_top" }, content: safe_join([ icon_tag("pencil"), tag.span("Edit details") ], " ") %>
  </div>

  <%= render "notes/section", subject: task, permanent: false, deferred: true %>
  <%# The pickers' menus, when an answer redraws the panel (TasksHelper#page_template): a panel
      opened over a page without task rows has no others. %>
  <%= task_picker_menus(panel: true) %>
</section>
