<% @page_title = @task.title %>
<% home = @task.scope_item || @task.work || @task.client %>
<% tabs = [
     record_tab("notes", "Notes", count: @task.notes.count),
     record_tab("documents", "Documents", count: @task.documents.count)
   ] + plugin_record_tabs(:task_panel) %>
<% tab = current_record_tab(tabs, "notes") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>

<% if home %>
  <%= parent_page(@task.scope_item&.description || @task.work&.ref || @task.client.name, home) %>
<% else %>
  <%= parent_page term(:task, count: 2), tasks_path(owner: "none") %>
<% end %>

<%= turbo_stream_from @task %>
<% layout = record_layout(:task) %>
<section class="record-page" data-controller="record-layout" data-record-layout-url-value="<%= settings_layout_path(:task) %>"
  data-action="dragstart->record-layout#dragstart dragover->record-layout#dragover drop->record-layout#drop dragend->record-layout#dragend keydown->record-layout#keydown">
  <%= render "record_fields/arrange", layout: layout, noun: "a #{term(:task).downcase}’s" %>
  <header class="record-page__header">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <% if @task.work %>
          <%= link_to "#{@task.work.ref} #{@task.work.title}", @task.work %>
          <span aria-hidden="true">›</span>
          <% if @task.scope_item %>
            <%= link_to @task.scope_item.description, @task.scope_item %>
          <% else %>
            <span>Other tasks</span>
          <% end %>
        <% elsif @task.client %>
          <%= link_to @task.client.name, @task.client %> <span aria-hidden="true">›</span> <span>Not on any <%= term(:work).downcase %></span>
        <% else %>
          <span>No <%= term(:client).downcase %> matched yet: edit it to choose one.</span>
        <% end %>
      </p>
    </div>
    <div class="button-row">
      <%= render "record_fields/arrange_button" %>
      <%= render "tasks/ai_brief", task: @task, labelled: true %>
      <%= link_to edit_task_path(@task), class: "btn btn--secondary", data: { keys: "e" } do %>
        <%= icon_tag "pencil" %>
        <span>Edit</span>
        <kbd class="hide-on-touch">E</kbd>
      <% end %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="record-page__main">
    <%# Its fields as the install arranged them (template mode): the working column's here,
        stacked; the sidebar's in Details. %>
    <section class="card record-card record-fields-card">
      <div class="card__content">
        <%= render "record_fields/zone", layout: layout, zone: "main", record: @task, stacked: true %>
      </div>
    </section>

    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "notes" %>
            <%= render "notes/section", subject: @task %>
          <% when "documents" %>
            <%= render "documents/section", subject: @task %>
          <% end %>
          <% if plugin_partial %>
            <%= render plugin_partial, task: @task %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="record-page__aside">
    <%= plugin_slots(:task_aside, task: @task) %>
    <%= render "record_fields/aside_card", layout: layout, record: @task %>

    <%= render "events/timeline", subject: @task %>
  </aside>
</section>
