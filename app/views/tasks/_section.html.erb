<%# locals: (work:, state: nil, item: nil, open_item: nil) %>
<%# A piece of work's work by scope item. Open work by default; the filter shows done or all.
    Each scope item's "done of total" always counts all of its work. item: one scope item's work
    alone (an id, or "other" for work outside the scope), picked in the sidebar's scope list.
    While it's open and not showing done, each section ends in a quick add (tasks/quick_add), and
    a section with no tasks yet shows too, so its first can be typed straight in. Each section is an
    accordion: the first open, and any empty one, and the one a task was just added to (open_item);
    the rest closed, and each stays as someone left it through a refresh (the keep-open behavior).
    Sections drag by their grip to a new place (the core's drag-and-drop, ScopeItems::MovesController).
    The + beside the hint adds a section. %>
<% state ||= "open" %>
<% focus_item = item %>
<% quick = !work.closed? && state != "done" %>
<% picked = item.is_a?(Integer) ? work.scope_items.find_by(id: item) : nil %>
<% focus = picked || item == "other" %>
<section class="card record-card" id="tasks" data-task-list="work" data-task-list-state="<%= state %>" data-task-list-keeps="<%= task_list_keeps(state) %>"<% if item %> data-task-list-item="<%= item %>"<% end %>>
  <header class="card__head">
    <h2 class="card__title"><%= term(:task, count: 2) %></h2>
    <div class="card__hint task-section__hint">
      <% if focus %>
        <span>Just one <%= term(:scope_item).downcase %>’s. Pick another in the sidebar.</span>
      <% else %>
        <span>By <%= term(:scope_item).downcase %>, soonest due first.</span>
        <% unless work.closed? %>
          <details class="task-section__new">
            <summary class="icon-button task-section__add" title="Add a <%= term(:scope_item).downcase %>"><%= icon_tag "add" %><span class="visually-hidden">Add a <%= term(:scope_item).downcase %></span></summary>
            <%= render "scope_items/new", work: work %>
          </details>
        <% end %>
      <% end %>
    </div>
    <div class="card__action task-section__actions">
      <%= render "layouts/shared/segmented_filter", label: "Show " + term(:task, count: 2).downcase, param: :tasks, current: state,
            options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ] %>
      <%= render "tasks/view_switch", current: "list" %>
    </div>
  </header>

  <% tasks = work.tasks.includes(:owner, :scope_item, :client, { assignments: :user }, :work).order(:due_on, :position) %>
  <% tasks = tasks.where(scope_item: picked) if focus %>
  <% all_groups = tasks.group_by(&:scope_item) %>
  <% shown = tasks.select { |task| state == "all" || (state == "done") == (task.status == "done") } %>
  <% groups = shown.group_by(&:scope_item) %>
  <% items = (work.scope_items.to_a + all_groups.keys.compact).uniq.select { |item| groups.key?(item) || (quick && !all_groups.key?(item) && (!focus || item == picked)) } %>

  <div class="card__content record-card__stack">
    <% if focus %>
      <% done = tasks.count { |task| task.status == "done" } %>
      <div class="list-row list-row--outline task-focus">
        <div class="list-row__content">
          <h3 class="list-row__title task-focus__title"><%= picked ? picked.description : "Other " + term(:task, count: 2).downcase %></h3>
          <span class="list-row__desc task-focus__count"><%= done %> of <%= tasks.size %> done</span>
        </div>
        <% if picked %>
          <%= status_tag picked.delivery_state.humanize, highlight: picked.delivery_state == "done" %>
          <%= link_to picked, class: "btn btn--secondary btn--sm", title: "Open the #{term(:scope_item).downcase}: its notes, documents and history" do %>
            <span>Open</span>
            <%= icon_tag "arrow-right" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# One list of sections, tight together: each an accordion that drags by its grip to a new place. %>
    <div class="task-groups" data-controller="drag-and-drop" data-drag-and-drop-dragged-item-class="task-group--dragging" data-drag-and-drop-hover-container-class="task-groups--hover"
      data-action="dragstart->drag-and-drop#dragStart dragover->drag-and-drop#dragOver drop->drag-and-drop#drop dragend->drag-and-drop#dragEnd">
      <div class="task-groups__sections" data-drag-and-drop-target="container" data-drag-and-drop-sortable data-drag-and-drop-url="<%= scope_item_move_path("__id__") %>">
        <div class="task-groups__list" data-drag-drop-item-container>
          <% items.each_with_index do |item, index| %>
            <%# herb:key item.id %>
            <% group = groups.fetch(item, []) %>
            <% everything = all_groups.fetch(item, []) %>
            <% if focus %>
              <div class="task-group">
                <ul class="record-list">
                  <%= render partial: "tasks/task", collection: group, as: :task %>
                </ul>
                <% if quick %>
                  <%= render "tasks/quick_add", work: work, scope_item: item, state: state, item: focus_item %>
                <% end %>
              </div>
            <% else %>
              <details class="task-group" data-keep-open data-drag-and-drop-target="item" data-id="<%= item.id %>" <% if index.zero? || group.empty? || item.id.to_s == open_item.to_s %>open<% end %>>
                <summary class="task-group__header">
                  <% unless work.closed? %>
                    <span class="task-group__grip" draggable="true" title="Drag to move this <%= term(:scope_item).downcase %>"><%= icon_tag "grip" %></span>
                  <% end %>
                  <%= icon_tag "caret-down", class: "task-group__caret" %>
                  <%= link_to item.description, work_path(work, request.query_parameters.merge("tab" => "tasks", "item" => item.id)), class: "task-group__name" %>
                  <span class="task-group__count"><%= everything.count { |task| task.status == "done" } %> of <%= everything.size %></span>
                  <%= status_tag item.delivery_state.humanize, highlight: item.delivery_state == "done" %>
                </summary>
                <ul class="record-list">
                  <%= render partial: "tasks/task", collection: group, as: :task %>
                </ul>
                <% if quick %>
                  <%= render "tasks/quick_add", work: work, scope_item: item, state: state, item: focus_item %>
                <% end %>
              </details>
            <% end %>
          <% end %>
        </div>
      </div>

    <% other = groups.fetch(nil, []) %>
    <% other_all = all_groups.fetch(nil, []) %>
    <% if other.any? || (quick && (focus_item == "other" || (!focus && work.scope_items.none?))) %>
      <% if focus %>
        <div class="task-group">
          <ul class="record-list">
            <%= render partial: "tasks/task", collection: other, as: :task %>
          </ul>
          <% if quick %>
            <%= render "tasks/quick_add", work: work, state: state, item: focus_item %>
          <% end %>
        </div>
      <% else %>
        <details class="task-group task-group--other" data-keep-open <% if items.empty? || other.empty? || open_item.to_s == "other" %>open<% end %>>
          <summary class="task-group__header">
            <%= icon_tag "caret-down", class: "task-group__caret" %>
            <span class="task-group__name">Other <%= term(:task, count: 2).downcase %></span>
            <span class="task-group__count"><%= other_all.count { |task| task.status == "done" } %> of <%= other_all.size %></span>
          </summary>
          <ul class="record-list">
            <%= render partial: "tasks/task", collection: other, as: :task %>
          </ul>
          <% if quick %>
            <%= render "tasks/quick_add", work: work, state: state, item: focus_item %>
          <% end %>
        </details>
      <% end %>
    <% end %>
    </div>

    <% if tasks.none? %>
      <% if focus %>
        <p class="record-card__empty">No <%= term(:task, count: 2).downcase %> here yet. Type the first above.</p>
      <% else %>
        <p class="record-card__empty">No <%= term(:task, count: 2).downcase %> yet. Type the first into a <%= term(:scope_item).downcase %> above, or add a <%= term(:scope_item).downcase %> with +.</p>
      <% end %>
    <% elsif shown.none? %>
      <p class="record-card__empty">
        <%= state == "open" ? "Nothing open: all #{tasks.size} done." : "Nothing done yet." %>
        <%= link_to "Show all", work_path(work, request.query_parameters.merge("tasks" => "all")) %>
      </p>
    <% end %>
  </div>
</section>
