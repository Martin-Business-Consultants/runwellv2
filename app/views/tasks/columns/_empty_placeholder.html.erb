<%# locals: () %>
<%# An empty column: "No tasks here", or on the board (where cards can be dragged) "Drag tasks here".
    tasks.css shows the one that fits. %>
<div class="empty cards__blank cards__blank--default">No <%= term(:task, count: 2).downcase %> here</div>
<div class="empty cards__blank cards__blank--drag">Drag <%= term(:task, count: 2).downcase %> here</div>
