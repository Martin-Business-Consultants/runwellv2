<%# locals: () %>
<%# What an empty Work list says: work is never added here, so say where it comes from. %>
<% if Task.exists? %>
  <%= ui :empty, description: "No #{term(:task, count: 2).downcase} matches these filters." %>
<% else %>
  <%= ui :empty, description: "No #{term(:task, count: 2).downcase} yet. It’s added on #{term(:work, count: 2).downcase} and #{term(:client, count: 2).downcase}.",
        action: ui(:button, href: works_path(state: "open"), variant: :outline, size: :sm, content: "Go to #{term(:work, count: 2).downcase}") %>
<% end %>
