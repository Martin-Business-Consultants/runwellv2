<%# locals: () %>
<%# What an empty Work list says: work is never added here, so say where it comes from. %>
<% if Task.exists? %>
  <%= render "layouts/shared/empty", text: "No #{term(:task, count: 2).downcase} matches these filters." %>
<% else %>
  <%= render "layouts/shared/empty", text: "No #{term(:task, count: 2).downcase} yet. It’s added on #{term(:work, count: 2).downcase} and #{term(:client, count: 2).downcase}.",
        action_text: "Go to #{term(:work, count: 2).downcase}", action_path: works_path(state: "open") %>
<% end %>
