<% @page_title = "Column: #{@status.humanize}" %>
<%# The breadcrumb names the page ("Work › Column: Planned"), and Esc goes back to the board. %>
<%= parent_page "Work", todos_path(todo_board_filters.merge(view: "board")) %>

<section class="cards cards--grid">
  <turbo-frame id="<%= @status %>_cards">
    <div class="cards__list" data-drag-drop-item-container>
      <% if @todos.any? %>
        <%= with_automatic_pagination "#{@status}_cards_page", @page do %>
          <%= render "todos/display/previews", todos: @todos, draggable: true %>
        <% end %>
      <% else %>
        <%= render "todos/columns/empty_placeholder" %>
      <% end %>
    </div>
  </turbo-frame>
</section>
