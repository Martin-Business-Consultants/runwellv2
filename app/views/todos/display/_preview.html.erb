<%# locals: (todo:, draggable: nil) %>
<%# A todo on the board (Fizzy's card preview, in its data attributes), drawn as a small index card
    (app-card--compact): the ref and client on a faint line, the title, then the due date as an
    outline badge and the people on it. The column names the status, so the card carries no colour
    of its own. %>
<% overdue = todo.status != "done" && todo.due_on&.past? %>
<%= todo_article_tag todo, class: "card app-card app-card--compact", draggable: draggable ? "true" : nil, tabindex: 0, data: {
      id: todo.id,
      drag_and_drop_target: "item",
      navigable_list_target: "item",
      css_variable_counter_target: "item",
      filter_target: "item",
      action: "mouseenter->navigable-list#hoverSelect" } do %>
  <%= link_to todo_path(todo), draggable: false, class: "app-card__link", title: todo.title, data: { turbo_frame: "_top" } do %>
    <span class="visually-hidden"><%= todo.title %></span>
  <% end %>

  <header class="app-card__header">
    <p class="app-card__eyebrow">
      <% if todo_ref(todo).present? %>
        <span class="app-card__ref"><span class="visually-hidden"><%= term(:engagement) %></span> <%= todo_ref(todo) %></span>
      <% end %>
      <span class="app-card__context"><%= todo_client_name(todo) %></span>
    </p>
    <h3 class="app-card__title"><%= todo.title %></h3>
  </header>

  <footer class="app-card__footer">
    <div class="app-card__badges">
      <% if todo.status == "done" && todo.completed_at %>
        <%= badge "Done #{l todo.completed_at.to_date, format: :short}", tone: :ok %>
      <% elsif overdue %>
        <%= badge "Due #{l todo.due_on, format: :short}", tone: :danger, title: "Overdue" %>
      <% elsif todo.due_on %>
        <%= badge "Due #{l todo.due_on, format: :short}", tone: :outline %>
      <% end %>
    </div>
    <% if todo.owners.any? %>
      <span class="app-card__people"><%= todo_owners_tag todo %></span>
    <% end %>
  </footer>
<% end %>
