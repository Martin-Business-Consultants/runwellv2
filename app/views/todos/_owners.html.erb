<%# locals: (todo:, labelled: nil) %>
<%# The owners picker's trigger: everyone on the work as overlapping avatars, the lead first (an
    empty circle for nobody), with their names when labelled. Todos::AssignmentsController answers
    each click in the menu by replacing this. The avatars are hidden from screen readers, since
    the button's own text names everyone. %>
<% owners = todo.owners %>
<% label = todo_owners_label(todo) %>
<button type="button" id="<%= dom_id(todo, labelled ? :owners_labelled : :owners) %>" class="owner-picker__trigger" title="<%= label %>: click to change" aria-haspopup="true" data-fixed-popup-target="trigger" data-action="click->dialog#toggle:stop">
  <% if owners.any? %>
    <%= todo_owners_tag todo, hidden: true %>
  <% else %>
    <span class="avatar avatar--md avatar--empty owner-picker__empty" aria-hidden="true"><%= icon_tag "person-add" %></span>
  <% end %>
  <% if labelled %>
    <span class="owner-picker__name"><%= owners.any? ? owners.map(&:display_name).to_sentence : "Unassigned" %></span>
  <% end %>
  <span class="visually-hidden">On it: <%= label %>. Change who’s on <%= todo.title %></span>
</button>
