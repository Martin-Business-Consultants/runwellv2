<%# locals: (todo:, labelled: nil) %>
<%# A todo's status as a colored circle, in the Work board's colors. Clicking it opens a menu
    of the four statuses (Fizzy's popup, like the quick filters); choosing one saves it. %>
<% label = todo.status.humanize %>
<div class="row-picker status-dot-picker" data-controller="dialog fixed-popup" data-dialog-orient-value="false"
  data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside dialog:show->fixed-popup#place dialog:close->fixed-popup#close">
  <button type="button" class="status-dot-picker__trigger" title="<%= label %>: click to change" aria-haspopup="true" data-fixed-popup-target="trigger" data-action="click->dialog#toggle:stop">
    <span class="status-dot status-dot--<%= todo.status.dasherize %>" aria-hidden="true"></span>
    <% if labelled %>
      <span class="status-dot-picker__label"><%= label %></span>
    <% end %>
    <span class="for-screen-reader">Status of <%= todo.title %>: <%= label %>. Change it</span>
  </button>

  <dialog class="margin-block-start-half popup panel flex-column align-start gap-half fill-white shadow txt-small" aria-label="Status of <%= todo.title %>" data-dialog-target="dialog" data-fixed-popup-target="popup">
    <strong class="popup__title pad-inline-half">Status</strong>
    <ul class="popup__list" role="group">
      <% Todo::STATUSES.each do |status| %>
        <%# herb:key status %>
        <li class="popup__item" role="checkbox" aria-checked="<%= status == todo.status %>">
          <%= button_to todo_path(todo), method: :patch, params: { todo: { status: status } }, class: "btn popup__btn", form_class: "full-width" do %>
            <span class="status-dot status-dot--<%= status.dasherize %>" aria-hidden="true"></span>
            <span class="overflow-ellipsis flex-item-grow"><%= status.humanize %></span>
            <%= icon_tag "check", class: "checked flex-item-justify-end" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </dialog>
</div>
