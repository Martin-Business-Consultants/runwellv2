<%# locals: (todo:, labelled: nil, options_on_page: nil) %>
<%# Who's on a todo, changed in place (Fizzy's assignments): the avatars (or an empty circle) open
    a menu of the team. Type to narrow it (fuzzy: "sp" finds Sarah Producer); each click puts that
    person on or takes them off, and the menu stays open. The first on leads (the owner); taking
    off the lead hands it to whoever came on next. The team's list is on the page once
    (todo_assignee_options_template) and copied into the menu when it first opens. %>
<% unless options_on_page %>
  <%= todo_assignee_options_template %>
<% end %>
<div class="row-picker owner-picker" id="<%= dom_id(todo, labelled ? :owner_labelled : :owner) %>" data-controller="dialog fixed-popup filter picker" data-dialog-orient-value="false" data-filter-fuzzy-value="true"
  data-picker-multiple-value="true" data-picker-current-value="<%= todo.owners.map(&:id).join(",") %>" data-picker-options-value="todo-assignee-options"
  data-action="keydown.esc->dialog#close click@document->dialog#closeOnClickOutside dialog:show->fixed-popup#place dialog:show->picker#fill dialog:close->fixed-popup#close dialog:close->filter#clearInput">
  <%= render "todos/owners", todo: todo, labelled: labelled %>

  <dialog class="margin-block-start-half popup panel flex-column align-start gap-half fill-white shadow txt-small" aria-label="Who’s on <%= todo.title %>" data-dialog-target="dialog" data-fixed-popup-target="popup">
    <input type="search" class="input input--transparent txt-small full-width owner-picker__search" placeholder="Who’s on it…" autocomplete="off" aria-label="Find a person" data-1p-ignore="true"
      data-filter-target="input" data-dialog-target="focusMouse" data-action="input->filter#filter">
    <%= form_with url: todo_assignments_path(todo), method: :post, class: "full-width" do %>
      <% if labelled %>
        <input type="hidden" name="labelled" value="1">
      <% end %>
      <ul class="popup__list" role="group" data-picker-target="list"></ul>
    <% end %>
    <p class="owner-picker__hint txt-x-small txt-subtle margin-none">The first on leads.</p>
  </dialog>
</div>
