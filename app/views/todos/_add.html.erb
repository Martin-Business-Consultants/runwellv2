<%# locals: (engagement: nil, client: nil, scope_item: nil) %>
<%# Adds work on an engagement (under one of its scope items, or other work), or straight on a client. %>
<% home = engagement || client %>
<details class="section-actions record-add">
  <summary class="ui-button ui-button--outline ui-button--sm"><%= icon_tag "add" %> Add a todo</summary>
  <%= form_with model: Todo.new, url: (engagement ? engagement_todos_path(engagement) : client_todos_path(client)), namespace: dom_id(scope_item || home, :new_todo),
        class: "record-add__form", data: { controller: "form" } do |form| %>
    <%= form.text_field :title, required: true, class: "ui-input", autocomplete: "off", placeholder: "What needs doing…", aria: { label: "Title" } %>
    <div class="record-add__fields">
      <%= form.select :owner_id, todo_owner_options, { include_blank: "Unassigned" }, class: "ui-select", aria: { label: "Owner" } %>
      <%= date_input form, :due_on, class: "ui-input", aria: { label: "Due" } %>
      <% if scope_item %>
        <%= form.hidden_field :scope_item_id, value: scope_item.id %>
      <% elsif engagement %>
        <%= form.select :scope_item_id, engagement.scope_items.map { |item| [ item.description, item.id ] }, { include_blank: "Other work" }, class: "ui-select", aria: { label: term(:scope_item) } %>
      <% end %>
    </div>
    <div class="record-add__actions">
      <button type="submit" class="ui-button ui-button--sm">Add a todo</button>
    </div>
  <% end %>
</details>
