<%# locals: (status:, page:) %>
<%# A column's cards, a page at a time: on the board inside its column (the first page, rendered
    with the board) and on the column's own page (todos/columns/show). Later pages come from the
    column's address as it scrolls. %>
<% records = page.records.to_a %>
<div class="cards__list" data-drag-drop-item-container>
  <% if records.any? %>
    <%= with_automatic_pagination "#{status}_cards_page", page, next_url: todos_column_path(status, todo_board_filters) do %>
      <%= render "todos/display/previews", todos: records, draggable: true %>
    <% end %>
  <% else %>
    <%= render "todos/columns/empty_placeholder" %>
  <% end %>
</div>
