<%# locals: (count:, board:) %>
<%# The planned stream: like the doing columns, its first page of cards comes with the board and
    the rest load from Todos::ColumnsController as it scrolls, so a board with hundreds of planned
    todos opens at once and without a wait. %>
<%= column_tag id: "planned-todos", name: "Planned", drop_url: columns_todo_drops_stream_path("__id__", todo_board_filters), collapsed: false, selected: "true", class: "cards--maybe", data: {
  drag_and_strum_target: "container",
  drag_and_drop_sortable: true,
  collapsible_columns_target: "column maybeColumn",
  action: "focus->collapsible-columns#focusOnColumn"
} do %>
  <header class="cards__header">
    <%= render "todos/board/expander", title: "Planned", count: count, column_id: "planned-todos", status: "planned" %>
    <%= render "todos/board/maximize", column_path: todos_column_path("planned", todo_board_filters) %>
  </header>
  <%= column_frame_tag "planned_cards" do %>
    <%= render "todos/board/cards", status: "planned", page: todo_board_page(board, "planned") %>
  <% end %>
<% end %>
