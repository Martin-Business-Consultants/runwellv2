<%# locals: (client:, state: nil) %>
<%# A client's work: on its engagements and straight on the client. Open by default; the filter
    shows done or all. Work added here is on the client, not on any engagement. %>
<% state ||= "open" %>
<% all = client.todos.includes(:owner, :engagement, :client, :custom_values, assignments: :user).order(:due_on, :position, :id).to_a %>
<% shown = all.select { |todo| state == "all" || (state == "done") == (todo.status == "done") } %>
<section class="ui-card record-card" id="work">
  <header class="ui-card__header">
    <h2 class="ui-card__title"><%= term(:work) %></h2>
    <p class="ui-card__description">On their <%= term(:engagement, count: 2).downcase %> and straight on <%= client.name %>.</p>
    <div class="ui-card__action">
      <%= render "layouts/shared/segmented_filter", label: "Show " + term(:work).downcase, param: :work, current: state,
            options: [ [ "Open", "open" ], [ "Done", "done" ], [ "All", "all" ] ] %>
    </div>
  </header>

  <div class="ui-card__content">
    <% if shown.any? %>
      <ul class="record-list">
        <% shown.each do |todo| %>
          <%# herb:key todo.id %>
          <%= render "todos/todo", todo: todo, with_engagement: true %>
        <% end %>
      </ul>
    <% elsif all.any? %>
      <p class="record-card__empty">
        <%= state == "open" ? "Nothing open: all #{all.size} done." : "Nothing done yet." %>
        <%= link_to "Show all", client_path(client, request.query_parameters.merge("tab" => "work", "work" => "all")), class: "txt-link" %>
      </p>
    <% else %>
      <p class="record-card__empty">No <%= term(:work).downcase %> yet. Add it here, on one of their <%= term(:engagement, count: 2).downcase %>, or it arrives as a request.</p>
    <% end %>
  </div>

  <footer class="ui-card__footer">
    <%= render "todos/add", client: client %>
  </footer>
</section>
