<% @page_title = term(:work) %>
<% listed = CustomField.for("Todo").listed.to_a %>
<% @body_class = "contained-scrolling" if @view == "board" %>

<% content_for :index_filters do %>
  <% unless @view == "board" %>
    <%= render "layouts/shared/quick_filter", title: "Show…", param: :status, current: @status,
          options: [ [ "Open work", "open" ], [ "All work", "all" ], [ "In progress", "in_progress" ], [ "In review", "in_review" ], [ "Blocked", "blocked" ] ] %>
  <% end %>
  <%= render "layouts/shared/quick_filter", title: "Due…", param: :due, current: @due,
        options: [ [ "Any time", "any" ], [ "Overdue", "overdue" ], [ "Due today", "today" ], [ "This week", "week" ] ] %>
  <%= render "layouts/shared/quick_filter", title: "Owner…", param: :owner, current: @owner,
        options: [ [ "Anyone", "any" ], [ "Unassigned", "none" ] ] + todo_owner_options.map { |name, id| [ name, id.to_s ] } %>
  <%= render "layouts/shared/quick_filter", title: "Engagement…", param: :engagement, current: @engagement,
        options: [ [ "All engagements", "all" ] ] + todo_engagement_filter_options(@engagement) %>
<% end %>
<% if @view == "table" %>
  <% content_for :index_bulk do %>
  <%= bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_todos_path, noun: term(:work).downcase) : nil) do %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[status]", label: "Status", choices: Todo::STATUSES.map { [ it.humanize, it ] } %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[owner_id]", label: "Owner", choices: [ [ "Unassigned", "none" ] ] + todo_owner_options %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[client_visible]", label: "Visibility", choices: [ [ "Shown to the #{term(:client).downcase}", "1" ], [ "Internal", "0" ] ] %>
    <%= bulk_date bulk_todos_path, method: :patch, name: "todo[due_on]", label: "Due date" %>
  <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, extra_views: [ [ "board", "Board", "board" ] ] %>

<% if @view == "board" %>
  <%= render "todos/board/columns", board: @board %>
<% elsif @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :todos_cards, @page do %>
        <% @todos.each do |todo| %>
          <%# herb:key todo.id %>
          <% overdue = todo.status != "done" && todo.due_on&.past? %>
          <%= render "layouts/shared/card", path: todo_path(todo), title: todo.title, id_label: todo_ref(todo),
                context: todo_client_name(todo),
                meta: [ ("Due " + l(todo.due_on, format: :short) if todo.due_on) ],
                people: todo_owners_tag(todo, fallback: "Unassigned"),
                status: overdue ? "Overdue" : todo.status.humanize, highlight: todo.status == "done" %>
        <% end %>
      <% end %>
    </div>
  </section>
  <% if @todos.none? %>
    <%= render "todos/blank" %>
  <% end %>
<% else %>
  <% columns = [ ui_column(:title, term(:work), sort: :title, width: [ @column_widths[:title], term(:work) ], hideable: false),
                 ui_column(:engagement, term(:engagement), sort: :engagement, width: [ @column_widths[:engagement], term(:engagement) ]),
                 ui_column(:client, term(:client), sort: :client, width: [ @column_widths[:client], term(:client) ]),
                 ui_column(:owner, "Owner", sort: :owner, width: :avatar),
                 ui_column(:due, "Due", sort: :due, width: [ 28, "Due" ]),
                 ui_column(:status, "Status", sort: :status, width: :status, align: :center),
                 *listed.map { ui_column("field_#{it.id}", it.label) } ] %>
  <%= render "ui/data_table", id: "todos", columns: columns, rows: @todos, row: "todos/row", as: :todo,
        row_locals: { listed: listed }, page: @page, selectable: true, actions: true %>
  <% if @todos.none? %>
    <%= render "todos/blank" %>
  <% end %>
<% end %>
