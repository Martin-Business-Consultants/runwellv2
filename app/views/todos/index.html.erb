<% @page_title = term(:work) %>
<% listed = CustomField.for("Todo").listed.to_a %>
<% @body_class = "contained-scrolling" if @view == "board" %>

<% content_for :index_filters do %>
  <% unless @view == "board" %>
    <%= render "layouts/shared/quick_filter", title: "Show…", param: :status, current: @status,
          options: [ [ "Open work", "open" ], [ "All work", "all" ] ] %>
  <% end %>
  <%= render "layouts/shared/quick_filter", title: "Owner…", param: :owner, current: @owner,
        options: [ [ "Anyone", "any" ] ] + todo_owner_options.map { |name, id| [ name, id.to_s ] } %>
  <%= render "layouts/shared/quick_filter", title: "Engagement…", param: :engagement, current: @engagement,
        options: [ [ "All engagements", "all" ] ] + todo_engagement_filter_options(@engagement) %>
<% end %>
<% if @view == "table" %>
  <% content_for :index_bulk do %>
  <%= bulk_bar delete: (can?(:delete_records) ? bulk_delete(bulk_todos_path, noun: term(:work).downcase) : nil) do %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[status]", label: "Status", choices: Todo::STATUSES.map { [ it.humanize, it ] } %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[owner_id]", label: "Owner", choices: [ [ "Unassigned", "none" ] ] + todo_owner_options %>
    <%= bulk_menu bulk_todos_path, method: :patch, name: "todo[client_visible]", label: "Visibility", choices: [ [ "Shown to the #{term(:client).downcase}", "1" ], [ "Internal", "0" ] ] %>
    <%= bulk_date bulk_todos_path, method: :patch, name: "todo[due_on]", label: "Due date" %>
    <%= bulk_menu bulk_todos_commitments_path, method: :post, name: "owner_kind", label: "Make #{term(:commitment, count: 2).downcase}", choices: [ [ "We promised", "us" ], [ "They promised", "client" ] ] %>
  <% end %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, extra_views: [ [ "board", "Board", "board" ] ] %>

<% if @view == "board" %>
  <%= render "todos/board/columns", board: @board %>
<% elsif @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :todos_cards, @page do %>
        <% @todos.each do |todo| %>
          <%# herb:key todo.id %>
          <% overdue = todo.status != "done" && todo.due_on&.past? %>
          <%= render "layouts/shared/card", path: todo_path(todo), title: todo.title, id_label: todo.engagement.ref,
                context: todo.engagement.client.name,
                meta: [ todo_owners_tag(todo, fallback: "Unassigned"), ("Due " + l(todo.due_on, format: :short) if todo.due_on) ],
                status: overdue ? "Overdue" : todo.status.humanize, highlight: todo.status == "done" %>
        <% end %>
      <% end %>
    </div>
  </section>
  <% if @todos.none? %>
    <%= render "todos/blank" %>
  <% end %>
<% else %>
  <section class="panel center index-table">

    <table class="data-table data-table--fixed">
      <%= table_colgroup :select, [ @column_widths[:title], term(:work) ], [ @column_widths[:engagement], term(:engagement) ], [ @column_widths[:client], term(:client) ], :avatar, [ 28, "Due" ], :status, *listed.map { :text }, :actions %>
      <thead>
        <tr><%= bulk_select_all_header %><%= sortable_th term(:work), :title %><%= sortable_th term(:engagement), :engagement %><%= sortable_th term(:client), :client %><%= sortable_th "Owner", :owner %><%= sortable_th "Due", :due %><%= sortable_th "Status", :status, class: "txt-align-center" %><% listed.each do |field| %><%# herb:key field.id %><th><%= field.label %></th><% end %><th></th></tr>
      </thead>
      <tbody id="<%= pagination_frame_id_for(:todos_rows, @page.number) %>">
        <% @todos.each do |todo| %>
          <%# herb:key todo.id %>
          <tr data-filter-target="item">
            <%= bulk_select_cell todo, todo.title %>
            <td><%= link_to todo.title, todo_path(todo), class: "txt-ink font-weight-bold" %></td>
            <td class="txt-nowrap"><%= link_to todo.engagement.ref, todo.engagement, class: "txt-ink" %></td>
            <td class="txt-subtle"><%= todo.engagement.client.name %></td>
            <td class="txt-subtle"><%= render "todos/owner_picker", todo: todo %></td>
            <td class="txt-nowrap"><%= render "todos/due", todo: todo %></td>
            <td class="txt-align-center"><%= render "todos/status_dot", todo: todo %></td>
            <% listed.each do |field| %>
              <%# herb:key field.id %>
              <td class="txt-subtle"><%= custom_field_text(field, todo.custom_value(field)) %></td>
            <% end %>
            <%= render "layouts/shared/row_actions", name: todo.title, edit_path: edit_todo_path(todo), delete_path: todo_path(todo), todo: todo %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @todos.none? %>
      <%= render "todos/blank" %>
    <% end %>
  </section>
  <%= table_pagination @page %>
<% end %>
