<% @page_title = "Edit #{@todo.title_was}" %>

<% content_for :header do %>
  <%= parent_page @todo.title_was, @todo %>
<% end %>

<section class="settings settings--split record-page">
  <header class="record-page__header page-heading">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">What it is, who’s on it and when it’s due, and where it came from.</p>
    </div>
    <div class="page-heading__actions">
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="settings__panel record-page__main">
    <%= render "layouts/shared/errors", record: @todo %>

    <%= form_with model: @todo, class: "ui-card record-form", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
      <%= hidden_field_tag :from_edit, "1" %>

      <div class="ui-card__content record-form__body">
        <fieldset class="ui-fieldset">
          <legend><%= term(:work) %></legend>
          <label class="ui-field">
            <span class="ui-label">Title</span>
            <%= form.text_field :title, required: true, class: "ui-input", autofocus: true, autocomplete: "off" %>
          </label>

          <label class="ui-field">
            <span class="ui-label">Description</span>
            <%= rich_text_field form, :description, staff: true %>
          </label>

          <div class="ui-field-row">
            <label class="ui-field">
              <span class="ui-label">Status</span>
              <%= form.select :status, todo_status_options, {}, class: "ui-select" %>
            </label>

            <label class="ui-field">
              <span class="ui-label">Due</span>
              <%= date_input form, :due_on, class: "ui-input" %>
            </label>
          </div>
        </fieldset>

        <hr class="ui-separator record-form__separator">

        <fieldset class="ui-fieldset">
          <legend>Who’s on it</legend>
          <label class="ui-field">
            <span class="ui-label">Lead</span>
            <%= form.select :owner_id, todo_owner_options, { include_blank: "Unassigned" }, class: "ui-select" %>
            <span class="ui-field__description">The one person it’s up to.</span>
          </label>

          <fieldset class="ui-field owner-checklist">
            <legend class="ui-label">Also on it</legend>
            <%= hidden_field_tag "todo[other_owner_ids][]", "", id: nil %>
            <div class="owner-checklist__people">
              <% others = @todo.other_owners.map(&:id) %>
              <% todo_people.each do |person| %>
                <%# herb:key person.id %>
                <label class="owner-checklist__person">
                  <%= check_box_tag "todo[other_owner_ids][]", person.id, others.include?(person.id), id: "todo_other_owner_#{person.id}", class: "ui-checkbox" %>
                  <%= person_tag person %>
                  <span><%= person.display_name %></span>
                </label>
              <% end %>
            </div>
          </fieldset>
        </fieldset>

        <hr class="ui-separator record-form__separator">

        <fieldset class="ui-fieldset">
          <legend>Where it belongs</legend>
          <% if @todo.engagement %>
            <label class="ui-field">
              <span class="ui-label"><%= term(:scope_item) %></span>
              <%= form.select :scope_item_id, @todo.engagement.scope_items.map { |item| [ item.description, item.id ] }, { include_blank: "None" }, class: "ui-select" %>
            </label>
          <% else %>
            <label class="ui-field">
              <span class="ui-label"><%= term(:client) %></span>
              <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "None yet" }, class: "ui-select" %>
            </label>
          <% end %>

          <div class="ui-field-row">
            <label class="ui-field">
              <span class="ui-label">Requested by</span>
              <%= form.grouped_collection_select :contact_id, Client.ordered.includes(:contacts), :contacts, :name, :id, :name,
                    { include_blank: "Nobody in particular" }, class: "ui-select" %>
            </label>

            <label class="ui-field">
              <span class="ui-label">Came in by</span>
              <%= form.text_field :source, required: true, class: "ui-input", autocomplete: "off", placeholder: "app, email, phone…" %>
            </label>
          </div>

          <%= switch_field form, :client_visible, label: "Visible to the client", hint: "Shown in the client’s portal, with its status and due date." %>

          <%= custom_field_inputs form, @todo %>
        </fieldset>
      </div>

      <footer class="ui-card__footer ui-card__footer--bordered ui-card__footer--end">
        <%= link_to "Cancel", todo_path(@todo), class: "ui-button ui-button--outline", data: { form_target: "cancel" } %>
        <button type="submit" class="ui-button" data-form-target="submit">
          <span>Save changes</span>
        </button>
      </footer>
    <% end %>
  </div>

  <aside class="settings__panel settings__panel--side record-page__aside">
    <section class="ui-card record-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">Details</h2>
      </header>
      <div class="ui-card__content">
        <dl class="record-facts">
          <% if @todo.engagement %>
            <dt><%= term(:engagement) %></dt><dd><%= link_to "#{@todo.engagement.ref} #{@todo.engagement.title}", @todo.engagement, class: "txt-link" %></dd>
          <% end %>
          <% if @todo.client %>
            <dt><%= term(:client) %></dt><dd><%= link_to @todo.client.name, @todo.client, class: "txt-link" %></dd>
          <% end %>
          <dt>Added</dt><dd><%= l @todo.created_at.to_date, format: :long %><%= " by #{@todo.created_by.display_name}" if @todo.created_by %></dd>
          <% if @todo.completed_at %>
            <dt>Done</dt><dd><%= l @todo.completed_at.to_date, format: :long %></dd>
          <% end %>
        </dl>
      </div>
    </section>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Remove this work", title: "Remove #{@todo.title_was}?",
            body: "It comes off the #{term(:engagement).downcase} and the #{term(:client).downcase}’s portal. Its history stays.",
            button: "Remove", path: todo_path(@todo) %>
    <% end %>
  </aside>
</section>
