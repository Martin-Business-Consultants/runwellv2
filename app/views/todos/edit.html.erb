<% @page_title = "Edit #{@todo.title_was}" %>

<% content_for :header do %>
  <%= parent_page @todo.title_was, @todo %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "layouts/shared/errors", record: @todo %>

    <%= form_with model: @todo, class: "flex flex-column gap txt-medium", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
      <%= hidden_field_tag :from_edit, "1" %>

      <label class="flex flex-column gap-half txt-align-start">
        <span class="record-form__label">Title</span>
        <%= form.text_field :title, required: true, class: "input full-width", autofocus: true, autocomplete: "off" %>
      </label>

      <label class="flex flex-column gap-half txt-align-start">
        <span class="record-form__label">Description</span>
        <%= rich_text_field form, :description, staff: true %>
      </label>

      <div class="flex gap">
        <label class="flex flex-column gap-half txt-align-start flex-item-grow">
          <span class="record-form__label">Status</span>
          <%= form.select :status, todo_status_options, {}, class: "input input--select full-width" %>
        </label>

        <label class="flex flex-column gap-half txt-align-start flex-item-grow">
          <span class="record-form__label">Due</span>
          <%= date_input form, :due_on, class: "input full-width" %>
        </label>
      </div>

      <label class="flex flex-column gap-half txt-align-start">
        <span class="record-form__label">Lead</span>
        <%= form.select :owner_id, todo_owner_options, { include_blank: "Unassigned" }, class: "input input--select full-width" %>
      </label>

      <fieldset class="flex flex-column gap-half txt-align-start owner-checklist">
        <legend class="record-form__label">Also on it</legend>
        <%= hidden_field_tag "todo[other_owner_ids][]", "", id: nil %>
        <div class="flex flex-wrap gap-half">
          <% others = @todo.other_owners.map(&:id) %>
          <% todo_people.each do |person| %>
            <%# herb:key person.id %>
            <label class="owner-checklist__person">
              <%= check_box_tag "todo[other_owner_ids][]", person.id, others.include?(person.id), id: "todo_other_owner_#{person.id}" %>
              <%= person_tag person %>
              <span><%= person.display_name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <% if @todo.engagement %>
        <label class="flex flex-column gap-half txt-align-start">
          <span class="record-form__label"><%= term(:scope_item) %></span>
          <%= form.select :scope_item_id, @todo.engagement.scope_items.map { |item| [ item.description, item.id ] }, { include_blank: "None" }, class: "input input--select full-width" %>
        </label>
      <% else %>
        <label class="flex flex-column gap-half txt-align-start">
          <span class="record-form__label"><%= term(:client) %></span>
          <%= form.select :client_id, Client.ordered.pluck(:name, :id), { include_blank: "None yet" }, class: "input input--select full-width" %>
        </label>
      <% end %>

      <div class="flex gap">
        <label class="flex flex-column gap-half txt-align-start flex-item-grow">
          <span class="record-form__label">Requested by</span>
          <%= form.grouped_collection_select :contact_id, Client.ordered.includes(:contacts), :contacts, :name, :id, :name,
                { include_blank: "Nobody in particular" }, class: "input input--select full-width" %>
        </label>

        <label class="flex flex-column gap-half txt-align-start flex-item-grow">
          <span class="record-form__label">Came in by</span>
          <%= form.text_field :source, required: true, class: "input full-width", autocomplete: "off", placeholder: "app, email, phone…" %>
        </label>
      </div>

      <%= switch_field form, :client_visible, label: "Visible to the client in the portal" %>

      <%= custom_field_inputs form, @todo %>

      <button type="submit" class="btn btn--link center" data-form-target="submit">
        <span>Save changes</span>
        <%= icon_tag "arrow-right" %>
      </button>

      <%= link_to "Cancel and go back", todo_path(@todo), data: { form_target: "cancel" }, hidden: true %>
    <% end %>

  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">

    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Details</h2>
      </header>
      <dl class="record-facts">
        <% if @todo.engagement %>
          <dt><%= term(:engagement) %></dt><dd><%= link_to "#{@todo.engagement.ref} #{@todo.engagement.title}", @todo.engagement, class: "txt-link" %></dd>
        <% end %>
        <% if @todo.client %>
          <dt><%= term(:client) %></dt><dd><%= link_to @todo.client.name, @todo.client, class: "txt-link" %></dd>
        <% end %>
        <dt>Added</dt><dd><%= l @todo.created_at.to_date, format: :long %><%= " by #{@todo.created_by.display_name}" if @todo.created_by %></dd>
        <% if @todo.completed_at %>
          <dt>Done</dt><dd><%= l @todo.completed_at.to_date, format: :long %></dd>
        <% end %>
      </dl>
    </section>

    <% if can?(:delete_records) %>
      <%= render "layouts/shared/confirm", trigger: "Remove this work", title: "Remove #{@todo.title_was}?",
            body: "It comes off the #{term(:engagement).downcase} and the #{term(:client).downcase}’s portal. Its history stays.",
            button: "Remove", path: todo_path(@todo) %>
    <% end %>
  </aside>
</section>
