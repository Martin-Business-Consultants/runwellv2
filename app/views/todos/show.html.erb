<% @page_title = @todo.title %>
<% home = @todo.scope_item || @todo.engagement || @todo.client %>
<% tabs = [
     record_tab("notes", "Notes", count: @todo.notes.count),
     record_tab("documents", "Documents", count: @todo.documents.count)
   ] + plugin_record_tabs(:todo_panel) %>
<% tab = current_record_tab(tabs, "notes") %>
<% plugin_partial = tabs.find { it.key == tab }&.partial %>

<% content_for :header do %>
  <% if home %>
    <%= parent_page(@todo.scope_item&.description || @todo.engagement&.ref || @todo.client.name, home) %>
  <% else %>
    <%= parent_page term(:work), todos_path(owner: "none") %>
  <% end %>

<% end %>

<section class="settings settings--split record-page">
  <header class="record-page__header page-heading">
    <div class="record-page__heading">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="record-page__description">
        <% if @todo.engagement %>
          <%= link_to "#{@todo.engagement.ref} #{@todo.engagement.title}", @todo.engagement, class: "txt-link" %>
          <span aria-hidden="true">›</span>
          <% if @todo.scope_item %>
            <%= link_to @todo.scope_item.description, @todo.scope_item, class: "txt-link" %>
          <% else %>
            <span>Other work</span>
          <% end %>
        <% elsif @todo.client %>
          <%= link_to @todo.client.name, @todo.client, class: "txt-link" %> <span aria-hidden="true">›</span> <span>Not on any <%= term(:engagement).downcase %></span>
        <% else %>
          <span>No <%= term(:client).downcase %> matched yet: edit it to choose one.</span>
        <% end %>
      </p>
    </div>
    <div class="page-heading__actions">
      <%= render "todos/ai_brief", todo: @todo, labelled: true %>
      <%= link_to edit_todo_path(@todo), class: "ui-button ui-button--outline", data: { keys: "e" } do %>
        <%= icon_tag "pencil" %>
        <span>Edit</span>
        <kbd class="hide-on-touch">E</kbd>
      <% end %>
      <%= render "layouts/shared/sidebar_toggle" %>
    </div>
  </header>

  <div class="settings__panel record-page__main">
    <section class="ui-card record-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">Description</h2>
      </header>
      <div class="ui-card__content record-card__stack">
        <% if @todo.description.present? %>
          <div class="record-card__prose"><%= rich_text @todo.description %></div>
        <% else %>
          <p class="record-card__empty">No description.</p>
        <% end %>
        <%= render "custom_fields/values", record: @todo %>
      </div>
    </section>

    <turbo-frame id="record_tab" target="_top">
      <div class="record-tabs">
        <%= render "layouts/shared/record_tabs", tabs: tabs, current: tab, variant: "pill" %>
        <div class="record-tabs__panel">
          <% case tab %>
          <% when "notes" %>
            <%= render "notes/section", subject: @todo %>
          <% when "documents" %>
            <%= render "documents/section", subject: @todo %>
          <% end %>
          <% if plugin_partial %>
            <%= render plugin_partial, todo: @todo %>
          <% end %>
        </div>
      </div>
    </turbo-frame>
  </div>

  <aside class="settings__panel settings__panel--side record-page__aside">
    <%= plugin_slots(:todo_aside, todo: @todo) %>
    <section class="ui-card record-card">
      <header class="ui-card__header">
        <h2 class="ui-card__title">Details</h2>
      </header>
      <div class="ui-card__content">
        <dl class="record-facts">
          <dt>Status</dt><dd><%= render "todos/status_dot", todo: @todo, labelled: true %></dd>
          <dt>On it</dt><dd><%= render "todos/owner_picker", todo: @todo, labelled: true %></dd>
          <dt>Due</dt>
          <dd>
            <% if @todo.due_on %>
              <%= l @todo.due_on, format: :long %>
              <% if @todo.status != "done" && @todo.due_on.past? %>
                <%= status_tag "Overdue", highlight: true %>
              <% end %>
            <% else %>
              <span class="txt-subtle">No date</span>
            <% end %>
          </dd>
          <dt><%= term(:client) %></dt>
          <dd>
            <% if @todo.client %>
              <%= link_to @todo.client.name, @todo.client, class: "txt-link" %>
            <% else %>
              <span class="txt-subtle">None matched</span>
            <% end %>
          </dd>
          <% if @todo.requester_name.present? %>
            <dt>Requested by</dt><dd><%= @todo.requester_name %><% if @todo.sender_email.present? && @todo.contact.nil? %> <span class="txt-subtle">(<%= @todo.sender_email %>)</span><% end %></dd>
          <% end %>
          <dt>Came in</dt><dd><%= @todo.source.humanize %>, <%= l @todo.created_at.to_date, format: :short %></dd>
          <dt>Client sees it</dt><dd><%= @todo.client_visible? ? "Yes, in the portal" : "No, internal" %></dd>
          <% if @todo.completed_at %>
            <dt>Done</dt><dd><%= l @todo.completed_at.to_date, format: :short %></dd>
          <% end %>
        </dl>
      </div>
    </section>

    <%= render "events/timeline", subject: @todo %>
  </aside>
</section>
