# Secrets for Kamal, read on the deploying machine at deploy time. Copy to .kamal/secrets
# (untracked; .kamal/secrets.<destination> for a destination). Never put real values here:
# each line runs a command or reads a variable that already holds the secret.

# This install's own keys, generated once and kept (the four lines bin/install writes to .env). Not RAILS_MASTER_KEY:
# config/credentials.yml.enc is encrypted with a key no install has, and setting one fails the boot.
# Losing the three encryption keys loses every API key and token stored in the database.
SECRET_KEY_BASE=$SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT

# The SMTP server's password (SMTP_* in config/deploy.yml).
SMTP_PASSWORD=$SMTP_PASSWORD

# Lets Settings > Updates start the Deploy workflow for this install.
# RUNWELL_GITHUB_TOKEN=$RUNWELL_GITHUB_TOKEN
