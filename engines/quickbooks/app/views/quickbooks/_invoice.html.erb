<%# locals: (invoice:, pay: nil) %>
<%# One invoice: what it is, what's left to pay, and QuickBooks' pay page (for the client). %>
<div class="flex align-center gap-half txt-small">
  <div class="txt-align-start overflow-ellipsis min-width">
    <strong><%= invoice.label %></strong> <span class="txt-subtle"><%= money invoice.total_cents %></span>
    <div class="txt-x-small txt-subtle">
      <%= [ invoice.txn_date && l(invoice.txn_date, format: :short), invoice.due_on && "due " + l(invoice.due_on, format: :short), invoice.engagement&.ref, invoice.sent_to && "sent to " + invoice.sent_to ].compact.join(" · ") %><%= " · " + money(invoice.balance_cents) + " left" if invoice.balance_cents.positive? && invoice.balance_cents < invoice.total_cents %>
    </div>
  </div>
  <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
  <%= status_tag invoice.status.humanize %>
  <% if invoice.payment_link.present? && invoice.balance_cents.positive? %>
    <%= link_to pay ? "Pay" : "Pay link", invoice.payment_link, class: pay ? "btn btn--link txt-x-small" : "btn txt-x-small", target: "_blank", rel: "noopener" %>
  <% end %>
</div>
