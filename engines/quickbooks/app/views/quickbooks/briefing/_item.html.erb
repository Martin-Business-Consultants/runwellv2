<%# locals: (item:) %>
<% case item %>
<% when Quickbooks::Invoice %>
  <%= link_to item.engagement ? engagement_path(item.engagement) : client_path(item.client), class: "txt-ink txt-align-start" do %>
    <strong><%= item.client.name %>: <%= item.label %></strong> <span class="txt-subtle">· <%= money item.balance_cents %> overdue</span>
    <div class="txt-x-small txt-subtle">Due <%= l item.due_on, format: :short %> · <%= pluralize(item.days_overdue, "day") %> late<%= " · " + item.engagement.ref if item.engagement %></div>
  <% end %>
<% when Quickbooks::RecurringLink %>
  <%= link_to engagement_path(item.engagement), class: "txt-ink txt-align-start" do %>
    <strong><%= item.engagement.ref %> <%= item.engagement.title %></strong> <span class="txt-subtle">· recurring invoice out of step</span>
    <div class="txt-x-small txt-subtle"><%= item.engagement.client.name %> · <%= item.drift %></div>
  <% end %>
<% when Quickbooks::BillingPlan %>
  <%= link_to engagement_path(item.engagement), class: "txt-ink txt-align-start" do %>
    <strong><%= item.engagement.ref %> <%= item.engagement.title %></strong> <span class="txt-subtle">· balance not sent</span>
    <div class="txt-x-small txt-subtle"><%= item.engagement.client.name %> · <%= item.last_error %></div>
  <% end %>
<% end %>
