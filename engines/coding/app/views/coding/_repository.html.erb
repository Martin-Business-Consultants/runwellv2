<%# locals: (repository:) %>
<%# One linked repository, compact: its name, branch and where it runs on one line; setup notes
    in two lines at most; its latest deploys; then one row of tools (the clone command, copy,
    edit, deploys shown to the client, the webhook, unlink). Editing opens under the tools. %>
<% connected = Coding::Connection.current&.connected? %>
<div class="code-repo flex flex-column gap-half txt-small">
  <div class="flex align-center gap-half">
    <%= link_to repository.web_url, class: "code-repo__name txt-ink txt-align-start overflow-ellipsis min-width", target: "_blank", rel: "noopener",
          title: [ repository.url, ("linked by #{repository.added_by.display_name}" if repository.added_by) ].compact.join(" · ") do %>
      <strong><%= repository.name %></strong>
      <span class="txt-x-small txt-subtle"><%= [ repository.default_branch, repository.path ].compact.join(" · ") %></span>
    <% end %>
    <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
    <% if repository.staging_url %>
      <%= link_to repository.staging_url, class: "btn txt-x-small flex-item-no-shrink", target: "_blank", rel: "noopener", title: repository.staging_url do %>
        <span>Staging</span>
      <% end %>
    <% end %>
    <% if repository.production_url %>
      <%= link_to repository.production_url, class: "btn txt-x-small flex-item-no-shrink", target: "_blank", rel: "noopener", title: repository.production_url do %>
        <span>Production</span>
      <% end %>
    <% end %>
  </div>

  <% if repository.setup_notes.present? && ActionText::Content.new(repository.setup_notes).to_plain_text.strip.present? %>
    <div class="code-repo__notes txt-x-small txt-subtle overflow-line-clamp"><%= rich_text repository.setup_notes %></div>
  <% end %>

  <% repository.latest_deploys.each do |deploy| %>
    <%# herb:key deploy.id %>
    <div class="flex align-center gap-half txt-x-small">
      <%= status_tag deploy.succeeded? ? "Done" : deploy.state.humanize %>
      <span class="txt-subtle"><%= deploy.environment %> · <%= deploy.sha.to_s.first(7) %> · <%= time_ago_in_words(deploy.deployed_at) %> ago</span>
    </div>
  <% end %>

  <div class="code-repo__tools">
    <code class="code-repo__clone txt-x-small overflow-ellipsis" title="git clone <%= repository.url %>">git clone <%= repository.url %></code>
    <button type="button" class="btn btn--circle txt-x-small" title="Copy the clone command" data-controller="copy-to-clipboard" data-copy-to-clipboard-content-value="git clone <%= repository.url %>" data-copy-to-clipboard-success-class="btn--reversed" data-action="copy-to-clipboard#copy">
      <%= icon_tag "clipboard" %>
      <span class="for-screen-reader">Copy the clone command</span>
    </button>
    <% if repository.github? %>
      <% if repository.share_deploys %>
        <%= button_to coding_repository_deploy_sharing_path(repository), method: :delete, class: "btn btn--circle btn--reversed txt-x-small", title: "Deploys show in the client portal. Click to hide them." do %>
          <%= icon_tag "share" %>
          <span class="for-screen-reader">Hide deploys from the client</span>
        <% end %>
      <% else %>
        <%= button_to coding_repository_deploy_sharing_path(repository), class: "btn btn--circle txt-x-small", title: "Show deploys in the client portal" do %>
          <%= icon_tag "share" %>
          <span class="for-screen-reader">Show deploys to the client</span>
        <% end %>
      <% end %>
      <% if connected && repository.webhook_id.nil? %>
        <%= button_to coding_repository_hook_path(repository), class: "btn btn--circle txt-x-small", title: "Add the GitHub webhook (pull requests, checks, deploys)" do %>
          <%= icon_tag "bolt" %>
          <span class="for-screen-reader">Add GitHub webhook</span>
        <% end %>
      <% end %>
    <% end %>
    <% if repository.deletable_by?(Current.user) %>
      <%= render "layouts/shared/delete_dialog", name: "the link to " + repository.name, path: coding_repository_path(repository), trigger_class: "txt-x-small",
            message: "It’s only unlinked here. Nothing changes in the repository." %>
    <% end %>
    <details class="code-repo__edit">
      <summary class="btn btn--circle txt-x-small" title="Edit setup and environments">
        <%= icon_tag "pencil" %>
        <span class="for-screen-reader">Edit setup and environments</span>
      </summary>
      <%= form_with model: repository, url: coding_repository_path(repository), method: :patch, scope: :repository, namespace: dom_id(repository), class: "flex flex-column gap-half txt-small" do |form| %>
        <%= form.text_field :url, required: true, class: "input full-width", autocomplete: "off", aria: { label: "Git remote" } %>
        <div class="flex flex-wrap gap-half">
          <%= form.text_field :default_branch, class: "input flex-item-grow", autocomplete: "off", placeholder: "main", aria: { label: "Default branch" } %>
          <%= form.text_field :path, class: "input flex-item-grow", autocomplete: "off", placeholder: "Folder in a monorepo (optional)", aria: { label: "Folder" } %>
        </div>
        <div class="flex flex-wrap gap-half">
          <%= form.url_field :staging_url, class: "input flex-item-grow", autocomplete: "off", placeholder: "Staging URL", aria: { label: "Staging URL" } %>
          <%= form.url_field :production_url, class: "input flex-item-grow", autocomplete: "off", placeholder: "Production URL", aria: { label: "Production URL" } %>
        </div>
        <%= rich_text_field form, :setup_notes, placeholder: "How to get it running, and where secrets live (never the secrets)", staff: true %>
        <button type="submit" class="btn btn--link txt-small center">Save</button>
      <% end %>
    </details>
  </div>
</div>
