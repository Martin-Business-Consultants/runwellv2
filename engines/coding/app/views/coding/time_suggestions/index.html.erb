<% @page_title = "Time from commits" %>

<% content_for :header do %>
  <%= parent_page "Home", root_path %>
<% end %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Suggested for you</h2>
      </header>
      <% unless @time_tracking %>
        <p class="txt-small txt-subtle margin-none">Switch on Time tracking in Settings &gt; Plugins to log these.</p>
      <% end %>
      <ul class="settings__scrollable-list">
        <% @suggestions.each do |suggestion| %>
          <%# herb:key suggestion.id %>
          <li class="flex align-center gap-half txt-small" data-filter-target="item">
            <div class="txt-align-start overflow-ellipsis min-width">
              <strong><%= code_duration suggestion.minutes %></strong> <%= suggestion.todo.title %>
              <div class="txt-x-small txt-subtle"><%= l suggestion.date, format: :short %> · <%= suggestion.todo.engagement.ref %> · <%= suggestion.note %></div>
            </div>
            <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
            <% if @time_tracking %>
              <%= button_to "Log", coding_time_suggestions_path, params: { suggestion: suggestion.id }, class: "btn btn--link txt-x-small" %>
            <% end %>
            <%= button_to "Dismiss", coding_time_dismissal_path, params: { suggestion: suggestion.id }, class: "btn txt-x-small" %>
          </li>
        <% end %>
      </ul>
      <% if @suggestions.empty? %>
        <p class="txt-small txt-subtle margin-none">Nothing to suggest. Commits pushed to a todo’s branch show up here, matched by your GitHub username.</p>
      <% end %>
    </section>

    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Your GitHub username</h2>
      </header>
      <%= form_with url: coding_identity_path, method: :patch, scope: :identity, class: "flex gap-half txt-small" do |form| %>
        <%= form.text_field :github_login, value: Current.user.coding_identity&.github_login, class: "input flex-item-grow", autocomplete: "off", placeholder: "octocat", aria: { label: "GitHub username" } %>
        <button type="submit" class="btn">Save</button>
      <% end %>
    </section>
  </div>
</section>
