<%# locals: (form_id:) %>
<%= form_with url: coding_repositories_path, scope: :repository, id: form_id, namespace: "quick_action", class: "flex flex-column gap txt-small", data: { turbo_frame: "_top" } do |form| %>
  <%= form.text_field :url, required: true, class: "input full-width", autocomplete: "off", placeholder: "https://github.com/agency/site or git@…", aria: { label: "Git remote" } %>
  <div class="flex flex-wrap gap-half">
    <%= form.text_field :default_branch, class: "input flex-item-grow", autocomplete: "off", placeholder: "Default branch (main)", aria: { label: "Default branch" } %>
    <%= form.text_field :path, class: "input flex-item-grow", autocomplete: "off", placeholder: "Folder in a monorepo (optional)", aria: { label: "Folder" } %>
  </div>
  <div class="flex flex-wrap gap-half">
    <%= form.url_field :staging_url, class: "input flex-item-grow", autocomplete: "off", placeholder: "Staging URL", aria: { label: "Staging URL" } %>
    <%= form.url_field :production_url, class: "input flex-item-grow", autocomplete: "off", placeholder: "Production URL", aria: { label: "Production URL" } %>
  </div>
  <%= rich_text_field form, :setup_notes, placeholder: "How to get it running, and where secrets live (never the secrets)", staff: true %>
  <p class="txt-x-small txt-subtle margin-none">Work under this record uses the repository unless it has its own.</p>
  <div class="flex gap-half justify-center">
    <button type="submit" class="btn btn--link">Link repository</button>
  </div>
<% end %>
