<%# locals: (client:) %>
<%# Account management on a client: who leads it, its meetings and its outside accounts. %>
<% lead = client.account_lead&.user %>
<% upcoming = AccountManagement::Meeting.for(client).upcoming.includes(:client, :owner).limit(5).to_a %>
<% recent = AccountManagement::Meeting.for(client).where(starts_at: ...Time.current).recent.includes(:client, :owner).limit(5).to_a %>
<% accesses = AccountManagement::Access.for(client).ordered.to_a %>
<section class="settings__section" id="account_management">
  <header>
    <h2 class="divider">Lead</h2>
  </header>
  <div class="flex align-center gap-half txt-small">
    <%= person_tag lead, fallback: "Nobody leads it" %>
    <% if lead %><span><%= lead.display_name %></span><% end %>
    <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
    <% if can?(:manage_accounts) %>
      <%= form_with url: account_management_client_lead_path(client), method: :patch, class: "flex align-center gap-half", data: { controller: "form", action: "change->form#submit" } do |form| %>
        <%= form.select :user_id, account_people_options, { include_blank: "Nobody", selected: lead&.id }, class: "input input--select txt-small", aria: { label: "Who leads it" } %>
      <% end %>
    <% end %>
  </div>
  <% if lead %>
    <p class="txt-x-small txt-subtle margin-block-start-half"><%= lead.display_name %> answers for its meetings, commitments and accounts, and covers it in their weekly update. <%= link_to "Scorecard", account_management_scorecard_path(lead), class: "txt-link" %>.</p>
  <% end %>
</section>

<section class="settings__section">
  <header>
    <h2 class="divider">Meetings</h2>
  </header>
  <ul class="settings__scrollable-list">
    <% (upcoming + recent).each do |meeting| %>
      <%# herb:key meeting.id %>
      <%= render "account_management/meetings/row", meeting: meeting %>
    <% end %>
  </ul>
  <% if upcoming.empty? && recent.empty? %>
    <p class="txt-subtle txt-small margin-none">No meetings yet. Each one gets an agenda a day ahead and a recap within a day after.</p>
  <% end %>
  <div class="section-actions">
    <%= link_to new_account_management_meeting_path(record: QuickAction.value_for(client)), class: "btn txt-small" do %>
      <%= icon_tag "add" %>
      <span>Plan a meeting</span>
    <% end %>
    <% if recent.size == 5 %>
      <%= link_to "Every meeting", account_management_meetings_path(state: "all", client_id: client.id), class: "btn txt-small" %>
    <% end %>
  </div>
</section>

<section class="settings__section">
  <header>
    <h2 class="divider">Accounts and access <span class="txt-subtle"><%= (count = accesses.count { !it.in_order? }).positive? ? "#{count} needing attention" : "" %></span></h2>
  </header>
  <ul class="settings__scrollable-list">
    <% accesses.each do |access| %>
      <%# herb:key access.id %>
      <%= render "account_management/accesses/row", access: access %>
    <% end %>
  </ul>
  <% if accesses.empty? %>
    <p class="txt-subtle txt-small margin-none">No outside accounts recorded. Add the pages, ad accounts, pixels, analytics and domains the work depends on, with who owns each and our access.</p>
  <% end %>
  <div class="section-actions">
    <%= link_to new_account_management_access_path(client_id: client.id), class: "btn txt-small" do %>
      <%= icon_tag "add" %>
      <span>Add an account</span>
    <% end %>
  </div>
</section>
