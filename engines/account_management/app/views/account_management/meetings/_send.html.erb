<%# locals: (meeting:, paper:) %>
<%# Send the agenda or recap: email it to the client's contacts, or say how it went out. %>
<%= form_with url: (paper == :agenda ? send_agenda_account_management_meeting_path(meeting) : send_recap_account_management_meeting_path(meeting)),
      class: "flex flex-column gap-half txt-small margin-block-start-half" do |_form| %>
  <% if meeting.recipients.any? %>
    <fieldset class="flex flex-column gap-quarter txt-align-start">
      <legend class="txt-x-small txt-subtle">Email it to</legend>
      <% meeting.recipients.each do |contact| %>
        <%# herb:key contact.id %>
        <label class="flex align-center gap-half">
          <%= check_box_tag "contact_ids[]", contact.id, true, id: "#{paper}_contact_#{contact.id}" %>
          <span><%= contact.name %> <span class="txt-subtle"><%= contact.email %></span></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>
  <%= text_field_tag :via, nil, class: "input full-width", autocomplete: "off", aria: { label: "Sent another way" },
        placeholder: meeting.recipients.any? ? "Or, sent another way: untick everyone and say how" : "How it was sent: calendar invite, email thread…" %>
  <button type="submit" class="btn btn--link txt-small center">Send the <%= paper %></button>
<% end %>
