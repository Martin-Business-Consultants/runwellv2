<% @page_title = "Edit meeting" %>

<% content_for :header do %>
  <%= parent_page @meeting.title.truncate(40), account_management_meeting_path(@meeting) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "layouts/shared/errors", record: @meeting %>
    <%= render "account_management/meetings/form", meeting: @meeting %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Details</h2>
      </header>
      <dl class="record-facts">
        <dt>State</dt><dd><%= account_meeting_tag @meeting %></dd>
        <dt><%= term(:client) %></dt><dd><%= link_to @meeting.client.name, client_path(@meeting.client), class: "txt-link" %></dd>
        <dt>Agenda</dt><dd><%= account_paper_line @meeting, :agenda %></dd>
        <dt>Recap</dt><dd><%= account_paper_line @meeting, :recap %></dd>
      </dl>
    </section>
    <%= render "account_management/meetings/sidebar" %>
  </aside>
</section>
