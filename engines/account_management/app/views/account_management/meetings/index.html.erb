<% @page_title = "Meetings" %>
<% clients = ::Client.where(id: AccountManagement::Meeting.select(:client_id)).ordered %>

<%= render "account_management/links" %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :state, current: @state,
        options: [ [ "Upcoming", "upcoming" ], [ "Agenda or recap due", "due" ], [ "Past", "past" ], [ "All", "all" ] ] %>
  <%= render "layouts/shared/quick_filter", title: "Run by…", param: :owner, current: @owner,
        options: [ [ "Anyone", "anyone" ], [ "Me", "me" ] ] %>
  <% if clients.size > 1 %>
    <%= render "layouts/shared/quick_filter", title: "#{term(:client)}…", param: :client_id, current: params[:client_id].to_s,
          options: [ [ "Every #{term(:client).downcase}", "" ] ] + clients.map { [ it.name, it.id.to_s ] } %>
  <% end %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view, new_text: "Plan a meeting", new_path: new_account_management_meeting_path(client_id: params[:client_id].presence) %>

<% if @meetings.any? %>
  <% if @view == "cards" %>
    <section class="cards cards--grid">
      <% @meetings.each do |meeting| %>
        <%# herb:key meeting.id %>
        <%= render "layouts/shared/card", path: account_management_meeting_path(meeting), title: meeting.title, id_label: meeting.when_label,
              context: meeting.client.name, meta: [ "Agenda: #{account_paper_line(meeting, :agenda).downcase_first}", meeting.owner&.display_name ], status: meeting.state.humanize %>
      <% end %>
    </section>
  <% else %>
    <section class="panel shadow center index-table">
      <table class="data-table">
        <thead>
          <tr><th>Meeting</th><th><%= term(:client) %></th><th>When</th><th>Agenda</th><th>Recap</th><th>Runs it</th><th>State</th><th></th></tr>
        </thead>
        <tbody>
          <% @meetings.each do |meeting| %>
            <%# herb:key meeting.id %>
            <tr data-filter-target="item">
              <td class="font-weight-bold"><%= link_to meeting.title, account_management_meeting_path(meeting), class: "txt-ink" %></td>
              <td class="txt-subtle"><%= link_to meeting.client.name, client_path(meeting.client), class: "txt-ink" %><% if meeting.engagement %> · <%= link_to meeting.engagement.ref, engagement_path(meeting.engagement), class: "txt-ink" %><% end %></td>
              <td class="txt-nowrap"><%= meeting.when_label %></td>
              <td class="txt-small <%= "txt-negative" if meeting.agenda_late? %>"><%= account_paper_line meeting, :agenda %></td>
              <td class="txt-small <%= "txt-negative" if meeting.started? && meeting.recap_late? %>"><%= meeting.started? || meeting.recap_sent? ? account_paper_line(meeting, :recap) : "After it" %></td>
              <td><%= person_tag meeting.owner, fallback: "—" %></td>
              <td><%= account_meeting_tag meeting %></td>
              <%= render "layouts/shared/row_actions", name: meeting.title, edit_path: edit_account_management_meeting_path(meeting),
                    delete_path: (account_management_meeting_path(meeting) if !meeting.agenda_sent? && can?(:delete_records)) %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>
<% else %>
  <div class="blank-slate">
    <% if AccountManagement::Meeting.none? %>
      No meetings yet. Plan one from a <%= term(:client).downcase %>’s Account management tab, or press A for the quick action tray and choose Meeting. Its agenda is due a day before it starts.
    <% else %>
      No <%= @state == "all" ? "" : @state %> meetings.
    <% end %>
  </div>
<% end %>
