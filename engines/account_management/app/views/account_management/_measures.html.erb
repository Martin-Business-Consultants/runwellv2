<%# locals: (scorecard:) %>
<%# A lead's four numbers against the playbook, each linking to the records behind it. %>
<section class="accounts-metrics">
  <% scorecard.measures.each do |measure| %>
    <%# herb:key measure.key %>
    <%= link_to account_management_scorecard_path(scorecard.user, anchor: measure.key), class: "accounts-metric panel shadow txt-ink" do %>
      <span class="accounts-metric__label"><%= measure.label %></span>
      <strong class="accounts-metric__value <%= "txt-negative" unless measure.met? %>"><%= account_percent measure.percent %></strong>
      <span class="accounts-metric__note">
        <% if measure.total.zero? %>
          Nothing to count in <%= scorecard.days %> days · target <%= measure.target %>%
        <% else %>
          <%= measure.kept %> of <%= measure.total %> · target <%= measure.target %>%
        <% end %>
      </span>
    <% end %>
  <% end %>
</section>
