<% @page_title = "Accounts" %>
<% mine = @scorecards.find { it.user == Current.user } %>

<%= render "account_management/links" %>

<% if mine %>
  <%= render "account_management/measures", scorecard: mine %>
<% end %>

<% if @scorecards.any? %>
  <section class="panel shadow center index-table">
    <table class="data-table">
      <thead>
        <tr><th>Lead</th><th><%= term(:client, count: 2) %></th><th class="data-table__number">Agendas</th><th class="data-table__number">Recaps</th><th class="data-table__number">Commitments</th><th class="data-table__number">Updates</th><th class="data-table__number">Overdue</th><th class="data-table__number">Accounts</th><th></th></tr>
      </thead>
      <tbody>
        <% @scorecards.each do |scorecard| %>
          <%# herb:key scorecard.user.id %>
          <tr data-filter-target="item">
            <td><%= link_to account_management_scorecard_path(scorecard.user), class: "txt-ink flex align-center gap-half" do %><%= person_tag scorecard.user %><span><%= scorecard.user.display_name %></span><% end %></td>
            <td class="txt-subtle"><%= scorecard.clients.map(&:name).to_sentence.presence || "—" %></td>
            <% scorecard.measures.each do |measure| %>
              <%# herb:key measure.key %>
              <td class="data-table__number <%= "txt-negative" unless measure.met? %>" title="<%= measure.kept %> of <%= measure.total %>, target <%= measure.target %>%"><%= account_percent measure.percent %></td>
            <% end %>
            <td class="data-table__number <%= "txt-negative" if scorecard.overdue_commitments.any? %>"><%= scorecard.overdue_commitments.size %></td>
            <td class="data-table__number <%= "txt-negative" if scorecard.accesses_needing_attention.any? %>"><%= scorecard.accesses_needing_attention.size %></td>
            <td><%= account_status_tag scorecard.met? ? "on_time" : "attention" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% else %>
  <div class="blank-slate">
    Nobody leads a <%= term(:client).downcase %> yet. On each <%= term(:client).downcase %>’s page, open the Account management tab and choose who answers for it: its meetings, its commitments, its accounts and its line in their weekly update.
  </div>
<% end %>

<div class="accounts-columns">
  <section class="panel shadow txt-align-start">
    <h2 class="divider txt-medium">Due now</h2>
    <% if @agendas_due.any? || @recaps_due.any? || @unled.any? %>
      <ul class="settings__scrollable-list">
        <% @agendas_due.each do |meeting| %>
          <%# herb:key "agenda-#{meeting.id}" %>
          <%= render "account_management/meetings/row", meeting: meeting, with_client: true %>
        <% end %>
        <% @recaps_due.each do |meeting| %>
          <%# herb:key "recap-#{meeting.id}" %>
          <%= render "account_management/meetings/row", meeting: meeting, with_client: true %>
        <% end %>
        <% @unled.each do |client| %>
          <%# herb:key "client-#{client.id}" %>
          <li class="flex align-center gap-half">
            <%= link_to client_path(client, tab: "plugin-account_management"), class: "txt-ink txt-align-start min-width" do %>
              <strong><%= client.name %></strong>
              <div class="txt-x-small txt-subtle">Nobody leads it</div>
            <% end %>
            <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
            <%= account_status_tag "attention" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="txt-small txt-subtle margin-none">No agenda or recap is due, and every <%= term(:client).downcase %> has a lead.</p>
    <% end %>
  </section>

  <section class="panel shadow txt-align-start">
    <h2 class="divider txt-medium">Accounts needing attention</h2>
    <% if @accesses.any? %>
      <ul class="settings__scrollable-list">
        <% @accesses.first(12).each do |access| %>
          <%# herb:key access.id %>
          <%= render "account_management/accesses/row", access: access, with_client: true %>
        <% end %>
      </ul>
      <% if @accesses.size > 12 %>
        <p class="txt-small margin-none"><%= link_to "All #{@accesses.size} in the register", account_management_accesses_path(state: "attention"), class: "txt-link" %></p>
      <% end %>
    <% else %>
      <p class="txt-small txt-subtle margin-none">Every account in the register is owned by its <%= term(:client).downcase %>, reachable by us, and checked in the last <%= (AccountManagement::Playbook::VERIFY_EVERY / 1.day).round %> days.</p>
    <% end %>
  </section>
</div>
