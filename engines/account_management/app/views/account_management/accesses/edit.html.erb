<% @page_title = @access.name %>

<% content_for :header do %>
  <%= parent_page "Access register", account_management_accesses_path(client_id: @access.client_id) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <%= render "layouts/shared/errors", record: @access %>
    <%= render "account_management/accesses/form", access: @access %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Details</h2>
      </header>
      <dl class="record-facts">
        <dt><%= term(:client) %></dt><dd><%= link_to @access.client.name, client_path(@access.client), class: "txt-link" %></dd>
        <dt>Checked</dt><dd><%= @access.verified_on ? "#{l @access.verified_on, format: :long}#{" by #{@access.verified_by.display_name}" if @access.verified_by}" : "Never" %></dd>
      </dl>
      <% unless @access.in_order? %>
        <ul class="accounts-problems txt-small">
          <% @access.problems.each do |problem| %>
            <%# herb:key problem %>
            <li><%= problem %></li>
          <% end %>
        </ul>
      <% end %>
      <%= button_to "Checked today: it’s as recorded", verify_account_management_access_path(@access), class: "btn btn--link txt-small center" %>
    </section>
    <%= render "account_management/accesses/sidebar" %>
    <% if can?(:manage_accounts) %>
      <section class="settings__section">
        <%= render "layouts/shared/confirm", trigger: "Remove from the register", title: "Remove #{@access.name}?", body: "Its history goes with it.", button: "Remove it", path: account_management_access_path(@access) %>
      </section>
    <% end %>
    <%= render "events/timeline", subject: @access %>
  </aside>
</section>
