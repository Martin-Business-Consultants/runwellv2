<%# locals: (update:) %>
<% url = update.persisted? ? account_management_weekly_update_path(update) : account_management_weekly_updates_path %>
<%= form_with model: update, url: url, scope: :weekly_update, class: "flex flex-column gap txt-medium", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <% unless update.persisted? %>
    <%= form.hidden_field :week_of %>
  <% end %>
  <div class="flex flex-column gap-half txt-align-start">
    <span class="txt-small font-weight-bold">Per <%= term(:client).downcase %>: status, shipped, next, blockers and risks</span>
    <%= rich_text_field form, :body, staff: true %>
  </div>
  <div class="flex flex-wrap gap-half justify-center">
    <button type="submit" class="btn" data-form-target="submit">Save the draft</button>
    <button type="submit" name="send" value="1" class="btn btn--link">
      <span>Send it</span>
      <%= icon_tag "arrow-right" %>
    </button>
  </div>
  <%= link_to "Cancel and go back", account_management_weekly_updates_path, data: { form_target: "cancel" }, hidden: true %>
<% end %>
