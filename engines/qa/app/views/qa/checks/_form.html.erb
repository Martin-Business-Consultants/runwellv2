<%# locals: (check:) %>
<% engagements = check.client ? check.client.engagements.order(:created_at).map { [ "#{it.ref} #{it.title}", it.ref ] } : [] %>
<%= render "layouts/shared/errors", record: check %>
<%= form_with model: check, url: check.new_record? ? qa_checks_path : qa_check_path(check), scope: :check, class: "qa-form txt-medium", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
  <label class="qa-form__field qa-form__field--wide">
    <span class="txt-small font-weight-bold">What is checked</span>
    <%= form.text_field :name, required: true, class: "input full-width", autofocus: true, autocomplete: "off", placeholder: "Quote email to the customer, Lead alert to the office, Thank-you page…" %>
  </label>

  <% if check.new_record? %>
    <label class="qa-form__field">
      <span class="txt-small font-weight-bold"><%= term(:client) %></span>
      <%= form.select :client_id, ::Client.order(:name).map { [ it.name, it.id ] }, (check.client ? {} : { include_blank: true }), required: true, class: "input input--select full-width" %>
    </label>
  <% end %>

  <label class="qa-form__field">
    <span class="txt-small font-weight-bold">Kind</span>
    <%= form.select :kind, Qa::Check::KINDS.map { [ it.humanize, it ] }, {}, class: "input input--select full-width" %>
  </label>

  <label class="qa-form__field">
    <span class="txt-small font-weight-bold">Owner</span>
    <%= form.select :owner_id, qa_owner_options, { include_blank: "Nobody (managers)" }, class: "input input--select full-width" %>
  </label>

  <label class="qa-form__field">
    <span class="txt-small font-weight-bold">Test again every (days)</span>
    <%= form.number_field :every_days, min: 1, max: 365, class: "input full-width" %>
  </label>

  <label class="qa-form__field qa-form__field--wide">
    <span class="txt-small font-weight-bold">URL</span>
    <%= form.url_field :url, class: "input full-width", autocomplete: "off", placeholder: "https://… the page, or where the email or webhook starts (optional)" %>
  </label>

  <% if engagements.any? %>
    <label class="qa-form__field qa-form__field--wide">
      <span class="txt-small font-weight-bold"><%= term(:engagement) %></span>
      <%= form.select :engagement_ref, engagements, { include_blank: "None", selected: check.engagement&.ref }, class: "input input--select full-width" %>
    </label>
  <% end %>

  <div class="qa-form__field qa-form__field--wide qa-form__switches">
    <div class="flex align-center gap-half">
      <label class="switch flex-item-no-shrink">
        <%= form.check_box :live, class: "switch__input" %>
        <span class="switch__btn"></span>
      </label>
      <%= form.label :live, "Live: customers see it now", class: "txt-small" %>
    </div>
    <% if check.new_record? %>
      <div class="flex align-center gap-half">
        <label class="switch flex-item-no-shrink">
          <%= check_box_tag :use_template, "1", true, class: "switch__input", id: "use_template" %>
          <span class="switch__btn"></span>
        </label>
        <label for="use_template" class="txt-small">Start from the usual list for its kind</label>
      </div>
    <% end %>
  </div>

  <div class="qa-form__field qa-form__field--wide">
    <span class="txt-small font-weight-bold">How to test it</span>
    <%= rich_text_field form, :instructions, placeholder: "Which test record to use, where the email lands, where the webhook’s log is…", staff: true %>
  </div>

  <div class="qa-form__field--wide flex align-center gap">
    <button type="submit" class="btn btn--link" data-form-target="submit">
      <span><%= check.new_record? ? "Add check" : "Save changes" %></span>
      <%= icon_tag "arrow-right" %>
    </button>
    <%= link_to "Cancel", check.new_record? ? (check.client ? client_path(check.client) : qa_root_path) : qa_check_path(check), class: "btn btn--plain txt-small", data: { form_target: "cancel" } %>
  </div>
<% end %>
