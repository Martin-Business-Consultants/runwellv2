<%# locals: (check:, with_client: nil) %>
<%# One check in a list: what it is, who answers for it, when it was last tested, its state. %>
<% last = check.latest_results.values.max_by(&:created_at) %>
<li class="flex align-center gap-half" data-filter-target="item">
  <%= link_to qa_check_path(check), class: "txt-ink txt-align-start overflow-ellipsis min-width" do %>
    <strong><%= check.name %></strong>
    <div class="txt-x-small txt-subtle"><%= [ (check.client.name if with_client), check.kind.humanize, check.engagement&.ref, ("live" if check.live), pluralize(check.expectations.size, "fact"), (last ? "tested #{time_ago_in_words(last.created_at)} ago" : "never tested") ].compact.join(" · ") %></div>
  <% end %>
  <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
  <% if check.owner %>
    <%= person_tag check.owner %>
  <% end %>
  <%= qa_status_tag check.state %>
</li>
