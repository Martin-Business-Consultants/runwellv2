<% @page_title = "#{@run.check.name}: #{@run.passed? ? "passed" : "failed"}" %>

<% content_for :header do %>
  <%= parent_page @run.check.name, qa_check_path(@run.check) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <h1 class="page-title"><%= @page_title %></h1>
    <section class="settings__section">
      <header>
        <h2 class="divider">What it saw</h2>
      </header>
      <div class="qa-table-wrap">
        <table class="data-table qa-truth qa-truth--results">
          <thead>
            <tr><th>Fact</th><th>Agreed</th><th>Saw</th><th>Result</th></tr>
          </thead>
          <tbody>
            <% @run.results.each do |result| %>
              <%# herb:key result.id %>
              <tr data-filter-target="item" class="<%= "qa-truth__row--failed" unless result.passed %>">
                <td class="qa-truth__fact"><strong><%= result.label %></strong><div class="qa-key txt-x-small txt-subtle" title="<%= result.key %>"><code><%= result.key %></code></div></td>
                <td class="qa-fact__value"><%= result.expected.presence || "—" %></td>
                <td class="qa-fact__value <%= "txt-negative" unless result.passed %>"><%= result.actual.presence || "—" %></td>
                <td><%= qa_status_tag result.passed ? "passed" : "failed" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <aside class="settings__panel panel shadow txt-align-start settings__panel--side">

    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <div class="flex flex-wrap align-center gap-half txt-small">
        <%= qa_status_tag @run.status %>
        <span class="txt-subtle"><%= @run.summary %></span>
      </div>
      <dl class="qa-facts txt-small">
        <dt>Tested by</dt><dd><% if @run.user %><%= person_tag @run.user %> <% end %><%= @run.tester_label %> · <%= Qa::Run::SOURCES.fetch(@run.source) %></dd>
        <dt>When</dt><dd><%= l @run.created_at, format: :long %></dd>
        <dt><%= term(:client) %></dt><dd><%= link_to @run.check.client.name, client_path(@run.check.client), class: "txt-link" %></dd>
        <% if @run.http_status %>
          <dt>Page</dt><dd><%= @run.check.url %> answered <%= @run.http_status %></dd>
        <% end %>
        <% if @run.evidence_url %>
          <dt>Evidence</dt><dd><%= link_to @run.evidence_url, @run.evidence_url, class: "txt-link", target: "_blank", rel: "noopener" %></dd>
        <% end %>
      </dl>
      <% if @run.notes.present? %>
        <div class="txt-small"><%= rich_text @run.notes %></div>
      <% end %>
    </section>
  </aside>
</section>
