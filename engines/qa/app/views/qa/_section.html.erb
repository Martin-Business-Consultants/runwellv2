<%# locals: (record:) %>
<%# QA on a client or engagement: its checks, and the issues still open on it. %>
<% checks = Qa::Check.for(record).active.includes(:client, :owner, :engagement, :expectations).ordered.to_a %>
<% issues = Qa::Issue.for(record).unverified.includes(:client, :assignee).recent.limit(10).to_a %>
<% client = record.is_a?(Client) ? record : record.client %>
<section class="settings__section" id="qa">
  <header>
    <h2 class="divider">QA <span class="txt-subtle"><%= checks.count(&:failing?).positive? ? "#{checks.count(&:failing?)} failing" : "" %></span></h2>
  </header>

  <ul class="settings__scrollable-list">
    <% checks.each do |check| %>
      <%# herb:key check.id %>
      <%= render "qa/checks/row", check: check %>
    <% end %>
  </ul>
  <% if checks.empty? %>
    <p class="txt-subtle txt-small margin-none">Nothing checked yet. Add a check for each thing customers see: an email, a page, a webhook, a form.</p>
  <% end %>

  <% if issues.any? %>
    <h3 class="qa-client-heading txt-small">Open issues</h3>
    <ul class="settings__scrollable-list">
      <% issues.each do |issue| %>
        <%# herb:key issue.id %>
        <%= render "qa/issues/row", issue: issue %>
      <% end %>
    </ul>
  <% end %>

  <% if can?(:manage_qa) %>
    <div class="section-actions">
      <%= link_to new_qa_check_path(client_id: client.id), class: "btn txt-small" do %>
        <%= icon_tag "add" %>
        <span>Add a check</span>
      <% end %>
    </div>
  <% end %>
</section>
