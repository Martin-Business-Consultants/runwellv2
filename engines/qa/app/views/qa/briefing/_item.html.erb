<%# locals: (item:) %>
<% case item %>
<% when Qa::Check %>
  <%= link_to qa_check_path(item), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.name %></strong>
      <div class="txt-x-small txt-subtle">
        <%= item.client.name %> ·
        <% if item.failing? %>
          <%= item.expectations.select { item.latest_results[it.id]&.passed == false }.map(&:label).to_sentence %> failing<%= ", live" if item.live %>
        <% else %>
          due for a test (every <%= pluralize item.every_days, "day" %>)
        <% end %>
      </div>
    </div>
    <%= qa_status_tag item.state %>
  <% end %>
<% when Qa::Expectation %>
  <%= link_to qa_check_path(item.check), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.label %> <%= item.expired? ? "ended" : "ends" %> <%= l item.expires_on, format: :short %></strong>
      <div class="txt-x-small txt-subtle"><%= item.check.client.name %> · <%= item.check.name %> · “<%= item.expected.to_s.truncate(70) %>”: change it or extend it, everywhere it shows</div>
    </div>
    <%= qa_status_tag item.expired? ? "failing" : "due" %>
  <% end %>
<% when Qa::Issue %>
  <%= link_to qa_issue_path(item), class: "txt-ink txt-align-start flex align-center gap-half" do %>
    <div class="min-width flex-item-grow">
      <strong><%= item.title %></strong>
      <div class="txt-x-small txt-subtle"><%= item.client.name %> · <%= item.open? ? "yours to fix" : "fixed by #{item.fixed_by&.display_name || "someone"}; verify it" %><%= " · found live" if item.found_live %></div>
    </div>
    <%= qa_status_tag item.state %>
  <% end %>
<% end %>
