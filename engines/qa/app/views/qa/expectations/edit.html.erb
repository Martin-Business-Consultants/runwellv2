<% @page_title = "Edit " + @expectation.label_was %>

<% content_for :header do %>
  <%= parent_page @check.name, qa_check_path(@check, fact: @expectation.id) %>
<% end %>

<section class="settings settings--split">
  <div class="settings__panel panel shadow txt-align-start">
    <div class="flex flex-column gap-half">
      <h1 class="page-title"><%= @page_title %></h1>
      <p class="txt-small txt-subtle margin-none">On <%= link_to @check.name, qa_check_path(@check), class: "txt-link" %> · <%= @check.client.name %>. Changing the value or match is recorded on the client’s history, and the check has to be tested again.</p>
    </div>
    <%= render "layouts/shared/errors", record: @expectation %>

    <%= form_with model: @expectation, url: qa_check_expectation_path(@check, @expectation), method: :patch, scope: :expectation, class: "qa-form txt-medium", data: { controller: "form", action: "keydown.esc->form#cancel" } do |form| %>
      <%= hidden_field_tag :from_edit, "1" %>
      <label class="qa-form__field qa-form__field--wide">
        <span class="txt-small font-weight-bold">Label</span>
        <%= form.text_field :label, required: true, class: "input full-width", autofocus: true, autocomplete: "off" %>
      </label>
      <label class="qa-form__field qa-form__field--wide">
        <span class="txt-small font-weight-bold">Agreed value</span>
        <%= form.text_field :expected, class: "input full-width", autocomplete: "off", placeholder: "Blank for a step to tick off; a list comma separated" %>
        <span class="txt-x-small txt-subtle">Exactly what customers must see. Spacing, letter case and phone formatting never fail a test.</span>
      </label>
      <label class="qa-form__field">
        <span class="txt-small font-weight-bold">Match</span>
        <%= form.select :match, Qa::Matcher::MATCHES.map { |key, words| [ words.capitalize, key ] }, {}, class: "input input--select full-width" %>
      </label>
      <label class="qa-form__field">
        <span class="txt-small font-weight-bold">Ends on</span>
        <%= date_input form, :expires_on, class: "input full-width" %>
        <span class="txt-x-small txt-subtle">For a promo or offer: home warns a week before.</span>
      </label>
      <label class="qa-form__field qa-form__field--wide">
        <span class="txt-small font-weight-bold">Source</span>
        <%= form.text_field :note, class: "input full-width", autocomplete: "off", placeholder: "Where the value comes from: a config file, the CMS, who approved it" %>
      </label>
      <div class="qa-form__field--wide flex align-center gap">
        <button type="submit" class="btn btn--link" data-form-target="submit">
          <span>Save changes</span>
          <%= icon_tag "arrow-right" %>
        </button>
        <%= link_to "Cancel", qa_check_path(@check, fact: @expectation.id), class: "btn btn--plain txt-small", data: { form_target: "cancel" } %>
      </div>
    <% end %>
  </div>

  <aside class="settings__panel settings__panel--side panel shadow txt-align-start">
    <%= render "layouts/shared/sidebar_toggle" %>
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Details</h2>
      </header>
      <dl class="record-facts">
        <dt>Key</dt><dd><code><%= @expectation.key %></code></dd>
        <dt>Agreed by</dt><dd><%= @expectation.approved_by ? "#{@expectation.approved_by.display_name}, #{l @expectation.approved_at.to_date, format: :short}" : "Imported" %></dd>
        <dt>Check</dt><dd><%= link_to @check.name, qa_check_path(@check), class: "txt-link" %></dd>
      </dl>
      <p class="txt-x-small txt-subtle margin-none">The key is fixed: the site’s own report names the fact by it.</p>
    </section>

    <section class="settings__section">
      <header>
        <h2 class="divider">Results</h2>
      </header>
      <ul class="settings__scrollable-list">
        <% @results.each do |result| %>
          <%# herb:key result.id %>
          <li class="flex align-center gap-half txt-small" data-filter-target="item">
            <%= qa_status_tag result.passed ? "passed" : "failed" %>
            <%= link_to qa_run_path(result.run), class: "txt-ink overflow-ellipsis min-width" do %>
              <%= result.actual.presence || "—" %>
            <% end %>
            <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
            <span class="txt-x-small txt-subtle txt-nowrap"><%= time_ago_in_words(result.created_at) %></span>
          </li>
        <% end %>
      </ul>
      <% if @results.empty? %>
        <p class="txt-subtle txt-small margin-none">Never tested.</p>
      <% end %>
    </section>

    <%= render "layouts/shared/confirm", trigger: "Remove this fact", title: "Remove #{@expectation.label_was}?",
          body: "Its past results keep what was checked. Removing it is recorded on the client’s history.",
          button: "Remove", path: qa_check_expectation_path(@check, @expectation), method: :delete %>
  </aside>
</section>
