<%# locals: (todo:) %>
<%# The checks this work must pass before it's done, where each stands, and issues on it. %>
<% gates = todo.qa_gates.includes(check: :expectations).to_a %>
<% available = Qa::Check.active.where(client_id: todo.engagement.client_id).where.not(id: gates.map(&:check_id)).ordered.to_a %>
<% issues = todo.qa_issues.unverified.includes(:client, :assignee).recent.to_a %>
<section class="settings__section flex flex-column gap-half" id="qa">
  <header>
    <h2 class="divider">QA</h2>
  </header>

  <% if gates.any? %>
    <ul class="settings__scrollable-list">
      <% gates.each do |gate| %>
        <%# herb:key gate.id %>
        <% problems = gate.problems %>
        <li class="flex flex-column gap-half" data-filter-target="item">
          <div class="flex align-center gap-half txt-small">
            <%= link_to gate.check.name, qa_check_path(gate.check), class: "txt-ink min-width overflow-ellipsis" %>
            <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
            <%= qa_status_tag problems.empty? ? "passed" : "due" %>
            <% if can?(:manage_qa) %>
              <%= render "layouts/shared/delete_dialog", name: "the gate on " + gate.check.name, path: qa_todo_gate_path(todo, gate), trigger_class: "txt-x-small",
                    message: "The work can then be marked done without this check passing." %>
            <% end %>
          </div>
          <% problems.each do |problem| %>
            <%# herb:key problem %>
            <div class="txt-x-small txt-subtle"><%= problem %></div>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="txt-x-small txt-subtle margin-none">It can’t be marked done until these pass in a test after it last went to review<%= ", by someone other than #{todo.owner.display_name}" if todo.owner %>.</p>
  <% else %>
    <p class="txt-subtle txt-small margin-none">No check has to pass before this is done.</p>
  <% end %>

  <% if available.any? %>
    <details>
      <summary class="btn txt-small">Require a check</summary>
      <%= form_with url: qa_todo_gates_path(todo), scope: :gate, namespace: dom_id(todo, :qa_gate), class: "flex flex-wrap align-center gap-half txt-small margin-block-start-half", data: { turbo_action: "advance" } do |form| %>
        <%= form.select :check_id, available.map { [ it.name, it.id ] }, {}, class: "input input--select flex-item-grow", aria: { label: "Check" } %>
        <button type="submit" class="btn btn--link txt-small">Require it</button>
      <% end %>
    </details>
  <% end %>

  <% if issues.any? %>
    <ul class="settings__scrollable-list">
      <% issues.each do |issue| %>
        <%# herb:key issue.id %>
        <%= render "qa/issues/row", issue: issue %>
      <% end %>
    </ul>
  <% end %>
</section>
