<% @page_title = "QA issues" %>

<% content_for :header do %>
  <%= parent_page "QA", qa_root_path %>
<% end %>

<% content_for :index_filters do %>
  <%= render "layouts/shared/quick_filter", title: "Show…", param: :state, current: @state,
        options: [ [ "Open", "open" ], [ "Fixed, to verify", "fixed" ], [ "Verified", "verified" ], [ "All", "all" ] ] %>
  <%= render "layouts/shared/quick_filter", title: "Found…", param: :found, current: @found,
        options: [ [ "Live or before", "all" ], [ "Live (escapes)", "live" ], [ "Before going live", "caught" ] ] %>
  <%= render "layouts/shared/quick_filter", title: "Whose…", param: :assignee, current: @assignee,
        options: [ [ "Anyone’s", "anyone" ], [ "Mine to fix", "me" ] ] %>
<% end %>
<%= render "layouts/shared/index_toolbar", view: @view %>

<% if @view == "cards" %>
  <section class="cards cards--grid">
    <div class="cards__list">
      <%= with_automatic_pagination :qa_issues_cards, @page do %>
        <% @issues.each do |issue| %>
          <%# herb:key issue.id %>
          <%= render "layouts/shared/card", path: qa_issue_path(issue), title: issue.title, id_label: issue.engagement&.ref, context: issue.client.name,
                meta: [ ("Found live" if issue.found_live), issue.check&.name, "#{time_ago_in_words(issue.created_at)} ago" ].compact,
                status: { "open" => "Open", "fixed" => "Awaiting", "verified" => "Done" }.fetch(issue.state), highlight: issue.verified? %>
        <% end %>
      <% end %>
    </div>
  </section>
<% else %>
  <section class="panel shadow center index-table">
    <table class="data-table" data-controller="pagination" data-pagination-paginate-on-intersection-value="true" data-pagination-discard-frame-value="true">
      <thead>
        <tr><th>Issue</th><th><%= term(:client) %></th><th>Found</th><th>Fixes it</th><th>Opened</th><th>Status</th><th></th></tr>
      </thead>
      <tbody id="<%= pagination_frame_id_for(:qa_issues_rows, @page.number) %>">
        <% @issues.each do |issue| %>
          <%# herb:key issue.id %>
          <tr data-filter-target="item">
            <td class="font-weight-bold"><%= link_to issue.title, qa_issue_path(issue), class: "txt-ink" %></td>
            <td class="txt-subtle"><%= link_to issue.client.name, client_path(issue.client), class: "txt-ink" %><% if issue.check %> · <%= link_to issue.check.name, qa_check_path(issue.check), class: "txt-ink" %><% end %></td>
            <td><%= issue.found_live ? status_tag("Live") : "Before live" %></td>
            <td><%= person_tag issue.assignee, fallback: "Unassigned" %></td>
            <td class="txt-nowrap"><%= l issue.created_at.to_date, format: :short %></td>
            <td><%= qa_status_tag issue.state %></td>
            <%= render "layouts/shared/row_actions", name: "this issue", edit_path: (edit_qa_issue_path(issue) if issue.fillable_by?(Current.user)), delete_path: (qa_issue_path(issue) if issue.open?) %>
          </tr>
        <% end %>
        <%= table_next_page_row :qa_issues_rows, @page, columns: 7 %>
      </tbody>
    </table>
  </section>
<% end %>

<% if @issues.none? %>
  <div class="blank-slate">
    <%= { "open" => "No open issues.", "fixed" => "Nothing waiting to be verified.", "verified" => "Nothing verified yet.", "all" => "No issues logged." }.fetch(@state) %>
    <% if Qa::Issue.none? %>
      A failing test opens one on its own. Log one yourself from the quick actions (A), under QA issue: where, how, what should happen and what did.
    <% end %>
  </div>
<% end %>
