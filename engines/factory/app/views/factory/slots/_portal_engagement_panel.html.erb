<%# locals: (engagement:) %>
<%# For the client: shared work an agent is building right now. Titles only, nothing internal. %>
<% building = Factory::Run.running.joins(:todo).merge(engagement.todos.client_visible).includes(:todo).map(&:todo).uniq %>
<% if building.any? %>
  <section class="settings__section flex flex-column gap-half">
    <header>
      <h2 class="divider">Being built now</h2>
    </header>
    <ul class="settings__scrollable-list">
      <% building.each do |todo| %>
        <%# herb:key todo.id %>
        <li class="flex align-center gap-half txt-small">
          <span class="status-dot status-dot--in-progress" aria-hidden="true"></span>
          <span class="txt-align-start"><%= todo.title %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
