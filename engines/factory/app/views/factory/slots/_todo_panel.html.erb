<%# locals: (todo:) %>
<%# Agents on this todo: hand it over (when it's ready), watch the run, see past attempts. %>
<% item = todo.factory_item %>
<% runs = todo.factory_runs.recent.to_a %>
<% readiness = Factory::Readiness.new(todo) %>
<section class="settings__section flex flex-column gap-half" id="factory">
  <header>
    <h2 class="divider">Agents</h2>
  </header>

  <% if item %>
    <div class="flex align-center gap-half txt-small">
      <%= factory_status_tag item.state %>
      <span class="txt-subtle min-width">
        <% case item.state %>
        <% when "queued" %>
          Waiting for the next free runner.
        <% when "running" %>
          <%= item.current_run.runner %> is working on it, until <%= l item.current_run.deadline, format: :short %> at the latest.
        <% when "review" %>
          An agent finished. Check the work, then mark it done.
        <% when "failed" %>
          Every attempt failed. Read the last run, fix what it needed, then hand it over again.
        <% when "blocked" %>
          <%= readiness.problems.to_sentence %>
        <% when "done" %>
          Done.
        <% end %>
      </span>
    </div>
    <% if item.instructions.present? %>
      <div class="txt-small"><strong>Instructions:</strong> <%= rich_text item.instructions %></div>
    <% end %>
    <% if can?(:queue_agent_work) %>
      <div class="flex flex-wrap align-center gap-half justify-center">
        <% if item.current_run %>
          <%= button_to "Stop the run", factory_run_cancellation_path(item.current_run), class: "btn txt-small" %>
        <% end %>
        <% if item.state == "failed" && readiness.ready? %>
          <%= button_to "Try again", factory_todo_item_path(todo), class: "btn btn--link txt-small" %>
        <% end %>
        <%= button_to "Take it back from agents", factory_todo_item_path(todo), method: :delete, class: "btn btn--plain txt-link txt-small" %>
      </div>
    <% end %>
  <% elsif !can?(:queue_agent_work) %>
    <p class="txt-small txt-subtle margin-none">Not handed to agents.</p>
  <% elsif readiness.ready? %>
    <details>
      <summary class="btn txt-small">Hand to an agent</summary>
      <%= form_with url: factory_todo_item_path(todo), scope: :item, namespace: dom_id(todo, :factory), class: "flex flex-column gap-half margin-block-start-half", data: { turbo_action: "advance" } do |form| %>
        <%= rich_text_field form, :instructions, placeholder: "Anything the agent should know (optional)" %>
        <button type="submit" class="btn btn--link txt-small">Queue it</button>
      <% end %>
    </details>
  <% else %>
    <div class="txt-small txt-subtle txt-align-start">
      Not ready for an agent yet:
      <ul class="margin-none">
        <% readiness.problems.each do |problem| %>
          <%# herb:key problem %>
          <li><%= problem %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if runs.any? %>
    <ul class="settings__scrollable-list">
      <% runs.each do |run| %>
        <%# herb:key run.id %>
        <%= render "factory/runs/row", run: run %>
      <% end %>
    </ul>
  <% end %>
</section>
