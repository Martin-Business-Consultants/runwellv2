<% @page_title = "Factory" %>
<%= render "settings/header", current: :factory %>

<section class="settings">
  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap">
      <header>
        <h2 class="divider">Limits</h2>
      </header>
      <%= form_with model: @policy, url: factory_settings_path, method: :patch, scope: :policy, class: "flex flex-column gap" do |form| %>
        <div class="factory-limits">
          <%= form.label :max_concurrent_runs, "Runs at once", class: "txt-small" %>
          <%= form.number_field :max_concurrent_runs, class: "input", min: 1, max: 50 %>
          <%= form.label :run_time_limit_minutes, "Minutes a run may take", class: "txt-small" %>
          <%= form.number_field :run_time_limit_minutes, class: "input", min: 5, max: 720 %>
          <%= form.label :max_attempts, "Attempts before a person looks", class: "txt-small" %>
          <%= form.number_field :max_attempts, class: "input", min: 1, max: 10 %>
          <%= form.label :lease_minutes, "Minutes without a heartbeat before a run is abandoned", class: "txt-small" %>
          <%= form.number_field :lease_minutes, class: "input", min: 2, max: 120 %>
          <%= form.label :monthly_budget_cents, "Monthly budget (blank for none)", class: "txt-small" %>
          <%= money_field form, :monthly_budget_cents, class: "input" %>
        </div>
        <p class="txt-x-small txt-subtle margin-none">Spent this month: <%= money @policy.spent_this_month_cents %>. Runners report each run’s cost; once the budget is used up, no new runs start.</p>

        <label class="flex align-center gap-half txt-small">
          <%= form.check_box :queue_on_approval %>
          <span>When a client approves an agreement, hand its ready <%= term(:work).downcase %> to agents</span>
        </label>

        <fieldset class="flex flex-column gap-half txt-small">
          <legend class="font-weight-bold">Never give agent work for</legend>
          <%= hidden_field_tag "policy[blocked_client_ids][]", "" %>
          <% @clients.each do |client| %>
            <%# herb:key client.id %>
            <label class="flex align-center gap-half">
              <%= check_box_tag "policy[blocked_client_ids][]", client.id, !@policy.client_allowed?(client), id: dom_id(client, :factory_blocked) %>
              <span><%= client.name %></span>
            </label>
          <% end %>
        </fieldset>

        <button type="submit" class="btn btn--link center">Save</button>
      <% end %>
    </section>
  </div>

  <div class="settings__panel panel shadow txt-align-start">
    <section class="settings__section flex flex-column gap-half">
      <header>
        <h2 class="divider">Runners</h2>
      </header>
      <p class="txt-small margin-none">A runner is a small program on a machine with Docker. It claims the next piece of <%= term(:work).downcase %>, starts a fresh container, clones the repositories, runs Claude Code on the task, and reports back. The work lands in review for a person; runners never merge.</p>
      <ol class="txt-small margin-none">
        <li>Make a personal token in <%= link_to "Settings → Connected apps", settings_connected_apps_path, class: "txt-link" %> for someone allowed to run the factory (owners and managers). Runs are recorded as their agent.</li>
        <li>Build the runner and the agent image from <code>engines/factory/runner</code> (its README has the details).</li>
        <li>Start it with the token, an Anthropic API key and a GitHub token that can push branches and open pull requests:</li>
      </ol>
      <%= code_block "export RUNWELL_URL=#{request.base_url}\nexport RUNWELL_TOKEN=…   ANTHROPIC_API_KEY=…   GH_TOKEN=…\nrunwell-runner --name #{(Socket.gethostname rescue "build-1")}" %>
      <p class="txt-x-small txt-subtle margin-none">Give the GitHub token access to branches only, not to merge or change settings. Stop a runner with Ctrl-C: it finishes reporting first.</p>
    </section>
  </div>
</section>
