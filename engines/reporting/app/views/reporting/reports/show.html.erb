<% @page_title = "Reports" %>
<% financials = @financials %>

<div class="filters margin-block-end">
  <%= render "layouts/shared/quick_filter", title: "Period", param: :period, options: Reporting::Period.options, current: @period.name %>
</div>

<% if financials.nil? %>
  <section class="settings">
    <div class="settings__panel panel shadow txt-align-start">
      <p class="txt-small margin-none">Reports read QuickBooks. Switch on the QuickBooks plugin in Settings &gt; Plugins and connect it.</p>
    </div>
  </section>
<% else %>
  <% pnl = financials.profit_and_loss %>
  <% recurring = financials.recurring %>
  <section class="settings">
    <div class="settings__panel panel shadow txt-align-start">
      <section class="settings__section flex flex-column gap">
        <header>
          <h2 class="divider"><%= @period.label %> · <%= l @period.from, format: :short %> to <%= l @period.to, format: :short %></h2>
        </header>
        <div class="report-stats">
          <div class="report-stat">
            <span class="txt-x-small txt-subtle">Billed</span>
            <span class="report-stat__value"><%= money financials.billed_cents %></span>
          </div>
          <div class="report-stat">
            <span class="txt-x-small txt-subtle">Collected</span>
            <span class="report-stat__value"><%= money financials.collected_cents %></span>
          </div>
          <div class="report-stat">
            <span class="txt-x-small txt-subtle">Owed to you now</span>
            <span class="report-stat__value"><%= money financials.outstanding_cents %></span>
            <span class="txt-x-small <%= financials.overdue_cents.positive? ? "txt-negative" : "txt-subtle" %>"><%= money financials.overdue_cents %> overdue</span>
          </div>
          <div class="report-stat">
            <span class="txt-x-small txt-subtle">Recurring, per month</span>
            <span class="report-stat__value"><%= money financials.monthly_recurring_cents %></span>
            <span class="txt-x-small txt-subtle"><%= money financials.monthly_recurring_billed_cents %> billed by QuickBooks</span>
          </div>
          <% if pnl.available? %>
            <div class="report-stat">
              <span class="txt-x-small txt-subtle">Net income</span>
              <span class="report-stat__value"><%= money pnl[:net_income] %></span>
              <% if pnl.margin %>
                <span class="txt-x-small txt-subtle"><%= pnl.margin %>% of income</span>
              <% end %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">Last twelve months</h2>
        </header>
        <%= report_month_chart financials.by_month %>
        <div class="report-legend txt-x-small txt-subtle center">
          <span><span class="report-legend__swatch report-legend__swatch--billed"></span>Billed</span>
          <span><span class="report-legend__swatch report-legend__swatch--collected"></span>Collected</span>
        </div>
      </section>

      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">Profit and loss</h2>
        </header>
        <% if pnl.available? %>
          <table class="data-table txt-small">
            <tbody>
              <% [ [ "Income", :income ], [ "Cost of sales", :cost_of_sales ], [ "Gross profit", :gross_profit ], [ "Expenses", :expenses ], [ "Net income", :net_income ] ].each do |label, key| %>
                <%# herb:key key %>
                <% unless pnl[key].nil? %>
                  <tr>
                    <td><%= label %></td>
                    <td class="txt-align-end"><strong><%= money pnl[key] %></strong></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
          <% if pnl.expense_lines.any? %>
            <p class="txt-x-small txt-subtle margin-none">Biggest costs: <%= pnl.expense_lines.first(5).map { "#{it[:name]} #{money it[:cents]}" }.join(" · ") %></p>
          <% end %>
        <% else %>
          <p class="txt-small txt-subtle margin-none">QuickBooks’ profit and loss isn’t available: <%= pnl.error %></p>
        <% end %>
      </section>
    </div>

    <div class="settings__panel panel shadow txt-align-start">
      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">What clients owe, by age</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% financials.aging.each do |bucket| %>
            <%# herb:key bucket[:label] %>
            <li class="flex align-center gap-half txt-small">
              <span class="min-width"><%= bucket[:label] %></span>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <%= report_share bucket[:cents], financials.outstanding_cents %>
              <span class="txt-nowrap"><strong><%= money bucket[:cents] %></strong> <span class="txt-subtle"><%= pluralize(bucket[:count], "invoice") %></span></span>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">Recurring revenue</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% recurring.each do |row| %>
            <%# herb:key row[:engagement].id %>
            <li class="flex align-center gap-half txt-small" data-filter-target="item">
              <%= link_to engagement_path(row[:engagement]), class: "txt-ink txt-align-start overflow-ellipsis min-width" do %>
                <strong><%= row[:engagement].ref %> <%= row[:engagement].title %></strong>
                <div class="txt-x-small txt-subtle"><%= row[:engagement].client.name %> · <%= money row[:amount] %> <%= row[:cadence] %></div>
              <% end %>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <span class="txt-nowrap"><%= money row[:monthly] %>/mo</span>
              <% if row[:state] == "billed" %>
                <%= status_tag "Active" %>
              <% else %>
                <%= status_tag row[:state] == "out of step" ? "Blocked" : "Dormant" %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if recurring.empty? %>
          <p class="txt-small txt-subtle margin-none">No open, approved services.</p>
        <% else %>
          <p class="txt-x-small txt-subtle margin-none">Dormant: QuickBooks doesn’t bill it. Blocked: QuickBooks bills something other than what was agreed.</p>
        <% end %>
      </section>

      <% unbilled = financials.unbilled %>
      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">Approved, not yet invoiced</h2>
        </header>
        <ul class="settings__scrollable-list">
          <% unbilled.each do |row| %>
            <%# herb:key row[:engagement].id %>
            <li class="flex align-center gap-half txt-small" data-filter-target="item">
              <%= link_to engagement_path(row[:engagement]), class: "txt-ink txt-align-start overflow-ellipsis min-width" do %>
                <strong><%= row[:engagement].ref %> <%= row[:engagement].title %></strong>
                <div class="txt-x-small txt-subtle"><%= row[:engagement].client.name %> · agreed <%= money row[:agreed] %> · invoiced <%= money row[:invoiced] %><%= " · closed" if row[:engagement].closed? %></div>
              <% end %>
              <hr class="separator--horizontal flex-item-grow txt-subtle" aria-hidden="true">
              <strong class="txt-nowrap"><%= money row[:agreed] - row[:invoiced] %></strong>
            </li>
          <% end %>
        </ul>
        <% if unbilled.empty? %>
          <p class="txt-small txt-subtle margin-none">Everything approved has been invoiced.</p>
        <% end %>
      </section>

      <% clients = financials.by_client.first(10) %>
      <section class="settings__section flex flex-column gap-half">
        <header>
          <h2 class="divider">By client</h2>
        </header>
        <table class="data-table txt-small">
          <thead>
            <tr><th class="txt-align-start"><%= term(:client) %></th><th class="txt-align-end">Billed</th><th class="txt-align-end">Collected</th><th class="txt-align-end">Owes</th></tr>
          </thead>
          <tbody>
            <% clients.each do |row| %>
              <%# herb:key row[:client].id %>
              <tr data-filter-target="item">
                <td><%= link_to row[:client].name, client_path(row[:client]), class: "txt-link" %></td>
                <td class="txt-align-end"><%= money row[:billed] %></td>
                <td class="txt-align-end"><%= money row[:collected] %></td>
                <td class="txt-align-end"><%= money row[:owed] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </section>
    </div>
  </section>
<% end %>
