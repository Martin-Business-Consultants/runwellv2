<%# locals: (link:, path:) %>
<%# One ad account at a glance: this month so far against last month, and the way into the
    full report. %>
<% this_month = link.this_month %>
<% last_month = link.last_month %>
<div class="flex flex-column gap-half">
  <div class="flex align-center gap-half txt-small">
    <strong class="overflow-ellipsis"><%= link.label %></strong>
    <span class="txt-subtle txt-nowrap"><%= link.formatted_customer_id %></span>
    <% if link.account&.blocked? %>
      <%= status_tag "Stopped" %>
    <% end %>
  </div>
  <% if link.account&.blocked? %>
    <p class="txt-small txt-negative margin-none">These ads have stopped running. <%= link.account.explanation %></p>
  <% end %>
  <div class="ads-stats">
    <div class="ads-stat">
      <span class="txt-x-small txt-subtle"><%= this_month&.label || Date.current.strftime("%B") + " so far" %></span>
      <span class="ads-stat__value"><%= this_month ? money(this_month.cost_cents) : "—" %></span>
      <span class="txt-x-small txt-subtle"><%= this_month ? pluralize(this_month.conversions.round, "lead") + " · through " + l(this_month.through, format: :short) : "Not synced yet" %></span>
    </div>
    <div class="ads-stat">
      <span class="txt-x-small txt-subtle"><%= last_month&.label || Date.current.prev_month.strftime("%B %Y") %></span>
      <span class="ads-stat__value"><%= last_month ? money(last_month.cost_cents) : "—" %></span>
      <span class="txt-x-small txt-subtle"><%= last_month ? pluralize(last_month.conversions.round, "lead") : "No figures" %></span>
    </div>
  </div>
  <%= link_to path, class: "btn btn--link txt-small center" do %>
    <span>Open the report</span>
    <%= icon_tag "arrow-right" %>
  <% end %>
</div>
