<%# locals: (engagement:) %>
<% link = engagement.google_ads_link %>
<% if link %>
  <section class="settings__section">
    <header>
      <h2 class="divider">Advertising</h2>
    </header>
    <%= render "google_ads/summary", link: link, path: google_ads_portal_report_path(account: link.customer_id) %>
  </section>
<% end %>
